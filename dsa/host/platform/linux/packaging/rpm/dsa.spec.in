# The RPM of DSA. build-packages.sh fills in the @...@ values and appends the description and
# the scripts; the files come already built from its staging folder.
Name:           @NAME@
Version:        @VERSION@
Release:        1
Summary:        @SUMMARY@
License:        Apache-2.0
URL:            https://github.com/thisisthepy/desktop-subsystem-for-android
Requires:       systemd
Requires:       systemd-udev
# What crosvm, which runs the Android VM, links from the system.
Requires:       libstdc++
Requires:       libcap
Requires:       libwayland-client
Requires:       libdrm
Requires:       vulkan-loader
# What DSA Settings, the settings app, links from the system.
Requires:       gtk4
Requires:       libadwaita
Recommends:     pipewire-pulseaudio
Recommends:     pulseaudio-libs
Recommends:     geoclue2
Recommends:     xdg-desktop-portal
Recommends:     cups-client
Recommends:     upower
Recommends:     power-profiles-daemon
Recommends:     iio-sensor-proxy
Recommends:     xdg-utils
AutoReqProv:    no

# The programs are built and stripped by cargo; nothing is rebuilt or post-processed here.
%global debug_package %{nil}
%global __os_install_post %{nil}
%global _build_id_links none

%install
mkdir -p %{buildroot}
cp -a @STAGE@/. %{buildroot}/

%files -f @FILES@
%defattr(-,root,root,-)
