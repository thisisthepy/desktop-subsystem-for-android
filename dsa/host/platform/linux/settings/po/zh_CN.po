msgstr "未安装"

msgid "Only APK files and split APK bundles can be installed: {0}"
msgstr "只能安装 APK 文件和拆分 APK 包：{0}"

msgid "Installing {0} in Android…"
msgstr "正在将 {0} 安装到 Android…"

