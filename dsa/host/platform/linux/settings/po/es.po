msgstr "No compatible: {0} {1} está instalado pero desactivado."

msgid "Not supported: {0} {1} is turned off."
msgstr "No compatible: {0} {1} está desactivado."

msgid "Supported by {0} {1} ({2}), the translator that comes with this Android."
msgstr "Compatible mediante {0} {1} ({2}), el traductor que incluye este Android."

msgid "{0} {1} ({2}) comes with this Android. It is used unless you install another translator.\nGoing back to it removes the package that replaced it, from the next start of Android."
msgstr "{0} {1} ({2}) viene con este Android. Se usa a menos que instale otro traductor.\nVolver a él quita el paquete que lo sustituyó, a partir del próximo inicio de Android."

msgid "Use the default translator"
msgstr "Usar el traductor predeterminado"

