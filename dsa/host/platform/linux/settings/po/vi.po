msgid "it is no longer installed"
msgstr "ứng dụng không còn được cài đặt"

msgid "it is part of Android"
msgstr "ứng dụng là một phần của Android"

msgid "Android does not allow it, because the app is a device administrator or a policy keeps it"
msgstr "Android không cho phép, vì ứng dụng là quản trị viên thiết bị hoặc một chính sách giữ nó lại"

msgid "Android could not uninstall it"
msgstr "Android không thể gỡ cài đặt ứng dụng"

msgid "it is an Android App Bundle, made to be uploaded to an app store. Get the app as an APK, or as an .xapk, .apks or .apkm bundle."
msgstr "đây là Android App Bundle, dùng để tải lên cửa hàng ứng dụng. Hãy lấy ứng dụng dạng APK, hoặc gói .xapk, .apks hay .apkm."

msgid "the bundle is encrypted, so its APKs cannot be read. Get the app as an APK, or as a newer bundle."
msgstr "gói đã được mã hóa nên không đọc được các APK bên trong. Hãy lấy ứng dụng dạng APK, hoặc một gói mới hơn."

msgid "a split APK of the bundle is signed with another key than its base APK, so Android would refuse it."
msgstr "một APK tách của gói được ký bằng khóa khác với APK gốc, nên Android sẽ từ chối."

msgid "the bundle is not one app that Android can install."
msgstr "gói này không phải một ứng dụng mà Android có thể cài đặt."

msgid "the app has no 64-bit code that DSA's Android runs: x86_64, or arm64-v8a through ARM translation. Get one of those builds."
msgstr "ứng dụng không có mã 64-bit mà Android của DSA chạy được: x86_64, hoặc arm64-v8a qua dịch ARM. Hãy lấy một trong các bản dựng đó."

msgid "the app has only ARM code (arm64-v8a), and ARM translation is off. Turn it on under ARM apps, restart Android and install it again."
msgstr "ứng dụng chỉ có mã ARM (arm64-v8a) và dịch ARM đang tắt. Hãy bật nó trong Ứng dụng ARM, khởi động lại Android rồi cài lại."

msgid "the app does not run on this Android: it needs another processor type, a newer Android version or a feature this device does not have."
msgstr "ứng dụng không chạy trên Android này: cần loại bộ xử lý khác, Android mới hơn hoặc tính năng mà thiết bị này không có."

msgid "the app is installed already, signed with another key. Uninstall it in Android first."
msgstr "ứng dụng đã được cài, nhưng ký bằng khóa khác. Hãy gỡ cài đặt nó trong Android trước."

msgid "the file is not a signed APK that Android can read."
msgstr "tệp không phải là APK đã ký mà Android có thể đọc."

msgid "Android has no room for the app."
msgstr "Android không còn chỗ cho ứng dụng."

msgid "a newer version of the app is installed. Uninstall it in Android first."
msgstr "một phiên bản mới hơn của ứng dụng đã được cài. Hãy gỡ cài đặt nó trong Android trước."

msgid "a policy of this Android does not allow the app."
msgstr "một chính sách của Android này không cho phép ứng dụng."

msgid "Android did not install the app."
msgstr "Android đã không cài đặt ứng dụng."

msgid "Not supported: no ARM translation package is installed."
msgstr "Không được hỗ trợ: chưa cài gói dịch ARM nào."

msgid "Not supported: {0} {1} is installed but turned off."
msgstr "Không được hỗ trợ: {0} {1} đã được cài nhưng đang tắt."

msgid "Not supported: {0} {1} is turned off."
msgstr "Không được hỗ trợ: {0} {1} đang tắt."

msgid "Supported by {0} {1} ({2}), the translator that comes with this Android."
msgstr "Được hỗ trợ bởi {0} {1} ({2}), trình dịch đi kèm Android này."

msgid "{0} {1} ({2}) comes with this Android. It is used unless you install another translator.\nGoing back to it removes the package that replaced it, from the next start of Android."
msgstr "{0} {1} ({2}) đi kèm Android này. Nó được dùng trừ khi bạn cài một trình dịch khác.\nQuay lại nó sẽ gỡ gói đã thay thế nó, từ lần khởi động Android tiếp theo."

msgid "Use the default translator"
msgstr "Dùng trình dịch mặc định"

