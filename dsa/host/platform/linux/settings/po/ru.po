msgstr "Не поддерживается: {0} {1} выключен."

msgid "Supported by {0} {1} ({2}), the translator that comes with this Android."
msgstr "Поддерживается через {0} {1} ({2}), транслятор, входящий в этот Android."

msgid "{0} {1} ({2}) comes with this Android. It is used unless you install another translator.\nGoing back to it removes the package that replaced it, from the next start of Android."
msgstr "{0} {1} ({2}) входит в этот Android. Он используется, если вы не установите другой транслятор.\nВозврат к нему удаляет заменивший его пакет со следующего запуска Android."

msgid "Use the default translator"
msgstr "Использовать транслятор по умолчанию"

msgid "Use"
msgstr "Использовать"

msgid "licence not given"
msgstr "лицензия не указана"

