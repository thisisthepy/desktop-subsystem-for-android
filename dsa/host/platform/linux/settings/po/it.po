msgstr "{0} ora funziona come ARM."

msgid "{0} runs its x86_64 code now."
msgstr "{0} ora esegue il suo codice x86_64."

msgid "its APKs on the device hold no code for that"
msgstr "i suoi APK sul dispositivo non contengono codice per questo"

msgid "ARM translation is not on"
msgstr "La traduzione ARM non è attiva"

msgid "Android refused"
msgstr "Android ha rifiutato"

