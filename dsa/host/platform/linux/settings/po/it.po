msgstr "Non chiudere DSA e non avviare app Android finché l'aggiornamento non è terminato."

msgid "Updated to {0}"
msgstr "Aggiornato a {0}"

msgid "DSA has not come back after the update to {0}. If it does not start soon, restart the computer."
msgstr "DSA non è ripartito dopo l'aggiornamento a {0}. Se non si avvia a breve, riavviare il computer."

msgid "Updating to {0} failed. The version before it is still installed."
msgstr "Aggiornamento a {0} non riuscito. La versione precedente è ancora installata."

