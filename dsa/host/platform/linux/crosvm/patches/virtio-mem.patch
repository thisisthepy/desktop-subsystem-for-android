+// found in the LICENSE file. It is contributed under crosvm's own licence
+// (BSD-3-Clause) so the patched crosvm keeps one licence.
+
+//! A virtio-mem device (virtio specification 1.2, section 5.15).
+//!
+//! The device owns one region of guest physical memory outside the boot memory map. The guest
+//! plugs and unplugs it block by block, and the main process asks for a size through
+//! `VirtioMemControlCommand::SetRequestedSize`; the device reports the new size to the guest
+//! with a configuration change interrupt, and the guest's driver plugs or unplugs blocks to
+//! reach it. A block the guest unplugs is freed on the host at once, so memory the guest gives
+//! back leaves the VM's footprint before the request completes. The region is part of
+//! `GuestMemory`, so every other device can reach the blocks the guest plugs.
+
+use std::collections::BTreeMap;
+use std::io::Read;
+use std::io::Write;
+use std::sync::Arc;
+
+use anyhow::anyhow;
+use anyhow::Context;
+use base::error;
+use base::warn;
+use base::AsRawDescriptor;
+use base::Event;
+use base::EventToken;
+use base::RawDescriptor;
+use base::Tube;
+use base::WaitContext;
+use base::WorkerThread;
+use serde::Deserialize;
+use serde::Serialize;
+use snapshot::AnySnapshot;
+use sync::Mutex;
+use vm_control::api::VmMemoryClient;
+use vm_control::AnyControlTube;
+use vm_control::VirtioMemControlCommand;
+use vm_memory::GuestAddress;
+use vm_memory::GuestMemory;
+use vm_memory::MemoryRegionPurpose;
+
+use super::copy_config;
+use super::DeviceType;
+use super::Interrupt;
+use super::Queue;
+use super::VirtioDevice;
+use crate::VirtioDeviceArgs;
+use crate::VirtioDeviceModule;
+
+const QUEUE_SIZE: u16 = 128;
+const QUEUE_SIZES: &[u16] = &[QUEUE_SIZE];
+
+/// The unit the guest plugs and unplugs. 2 MiB is the pageblock size of x86-64 and of arm64
+/// with 4 KiB pages, the smallest block a Linux guest can take on and give back.
+pub const BLOCK_SIZE: u64 = 2 << 20;
+
+const VIRTIO_MEM_REQ_PLUG: u16 = 0;
+const VIRTIO_MEM_REQ_UNPLUG: u16 = 1;
+const VIRTIO_MEM_REQ_UNPLUG_ALL: u16 = 2;
+const VIRTIO_MEM_REQ_STATE: u16 = 3;
+
+const VIRTIO_MEM_RESP_ACK: u16 = 0;
+const VIRTIO_MEM_RESP_NACK: u16 = 1;
+const VIRTIO_MEM_RESP_ERROR: u16 = 3;
+
+const VIRTIO_MEM_STATE_PLUGGED: u16 = 0;
+const VIRTIO_MEM_STATE_UNPLUGGED: u16 = 1;
+const VIRTIO_MEM_STATE_MIXED: u16 = 2;
+
+/// `struct virtio_mem_req`: type, padding, then addr, nb_blocks and padding.
+const REQUEST_SIZE: usize = 24;
+/// `struct virtio_mem_resp`: type, padding, then the state.
+const RESPONSE_SIZE: usize = 10;
+/// `struct virtio_mem_config`.
+const CONFIG_SIZE: usize = 56;
+
+/// Which blocks are plugged and how much the guest is asked to have.
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+pub struct MemState {
+    pub addr: u64,
+    pub block_size: u64,
+    /// The usable region's size, a whole number of blocks.
+    pub region_size: u64,
+    pub requested_size: u64,
+    pub plugged: Vec<bool>,
+}
+
+/// What the device answers a request with.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MemResponse {
+    Ack,
+    Nack,
+    Error,
+    State(u16),
+}
+
+impl MemResponse {
+    fn to_bytes(self) -> [u8; RESPONSE_SIZE] {
+        let (kind, state) = match self {
+            MemResponse::Ack => (VIRTIO_MEM_RESP_ACK, 0),
+            MemResponse::Nack => (VIRTIO_MEM_RESP_NACK, 0),
+            MemResponse::Error => (VIRTIO_MEM_RESP_ERROR, 0),
+            MemResponse::State(state) => (VIRTIO_MEM_RESP_ACK, state),
+        };
+        let mut out = [0u8; RESPONSE_SIZE];
+        out[0..2].copy_from_slice(&kind.to_le_bytes());
+        out[8..10].copy_from_slice(&state.to_le_bytes());
+        out
+    }
+}
+
+/// A host-side change a request needs before it is answered.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MemEffect {
+    None,
+    /// The guest may use this range again.
+    Reclaim(u64, u64),
+    /// The guest gave this range back: free it on the host.
+    Free(u64, u64),
+}
+
+impl MemState {
+    pub fn new(addr: u64, size: u64) -> MemState {
+        let blocks = size / BLOCK_SIZE;
+        MemState {
+            addr,
+            block_size: BLOCK_SIZE,
+            region_size: blocks * BLOCK_SIZE,
+            requested_size: 0,
+            plugged: vec![false; blocks as usize],
+        }
+    }
+
+    pub fn plugged_size(&self) -> u64 {
+        self.plugged.iter().filter(|p| **p).count() as u64 * self.block_size
+    }
+
+    /// Sets the size the guest is asked to have, rounded down to a block and capped at the
+    /// region. Returns whether it changed.
+    pub fn set_requested_size(&mut self, bytes: u64) -> bool {
+        let size = (bytes / self.block_size * self.block_size).min(self.region_size);
+        let changed = size != self.requested_size;
+        self.requested_size = size;
+        changed
+    }
+
+    /// The blocks `addr` and `nb_blocks` name, if they are inside the usable region.
+    fn blocks(&self, addr: u64, nb_blocks: u16) -> Option<std::ops::Range<usize>> {
+        if nb_blocks == 0 || addr < self.addr || (addr - self.addr) % self.block_size != 0 {
+            return None;
+        }
+        let first = (addr - self.addr) / self.block_size;
+        let end = first.checked_add(u64::from(nb_blocks))?;
+        if end > self.plugged.len() as u64 {
+            return None;
+        }
+        Some(first as usize..end as usize)
+    }
+
+    /// Answers one request from the guest. `request` is `struct virtio_mem_req`, zero padded.
+    pub fn handle(&mut self, request: &[u8; REQUEST_SIZE]) -> (MemResponse, MemEffect) {
+        let kind = u16::from_le_bytes([request[0], request[1]]);
+        let mut addr_bytes = [0u8; 8];
+        addr_bytes.copy_from_slice(&request[8..16]);
+        let addr = u64::from_le_bytes(addr_bytes);
+        let nb_blocks = u16::from_le_bytes([request[16], request[17]]);
+        match kind {
+            VIRTIO_MEM_REQ_PLUG => {
+                let Some(blocks) = self.blocks(addr, nb_blocks) else {
+                    return (MemResponse::Error, MemEffect::None);
+                };
+                if self.plugged[blocks.clone()].iter().any(|p| *p) {
+                    return (MemResponse::Error, MemEffect::None);
+                }
+                let size = u64::from(nb_blocks) * self.block_size;
+                if self.plugged_size() + size > self.requested_size {
+                    return (MemResponse::Nack, MemEffect::None);
+                }
+                self.plugged[blocks].iter_mut().for_each(|p| *p = true);
+                (MemResponse::Ack, MemEffect::Reclaim(addr, size))
+            }
+            VIRTIO_MEM_REQ_UNPLUG => {
+                let Some(blocks) = self.blocks(addr, nb_blocks) else {
+                    return (MemResponse::Error, MemEffect::None);
+                };
+                if !self.plugged[blocks.clone()].iter().all(|p| *p) {
+                    return (MemResponse::Error, MemEffect::None);
+                }
+                self.plugged[blocks].iter_mut().for_each(|p| *p = false);
+                let size = u64::from(nb_blocks) * self.block_size;
+                (MemResponse::Ack, MemEffect::Free(addr, size))
+            }
+            VIRTIO_MEM_REQ_UNPLUG_ALL => {
+                self.plugged.iter_mut().for_each(|p| *p = false);
+                (MemResponse::Ack, MemEffect::Free(self.addr, self.region_size))
+            }
+            VIRTIO_MEM_REQ_STATE => {
+                let Some(blocks) = self.blocks(addr, nb_blocks) else {
+                    return (MemResponse::Error, MemEffect::None);
+                };
+                let range = &self.plugged[blocks];
+                let state = if range.iter().all(|p| *p) {
+                    VIRTIO_MEM_STATE_PLUGGED
+                } else if range.iter().all(|p| !*p) {
+                    VIRTIO_MEM_STATE_UNPLUGGED
+                } else {
+                    VIRTIO_MEM_STATE_MIXED
+                };
+                (MemResponse::State(state), MemEffect::None)
+            }
+            _ => (MemResponse::Error, MemEffect::None),
+        }
+    }
+
+    /// `struct virtio_mem_config`.
+    pub fn config(&self) -> [u8; CONFIG_SIZE] {
+        let mut out = [0u8; CONFIG_SIZE];
+        out[0..8].copy_from_slice(&self.block_size.to_le_bytes());
+        // node_id (0) and padding stay zero.
+        out[16..24].copy_from_slice(&self.addr.to_le_bytes());
+        out[24..32].copy_from_slice(&self.region_size.to_le_bytes());
+        out[32..40].copy_from_slice(&self.region_size.to_le_bytes());
+        out[40..48].copy_from_slice(&self.plugged_size().to_le_bytes());
+        out[48..56].copy_from_slice(&self.requested_size.to_le_bytes());
+        out
+    }
+}
+
+fn apply(client: &VmMemoryClient, effect: MemEffect) {
+    let result = match effect {
+        MemEffect::None => return,
+        MemEffect::Reclaim(addr, size) => {
+            client.dynamically_reclaim_memory_ranges(vec![(GuestAddress(addr), size)])
+        }
+        MemEffect::Free(addr, size) => {
+            client.dynamically_free_memory_ranges(vec![(GuestAddress(addr), size)])
+        }
+    };
+    if let Err(e) = result {
+        warn!("virtio-mem: {:?} failed: {:#}", effect, e);
+    }
+}
+
+struct Worker {
+    queue: Queue,
+    interrupt: Interrupt,
+    state: Arc<Mutex<MemState>>,
+    control_tube: Tube,
+    vm_memory_client: VmMemoryClient,
+}
+
+impl Worker {
+    fn process_queue(&mut self) {
+        let mut used = false;
+        while let Some(mut chain) = self.queue.pop() {
+            let mut request = [0u8; REQUEST_SIZE];
+            let len = chain.reader.available_bytes().min(REQUEST_SIZE);
+            let response = match chain.reader.read_exact(&mut request[..len]) {
+                Ok(()) => {
+                    let (response, effect) = self.state.lock().handle(&request);
+                    // The host side first: memory the guest gave back is freed before the
+                    // guest hears that the unplug is done.
+                    apply(&self.vm_memory_client, effect);
+                    response
+                }
+                Err(e) => {
+                    warn!("virtio-mem: unreadable request: {}", e);
+                    MemResponse::Error
+                }
+            };
+            if let Err(e) = chain.writer.write_all(&response.to_bytes()) {
+                warn!("virtio-mem: could not answer a request: {}", e);
+            }
+            self.queue.add_used(chain);
+            used = true;
+        }
+        if used {
+            self.queue.trigger_interrupt();
+        }
+    }
+
+    fn process_control(&mut self) -> anyhow::Result<()> {
+        let command: VirtioMemControlCommand = self
+            .control_tube
+            .recv()
+            .context("failed to receive a virtio-mem command")?;
+        match command {
+            VirtioMemControlCommand::SetRequestedSize { bytes } => {
+                if self.state.lock().set_requested_size(bytes) {
+                    self.interrupt.signal_config_changed();
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn run(&mut self, kill_evt: Event) -> anyhow::Result<()> {
+        #[derive(EventToken)]
+        enum Token {
+            Queue,
+            Control,
+            Kill,
+        }
+
+        let wait_ctx = WaitContext::build_with(&[
+            (self.queue.event(), Token::Queue),
+            (&self.control_tube, Token::Control),
+            (&kill_evt, Token::Kill),
+        ])
+        .context("failed creating WaitContext")?;
+
+        // Requests that came while the device was not running.
+        self.process_queue();
+        loop {
+            let events = wait_ctx.wait().context("failed polling for events")?;
+            for event in events.iter() {
+                match event.token {
+                    Token::Queue => {
+                        self.queue
+                            .event()
+                            .wait()
+                            .context("failed reading queue Event")?;
+                        self.process_queue();
+                    }
+                    Token::Control => {
+                        if event.is_hungup && !event.is_readable {
+                            // The main process is gone; keep serving the guest.
+                            wait_ctx
+                                .delete(&self.control_tube)
+                                .context("failed to remove the control tube")?;
+                        } else if let Err(e) = self.process_control() {
+                            error!("{:#}", e);
+                            wait_ctx
+                                .delete(&self.control_tube)
+                                .context("failed to remove the control tube")?;
+                        }
+                    }
+                    Token::Kill => return Ok(()),
+                }
+            }
+        }
+    }
+}
+
+/// The tubes a stopped worker hands back.
+struct Stopped {
+    queue: Queue,
+    control_tube: Tube,
+    vm_memory_client: VmMemoryClient,
+}
+
+struct VirtioMem {
+    base_features: u64,
+    state: Arc<Mutex<MemState>>,
+    control_tube: Option<Tube>,
+    vm_memory_client: Option<VmMemoryClient>,
+    worker_thread: Option<WorkerThread<Stopped>>,
+}
+
+impl VirtioMem {
+    fn stop_worker(&mut self) -> Option<Queue> {
+        let stopped = self.worker_thread.take()?.stop();
+        self.control_tube = Some(stopped.control_tube);
+        self.vm_memory_client = Some(stopped.vm_memory_client);
+        Some(stopped.queue)
+    }
+}
+
+impl VirtioDevice for VirtioMem {
+    fn keep_rds(&self) -> Vec<RawDescriptor> {
+        let mut rds = Vec::new();
+        if let Some(tube) = &self.control_tube {
+            rds.push(tube.as_raw_descriptor());
+        }
+        if let Some(client) = &self.vm_memory_client {
+            rds.push(client.as_raw_descriptor());
+        }
+        rds
+    }
+
+    fn device_type(&self) -> DeviceType {
+        DeviceType::Mem
+    }
+
+    fn queue_max_sizes(&self) -> &[u16] {
+        QUEUE_SIZES
+    }
+
+    fn features(&self) -> u64 {
+        // No VIRTIO_MEM_F_ACPI_PXM (one node) and no VIRTIO_MEM_F_UNPLUGGED_INACCESSIBLE: an
+        // unplugged block reads as zeroes, which the guest never relies on.
+        self.base_features
+    }
+
+    fn read_config(&self, offset: u64, data: &mut [u8]) {
+        let config = self.state.lock().config();
+        copy_config(data, 0, &config, offset);
+    }
+
+    fn activate(
+        &mut self,
+        _mem: GuestMemory,
+        interrupt: Interrupt,
+        mut queues: BTreeMap<usize, Queue>,
+    ) -> anyhow::Result<()> {
+        if queues.len() != 1 {
+            return Err(anyhow!("expected 1 queue, got {}", queues.len()));
+        }
+        let queue = queues.remove(&0).unwrap();
+        let control_tube = self
+            .control_tube
+            .take()
+            .context("the virtio-mem control tube is missing")?;
+        let vm_memory_client = self
+            .vm_memory_client
+            .take()
+            .context("the virtio-mem memory client is missing")?;
+        let state = self.state.clone();
+        self.worker_thread = Some(WorkerThread::start("v_mem", move |kill_evt| {
+            let mut worker = Worker {
+                queue,
+                interrupt,
+                state,
+                control_tube,
+                vm_memory_client,
+            };
+            if let Err(e) = worker.run(kill_evt) {
+                error!("virtio-mem worker thread failed: {:#}", e);
+            }
+            Stopped {
+                queue: worker.queue,
+                control_tube: worker.control_tube,
+                vm_memory_client: worker.vm_memory_client,
+            }
+        }));
+        Ok(())
+    }
+
+    fn reset(&mut self) -> anyhow::Result<()> {
+        self.stop_worker();
+        // A reset guest starts with nothing plugged; give back what it had at once.
+        let mut state = self.state.lock();
+        let had = state.plugged_size() > 0;
+        state.plugged.iter_mut().for_each(|p| *p = false);
+        if had {
+            if let Some(client) = &self.vm_memory_client {
+                apply(client, MemEffect::Free(state.addr, state.region_size));
+            }
+        }
+        Ok(())
+    }
+
+    fn virtio_sleep(&mut self) -> anyhow::Result<Option<BTreeMap<usize, Queue>>> {
+        Ok(self.stop_worker().map(|queue| BTreeMap::from([(0, queue)])))
+    }
+
+    fn virtio_wake(
+        &mut self,
+        queues_state: Option<(GuestMemory, Interrupt, BTreeMap<usize, Queue>)>,
+    ) -> anyhow::Result<()> {
+        if let Some((mem, interrupt, queues)) = queues_state {
+            self.activate(mem, interrupt, queues)?;
+        }
+        Ok(())
+    }
+
+    fn virtio_snapshot(&mut self) -> anyhow::Result<AnySnapshot> {
+        AnySnapshot::to_any(self.state.lock().clone())
+    }
+
+    fn virtio_restore(&mut self, data: AnySnapshot) -> anyhow::Result<()> {
+        let restored: MemState = AnySnapshot::from_any(data)?;
+        let mut state = self.state.lock();
+        if restored.addr != state.addr || restored.plugged.len() != state.plugged.len() {
+            return Err(anyhow!("the snapshot's virtio-mem region differs from this VM's"));
+        }
+        *state = restored;
+        Ok(())
+    }
+}
+
+/// The virtio-mem device of a VM made with `--virtio-mem`: it serves the `VirtioMem` region
+/// of guest memory.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct VirtioMemModule;
+
+impl VirtioDeviceModule for VirtioMemModule {
+    fn sort_name(&self) -> &'static str {
+        "mem"
+    }
+
+    fn create(&self, cx: &mut VirtioDeviceArgs<'_>) -> anyhow::Result<Box<dyn VirtioDevice>> {
+        let (addr, size) = cx
+            .vm
+            .get_memory()
+            .regions()
+            .find(|region| region.options.purpose == MemoryRegionPurpose::VirtioMem)
+            .map(|region| (region.guest_addr.offset(), region.size as u64))
+            .context("the VM has no virtio-mem region")?;
+        let (control_host, control_device) = Tube::pair().context("failed to create tube")?;
+        (cx.add_control_tube)(AnyControlTube::VirtioMem(control_host));
+        let (memory_host, memory_device) = Tube::pair().context("failed to create tube")?;
+        (cx.add_control_tube)(AnyControlTube::VmMemoryTube {
+            tube: memory_host,
+            expose_with_viommu: false,
+            remote_peer: cx.jail_config.is_some(),
+        });
+        Ok(Box::new(VirtioMem {
+            base_features: super::base_features(cx.protection_type),
+            state: Arc::new(Mutex::new(MemState::new(addr, size))),
+            control_tube: Some(control_device),
+            vm_memory_client: Some(VmMemoryClient::new(memory_device)),
+            worker_thread: None,
+        }))
+    }
+
+    fn create_jail(
+        &self,
+        jail_config: Option<&jail::JailConfig>,
+    ) -> anyhow::Result<Option<minijail::Minijail>> {
+        // The balloon's policy: the device frees guest memory through the main process, the
+        // same requests the balloon makes.
+        jail::simple_jail(jail_config, "balloon_device")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const ADDR: u64 = 0x1_4000_0000;
+
+    fn request(kind: u16, addr: u64, nb_blocks: u16) -> [u8; REQUEST_SIZE] {
+        let mut r = [0u8; REQUEST_SIZE];
+        r[0..2].copy_from_slice(&kind.to_le_bytes());
+        r[8..16].copy_from_slice(&addr.to_le_bytes());
+        r[16..18].copy_from_slice(&nb_blocks.to_le_bytes());
+        r
+    }
+
+    #[test]
+    fn plugs_up_to_the_requested_size_and_frees_what_is_unplugged() {
+        let mut state = MemState::new(ADDR, 64 * BLOCK_SIZE);
+        // Nothing is requested: a plug is refused.
+        assert_eq!(
+            state.handle(&request(VIRTIO_MEM_REQ_PLUG, ADDR, 1)).0,
+            MemResponse::Nack
+        );
+        assert!(state.set_requested_size(4 * BLOCK_SIZE + 1));
+        assert_eq!(state.requested_size, 4 * BLOCK_SIZE);
+        assert_eq!(
+            state.handle(&request(VIRTIO_MEM_REQ_PLUG, ADDR, 4)),
+            (MemResponse::Ack, MemEffect::Reclaim(ADDR, 4 * BLOCK_SIZE))
+        );
+        assert_eq!(state.plugged_size(), 4 * BLOCK_SIZE);
+        // Beyond the request.
+        assert_eq!(
+            state
+                .handle(&request(VIRTIO_MEM_REQ_PLUG, ADDR + 4 * BLOCK_SIZE, 1))
+                .0,
+            MemResponse::Nack
+        );
+        assert_eq!(
+            state.handle(&request(VIRTIO_MEM_REQ_STATE, ADDR, 8)).0,
+            MemResponse::State(VIRTIO_MEM_STATE_MIXED)
+        );
+        assert_eq!(
+            state.handle(&request(VIRTIO_MEM_REQ_UNPLUG, ADDR + BLOCK_SIZE, 2)),
+            (MemResponse::Ack, MemEffect::Free(ADDR + BLOCK_SIZE, 2 * BLOCK_SIZE))
+        );
+        assert_eq!(state.plugged_size(), 2 * BLOCK_SIZE);
+        // Unplugging a block that is not plugged is an error.
+        assert_eq!(
+            state.handle(&request(VIRTIO_MEM_REQ_UNPLUG, ADDR + BLOCK_SIZE, 1)).0,
+            MemResponse::Error
+        );
+        assert_eq!(
+            state.handle(&request(VIRTIO_MEM_REQ_UNPLUG_ALL, 0, 0)),
+            (MemResponse::Ack, MemEffect::Free(ADDR, 64 * BLOCK_SIZE))
+        );
+        assert_eq!(state.plugged_size(), 0);
+    }
+
+    #[test]
+    fn rejects_ranges_outside_the_region() {
+        let mut state = MemState::new(ADDR, 8 * BLOCK_SIZE);
+        state.set_requested_size(u64::MAX);
+        assert_eq!(state.requested_size, 8 * BLOCK_SIZE);
+        for (addr, nb) in [
+            (ADDR - BLOCK_SIZE, 1),
+            (ADDR + 1, 1),
+            (ADDR, 9),
+            (ADDR, 0),
+            (ADDR + 8 * BLOCK_SIZE, 1),
+        ] {
+            assert_eq!(
+                state.handle(&request(VIRTIO_MEM_REQ_PLUG, addr, nb)).0,
+                MemResponse::Error
+            );
+        }
+        assert_eq!(state.handle(&request(9, ADDR, 1)).0, MemResponse::Error);
+    }
+
+    #[test]
+    fn config_reports_the_region_and_sizes() {
+        let mut state = MemState::new(ADDR, 8 * BLOCK_SIZE + 5);
+        state.set_requested_size(2 * BLOCK_SIZE);
+        state.handle(&request(VIRTIO_MEM_REQ_PLUG, ADDR, 1));
+        let config = state.config();
+        let field = |at: usize| u64::from_le_bytes(config[at..at + 8].try_into().unwrap());
+        assert_eq!(field(0), BLOCK_SIZE);
+        assert_eq!(field(16), ADDR);
+        assert_eq!(field(24), 8 * BLOCK_SIZE);
+        assert_eq!(field(32), 8 * BLOCK_SIZE);
+        assert_eq!(field(40), BLOCK_SIZE);
+        assert_eq!(field(48), 2 * BLOCK_SIZE);
+    }
+}
