# The upstream revisions the Linux host's VM is built from. build.sh fetches each into
# .scratch/ and builds it; nothing of them is kept in this repository.

# crosvm (BSD-3-Clause), the VMM, from https://chromium.googlesource.com/crosvm/crosvm. Upstream
# has no virtio-mem device (checked at this revision and at main 3fc118b2 of 2026-11-05), so
# build.sh applies patches/virtio-mem.patch. Moving the pin means checking that it still applies.
CROSVM_REMOTE=https://chromium.googlesource.com/crosvm/crosvm
CROSVM_REVISION=b1aa4d87ea41273aad8be3ac8e37ba7d86b9b1c4

# The crosvm features DSA ships: the balloon with free page reporting, virtio-net and
# vhost-user (for passt), qcow2 disks made by earlier DSA builds, and virtio-gpu with
# gfxstream. vhost-vsock, virtio-blk, the virtio console and the minijail sandbox are always
# built in.
CROSVM_FEATURES=balloon,net,qcow,gpu,gfxstream

# passt (GPL-2.0-or-later AND BSD-3-Clause), the user-mode NAT, from https://passt.top/passt
PASST_REMOTE=https://passt.top/passt
PASST_TAG=2026_09_25.df90211
