    "WidevineRestartBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android verwendet die Änderung ab seinem nächsten Start."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android uses the change from its next start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android aplica el cambio desde su próximo inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
