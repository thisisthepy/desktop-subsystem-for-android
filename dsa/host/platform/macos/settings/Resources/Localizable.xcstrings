    "Arm_DefaultDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1} ({2}) gehört zu diesem Android und wird verwendet, solange Sie keinen anderen Übersetzer installieren.\nDie Rückkehr dazu entfernt das an seiner Stelle installierte Paket, ab dem nächsten Start von Android."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1} ({2}) comes with this Android and is used unless you install another translator.\nGoing back to it removes the package installed in its place, from the next start of Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1} ({2}) viene con este Android y se usa salvo que instale otro traductor.\nVolver a él elimina el paquete instalado en su lugar, desde el próximo inicio de Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1} ({2}) est fourni avec cet Android et est utilisé sauf si vous installez un autre traducteur.\nY revenir supprime le paquet installé à sa place, à partir du prochain démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1} ({2}) disertakan dengan Android ini dan digunakan kecuali Anda menginstal penerjemah lain.\nKembali ke penerjemah ini menghapus paket yang diinstal sebagai gantinya, sejak Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1} ({2}) è incluso in questo Android e viene usato se non installi un altro traduttore.\nTornare a questo rimuove il pacchetto installato al suo posto, dal prossimo avvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1} ({2}) はこの Android に付属しており、別の変換ツールをインストールしない限り使われます。\nこれに戻すと、代わりにインストールしたパッケージが、次に Android が起動したときから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1}({2})은(는) 이 Android에 함께 들어 있으며, 다른 번역기를 설치하지 않으면 이것을 씁니다.\n이것으로 되돌리면 대신 설치한 묶음을 지웁니다. 다음에 Android를 시작할 때부터 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1} ({2}) vem com este Android e é usado se você não instalar outro tradutor.\nVoltar a ele remove o pacote instalado no lugar dele, a partir da próxima inicialização do Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1} ({2}) входит в этот Android и используется, если не установлен другой транслятор.\nВозврат к нему удаляет пакет, установленный вместо него, начиная со следующего запуска Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1} ({2}) bu Android ile birlikte gelir ve başka bir çevirmen yüklemediğiniz sürece kullanılır.\nOna geri dönmek, yerine yüklenen paketi Android'in sonraki açılışından itibaren kaldırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1} ({2}) đi kèm Android này và được dùng trừ khi bạn cài trình dịch khác.\nQuay lại trình dịch này sẽ gỡ bỏ gói đã cài thay cho nó, từ lần khởi động Android tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1}（{2}）随此 Android 提供，除非您安装其他转译器，否则会使用它。\n改回它会移除代替它安装的软件包，从 Android 下次启动时起生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1}（{2}）隨附於此 Android，除非您安裝其他轉譯器，否則會使用它。\n改回它時，會移除取代它而安裝的套件，從 Android 下次啟動時開始生效。"
          }
        }
      }
    },
    "Arm_SupportedDefault": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützt durch {0} {1} ({2}), den Übersetzer, der zu diesem Android gehört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported by {0} {1} ({2}), the translator that comes with this Android."
