    "AppsFullScreen.ToolTip": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo diese App erscheint, wenn sie klar Vollbild anfordert, etwa per Vollbildtaste eines Videoplayers. F11 schaltet Vollbild immer um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where this app shows a clear full screen request, such as a video player's full screen button. F11 always switches full screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde se muestra esta app cuando pide claramente pantalla completa, como el botón de un reproductor de vídeo. F11 siempre la alterna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où s'affiche cette app sur une demande claire de plein écran, comme le bouton d'un lecteur vidéo. F11 bascule toujours le plein écran."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat aplikasi ini tampil saat jelas meminta layar penuh, seperti tombol layar penuh pemutar video. F11 selalu mengalihkan layar penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove appare l'app se chiede esplicitamente lo schermo intero, come col pulsante di un lettore video. F11 lo attiva o disattiva sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画プレーヤーの全画面ボタンなど、このアプリが明示的に全画面表示を求めたときの表示先です。F11 は常に全画面表示を切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 앱의 전체 화면 단추처럼 이 앱이 분명하게 전체 화면을 요청할 때 어디에 보일지 정합니다. F11은 언제나 전체 화면을 켜고 끕니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde este app aparece ao pedir claramente tela cheia, como o botão de tela cheia de um player de vídeo. F11 sempre alterna a tela cheia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где показывать приложение при явном запросе полного экрана, например кнопкой видеоплеера. F11 всегда переключает полный экран."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama, video oynatıcının tam ekran düğmesi gibi açık bir tam ekran isteğinde nerede görünür. F11 her zaman tam ekranı açıp kapatır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nơi ứng dụng này hiển thị khi yêu cầu rõ ràng toàn màn hình, như nút toàn màn hình của trình phát video. F11 luôn chuyển toàn màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用发出明确的全屏请求（例如视频播放器的全屏按钮）时显示的位置。F11 始终可以切换全屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式明確要求全螢幕時（例如影片播放器的全螢幕按鈕）要在哪裡顯示。F11 一律會切換全螢幕。"
          }
        }
      }
    },
