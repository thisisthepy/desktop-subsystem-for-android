    "BackupNowCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert die Daten aller Apps in Android verschlüsselt im Sicherungsordner.\nAndroid startet bei Bedarf zuerst, und die Sicherung kann eine Weile dauern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the data of every app in Android to the backup folder, encrypted.\nAndroid starts first if needed, and backing up can take a while."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda cifrados en la carpeta de copia de seguridad los datos de todas las apps de Android.\nAndroid se inicia antes si hace falta, y la copia puede tardar un rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les données de chaque app d'Android dans le dossier de sauvegarde, chiffrées.\nAndroid démarre d'abord si nécessaire, et la sauvegarde peut prendre un moment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan data setiap aplikasi di Android ke folder cadangan, dalam bentuk terenkripsi.\nAndroid dimulai lebih dulu jika perlu, dan pencadangan dapat memakan waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva in modo crittografato i dati di ogni app di Android nella cartella di backup.\nSe necessario, Android si avvia prima, e il backup può richiedere un po' di tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android のすべてのアプリのデータを暗号化して、バックアップ フォルダに保存します。\n必要に応じて先に Android が起動します。バックアップには時間がかかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android에 있는 모든 앱의 데이터를 암호화해 백업 폴더에 저장합니다.\n필요하면 Android를 먼저 시작하며, 백업에는 시간이 걸릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva os dados de todos os apps do Android na pasta de backup, criptografados.\nO Android inicia antes, se necessário, e o backup pode demorar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет данные всех приложений Android в папку резервных копий в зашифрованном виде.\nПри необходимости сначала запускается Android; создание копии может занять время."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android'deki her uygulamanın verilerini şifreleyerek yedekleme klasörüne kaydeder.\nGerekirse önce Android başlar ve yedekleme biraz zaman alabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu dữ liệu của mọi ứng dụng trong Android vào thư mục sao lưu, có mã hóa.\nAndroid khởi động trước nếu cần, và việc sao lưu có thể mất một lúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 Android 中每个应用的数据加密存储到备份文件夹。\n如有需要，会先启动 Android，备份可能需要一段时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Android 中所有應用程式的資料加密後儲存到備份資料夾。\n必要時會先啟動 Android，備份可能需要一段時間。"
          }
        }
      }
    },
