    "ArmRemoveCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht das Paket von Ihrem Add-on-Datenträger. Installierte ARM-Apps bleiben, laufen aber nach einem Neustart von Android nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the package from your add-on disk. ARM apps you installed stay, but do not run after Android restarts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el paquete de su disco de complementos. Las apps ARM instaladas se conservan, pero no se ejecutan tras reiniciar Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le paquet de votre disque d'extensions. Les apps ARM installées restent, mais ne s'exécutent plus une fois Android redémarré."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus paket dari disk add-on Anda. Aplikasi ARM yang Anda instal tetap ada, tetapi tidak berjalan setelah Android dimulai ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina il pacchetto dal disco dei componenti aggiuntivi. Le app ARM installate restano, ma non funzionano dopo il riavvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドオン用ディスクからパッケージを削除します。インストールした ARM アプリは残りますが、Android の再起動後は動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 구성 요소 디스크에서 묶음을 지웁니다. 설치한 ARM 앱은 남지만, Android를 다시 시작하면 실행되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga o pacote do disco de complementos. Os apps ARM instalados ficam, mas não são executados depois que o Android reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет пакет с диска дополнений. Установленные приложения ARM останутся, но не будут запускаться после перезапуска Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketi eklenti diskinizden siler. Yüklediğiniz ARM uygulamaları kalır, ancak Android yeniden başladıktan sonra çalışmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa gói khỏi đĩa tiện ích bổ sung. Các ứng dụng ARM bạn đã cài vẫn còn, nhưng không chạy sau khi Android khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从附加组件磁盘中删除该软件包。您安装的 ARM 应用会保留，但 Android 重新启动后将无法运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從您的附加元件磁碟刪除套件。您安裝的 ARM 應用程式會保留，但 Android 重新啟動後就無法執行。"
          }
        }
      }
    },
    "ArmRemoveCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "de": {
