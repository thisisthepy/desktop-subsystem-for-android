          }
        }
      }
    },
    "ChangeAsAdmin.Content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change as administrator"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 권한으로 변경"
          }
        }
      }
    },
    "ClipboardCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default: text you copy on the Mac can be pasted in Android apps, and text copied in Android can be pasted on the Mac. Images stay where they were copied."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 켜짐입니다. Mac에서 복사한 텍스트를 Android 앱에 붙여넣을 수 있고, Android에서 복사한 텍스트를 Mac에 붙여넣을 수 있습니다. 이미지는 복사한 곳에만 남습니다."
          }
        }
      }
    },
    "ClipboardCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the clipboard with Android"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android와 클립보드 공유"
          }
        }
      }
    },
    "CommandLineCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything on these pages is also available from a terminal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면의 모든 기능을 터미널에서도 쓸 수 있습니다."
          }
        }
      }
    },
    "CommandLineCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dsa command"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "dsa 명령"
          }
        }
      }
    },
    "CommandLineHeader.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command line"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령줄"
          }
        }
      }
    },
    "CopyButton.ToolTip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사"
          }
        }
      }
    },
    "DeveloperHeader.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발자"
          }
        }
      }
    },
    "DeveloperModeCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. When on, adb on this Mac can connect to Android without asking in Android, through a port only this Mac can reach. Turn it off when you are done."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐입니다. 켜면 이 Mac의 adb가 Android에서 승인하지 않고 Android에 연결할 수 있습니다. 포트는 이 Mac에서만 닿습니다. 다 쓰면 끄세요."
          }
        }
      }
    },
    "DeveloperModeCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer mode"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발자 모드"
          }
        }
      }
    },
    "DiagnosticsHeader.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단"
          }
        }
      }
    },
    "DiagnosticsNote.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The traces go to the DSA logs below and make them grow, so turn them on only to report a problem. They apply to every user of this Mac, so only an administrator can change them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적은 아래의 DSA 로그에 쌓여 로그를 키우므로, 문제를 알릴 때만 켜세요. 이 Mac의 모든 사용자에게 적용되므로 관리자만 바꿀 수 있습니다."
          }
        }
      }
    },
    "DisplayGpuCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the default choice renders on now."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값을 고르면 지금 이 GPU에서 렌더링합니다."
          }
        }
      }
    },
    "DisplayGpuCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU of the main display"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 디스플레이의 GPU"
          }
        }
      }
    },
    "DisplayTitle.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display & GPU"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 및 GPU"
          }
        }
      }
    },
    "ElevatedFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The setting was not changed (dsa ended with code {0})."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 바꾸지 못했습니다(dsa 종료 코드 {0})."
          }
        }
      }
    },
    "Elevation_Prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA Settings wants to change a setting that applies to every user of this Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 설정이 이 Mac의 모든 사용자에게 적용되는 설정을 바꾸려고 합니다."
          }
        }
      }
    },
    "ElevationDeclined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The setting was not changed, because administrator rights were not given."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 권한을 받지 못해 설정을 바꾸지 않았습니다."
          }
        }
      }
    },
    "FileSharingCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default: the folders chosen below show in Android's shared storage, in the Host folder, so Android apps can open and save files there. Android apps reach them only with Android's storage permission, and macOS lets them do only what your own account may do."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 켜짐입니다. 아래에서 고른 폴더가 Android 공유 저장소의 Host 폴더에 보여, Android 앱이 그곳의 파일을 열고 저장할 수 있습니다. Android 앱은 Android의 저장소 권한이 있을 때만 이 폴더에 닿고, macOS는 내 계정이 할 수 있는 일만 허락합니다."
          }
        }
      }
    },
