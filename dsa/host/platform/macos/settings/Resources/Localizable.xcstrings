    "ProgramUpdate_KeepOpen": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie DSA nicht und starten Sie keine Android-Apps, bis das Update abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not close DSA or start Android apps until the update is done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cierre DSA ni inicie apps de Android hasta que termine la actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne fermez pas DSA et ne lancez pas d'apps Android avant la fin de la mise à jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan tutup DSA atau memulai aplikasi Android sampai pembaruan selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non chiudere DSA e non avviare app Android finché l'aggiornamento non è terminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが完了するまで、DSA を閉じたり Android アプリを起動したりしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트가 끝날 때까지 DSA를 닫거나 Android 앱을 시작하지 마십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não feche o DSA nem abra apps Android até a atualização terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закрывайте DSA и не запускайте приложения Android, пока обновление не завершится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme bitene kadar DSA'yı kapatmayın ve Android uygulamalarını başlatmayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đóng DSA hoặc mở ứng dụng Android cho đến khi cập nhật xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新完成前，请勿关闭 DSA 或启动 Android 应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新完成前，請勿關閉 DSA 或啟動 Android 應用程式。"
          }
        }
      }
    },
