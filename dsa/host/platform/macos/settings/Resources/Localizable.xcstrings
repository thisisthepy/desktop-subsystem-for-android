    "GappsRegisterCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hat dieses Android nicht zertifiziert, daher verweigert Google die Anmeldung unter Umständen, bis Sie es registrieren.\nÖffnen Sie die Seite unten, melden Sie sich bei Google an und geben Sie die Android-ID ein. Einige Minuten später klappt die Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google has not certified this Android, so it may refuse to sign you in until you register it.\nOpen the page below, sign in with your Google account and enter this device's Android ID. Sign-in works a few minutes later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google no ha certificado este Android, así que puede impedirle iniciar sesión hasta que lo registre.\nAbra la página de abajo, inicie sesión en Google e introduzca el ID de Android de este dispositivo. Minutos después podrá entrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google n'a pas certifié cet Android et peut donc refuser votre connexion tant que vous ne l'avez pas enregistré.\nSur la page ci-dessous, connectez-vous à Google et saisissez l'Android ID de l'appareil. La connexion fonctionne quelques minutes après."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Google belum mensertifikasi Android ini, jadi Google mungkin menolak proses masuk sampai Anda mendaftarkannya.\nBuka halaman di bawah, masuk dengan akun Google Anda, lalu masukkan Android ID perangkat ini. Masuk berhasil beberapa menit kemudian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Google non ha certificato questo Android, quindi potrebbe rifiutare l'accesso finché non lo registri.\nApri la pagina qui sotto, accedi con l'account Google e inserisci l'ID Android del dispositivo. L'accesso funziona dopo qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Android は Google の認定を受けていないため、登録するまで Google がサインインを拒否することがあります。\n下のページを開き、Google アカウントでサインインして、このデバイスの Android ID を入力してください。数分後からサインインできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Android는 Google이 인증한 기기가 아니어서, 등록하기 전에는 Google이 로그인을 거부할 수 있습니다.\n아래 페이지를 열어 Google 계정으로 로그인하고 이 기기의 Android ID를 입력하세요. 몇 분 뒤부터 로그인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Google não certificou este Android, então pode recusar seu login até que você o registre.\nAbra a página abaixo, faça login com sua Conta do Google e informe o Android ID deste dispositivo. Minutos depois, o login funciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Google не сертифицировал этот Android, поэтому может отказывать во входе, пока вы его не зарегистрируете.\nОткройте страницу ниже, войдите в аккаунт Google и введите Android ID этого устройства. Вход заработает через несколько минут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google bu Android'i onaylamadığından, siz kaydedene kadar oturum açmanızı reddedebilir.\nAşağıdaki sayfayı açın, Google hesabınızla oturum açın ve bu aygıtın Android ID'sini girin. Oturum açma birkaç dakika sonra çalışır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google chưa chứng nhận Android này, nên Google có thể từ chối cho bạn đăng nhập cho đến khi bạn đăng ký nó.\nMở trang bên dưới, đăng nhập bằng tài khoản Google và nhập Android ID của thiết bị này. Vài phút sau là đăng nhập được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Android 未经 Google 认证，因此在您注册之前，Google 可能会拒绝您登录。\n打开下面的页面，用您的 Google 账号登录，并输入此设备的 Android ID。几分钟后即可登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Android 未經 Google 認證，因此在您註冊前，Google 可能會拒絕讓您登入。\n請打開下方頁面，以您的 Google 帳號登入，並輸入此裝置的 Android ID。幾分鐘後即可登入。"
          }
        }
      }
    },
