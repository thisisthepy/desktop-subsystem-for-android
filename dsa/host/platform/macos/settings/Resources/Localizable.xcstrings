          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicie o Android para aplicar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустите Android, чтобы применить"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamak için Android'i yeniden başlatın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại Android để áp dụng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动 Android 以应用更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動 Android 以套用"
          }
        }
      }
    },
    "RootElevation_LogAt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Anfrage wird im Dienstprotokoll mit App, Zeit, Zustimmung und Befehl festgehalten: {0}"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each request is kept in the service log with the app, the time, whether it was approved and the command: {0}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada solicitud queda en el registro del servicio con la app, la hora, si se aprobó y el comando: {0}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque demande est consignée dans le journal du service avec l'app, l'heure, la décision et la commande : {0}"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap permintaan dicatat di log layanan beserta aplikasi, waktu, apakah disetujui, dan perintahnya: {0}"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni richiesta resta nel log del servizio con l'app, l'ora, l'esito dell'approvazione e il comando: {0}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各要求は、アプリ、時刻、承認されたかどうか、コマンドとともにサービスのログに記録されます: {0}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청마다 앱, 시각, 승인 여부, 실행한 명령이 서비스 로그에 남습니다: {0}"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pedido fica no log do serviço com o app, a hora, se foi aprovado e o comando: {0}"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый запрос записывается в журнал службы с приложением, временем, решением и командой: {0}"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her istek; uygulama, zaman, onaylanıp onaylanmadığı ve komutla birlikte hizmet günlüğünde tutulur: {0}"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi yêu cầu được lưu trong nhật ký dịch vụ cùng ứng dụng, thời gian, kết quả chấp thuận và lệnh: {0}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个请求都会连同应用、时间、是否获批和命令记录在服务日志中：{0}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
