        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android không cài ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 未安装该应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 未安裝此應用程式。"
          }
        }
      }
    },
    "Install_Reason_app-bundle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "es ist ein Android App Bundle zum Hochladen in einen App-Store. Laden Sie die App als APK oder als Bundle (.xapk, .apks oder .apkm)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "it is an Android App Bundle, made to be uploaded to an app store. Get the app as an APK, or as an .xapk, .apks or .apkm bundle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "es un Android App Bundle, pensado para subirse a una tienda de apps. Consiga la app como APK o como paquete .xapk, .apks o .apkm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "il s'agit d'un Android App Bundle, destiné à être publié sur une boutique d'apps. Obtenez l'app en APK, ou en lot .xapk, .apks ou .apkm."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "ini Android App Bundle, untuk diunggah ke toko aplikasi. Dapatkan aplikasi dalam bentuk APK, atau bundel .xapk, .apks, atau .apkm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "è un Android App Bundle, fatto per essere caricato in uno store di app. Ottieni l'app come APK o come bundle .xapk, .apks o .apkm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリストアにアップロードするための Android App Bundle です。APK か、.xapk、.apks、.apkm のバンドルで入手してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 스토어에 올리는 Android App Bundle입니다. 앱을 APK나 .xapk, .apks, .apkm 묶음으로 받으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "é um Android App Bundle, feito para ser enviado a uma loja de apps. Obtenha o app como APK ou como pacote .xapk, .apks ou .apkm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "это Android App Bundle для публикации в магазине приложений. Скачайте приложение в виде APK или пакета .xapk, .apks или .apkm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bu, uygulama mağazalarına yüklemek için yapılmış bir Android App Bundle. Uygulamayı APK ya da .xapk, .apks veya .apkm paketi olarak alın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "đây là Android App Bundle, dùng để tải lên cửa hàng ứng dụng. Hãy lấy ứng dụng dưới dạng APK, hoặc gói .xapk, .apks hay .apkm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 Android App Bundle，用于上传到应用商店。请获取该应用的 APK，或 .xapk、.apks 或 .apkm 包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是要上傳到應用程式商店的 Android App Bundle。請以 APK，或 .xapk、.apks、.apkm 組合包的形式取得應用程式。"
          }
        }
      }
    },
    "Install_Reason_encrypted-bundle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "das Bundle ist verschlüsselt, daher lassen sich seine APKs nicht lesen. Laden Sie die App als APK oder als neueres Bundle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the bundle is encrypted, so its APKs cannot be read. Get the app as an APK, or as a newer bundle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "el paquete está cifrado, así que sus APK no se pueden leer. Consiga la app como APK o como un paquete más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le lot est chiffré, ses APK sont donc illisibles. Obtenez l'app en APK, ou dans un lot plus récent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "bundel ini terenkripsi, jadi APK-nya tidak dapat dibaca. Dapatkan aplikasi sebagai APK, atau sebagai bundel yang lebih baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "il bundle è crittografato, quindi i suoi APK non si possono leggere. Ottieni l'app come APK o come bundle più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バンドルが暗号化されているため、APK を読み取れません。APK または新しいバンドルとしてアプリを入手してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 묶음이라 APK를 읽을 수 없습니다. 앱을 APK나 새 묶음으로 받으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o pacote é criptografado, então os APKs dele não podem ser lidos. Obtenha o app como APK ou como um pacote mais novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "пакет зашифрован, поэтому его APK не читаются. Скачайте приложение в виде APK или более нового пакета."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "paket şifreli olduğundan APK'leri okunamıyor. Uygulamayı APK veya daha yeni bir paket olarak alın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "gói đã được mã hóa, nên không đọc được các APK bên trong. Hãy lấy ứng dụng dưới dạng APK, hoặc một gói mới hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该包已加密，因此无法读取其中的 APK。请获取该应用的 APK 或较新的包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此組合包已加密，因此無法讀取其中的 APK。請以 APK 或較新的組合包形式取得應用程式。"
          }
        }
      }
    },
    "Install_Reason_split-signature-mismatch": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "eine Split-APK des Bundles ist mit einem anderen Schlüssel signiert als ihre Basis-APK, daher würde Android sie ablehnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a split APK of the bundle is signed with another key than its base APK, so Android would refuse it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "un APK dividido del paquete está firmado con una clave distinta de la de su APK base, así que Android lo rechazaría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "un APK fractionné du lot est signé avec une autre clé que son APK de base : Android le refuserait."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "sebuah split APK dalam bundel ditandatangani dengan kunci yang berbeda dari APK dasarnya, jadi Android akan menolaknya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "un APK suddiviso del bundle è firmato con una chiave diversa da quella dell'APK di base, quindi Android lo rifiuterebbe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バンドル内の分割 APK がベース APK と異なるキーで署名されているため、Android はインストールを拒否します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "묶음의 분할 APK가 기본 APK와 다른 키로 서명되어 있어 Android가 설치하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "um APK dividido do pacote está assinado com uma chave diferente da do APK base, então o Android o recusaria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "разделённый APK пакета подписан не тем ключом, что базовый APK, поэтому Android его отклонит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "paketteki bölünmüş bir APK, temel APK'den farklı bir anahtarla imzalanmış; Android bunu reddeder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "một split APK của gói được ký bằng khóa khác với APK cơ sở, nên Android sẽ từ chối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包中的某个拆分 APK 与其基础 APK 使用不同的密钥签名，因此 Android 会拒绝它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "組合包中的某個分割 APK 與其基礎 APK 是以不同金鑰簽署，因此 Android 會拒絕安裝。"
          }
        }
      }
    },
    "Install_Reason_invalid-bundle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "das Bundle ist keine einzelne App, die Android installieren kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the bundle is not one app that Android can install."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "el paquete no es una sola app que Android pueda instalar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le lot ne contient pas une seule app installable par Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "bundel ini bukan satu aplikasi yang dapat diinstal Android."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "il bundle non è un'unica app che Android può installare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバンドルは、Android がインストールできる 1 つのアプリではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 설치할 수 있는 하나의 앱으로 된 묶음이 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o pacote não é um único app que o Android consiga instalar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "пакет не является одним приложением, которое Android может установить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "paket, Android'in yükleyebileceği tek bir uygulama değil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "gói không phải là một ứng dụng duy nhất mà Android cài được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该包不是 Android 可以安装的单个应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此組合包不是 Android 可安裝的單一應用程式。"
          }
        }
      }
    },
