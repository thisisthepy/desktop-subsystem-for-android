    "BackupKeyCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel, der die Sicherung öffnet. Ohne ihn lässt sich die Sicherung nicht auf einem anderen Computer wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key that opens the backup. Without it, the backup cannot be restored on another computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave que abre la copia de seguridad. Sin ella, la copia no se puede restaurar en otro equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé qui ouvre la sauvegarde. Sans elle, la sauvegarde ne peut pas être restaurée sur un autre ordinateur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci yang membuka cadangan. Tanpanya, cadangan tidak dapat dipulihkan di komputer lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave che apre il backup. Senza di essa, il backup non può essere ripristinato su un altro computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを開くキーです。これがないと、別のコンピューターでバックアップを復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 여는 키입니다. 이 키가 없으면 다른 컴퓨터에서 백업을 복원할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave que abre o backup. Sem ela, o backup não pode ser restaurado em outro computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ, открывающий резервную копию. Без него копию нельзя восстановить на другом компьютере."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedeği açan anahtar. Bu anahtar olmadan yedek başka bir bilgisayarda geri yüklenemez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa để mở bản sao lưu. Không có khóa này, không thể khôi phục bản sao lưu trên máy tính khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于打开备份的密钥。没有它，就无法在其他电脑上恢复备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來打開備份的密鑰。沒有它，就無法在其他電腦上回復備份。"
          }
        }
      }
    },
    "BackupKeyShowButton.Content": {
