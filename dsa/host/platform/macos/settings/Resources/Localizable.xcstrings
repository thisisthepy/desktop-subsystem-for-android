    "UpdateNowBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA stops every user's Android and installs the newest version. The DSA service restarts when setup is done."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA가 모든 사용자의 Android를 종료하고 최신 버전을 설치합니다. 설치가 끝나면 DSA 서비스가 다시 시작합니다."
          }
        }
      }
    },
