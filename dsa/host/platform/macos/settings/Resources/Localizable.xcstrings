          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPU utilisé actuellement par le choix par défaut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat pilihan bawaan merender saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La GPU su cui esegue il rendering ora la scelta predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトの選択で現在描画に使われる GPU です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값을 고르면 지금 이 GPU에서 렌더링합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde a opção padrão renderiza agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где сейчас выполняется рендеринг при выборе по умолчанию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan seçimin şu an görüntü oluşturduğu GPU."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nơi lựa chọn mặc định hiện đang kết xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认选项当前用于渲染的 GPU。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設選項目前用來繪製的 GPU。"
          }
        }
      }
    },
    "DisplayGpuCard.Header": {
