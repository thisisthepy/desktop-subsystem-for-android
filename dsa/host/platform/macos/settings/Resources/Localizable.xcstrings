    "BackgroundAskCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this back on if you chose not to be asked again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 묻지 않도록 골랐다면 여기서 다시 켤 수 있습니다."
          }
        }
      }
    },
    "BackgroundAskCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask before stopping an app from the menu bar"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 앱을 중지하기 전에 묻기"
          }
        }
      }
    },
    "BackgroundDoneBar.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "BackgroundErrorBar.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The apps that run in the background could not be read or changed"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 실행 중인 앱을 읽거나 바꾸지 못했습니다"
          }
        }
      }
    },
    "BackgroundIntro.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These Android apps keep running after their windows close, because they play music, download files, keep a VPN on or do other work in the background. Each also has an item in the menu bar. Stopping an app ends what it is doing and frees the memory it used."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Android 앱들은 창을 닫은 뒤에도 음악 재생, 파일 내려받기, VPN 같은 일을 하며 계속 실행됩니다. 앱마다 메뉴 막대에도 항목이 있습니다. 앱을 중지하면 하던 일을 멈추고 쓰던 메모리를 돌려받습니다."
          }
        }
      }
    },
    "BackgroundNone.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app runs in the background."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 실행 중인 앱이 없습니다."
          }
        }
      }
    },
    "BackgroundOpenButton.Content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기"
          }
        }
      }
    },
    "BackgroundRefreshButton.Content": {
      "extractionState": "manual",
