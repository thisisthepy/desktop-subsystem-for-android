    "AboutIndependent.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android ist ein unabhängiges Open-Source-Projekt.\nEs steht in keiner Verbindung zu Apple oder Google und wird von ihnen weder unterstützt noch gesponsert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android is an independent open source project.\nIt is not affiliated with, endorsed by or sponsored by Apple or Google."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android es un proyecto independiente de código abierto.\nNo está afiliado a Apple ni a Google, ni cuenta con su respaldo o patrocinio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android est un projet open source indépendant.\nIl n'est ni affilié à Apple ou Google, ni approuvé ou parrainé par eux."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android adalah proyek sumber terbuka independen.\nProyek ini tidak berafiliasi dengan, didukung oleh, atau disponsori oleh Apple maupun Google."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android è un progetto open source indipendente.\nNon è affiliato, approvato o sponsorizzato da Apple o Google."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android は独立したオープンソース プロジェクトです。\nApple および Google とは提携しておらず、両社による承認や後援も受けていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android는 독립된 오픈 소스 프로젝트입니다.\nApple이나 Google과 제휴하거나 그 보증이나 후원을 받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Desktop Subsystem for Android é um projeto de código aberto independente.\nEle não é afiliado à Apple nem ao Google, nem endossado ou patrocinado por eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android является независимым проектом с открытым исходным кодом.\nОн не связан с Apple или Google, не одобрен и не спонсируется ими."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android bağımsız bir açık kaynak projesidir.\nApple veya Google ile bağlantılı değildir, onlar tarafından onaylanmamış veya desteklenmemektedir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android là một dự án mã nguồn mở độc lập.\nDự án không liên kết với Apple hay Google, và không được Apple hay Google xác nhận hoặc tài trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android 是一个独立的开源项目。\n它与 Apple 或 Google 没有关联，也未获得二者的认可或赞助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android 是獨立的開放原始碼專案。\n與 Apple 或 Google 沒有任何關聯，也未獲得其背書或贊助。"
          }
        }
      }
    },
    "AboutLicenseCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA steht unter der Apache License 2.0. Öffnen Sie die Lizenzen aller mitgelieferten Komponenten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA is licensed under the Apache License 2.0. Open the licences of every component it ships."
          }
