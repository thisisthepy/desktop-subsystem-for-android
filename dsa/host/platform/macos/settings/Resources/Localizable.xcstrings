    "WidevineInstallCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert das Widevine-Modul von Google, unverändert aus dem Android-Emulator-Abbild von Google übernommen (etwa 2 GB Download).\nNichts wird geladen, bevor Sie zustimmen. Widevine funktioniert ab dem nächsten Start von Android."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs Google's Widevine module, taken unchanged from Google's Android emulator image (about 2 GB to download).\nNothing is downloaded until you agree. Widevine works from the next start of Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala el módulo Widevine de Google, extraído sin cambios de la imagen del emulador de Android de Google (unos 2 GB de descarga).\nNo se descarga nada hasta que acepte. Widevine funciona a partir del próximo inicio de Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe le module Widevine de Google, extrait tel quel de l'image de l'émulateur Android de Google (environ 2 GB à télécharger).\nRien n'est téléchargé tant que vous n'acceptez pas. Widevine fonctionne à partir du prochain démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menginstal modul Widevine Google, diambil tanpa diubah dari image emulator Android milik Google (unduhan sekitar 2 GB).\nTidak ada yang diunduh sampai Anda setuju. Widevine berfungsi sejak Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa il modulo Widevine di Google, preso senza modifiche dall'immagine dell'emulatore Android di Google (circa 2 GB da scaricare).\nNon viene scaricato nulla finché non accetti. Widevine funziona dal prossimo avvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google の Android エミュレーター イメージ (約 2 GB をダウンロード) から、Widevine モジュールをそのまま取り出してインストールします。\n同意するまで何もダウンロードしません。Widevine は次に Android が起動したときから動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google의 Android 에뮬레이터 이미지(약 2GB 다운로드)에서 Widevine 모듈을 바꾸지 않고 꺼내 설치합니다.\n동의하기 전에는 아무것도 받지 않습니다. Widevine은 다음에 Android를 시작할 때부터 동작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala o módulo Widevine do Google, retirado sem alterações da imagem do emulador Android do Google (cerca de 2 GB para baixar).\nNada é baixado até você aceitar. O Widevine funciona a partir da próxima inicialização do Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает модуль Widevine от Google, извлечённый без изменений из образа эмулятора Android от Google (загрузка около 2 GB).\nНичего не загружается без вашего согласия. Widevine заработает при следующем запуске Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google'ın Widevine modülünü, Google'ın Android öykünücü görüntüsünden değiştirmeden alarak yükler (yaklaşık 2 GB indirme).\nSiz kabul edene kadar hiçbir şey indirilmez. Widevine, Android'in sonraki açılışından itibaren çalışır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài mô-đun Widevine của Google, lấy nguyên vẹn từ ảnh trình giả lập Android của Google (tải khoảng 2 GB).\nKhông có gì được tải xuống cho đến khi bạn đồng ý. Widevine hoạt động từ lần khởi động Android tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Google 的 Widevine 模块，它从 Google 的 Android 模拟器映像中原样取出（需下载约 2 GB）。\n在您同意之前，不会下载任何内容。Widevine 从 Android 下次启动时起生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝 Google 的 Widevine 模組，原封不動取自 Google 的 Android 模擬器映像（需下載約 2 GB）。\n在您同意前，不會下載任何內容。Widevine 會從 Android 下次啟動時開始運作。"
          }
        }
      }
    },
    "WidevineInstalling.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa 2 GB werden von Google geladen und Widevine wird entnommen. Das dauert einige Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading about 2 GB from Google and taking out Widevine. It takes minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargando unos 2 GB de Google y extrayendo Widevine. Tarda unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement d'environ 2 GB depuis Google et extraction de Widevine. Cela prend quelques minutes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunduh sekitar 2 GB dari Google dan mengambil Widevine. Ini memakan waktu beberapa menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download di circa 2 GB da Google ed estrazione di Widevine. Richiede alcuni minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google から約 2 GB をダウンロードし、Widevine を取り出しています。数分かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google에서 약 2GB를 받아 Widevine을 꺼내고 있습니다. 몇 분 걸립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixando cerca de 2 GB do Google e extraindo o Widevine. Leva alguns minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка около 2 GB с серверов Google и извлечение Widevine. Это займёт несколько минут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google'dan yaklaşık 2 GB indiriliyor ve Widevine çıkarılıyor. Bu birkaç dakika sürer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải khoảng 2 GB từ Google và tách Widevine ra. Việc này mất vài phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在从 Google 下载约 2 GB 并取出 Widevine。这需要几分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在從 Google 下載約 2 GB 並取出 Widevine。這需要幾分鐘。"
          }
        }
      }
    },
