    "IdentityIntro.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Namen und der Build-Fingerprint, die Android Apps meldet. Ein leeres Feld behält den darin angezeigten Wert.\nAndroid liest diese Werte beim Start, daher gilt eine Änderung ab dem nächsten Start."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The names and build fingerprint Android reports to apps. An empty box keeps the value shown in it.\nAndroid reads these when it starts, so a change applies from its next start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres y la huella digital de compilación que Android comunica a las apps. Un campo vacío usa el valor que muestra.\nAndroid los lee al iniciarse, así que un cambio se aplica desde su próximo inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms et l'empreinte du build qu'Android indique aux apps. Un champ vide conserve la valeur qui y est affichée.\nAndroid les lit au démarrage : un changement s'applique donc à son prochain démarrage."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama dan sidik jari build yang dilaporkan Android ke aplikasi. Kotak kosong mempertahankan nilai yang ditampilkan di dalamnya.\nAndroid membacanya saat dimulai, jadi perubahan berlaku sejak Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi e l'impronta della build che Android comunica alle app. Una casella vuota mantiene il valore mostrato al suo interno.\nAndroid li legge all'avvio, quindi una modifica si applica dal prossimo avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android がアプリに報告する名前とビルド フィンガープリントです。空欄にすると、欄に表示されている値が使われます。\nAndroid は起動時にこれらを読み込むため、変更は次の起動から適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 앱에 알리는 이름과 빌드 지문입니다. 칸을 비워 두면 칸에 보이는 값을 씁니다.\nAndroid는 시작할 때 이 값을 읽으므로, 바꾼 값은 다음 시작부터 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes e a impressão digital da build que o Android informa aos apps. Uma caixa vazia mantém o valor mostrado nela.\nO Android os lê ao iniciar, por isso uma alteração vale a partir da próxima inicialização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена и отпечаток сборки, которые Android сообщает приложениям. Пустое поле сохраняет показанное в нём значение.\nAndroid читает их при запуске, поэтому изменение применяется при следующем запуске."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android'in uygulamalara bildirdiği adlar ve derleme parmak izi. Boş bırakılan kutu, içinde gösterilen değeri korur.\nAndroid bunları başlarken okur, bu yüzden değişiklik sonraki açılışından itibaren geçerlidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên và dấu vân tay bản dựng mà Android báo cho ứng dụng. Ô trống sẽ giữ giá trị hiển thị trong đó.\nAndroid đọc các giá trị này khi khởi động, nên thay đổi được áp dụng từ lần khởi động tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 向应用报告的名称和构建指纹。框留空时，会保留其中显示的值。\nAndroid 在启动时读取这些值，因此更改从下次启动时起生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 向應用程式回報的名稱與組建指紋。空白欄位會沿用其中顯示的值。\nAndroid 會在啟動時讀取這些值，因此變更會從下次啟動起套用。"
          }
        }
      }
    },
