    "AppsUninstallConfirmBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} und die zugehörigen Daten werden aus Android entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} and its data will be removed from Android. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} y sus datos se eliminarán de Android. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} et ses données seront supprimés d'Android. Cette opération est irréversible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} dan datanya akan dihapus dari Android. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} e i suoi dati verranno rimossi da Android. L'operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} とそのデータが Android から削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0}과(와) 그 데이터가 Android에서 지워집니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} e seus dados serão removidos do Android. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} и его данные будут удалены из Android. Это действие нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} ve verileri Android'den kaldırılacak. Bu işlem geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} và dữ liệu của nó sẽ bị xóa khỏi Android. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 及其数据将从 Android 中移除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 及其資料將從 Android 中移除。此動作無法復原。"
          }
        }
      }
    },
