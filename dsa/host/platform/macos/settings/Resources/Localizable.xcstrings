    "AndroidChooseCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA supports the latest two Android versions. Some apps run on only one of them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA는 최신 Android 버전 두 개를 지원합니다. 어떤 앱은 그중 한 버전에서만 동작합니다."
          }
        }
      }
    },
    "AndroidChooseCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version to use"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 버전"
          }
        }
      }
    },
    "AndroidChooseHeader.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android version"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 버전"
          }
        }
      }
    },
    "AndroidChooseNote.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every user of this computer runs the same Android version, so changing it needs an administrator. Security updates for the chosen version keep coming. When a version stops being supported, DSA moves to the next one and keeps your apps."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터의 모든 사용자가 같은 Android 버전을 쓰므로, 바꾸려면 관리자 권한이 필요합니다. 고른 버전의 보안 업데이트는 계속 받습니다. 버전의 지원이 끝나면 DSA가 다음 버전으로 올리고 앱은 그대로 둡니다."
          }
        }
      }
    },
    "AndroidDownConfirm.Action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase data and change"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 지우고 바꾸기"
          }
        }
      }
    },
    "AndroidDownConfirm.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase Android data to move to an older version?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 데이터를 지우고 이전 버전으로 옮길까요?"
          }
        }
      }
    },
    "AndroidFilesCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Android's shared storage in the Finder: the files Android apps saved, such as photos and downloads. Android starts if it is not running."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 공유 저장소를 Finder에서 엽니다. 사진과 다운로드처럼 Android 앱이 저장한 파일이 있습니다. Android가 실행 중이 아니면 시작합니다."
          }
        }
      }
    },
    "AndroidFilesCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android files"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 파일"
          }
        }
      }
    },
    "AndroidPatchCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security patch level"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 패치 수준"
          }
        }
      }
    },
    "AndroidRunningHeader.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running now"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 실행 중"
          }
        }
      }
    },
    "AndroidSwitchingBar.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the Android version"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 버전 바꾸는 중"
          }
        }
      }
    },
    "AndroidUpConfirm.Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} is downloaded and used the next time Android starts. Your apps and their data move along. Moving back later erases the data."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0}을(를) 내려받아 다음에 Android가 시작될 때부터 씁니다. 앱과 데이터는 함께 옮겨집니다. 나중에 되돌리면 데이터가 지워집니다."
          }
        }
      }
    },
    "AndroidUpConfirm.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to a newer Android?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 새 Android로 옮길까요?"
          }
        }
      }
    },
    "Android_UpToDate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Android update is waiting. DSA checks every day, and restarts Android into an update once no app window is open."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기다리는 Android 업데이트가 없습니다. DSA가 매일 확인하며, 열린 앱 창이 없을 때 Android를 다시 시작해 업데이트를 적용합니다."
          }
        }
      }
    },
    "AppsRoot.Name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root access"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트 권한"
          }
        }
      }
    },
    "AppsRootNote.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root access: Not allowed hides su from the app. Ask each time shows an administrator prompt with the app's name for each request, and after an approval the app is not asked again for 15 minutes. Remember approves without asking, so choosing it needs an administrator's approval."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트 권한: 요청 불가는 앱에게 su를 보이지 않게 합니다. 요청할 때 묻기는 요청마다 앱 이름이 적힌 관리자 승인 창을 띄우고, 승인한 뒤 15분 동안은 다시 묻지 않습니다. 기억은 묻지 않고 승인하므로, 이 수준을 고르려면 관리자 승인이 필요합니다."
          }
        }
      }
    },
    "AppsRootOffBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app can use su. An administrator of this Mac can turn root access on in Advanced, and then you choose each app's level here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 앱도 su를 쓸 수 없습니다. 이 Mac의 관리자가 고급 페이지에서 루트 권한을 켜면, 여기서 앱마다 수준을 고를 수 있습니다."
          }
        }
      }
    },
    "AppsRootOffBar.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root access is off"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트 권한이 꺼져 있습니다"
          }
        }
      }
    },
