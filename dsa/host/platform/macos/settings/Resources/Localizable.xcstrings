          }
        }
      }
    },
    "ArmRestartBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android wurde vor dieser Änderung gestartet. Beenden und starten Sie Android, damit ARM-Apps ihr folgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android started before this change. Stop and start Android for ARM apps to follow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android se inició antes de este cambio. Detenga e inicie Android para que las apps ARM lo apliquen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android a démarré avant ce changement. Arrêtez puis redémarrez Android pour que les apps ARM en tiennent compte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android dimulai sebelum perubahan ini. Hentikan lalu mulai Android agar aplikasi ARM mengikutinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android si è avviato prima di questa modifica. Arresta e avvia Android perché le app ARM la seguano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android はこの変更より前に起動しています。ARM アプリに反映するには、Android を停止してから起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 이 변경 전에 시작되었습니다. Android를 멈췄다가 다시 시작하면 ARM 앱에 반영됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android iniciou antes desta alteração. Pare e inicie o Android para que os apps ARM a sigam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android запущен до этого изменения. Остановите и снова запустите Android, чтобы оно применилось к приложениям ARM."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android bu değişiklikten önce başladı. ARM uygulamalarının buna uyması için Android'i durdurup yeniden başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android đã khởi động trước thay đổi này. Hãy dừng rồi khởi động Android để ứng dụng ARM áp dụng thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 在此更改之前就已启动。停止并重新启动 Android，ARM 应用才会采用此更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 在此變更之前就已啟動。請停止並再次啟動 Android，讓 ARM 應用程式套用變更。"
          }
        }
      }
    },
