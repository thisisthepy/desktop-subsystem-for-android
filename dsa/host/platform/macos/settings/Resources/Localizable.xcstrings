    "Memory_SharedDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher, den mehrere Prozesse gemeinsam nutzen, etwa Fensterbilder und Grafikpuffer. Er wird frei, wenn die Apps, die ihn nutzen, geschlossen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory that several processes use together, such as window images and graphics buffers. It is freed when the apps using it close."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria que comparten varios procesos, como las imágenes de las ventanas y los búferes gráficos. Se libera al cerrar las apps que la usan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoire partagée par plusieurs processus, comme les images des fenêtres et les tampons graphiques. Elle est libérée quand les applis qui l'utilisent se ferment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memori yang dipakai bersama oleh beberapa proses, seperti gambar jendela dan buffer grafis. Dilepas saat aplikasi yang memakainya ditutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria usata insieme da più processi, come le immagini delle finestre e i buffer grafici. Viene liberata quando le app che la usano si chiudono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のプロセスが共有するメモリです。ウィンドウの画像やグラフィックスのバッファが含まれます。使っているアプリを閉じると解放されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 프로세스가 함께 쓰는 메모리입니다. 창 화면과 그래픽 버퍼가 여기에 들어갑니다. 쓰던 앱을 닫으면 풀립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória que vários processos usam juntos, como imagens de janelas e buffers gráficos. É liberada quando os apps que a usam fecham."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Память, которую используют сразу несколько процессов, например изображения окон и графические буферы. Освобождается, когда использующие её приложения закрываются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere görüntüleri ve grafik arabellekleri gibi birkaç işlemin birlikte kullandığı bellek. Onu kullanan uygulamalar kapanınca serbest kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ nhiều tiến trình dùng chung, như hình ảnh cửa sổ và bộ đệm đồ họa. Được giải phóng khi các ứng dụng dùng nó đóng lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个进程共用的内存，例如窗口画面和图形缓冲区。使用它的应用关闭后即释放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多個程序共用的記憶體，例如視窗畫面和圖形緩衝區。使用它的應用程式關閉後即釋放。"
          }
        }
      }
    },
