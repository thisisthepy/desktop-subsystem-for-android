    "HostCertificatesOff.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange der Schalter aus ist, vertraut Android diesen Zertifikaten nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the switch is off, Android does not trust these certificates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras el interruptor esté desactivado, Android no confía en estos certificados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que l'interrupteur est désactivé, Android ne fait pas confiance à ces certificats."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selama sakelar nonaktif, Android tidak memercayai sertifikat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché l'interruttore è disattivato, Android non considera attendibili questi certificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチがオフの間、Android はこれらの証明書を信頼しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치가 꺼져 있는 동안 Android는 이 인증서를 신뢰하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto o botão estiver desativado, o Android não confia nesses certificados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока переключатель выключен, Android не доверяет этим сертификатам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar kapalıyken Android bu sertifikalara güvenmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi công tắc tắt, Android không tin cậy các chứng chỉ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开关关闭时，Android 不信任这些证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開關關閉時，Android 不會信任這些憑證。"
          }
        }
      }
    },
