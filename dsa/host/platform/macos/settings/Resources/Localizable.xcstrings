    "FilesNote.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To send a file to an Android app, drag it from the Finder onto the app's window. An APK you drop on this window is installed."
          }
        },
        "ko": {
          "stringUnit": {
