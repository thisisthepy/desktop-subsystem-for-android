          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 고침"
          }
        }
      }
    },
    "RenderGpuAppliesBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new render GPU takes effect when the window manager starts again: at the next login, or when you restart it below."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꾼 렌더링 GPU는 창 관리자가 다시 시작할 때 적용됩니다. 다음에 로그인할 때 적용되며, 아래에서 바로 다시 시작할 수도 있습니다."
          }
        }
      }
    },
    "RenderGpuCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The GPU that draws Android apps. By default it is the one that drives the main display, so frames never cross between GPUs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 앱을 그리는 GPU입니다. 기본값은 주 디스플레이를 구동하는 GPU입니다. 그래서 프레임이 GPU 사이를 건너지 않습니다."
          }
        }
      }
    },
    "RenderGpuCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Render GPU"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌더링 GPU"
          }
        }
      }
    },
    "ResetData_Warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This erases every app you installed in Android, the accounts you signed in to and the data of every app. Android stops now, and its next start is as it was first installed. The Android image and DSA's settings stay. This cannot be undone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android에 설치한 모든 앱, 로그인한 계정, 모든 앱의 데이터가 지워집니다. Android는 지금 멈추고, 다음에 시작할 때 처음 설치했을 때의 상태가 됩니다. Android 이미지와 DSA 설정은 그대로 남습니다. 되돌릴 수 없습니다."
          }
        }
      }
    },
    "ResetDataButton.Content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초기화"
          }
        }
      }
    },
    "ResetDataCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erases every app you installed, your accounts and the data of every app, so Android starts as it was first installed. The Android image and these settings stay."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치한 앱, 계정, 모든 앱의 데이터를 지우고 Android를 처음 설치했을 때로 되돌립니다. Android 이미지와 이 설정은 그대로 남습니다."
          }
        }
      }
    },
    "ResetDataCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Android's data"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
