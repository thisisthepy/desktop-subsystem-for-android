    "Identity_characteristics_Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics: tablet (Layouts für große Bildschirme), default (ein Smartphone) oder andere durch Kommas getrennte Wörter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics: tablet (large-screen layouts), default (a phone), or other words separated by commas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics: tablet (diseños para pantallas grandes), default (un teléfono) u otras palabras separadas por comas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics : tablet (dispositions grand écran), default (un téléphone), ou d'autres mots séparés par des virgules."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics: tablet (tata letak layar besar), default (ponsel), atau kata lain yang dipisahkan koma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics: tablet (layout per schermi grandi), default (un telefono) o altre parole separate da virgole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics: tablet (大画面のレイアウト)、default (スマートフォン)、またはコンマで区切ったその他の語です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics: tablet(큰 화면 배치), default(휴대전화), 또는 쉼표로 나눈 다른 낱말입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics: tablet (layouts de tela grande), default (um celular) ou outras palavras separadas por vírgulas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics: tablet (макеты для больших экранов), default (телефон) или другие слова через запятую."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics: tablet (büyük ekran düzenleri), default (telefon) veya virgülle ayrılmış başka sözcükler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics: tablet (bố cục màn hình lớn), default (điện thoại), hoặc các từ khác phân tách bằng dấu phẩy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics：tablet（大屏幕布局）、default（手机），或用逗号分隔的其他词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ro.build.characteristics：tablet（大螢幕版面配置）、default（手機），或以逗號分隔的其他字詞。"
          }
        }
      }
    },
    "Identity_characteristics_Invalid": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie kleingeschriebene Wörter aus Buchstaben, Ziffern und '_', durch Kommas getrennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use lower-case words of letters, digits and '_', separated by commas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use palabras en minúsculas de letras, dígitos y '_', separadas por comas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des mots en minuscules faits de lettres, de chiffres et de '_', séparés par des virgules."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan kata huruf kecil dari huruf, angka, dan '_', dipisahkan koma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa parole minuscole di lettere, cifre e '_', separate da virgole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英小文字、数字、'_' からなる語を、コンマで区切って使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소문자, 숫자, '_'로 된 낱말을 쉼표로 나누어 쓰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use palavras em minúsculas, com letras, dígitos e '_', separadas por vírgulas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте слова из строчных букв, цифр и '_', разделённые запятыми."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harf, rakam ve '_' içeren küçük harfli sözcükleri virgülle ayırarak kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng các từ viết thường gồm chữ cái, chữ số và '_', phân tách bằng dấu phẩy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用由小写字母、数字和 '_' 组成的词，并用逗号分隔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用由小寫字母、數字與 '_' 組成的字詞，並以逗號分隔。"
          }
        }
      }
    },
