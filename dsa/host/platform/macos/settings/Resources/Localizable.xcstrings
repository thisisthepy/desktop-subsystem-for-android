    "ProgramUpdate_Failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update auf {0} ist fehlgeschlagen. Die vorherige Version ist weiterhin installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating to {0} failed. The version before it is still installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar a {0}. La versión anterior sigue instalada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour vers {0} a échoué. La version précédente est toujours installée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan ke {0} gagal. Versi sebelumnya masih terinstal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamento a {0} non riuscito. La versione precedente è ancora installata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} へのアップデートに失敗しました。以前のバージョンがそのままインストールされています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 버전으로 업데이트하지 못했습니다. 이전 버전이 그대로 설치되어 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar para {0}. A versão anterior continua instalada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить до {0}. Предыдущая версия по-прежнему установлена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} sürümüne güncellenemedi. Önceki sürüm hâlâ yüklü."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể cập nhật lên {0}. Phiên bản trước đó vẫn được cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新到 {0} 失败。之前的版本仍保持安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更新至 {0}。先前的版本仍維持安裝。"
          }
        }
      }
    },
    "ProgramUpdate_NotBack": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA ist nach dem Update auf {0} nicht wieder gestartet. Wenn es nicht bald startet, starten Sie den Computer neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA has not come back after the update to {0}. If it does not start soon, restart the computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA no ha vuelto a iniciarse tras actualizarse a {0}. Si no se inicia pronto, reinicie el equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA n'a pas redémarré après la mise à jour vers {0}. S'il ne démarre pas bientôt, redémarrez l'ordinateur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA belum kembali setelah pembaruan ke {0}. Jika tidak segera dimulai, mulai ulang komputer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA non si è riavviato dopo l'aggiornamento a {0}. Se non si avvia a breve, riavvia il computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} へのアップデート後、DSA が再開していません。まもなく起動しない場合は、コンピューターを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 버전으로 업데이트한 뒤 DSA가 다시 시작하지 않았습니다. 곧 시작하지 않으면 컴퓨터를 다시 시작하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DSA não voltou após a atualização para {0}. Se ele não iniciar logo, reinicie o computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После обновления до {0} DSA ещё не работает. Если запуск не произойдёт в ближайшее время, перезагрузите компьютер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} sürümüne güncellemeden sonra DSA yeniden açılmadı. Kısa süre içinde başlamazsa bilgisayarı yeniden başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA chưa hoạt động trở lại sau khi cập nhật lên {0}. Nếu DSA không sớm khởi động, hãy khởi động lại máy tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新到 {0} 后，DSA 尚未重新启动。如果它没有很快启动，请重新启动电脑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新至 {0} 後，DSA 尚未恢復執行。如果稍後仍未啟動，請重新啟動電腦。"
          }
        }
      }
    },
    "AboutAndroidVersionCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Android-Abbild, das beim nächsten Start geladen wird. Abbild-Updates ändern es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Android image the next start boots. Image updates change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen de Android que arranca en el próximo inicio. Las actualizaciones de imagen la cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image Android utilisée au prochain démarrage. Les mises à jour de l'image la modifient."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Image Android yang di-boot saat mulai berikutnya. Pembaruan image mengubahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'immagine Android usata al prossimo avvio. Gli aggiornamenti dell'immagine la cambiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回の起動で使われる Android イメージです。イメージのアップデートで変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 시작할 때 부팅하는 Android 이미지입니다. 이미지 업데이트가 이 버전을 바꿉니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem do Android que a próxima inicialização usa. As atualizações de imagem a alteram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образ Android, который загрузится при следующем запуске. Обновления образа меняют его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki başlatmada açılacak Android görüntüsü. Görüntü güncellemeleri bunu değiştirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh Android mà lần khởi động tiếp theo sẽ dùng. Các bản cập nhật ảnh sẽ thay đổi nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次启动时引导的 Android 映像。映像更新会改变它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次啟動時開機所用的 Android 映像。映像更新會變更此版本。"
          }
        }
      }
    },
