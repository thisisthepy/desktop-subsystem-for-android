    "Memory_KernelPercpuDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten, die der Kernel einmal für jeden Prozessorkern hält. Ihre Größe steht beim Start von Android fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data the kernel keeps once for each processor core. Its size is fixed when Android starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos que el kernel guarda una vez por cada núcleo del procesador. Su tamaño se fija al iniciar Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données que le noyau garde une fois par cœur de processeur. Leur taille est fixée au démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data yang disimpan kernel satu untuk setiap inti prosesor. Ukurannya ditetapkan saat Android mulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati che il kernel tiene una volta per ogni core del processore. La dimensione è fissata all'avvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーネルがプロセッサーのコアごとに 1 つずつ持つデータです。サイズは Android の起動時に決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커널이 프로세서 코어마다 하나씩 두는 데이터입니다. 크기는 Android가 시작할 때 정해집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados que o kernel mantém uma vez para cada núcleo do processador. O tamanho é fixado quando o Android inicia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные, которые ядро держит по одной копии на каждое ядро процессора. Их размер задаётся при запуске Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekirdeğin her işlemci çekirdeği için birer tane tuttuğu veriler. Boyutu Android başlarken belirlenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu kernel giữ một bản cho mỗi lõi bộ xử lý. Kích thước được cố định khi Android khởi động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内核为每个处理器核心各保留一份的数据。大小在 Android 启动时确定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核心為每個處理器核心各保留一份的資料。大小在 Android 啟動時確定。"
          }
        }
      }
    },
