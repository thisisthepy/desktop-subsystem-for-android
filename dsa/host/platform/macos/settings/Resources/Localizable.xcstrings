    "Memory_KernelUnaccountedDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was kein Zähler erfasst, etwa GPU- und DMA-Puffer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What no counter names, such as GPU and DMA buffers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que ningún contador nombra, como los búferes de GPU y DMA"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu'aucun compteur ne nomme, comme les tampons GPU et DMA"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang tidak tercatat di penghitung mana pun, seperti buffer GPU dan DMA"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che nessun contatore indica, come i buffer GPU e DMA"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU や DMA のバッファーなど、どのカウンターにも含まれないもの"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU와 DMA 버퍼처럼 어떤 카운터에도 잡히지 않는 메모리"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que nenhum contador identifica, como buffers de GPU e DMA"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что не учитывает ни один счётчик, например буферы GPU и DMA"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU ve DMA arabellekleri gibi hiçbir sayacın adlandırmadığı bellek"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần không bộ đếm nào ghi nhận, như bộ đệm GPU và DMA"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有计数器记录的内存，例如 GPU 和 DMA 缓冲区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有任何計數器列出的部分，例如 GPU 與 DMA 緩衝區"
          }
        }
      }
    },
