    "Install_Reason_incompatible": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "die App läuft nicht auf diesem Android: Sie braucht einen anderen Prozessor, ein neueres Android oder eine fehlende Gerätefunktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the app does not run on this Android: it needs another processor type, a newer Android version or a feature this device does not have."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la app no funciona en este Android: requiere otro procesador, un Android más reciente o una función que este dispositivo no tiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "l'app ne tourne pas sur cet Android : il lui faut un autre processeur, un Android plus récent ou une fonction absente de cet appareil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "aplikasi tidak berjalan di Android ini: perlu prosesor jenis lain, Android lebih baru, atau fitur yang tak ada di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "l'app non funziona su questo Android: serve un altro processore, un Android più recente o una funzione assente su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはこの Android では動きません: 別のプロセッサー、より新しい Android のバージョン、またはこのデバイスにない機能が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Android에서 실행되지 않는 앱입니다. 다른 프로세서 종류, 더 새로운 Android 버전 또는 이 기기에 없는 기능이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o app não roda neste Android: precisa de outro processador, de um Android mais novo ou de um recurso que este dispositivo não tem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "приложение не работает в этом Android: ему нужен другой процессор, более новый Android или функция, которой нет на устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "uygulama bu Android'de çalışmaz: başka bir işlemci türü, daha yeni bir Android sürümü veya bu aygıtta olmayan bir özellik gerektiriyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ứng dụng không chạy trên Android này: nó cần loại bộ xử lý khác, phiên bản Android mới hơn hoặc một tính năng thiết bị này không có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该应用无法在此 Android 上运行：它需要其他类型的处理器、更高的 Android 版本，或此设备不具备的功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式無法在此 Android 上執行：它需要其他類型的處理器、較新的 Android 版本，或此裝置沒有的功能。"
          }
        }
      }
    },
