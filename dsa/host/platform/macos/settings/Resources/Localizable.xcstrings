    "MemoryGuestNoneBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android meldet seine Speichernutzung einige Minuten nach dem Start."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android reports how it uses its memory a few minutes after it starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android informa de cómo usa su memoria unos minutos después de iniciarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android indique l'utilisation de sa mémoire quelques minutes après son démarrage."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android melaporkan pemakaian memorinya beberapa menit setelah dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android indica come usa la memoria qualche minuto dopo l'avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android は起動の数分後に、メモリの使用状況を報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android는 시작하고 몇 분 뒤에 메모리 사용 내역을 보고합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android informa como usa a memória alguns minutos depois de iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android сообщает об использовании памяти через несколько минут после запуска."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android, başladıktan birkaç dakika sonra belleğini nasıl kullandığını bildirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android báo cáo cách dùng bộ nhớ vài phút sau khi khởi động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 会在启动几分钟后报告其内存使用情况。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 會在啟動數分鐘後回報其記憶體使用方式。"
          }
        }
      }
    },
