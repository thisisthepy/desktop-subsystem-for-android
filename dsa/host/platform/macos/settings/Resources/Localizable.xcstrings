    "AppsDpiScaling.Name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaling on another monitor"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 모니터에서의 크기 조정"
          }
        }
      }
    },
    "AppsDpiScaling.ToolTip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who scales this app when its window moves to a monitor of another scale. App: the app redraws at the new scale, and text stays sharp; for an app that does not say it handles this, Android recreates its screen and restores its state, so it may redraw briefly when it moves. System: the app keeps its scale and DSA scales its window to the same physical size; text can look a little blurry. Automatic picks App for apps that say they handle it, and System for the others. Automatic and System never restart the app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 창이 배율이 다른 모니터로 갈 때 누가 크기를 맞출지 정합니다. 앱: 앱이 새 배율로 다시 그려서 글자가 선명합니다. 이를 처리한다고 밝히지 않은 앱은 Android가 화면을 다시 만들고 상태를 되살리므로, 모니터를 옮길 때 잠깐 다시 그려질 수 있습니다. 시스템: 앱은 배율을 그대로 두고 DSA가 창을 같은 실제 크기로 늘이거나 줄입니다. 글자가 조금 흐려질 수 있습니다. 자동은 직접 처리한다고 밝힌 앱에 앱을, 나머지에 시스템을 씁니다. 자동과 시스템은 앱을 재시작하지 않습니다."
          }
        }
      }
    },
    "Apps_DpiScaling_Auto": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaling: automatic"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 조정: 자동"
          }
        }
      }
    },
    "Apps_DpiScaling_App": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaling performed by: app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 조정 수행 주체: 앱"
          }
        }
      }
    },
