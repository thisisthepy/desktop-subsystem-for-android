    "MemoryHostNone.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android läuft nicht und belegt daher keinen Speicher auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android is not running, so it takes no memory on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no está en ejecución, así que no ocupa memoria en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android n'est pas en cours d'exécution : il n'occupe aucune mémoire sur ce Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android tidak berjalan, jadi tidak memakai memori di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non è in esecuzione, quindi non occupa memoria su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android が実行されていないため、この Mac のメモリを使用していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 실행 중이 아니므로 이 Mac의 메모리를 쓰지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android não está em execução, então não ocupa memória neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android не запущен, поэтому не занимает память на этом Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android çalışmıyor, bu yüzden bu Mac'te bellek kullanmıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android không chạy, nên không chiếm bộ nhớ trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 未运行，因此不占用这台 Mac 的内存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 未在執行，因此不佔用此 Mac 的記憶體。"
          }
        }
      }
    },
    "MemoryHostTotalCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher, den die virtuelle Maschine, der Fenstermanager und die App-Fenster derzeit belegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The memory the virtual machine, the window manager and the app windows hold now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria que ocupan ahora la máquina virtual, el gestor de ventanas y las ventanas de las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire qu'occupent actuellement la machine virtuelle, le gestionnaire de fenêtres et les fenêtres d'app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memori yang dipakai mesin virtual, pengelola jendela, dan jendela aplikasi saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria occupata ora dalla macchina virtuale, dal gestore delle finestre e dalle finestre delle app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想マシン、ウィンドウ マネージャー、アプリのウィンドウが現在使用しているメモリです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 머신, 창 관리자, 앱 창이 지금 차지한 메모리입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória que a máquina virtual, o gerenciador de janelas e as janelas dos apps ocupam agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Память, которую сейчас занимают виртуальная машина, диспетчер окон и окна приложений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanal makinenin, pencere yöneticisinin ve uygulama pencerelerinin şu an tuttuğu bellek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ mà máy ảo, trình quản lý cửa sổ và các cửa sổ ứng dụng đang giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟机、窗口管理器和应用窗口当前占用的内存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "虛擬機器、視窗管理程式與應用程式視窗目前佔用的記憶體。"
          }
        }
      }
    },
