        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1} ({2}) で対応しています。この Android に付属する変換ツールです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} {1}(으)로 지원합니다({2}). 이 Android에 함께 들어 있는 번역기입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatível via {0} {1} ({2}), o tradutor que vem com este Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживается: {0} {1} ({2}), транслятор, входящий в этот Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Android ile birlikte gelen çevirmen {0} {1} ({2}) tarafından destekleniyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được hỗ trợ bởi {0} {1} ({2}), trình dịch đi kèm Android này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
