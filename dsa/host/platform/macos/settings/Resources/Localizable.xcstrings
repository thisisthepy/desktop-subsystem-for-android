    "RestartWindowManagerCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Android-App-Fenster schließen sich und kommen zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Android app windows close and come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas abiertas de apps de Android se cierran y vuelven a aparecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres d'apps Android ouvertes se ferment puis reviennent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela aplikasi Android yang terbuka ditutup lalu muncul kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre aperte delle app Android si chiudono e ricompaiono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いている Android アプリのウィンドウが閉じて、再び開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열려 있는 Android 앱 창이 닫혔다가 다시 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas abertas de apps Android fecham e voltam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытые окна приложений Android закроются и откроются снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık Android uygulama pencereleri kapanır ve geri gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cửa sổ ứng dụng Android đang mở sẽ đóng rồi mở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开的 Android 应用窗口会关闭，然后恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已打開的 Android 應用程式視窗會關閉後再重新出現。"
          }
        }
      }
    },
    "RestartWindowManagerCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenstermanager neu starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the window manager"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciar el gestor de ventanas"
          }
        },
        "fr": {
