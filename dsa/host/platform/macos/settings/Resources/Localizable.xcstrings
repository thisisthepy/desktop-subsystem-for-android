    "RootElevationAdminReason.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Administrator kann dies ändern, weil es für alle Benutzer dieses Mac gilt.\nWählen Sie „Als Administrator ändern“, dann fragt macOS nach dem Passwort eines Administrators."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an administrator can change this, because it applies to every user of this Mac.\nUse Change as administrator, and macOS asks for an administrator's password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un administrador puede cambiar esto, porque se aplica a todos los usuarios de este Mac.\nUse Cambiar como administrador y macOS le pedirá la contraseña de un administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un administrateur peut modifier ce réglage, car il s'applique à tous les utilisateurs de ce Mac.\nUtilisez Modifier en tant qu'administrateur, et macOS demande le mot de passe d'un administrateur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya administrator yang dapat mengubah ini, karena berlaku untuk setiap pengguna Mac ini.\nGunakan Ubah sebagai administrator, lalu macOS meminta kata sandi administrator."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un amministratore può modificarlo, perché vale per tutti gli utenti di questo Mac.\nUsa Modifica come amministratore e macOS chiederà la password di un amministratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac のすべてのユーザーに適用されるため、変更できるのは管理者だけです。\n「管理者として変更」を使うと、macOS が管理者のパスワードを求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 모든 사용자에게 적용되므로 관리자만 바꿀 수 있습니다.\n관리자 권한으로 변경을 누르면 macOS가 관리자 암호를 묻습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só um administrador pode alterar isto, porque vale para todos os usuários deste Mac.\nUse Alterar como administrador, e o macOS pedirá a senha de um administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить это может только администратор, так как это действует для всех пользователей этого Mac.\nНажмите «Изменить как администратор», и macOS запросит пароль администратора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'in tüm kullanıcılarına uygulandığı için bunu yalnızca bir yönetici değiştirebilir.\nYönetici olarak değiştir'i kullanın; macOS bir yönetici parolası ister."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ quản trị viên mới có thể thay đổi mục này, vì nó áp dụng cho mọi người dùng của máy Mac này.\nDùng Thay đổi với tư cách quản trị viên, và macOS sẽ hỏi mật khẩu của quản trị viên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理员可以更改此项，因为它适用于这台 Mac 的所有用户。\n使用“以管理员身份更改”后，macOS 会要求输入管理员密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於此設定會套用到此 Mac 的所有使用者，只有管理者可以變更。\n使用「以管理者身分變更」，macOS 就會要求輸入管理者的密碼。"
          }
        }
      }
    },
    "RootElevationCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Auf der Seite „Apps“ erlaubte Apps können wie mit sudo Befehle als root ausführen, wenn ein Mac-Administrator zustimmt.\nDas Android-Abbild, seine Build-Eigenschaften und SELinux bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Apps you allow on the Apps page can run commands as root once an administrator of this Mac approves, as with sudo.\nThe Android image, its build properties and SELinux stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Las apps que permita en Apps ejecutan comandos como root, como con sudo, si lo aprueba un administrador.\nLa imagen de Android, sus propiedades de compilación y SELinux no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Les apps autorisées dans Apps exécutent des commandes en root après accord d'un administrateur du Mac, comme sudo.\nL'image Android, ses propriétés de build et SELinux restent inchangés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonaktif secara bawaan. Aplikasi yang diizinkan di halaman Aplikasi memakai root seperti sudo, bila administrator Mac ini setuju.\nImage Android, properti build-nya, dan SELinux tetap apa adanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito: disattivato. Le app consentite in App eseguono comandi come root se un amministratore del Mac approva, come con sudo.\nL'immagine Android, le sue proprietà di build e SELinux restano invariate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオフです。「アプリ」ページで許可したアプリは、sudo のように、この Mac の管理者が承認すると root としてコマンドを実行できます。\nAndroid イメージ、そのビルド プロパティ、SELinux はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐입니다. 앱 페이지에서 허용한 앱은 이 Mac의 관리자가 승인하면 sudo처럼 루트로 명령을 실행합니다.\nAndroid 이미지, 빌드 속성, SELinux는 그대로입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão. Apps permitidos na página Apps rodam comandos como root após um administrador deste Mac aprovar, como no sudo.\nA imagem do Android, as propriedades de build e o SELinux não mudam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Приложения, разрешённые в «Приложениях», запускают команды от root с одобрения администратора Mac, как sudo.\nОбраз Android, его свойства сборки и SELinux не меняются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak kapalı. Uygulamalar sayfasında izin verilenler, bu Mac'in yöneticisi onaylayınca sudo gibi kök olarak komut çalıştırır.\nAndroid görüntüsü, derleme özellikleri ve SELinux olduğu gibi kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt theo mặc định. Ứng dụng bạn cho phép ở trang Ứng dụng có thể chạy lệnh bằng root khi quản trị viên máy Mac này chấp thuận, như sudo.\nẢnh Android, thuộc tính bản dựng và SELinux vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。您在“应用”页面上允许的应用，经这台 Mac 的管理员批准后，可以像 sudo 那样以 root 身份运行命令。\nAndroid 映像、其构建属性和 SELinux 保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為關閉。您在「應用程式」頁面允許的應用程式，經此 Mac 的管理者核准後，就能像 sudo 一樣以 root 身分執行指令。\nAndroid 映像、其組建屬性與 SELinux 都維持不變。"
          }
        }
      }
    },
    "RootElevationCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-Apps Root anfordern lassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let Android apps ask for root"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que las apps de Android pidan acceso root"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les apps Android à demander root"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan aplikasi Android meminta root"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti alle app Android di chiedere l'accesso root"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android アプリによる root 権限の要求を許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 앱의 루트 권한 요청 허용"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que apps Android peçam root"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить приложениям Android запрашивать root"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android uygulamalarının kök erişimi istemesine izin ver"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép ứng dụng Android yêu cầu root"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Android 应用请求 root 权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Android 應用程式要求 root 權限"
          }
        }
      }
    },
    "RootElevationRestartBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Root-Zugriff ändert sich ab dem nächsten Android-Start. Beenden Sie Android auf der Seite „Allgemein“ und öffnen Sie dann eine App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root access changes from the next start of Android. Stop Android on the General page, then open an app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso root cambia desde el próximo inicio de Android. Detenga Android en la página General y luego abra una app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès root change au prochain démarrage d'Android. Arrêtez Android dans la page Général, puis ouvrez une app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan akses root berlaku sejak Android dimulai lagi. Hentikan Android di halaman Umum, lalu buka aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche all'accesso root valgono dal prossimo avvio di Android. Arresta Android nella pagina Generali, poi apri un'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "root 権限の変更は、次に Android が起動したときから適用されます。「一般」ページで Android を停止してから、アプリを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트 권한 설정은 Android가 다음에 시작할 때 적용됩니다. 일반 페이지에서 Android를 중지한 뒤 앱을 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso root muda a partir da próxima inicialização do Android. Pare o Android na página Geral e depois abra um app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Root-доступ изменится при следующем запуске Android. Остановите Android на странице «Основные», затем откройте приложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kök erişimi, Android'in sonraki açılışından itibaren değişir. Genel sayfasında Android'i durdurun, ardından bir uygulama açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi quyền root có hiệu lực từ lần khởi động Android tiếp theo. Hãy dừng Android trên trang Cài đặt chung, rồi mở một ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "root 访问权限的更改从 Android 下次启动时起生效。请在“通用”页面上停止 Android，然后打开一个应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "root 存取權的變更會從 Android 下次啟動時生效。請在「一般」頁面停止 Android，然後打開應用程式。"
          }
        }
      }
    },
    "RootElevationRestartBar.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android zum Anwenden neu starten"
          }
        },
        "en": {
