    "WidevineStatusCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht Streaming-Apps die Wiedergabe geschützter Videos. DSA enthält Widevine von Google nicht und gibt es nicht weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets streaming apps play protected video. DSA does not include or pass on Google's Widevine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que las apps de streaming reproduzcan vídeo protegido. DSA no incluye ni redistribuye el Widevine de Google."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet aux apps de streaming de lire des vidéos protégées. DSA n'inclut ni ne redistribue le Widevine de Google."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkan aplikasi streaming memutar video yang dilindungi. DSA tidak menyertakan atau meneruskan Widevine milik Google."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente alle app di streaming di riprodurre video protetti. DSA non include né ridistribuisce il Widevine di Google."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミング アプリで保護された動画を再生できるようにします。DSA は Google の Widevine を同梱も再配布もしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍 앱이 보호된 동영상을 재생하게 합니다. DSA는 Google의 Widevine을 싣거나 다시 배포하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que apps de streaming reproduzam vídeo protegido. O DSA não inclui nem redistribui o Widevine do Google."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет потоковым приложениям воспроизводить защищённое видео. DSA не включает и не распространяет Widevine от Google."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın uygulamalarının korumalı video oynatmasını sağlar. DSA, Google'ın Widevine'ini içermez veya başkasına aktarmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép ứng dụng phát trực tuyến phát video được bảo vệ. DSA không chứa hay phân phối lại Widevine của Google."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让流媒体应用可以播放受保护的视频。DSA 不包含也不转发 Google 的 Widevine。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓串流應用程式能播放受保護的影片。DSA 不包含也不轉發 Google 的 Widevine。"
          }
        }
      }
    },
