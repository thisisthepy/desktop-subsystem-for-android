    "WidevineRemoveCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt das Modul und die gespeicherten Gerätezertifikate, ab dem nächsten Start von Android."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the module and the device certificates it kept, from the next start of Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el módulo y los certificados de dispositivo que guardó, a partir del próximo inicio de Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le module et les certificats d'appareil qu'il a conservés, à partir du prochain démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus modul beserta sertifikat perangkat yang disimpannya, sejak Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove il modulo e i certificati del dispositivo che ha conservato, dal prossimo avvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に Android が起動したときから、モジュールと、モジュールが保存したデバイス証明書を削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android를 다음에 시작할 때부터 모듈과 모듈이 저장한 기기 인증서를 지웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o módulo e os certificados do dispositivo que ele guardou, a partir da próxima inicialização do Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет модуль и сохранённые им сертификаты устройства, начиная со следующего запуска Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modülü ve sakladığı aygıt sertifikalarını Android'in sonraki açılışından itibaren kaldırır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ bỏ mô-đun và các chứng chỉ thiết bị mà nó đã lưu, từ lần khởi động Android tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Android 下次启动时起，移除该模块及其保存的设备证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Android 下次啟動起，移除此模組及其保存的裝置憑證。"
          }
        }
      }
    },
