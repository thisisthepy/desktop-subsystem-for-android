    "Memory_KernelStacksDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitsbereich, den der Kernel für jeden laufenden Thread hält. Er schrumpft, wenn Apps geschlossen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working space the kernel keeps for every running thread. It shrinks as apps close."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espacio de trabajo que el kernel guarda para cada hilo en ejecución. Se reduce al cerrar apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace de travail que le noyau garde pour chaque thread en cours. Il diminue quand des applis se ferment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang kerja yang disimpan kernel untuk setiap thread yang berjalan. Mengecil saat aplikasi ditutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio di lavoro che il kernel tiene per ogni thread in esecuzione. Si riduce quando le app si chiudono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のスレッドごとにカーネルが持つ作業領域です。アプリを閉じると減ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 스레드마다 커널이 두는 작업 공간입니다. 앱을 닫으면 줄어듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço de trabalho que o kernel mantém para cada thread em execução. Diminui quando apps fecham."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочее место, которое ядро держит для каждого работающего потока. Уменьшается, когда приложения закрываются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekirdeğin çalışan her iş parçacığı için tuttuğu çalışma alanı. Uygulamalar kapandıkça küçülür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng làm việc kernel giữ cho mỗi luồng đang chạy. Giảm khi đóng ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内核为每个运行中的线程保留的工作空间。关闭应用后会减少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核心為每個執行中的執行緒保留的工作空間。關閉應用程式後會減少。"
          }
        }
      }
    },
