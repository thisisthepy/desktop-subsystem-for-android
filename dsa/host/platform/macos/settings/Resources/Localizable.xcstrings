    "InputTraceCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder DSA-Prozess protokolliert, wann ihn Berührungen, Klicks und Tasten erreichen, um die Verzögerung von Eingabe bis Bild zu messen.\nStandardmäßig aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every DSA process records when each touch, click and key reaches it, to measure the delay from input to picture.\nOff by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada proceso de DSA registra cuándo le llega cada toque, clic y tecla, para medir el retraso entre la entrada y la imagen.\nDesactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque processus DSA enregistre l'heure où chaque toucher, clic et touche lui parvient, pour mesurer le délai de la saisie à l'image.\nDésactivé par défaut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap proses DSA mencatat kapan setiap sentuhan, klik, dan tombol sampai padanya, untuk mengukur jeda dari input ke gambar.\nNonaktif secara bawaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni processo DSA registra quando ogni tocco, clic e tasto lo raggiunge, per misurare il ritardo tra input e immagine.\nPredefinito: disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力から画面表示までの遅延を測るため、すべての DSA プロセスがタッチ、クリック、キーの到着時刻を記録します。\nデフォルトではオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 DSA 프로세스가 터치, 클릭, 키가 닿은 시각을 기록해, 입력에서 화면까지의 지연을 잽니다.\n기본값은 꺼짐입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo processo do DSA registra quando cada toque, clique e tecla chega a ele, para medir o atraso entre a entrada e a imagem.\nDesativado por padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый процесс DSA записывает время прихода касаний, щелчков и клавиш, чтобы измерить задержку от ввода до изображения.\nПо умолчанию выключено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her DSA işlemi, girişten görüntüye gecikmeyi ölçmek için her dokunma, tıklama ve tuşun kendisine ne zaman ulaştığını kaydeder.\nVarsayılan olarak kapalı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi tiến trình DSA ghi lại thời điểm mỗi lần chạm, nhấp và phím đến nó, để đo độ trễ từ thao tác nhập đến hình ảnh.\nTắt theo mặc định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个 DSA 进程都会记录每次触摸、点按和按键到达它的时间，以测量从输入到画面的延迟。\n默认关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個 DSA 程序都會記錄每次觸控、按一下與按鍵到達的時間，以測量從輸入到畫面的延遲。\n預設為關閉。"
          }
        }
      }
    },
