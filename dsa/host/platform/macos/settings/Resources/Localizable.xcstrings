    "Arm_TurnedOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not supported: {0} {1} is installed but turned off."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원하지 않음: {0} {1}이(가) 설치되어 있지만 꺼져 있습니다."
          }
        }
      }
    },
    "ArmCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many Android apps contain code only for ARM processors. They install and run here only through an ARM translator. Android uses the open source translator that comes with it, unless you install another ARM translation package (dsa arm-translation install) or Google's translator. This switch decides whether Android uses a translator at all; it applies from the next start of Android. Only 64-bit ARM apps (arm64-v8a) can run."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "많은 Android 앱은 ARM 프로세서용 코드만 담고 있습니다. 이런 앱은 ARM 번역기를 거쳐야 여기서 설치되고 실행됩니다. Android는 함께 들어 있는 오픈 소스 번역기를 씁니다. 다른 ARM 번역 묶음(dsa arm-translation install)이나 Google의 번역기를 설치하면 그것을 씁니다. 이 스위치는 Android가 번역기를 쓸지 정하며, 다음에 Android를 시작할 때부터 적용됩니다. 64비트 ARM 앱(arm64-v8a)만 실행할 수 있습니다."
          }
        }
      }
    },
    "ArmCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run apps built only for ARM"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ARM 전용 앱 실행"
          }
        }
      }
    },
    "ArmGoogleButton.Content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받기"
          }
        }
      }
    },
    "ArmGoogleCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gets the ARM translator from the Android emulator image Google offers for this Android version and installs it as a translation package. DSA does not include or pass on Google's translator: your Mac downloads the image from Google, under Google's Android SDK License, keeps only the translator and deletes the rest (about 2 GB). Nothing is downloaded until you agree. A package built from another translator, such as Digitalis, does the same job."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google이 이 Android 버전용으로 제공하는 Android 에뮬레이터 이미지에서 ARM 번역기를 꺼내 번역 묶음으로 설치합니다. DSA는 Google의 번역기를 담거나 다시 배포하지 않습니다. 이 Mac이 Google의 Android SDK 라이선스에 따라 Google에서 이미지를 직접 받고, 번역기만 남긴 뒤 나머지(약 2GB)는 지웁니다. 동의하기 전에는 아무것도 받지 않습니다. Digitalis 같은 다른 번역기로 만든 묶음으로도 같은 일을 할 수 있습니다."
          }
        }
      }
    },
    "ArmGoogleCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google's ARM translator"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google의 ARM 번역기"
          }
        }
      }
    },
    "ArmGoogleConfirm.Action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept and download"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동의하고 받기"
          }
        }
      }
    },
    "ArmGoogleConfirm.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Google's ARM translator?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google의 ARM 번역기를 받을까요?"
          }
        }
      }
    },
    "ArmGoogleFetching.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading about 2 GB from Google and taking out the translator. It takes minutes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google에서 약 2GB를 받아 번역기를 꺼내고 있습니다. 몇 분 걸립니다."
          }
        }
      }
    },
    "ArmGoogleTermsLink.Content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android SDK License"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android SDK 라이선스"
          }
        }
      }
    },
    "ArmGoogle_Notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA downloads the Android emulator image for this Android version from Google's SDK repository ({0}) and takes out only its ARM translator. The translator is Google's software, offered under the Android SDK License ({1}); by downloading it you accept those terms. DSA does not ship or pass it on. The image is about 2 GB and is deleted afterwards. The translator works from the next start of Android."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA가 Google의 SDK 저장소({0})에서 이 Android 버전용 Android 에뮬레이터 이미지를 받고, 그 안의 ARM 번역기만 꺼냅니다. 번역기는 Google의 소프트웨어이며 Android SDK 라이선스({1})에 따라 제공됩니다. 받으면 그 약관에 동의하는 것입니다. DSA는 번역기를 싣거나 다시 배포하지 않습니다. 이미지는 약 2GB이며 다 쓰면 지웁니다. 번역기는 Android를 다음에 시작할 때부터 동작합니다."
          }
        }
      }
    },
    "ArmHeader.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ARM apps"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ARM 앱"
          }
        }
      }
    },
    "ArmRemoveButton.Content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거"
          }
        }
      }
    },
    "ArmDefaultCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the default translator"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 번역기 사용"
          }
        }
      }
    },
    "ArmDefaultButton.Content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use"
          }
        },
        "ko": {
