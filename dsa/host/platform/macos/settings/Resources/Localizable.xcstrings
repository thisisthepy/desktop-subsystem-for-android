    "IdentityResetConfirmBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Wert wird auf seinen Standard zurückgesetzt.\n\nDer Standard ist der Wert dieses Mac oder der eigene Wert von DSA, wo der Mac nichts angibt.\n\nDies gilt ab dem nächsten Start von Android."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every value goes back to its default.\n\nThe default is this Mac's value, or DSA's own where the Mac does not say.\n\nIt applies from the next start of Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los valores vuelven a su valor predeterminado.\n\nEl valor predeterminado es el de este Mac, o el propio de DSA si el Mac no lo indica.\n\nSe aplica desde el próximo inicio de Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque valeur revient à sa valeur par défaut.\n\nLa valeur par défaut est celle de ce Mac, ou celle de DSA quand le Mac ne l'indique pas.\n\nLe changement s'applique au prochain démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap nilai kembali ke bawaannya.\n\nBawaannya adalah nilai Mac ini, atau nilai DSA sendiri jika Mac tidak menyebutkannya.\n\nBerlaku sejak Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni valore torna al suo valore predefinito.\n\nIl valore predefinito è quello di questo Mac, oppure quello di DSA dove il Mac non lo indica.\n\nSi applica dal prossimo avvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての値がデフォルトに戻ります。\n\nデフォルトはこの Mac の値で、Mac から提供されない値は DSA 独自の値です。\n\n次に Android が起動したときから適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 값이 기본값으로 돌아갑니다.\n\n기본값은 이 Mac의 정보이고, Mac이 알려 주지 않는 값은 DSA의 값입니다.\n\nAndroid를 다음에 시작할 때부터 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os valores voltam ao padrão.\n\nO padrão é o valor deste Mac, ou o do próprio DSA quando o Mac não informa.\n\nVale a partir da próxima inicialização do Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все значения вернутся к значениям по умолчанию.\n\nПо умолчанию используется значение этого Mac или собственное значение DSA, если Mac его не сообщает.\n\nИзменение применится при следующем запуске Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her değer varsayılanına döner.\n\nVarsayılan, bu Mac'in değeridir; Mac'in bildirmediği yerde DSA'nın kendi değeridir.\n\nAndroid'in sonraki açılışından itibaren geçerli olur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi giá trị trở về mặc định.\n\nGiá trị mặc định là giá trị của máy Mac này, hoặc của DSA khi máy Mac không cho biết.\n\nÁp dụng từ lần khởi động Android tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有值都会恢复为默认值。\n\n默认值是这台 Mac 的值；Mac 未提供的，则使用 DSA 自己的值。\n\n从 Android 下次启动时起生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有值都會恢復為預設值。\n\n預設值是此 Mac 的值；Mac 未提供的項目則使用 DSA 自己的值。\n\n變更會從 Android 下次啟動時套用。"
          }
        }
      }
    },
