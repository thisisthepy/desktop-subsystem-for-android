    "Identity_fingerprint_type_Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "user, userdebug oder eng. Nur der Fingerprint gibt es an; Android bleibt ein user-Build."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "user, userdebug or eng. Only the fingerprint says it; Android stays a user build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "user, userdebug o eng. Solo lo indica la huella digital; Android sigue siendo una compilación user."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "user, userdebug ou eng. Seule l'empreinte l'indique ; Android reste un build user."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "user, userdebug, atau eng. Hanya sidik jari yang menyebutkannya; Android tetap build user."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "user, userdebug o eng. Lo indica solo l'impronta; Android resta una build user."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "user、userdebug、eng のいずれかです。フィンガープリント上の表示だけで、Android は user ビルドのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "user, userdebug, eng 중 하나입니다. 지문에만 쓰이고, Android는 user 빌드 그대로입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "user, userdebug ou eng. Só a impressão digital diz isso; o Android continua sendo uma build user."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "user, userdebug или eng. Это указывается только в отпечатке; Android остаётся сборкой user."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "user, userdebug veya eng. Bunu yalnızca parmak izi söyler; Android bir user derlemesi olarak kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "user, userdebug hoặc eng. Chỉ dấu vân tay ghi như vậy; Android vẫn là bản dựng user."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "user、userdebug 或 eng。只有指纹会这样显示；Android 仍是 user 构建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "user、userdebug 或 eng。只有指紋會這樣表示；Android 仍是 user 組建。"
          }
        }
      }
    },
