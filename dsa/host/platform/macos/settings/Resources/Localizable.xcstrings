    "BackupKeyImportCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie den Schlüssel eines Sicherungsordners von einem anderen Computer oder Benutzer ein, um ihn hier wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the recovery key of a backup folder made on another computer or by another user, so it can be restored here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca la clave de recuperación de una carpeta de copia de seguridad creada en otro equipo o por otro usuario para restaurarla aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez la clé de récupération d'un dossier de sauvegarde créé sur un autre ordinateur ou par un autre utilisateur, pour le restaurer ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kunci pemulihan dari folder cadangan yang dibuat di komputer lain atau oleh pengguna lain, agar dapat dipulihkan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la chiave di recupero di una cartella di backup creata su un altro computer o da un altro utente, per ripristinarla qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のコンピューターや別のユーザーが作成したバックアップ フォルダの復旧キーを入力すると、ここで復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 컴퓨터나 다른 사용자가 만든 백업 폴더의 복구 키를 넣으면 여기서 복원할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a chave de recuperação de uma pasta de backup criada em outro computador ou por outro usuário, para restaurá-la aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ключ восстановления папки копий, созданной на другом компьютере или другим пользователем, чтобы восстановить её здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir bilgisayarda veya başka bir kullanıcının oluşturduğu yedekleme klasörünün kurtarma anahtarını girin; böylece burada geri yüklenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập khóa khôi phục của thư mục sao lưu được tạo trên máy tính khác hoặc bởi người dùng khác, để khôi phục tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入在其他电脑上或由其他用户创建的备份文件夹的恢复密钥，以便在这里恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入在其他電腦上或由其他使用者建立之備份資料夾的復原密鑰，即可在這裡回復。"
          }
        }
      }
    },
