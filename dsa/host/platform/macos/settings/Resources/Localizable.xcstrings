    "AppImmersiveCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo eine App erscheint, wenn sie nur ihre Leisten ausblendet, wie ein Feed mit kurzen Videos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where an app shows when it only hides its bars, as a feed of short videos does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde se muestra una app cuando solo oculta sus barras, como hace un feed de vídeos cortos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où s'affiche une app quand elle masque seulement ses barres, comme un flux de vidéos courtes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat aplikasi tampil saat hanya menyembunyikan bilahnya, seperti feed video pendek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove appare un'app quando nasconde solo le barre, come fa un feed di video brevi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショート動画のフィードのように、アプリがバーを隠すだけのときの表示先です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 동영상 피드처럼 앱이 막대만 숨길 때 어디에 보일지 정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde um app aparece quando só oculta as barras, como faz um feed de vídeos curtos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где показывать приложение, когда оно только скрывает панели, как лента коротких видео."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uygulama, kısa video akışlarında olduğu gibi yalnızca çubuklarını gizlediğinde nerede görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
