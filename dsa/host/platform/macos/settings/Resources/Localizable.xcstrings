    "DeveloperModeCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Eingeschaltet verbindet sich adb auf diesem Mac ohne Abfrage mit Android, über einen Port, den nur dieser Mac erreicht.\nSchalten Sie ihn aus, wenn Sie fertig sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. On, adb on this Mac connects to Android without asking in Android, through a port only this Mac can reach.\nTurn it off when you are done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Si se activa, adb en este Mac se conecta a Android sin aviso en Android, por un puerto que solo ve este Mac.\nDesactívelo cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Activé, l'adb de ce Mac se connecte à Android sans confirmation dans Android, via un port réservé à ce Mac.\nDésactivez-le quand vous avez terminé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonaktif secara bawaan. Jika aktif, adb Mac ini terhubung ke Android tanpa ditanya di Android, lewat port khusus untuk Mac ini.\nNonaktifkan setelah Anda selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito: disattivato. Se attivo, adb del Mac si collega ad Android senza conferma in Android, tramite una porta riservata a questo Mac.\nDisattivalo quando hai finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオフです。オンにすると、この Mac の adb は、この Mac だけが使えるポートを通して、Android での確認なしに接続します。\n使い終わったらオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐입니다. 켜면 이 Mac의 adb가 이 Mac에서만 닿는 포트로, Android의 승인 없이 연결합니다.\n다 쓰면 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão. Ativado, o adb deste Mac se conecta ao Android sem confirmação no Android, por uma porta que só este Mac alcança.\nDesative quando terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Если включить, adb этого Mac подключится к Android без запроса через порт, доступный только этому Mac.\nВыключите, когда закончите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak kapalı. Açıkken bu Mac'teki adb, yalnızca bu Mac'in erişebildiği bağlantı noktasından, Android onayı olmadan bağlanır.\nİşiniz bitince kapatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt theo mặc định. Khi bật, adb của máy Mac này kết nối Android không cần xác nhận trong Android, qua cổng chỉ máy Mac này dùng được.\nHãy tắt khi bạn dùng xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。开启后，这台 Mac 上的 adb 会通过只有这台 Mac 能访问的端口连接到 Android，无需在 Android 中确认。\n用完后请关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為關閉。開啟後，此 Mac 上的 adb 會透過只有此 Mac 能連到的連接埠連線到 Android，不必在 Android 中確認。\n使用完畢後請將它關閉。"
          }
        }
      }
    },
