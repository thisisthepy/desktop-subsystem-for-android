    "GappsInstallCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt LiteGapps Core, ein öffentliches Paket der Apps von Google für diese Android-Version (etwa 120 bis 260 MB), und installiert es.\nAndroid startet bei Bedarf zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads LiteGapps Core, a public package of Google's apps for this Android version (about 120 to 260 MB), and installs it.\nAndroid starts first if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga e instala LiteGapps Core, un paquete público de apps de Google para esta versión de Android (unos 120 a 260 MB).\nAndroid se inicia antes si hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge et installe LiteGapps Core, un paquet public des apps Google pour cette version d'Android (environ 120 à 260 MB).\nAndroid démarre d'abord si nécessaire."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunduh LiteGapps Core, paket publik aplikasi Google untuk versi Android ini (sekitar 120–260 MB), lalu menginstalnya.\nAndroid dimulai lebih dulu jika perlu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica LiteGapps Core, un pacchetto pubblico delle app di Google per questa versione di Android (circa da 120 a 260 MB), e lo installa.\nSe necessario, Android si avvia prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Android バージョン用の、Google のアプリの公開パッケージ LiteGapps Core (約 120～260 MB) をダウンロードしてインストールします。\n必要に応じて、先に Android を起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개된 Google 앱 패키지인 LiteGapps Core를 이 Android 버전에 맞게 받아(약 120~260MB) 설치합니다.\n필요하면 Android를 먼저 켭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa e instala o LiteGapps Core, um pacote público dos apps do Google para esta versão do Android (cerca de 120 a 260 MB).\nO Android inicia antes, se necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает и устанавливает LiteGapps Core, общедоступный пакет приложений Google для этой версии Android (около 120–260 MB).\nПри необходимости сначала запускается Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Android sürümü için Google uygulamalarının herkese açık paketi LiteGapps Core'u (yaklaşık 120 ila 260 MB) indirir ve yükler.\nGerekirse önce Android başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống LiteGapps Core, một gói công khai gồm các ứng dụng Google cho phiên bản Android này (khoảng 120 đến 260 MB), rồi cài đặt.\nAndroid khởi động trước nếu cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并安装 LiteGapps Core，这是适用于此 Android 版本的公开 Google 应用软件包（约 120 到 260 MB）。\n如有需要，会先启动 Android。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載並安裝 LiteGapps Core，這是適用於此 Android 版本的公開 Google 應用程式套件（約 120 至 260 MB）。\n必要時會先啟動 Android。"
          }
        }
      }
    },
    "GappsInstalling.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play wird geladen und installiert. Das kann einige Minuten dauern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading and installing Google Play. This can take several minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargando e instalando Google Play. Puede tardar varios minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement et installation de Google Play. Cela peut prendre plusieurs minutes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunduh dan menginstal Google Play. Ini dapat memakan waktu beberapa menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download e installazione di Google Play. Può richiedere alcuni minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play をダウンロードしてインストールしています。数分かかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play를 받아 설치하는 중입니다. 몇 분 걸릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixando e instalando o Google Play. Isso pode levar vários minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка и установка Google Play. Это может занять несколько минут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play indiriliyor ve yükleniyor. Bu birkaç dakika sürebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải xuống và cài đặt Google Play. Việc này có thể mất vài phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载并安装 Google Play。这可能需要几分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
