    "Identity_device_Invalid": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie bis zu 32 Buchstaben, Ziffern, '.', '_' oder '-', beginnend mit einem Buchstaben oder einer Ziffer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use up to 32 letters, digits, '.', '_' or '-', starting with a letter or a digit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use hasta 32 letras, dígitos, '.', '_' o '-', empezando por una letra o un dígito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez jusqu'à 32 lettres, chiffres, '.', '_' ou '-', en commençant par une lettre ou un chiffre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan hingga 32 huruf, angka, '.', '_', atau '-', diawali huruf atau angka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa fino a 32 lettere, cifre, '.', '_' o '-', iniziando con una lettera o una cifra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字または数字で始まる、32 文字以内の英字、数字、'.'、'_'、'-' を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영문자나 숫자로 시작하는 32자 이하의 영문자, 숫자, '.', '_', '-'를 쓰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use até 32 letras, dígitos, '.', '_' ou '-', começando com uma letra ou um dígito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте до 32 букв, цифр, '.', '_' или '-', начиная с буквы или цифры."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir harf veya rakamla başlayan, en fazla 32 harf, rakam, '.', '_' veya '-' kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng tối đa 32 chữ cái, chữ số, '.', '_' hoặc '-', bắt đầu bằng chữ cái hoặc chữ số."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用不超过 32 个字母、数字、'.'、'_' 或 '-'，并以字母或数字开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用最多 32 個字母、數字、'.'、'_' 或 '-'，並以字母或數字開頭。"
          }
        }
      }
    },
