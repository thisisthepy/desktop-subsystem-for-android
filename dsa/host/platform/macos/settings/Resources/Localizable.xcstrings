    "Android_ChoiceLatest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always the newest (now Android {0})"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 최신 버전(지금은 Android {0})"
          }
        }
      }
    },
    "Android_ChoiceMajor": {
      "extractionState": "manual",
