    "Apps_Refused_blocked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android erlaubt es nicht, weil die App ein Geräteadministrator ist oder eine Richtlinie sie schützt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android does not allow it, because the app is a device administrator or a policy keeps it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no lo permite, porque la app es administradora del dispositivo o una directiva la mantiene"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ne l'autorise pas, car l'app est un administrateur de l'appareil ou une règle la protège"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android tidak mengizinkannya, karena aplikasi ini adalah administrator perangkat atau dipertahankan oleh kebijakan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non lo consente, perché l'app è un amministratore del dispositivo o un criterio la blocca"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがデバイス管理者であるか、ポリシーで保護されているため、Android が許可しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 관리자 앱이거나 정책이 막고 있어 Android가 허용하지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o Android não permite, porque o app é administrador do dispositivo ou uma política o mantém"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android не разрешает это, так как приложение является администратором устройства или защищено политикой"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama bir aygıt yöneticisi olduğu veya bir ilke onu koruduğu için Android buna izin vermiyor"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android không cho phép, vì ứng dụng là quản trị viên thiết bị hoặc bị một chính sách giữ lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 不允许，因为该应用是设备管理器，或受策略保护"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 不允許，因為此應用程式是裝置管理員，或受到原則保留"
          }
        }
      }
    },
