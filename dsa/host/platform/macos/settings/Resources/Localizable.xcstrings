    "AdminBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Update-Einstellungen gelten für alle Benutzer dieses Mac, daher kann nur ein Administrator sie ändern.\nWählen Sie „Als Administrator ändern“, dann fragt macOS nach dem Passwort eines Administrators."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update settings apply to every user of this Mac, so only an administrator can change them.\nUse Change as administrator, and macOS asks for an administrator's password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de actualización se aplican a todos los usuarios de este Mac, así que solo un administrador puede cambiarlos.\nUse Cambiar como administrador y macOS le pedirá la contraseña de un administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages de mise à jour s'appliquent à tous les utilisateurs de ce Mac : seul un administrateur peut les modifier.\nUtilisez Modifier en tant qu'administrateur, et macOS demande le mot de passe d'un administrateur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan pembaruan berlaku untuk setiap pengguna Mac ini, jadi hanya administrator yang dapat mengubahnya.\nGunakan Ubah sebagai administrator, lalu macOS meminta kata sandi administrator."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni di aggiornamento valgono per tutti gli utenti di questo Mac, quindi solo un amministratore può modificarle.\nUsa Modifica come amministratore e macOS chiederà la password di un amministratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートの設定はこの Mac のすべてのユーザーに適用されるため、管理者だけが変更できます。\n「管理者として変更」を使うと、macOS が管理者のパスワードを求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 설정은 이 Mac의 모든 사용자에게 적용되므로 관리자만 바꿀 수 있습니다.\n관리자 권한으로 변경을 누르면 macOS가 관리자 암호를 묻습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes de atualização valem para todos os usuários deste Mac, por isso só um administrador pode alterá-los.\nUse Alterar como administrador, e o macOS pedirá a senha de um administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки обновлений действуют для всех пользователей этого Mac, поэтому изменить их может только администратор.\nНажмите «Изменить как администратор», и macOS запросит пароль администратора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme ayarları bu Mac'in tüm kullanıcılarına uygulanır, bu yüzden yalnızca bir yönetici bunları değiştirebilir.\nYönetici olarak değiştir'i kullanın; macOS bir yönetici parolası ister."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt cập nhật áp dụng cho mọi người dùng của máy Mac này, nên chỉ quản trị viên mới có thể thay đổi.\nDùng Thay đổi với tư cách quản trị viên, và macOS sẽ hỏi mật khẩu của quản trị viên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新设置适用于这台 Mac 的所有用户，因此只有管理员可以更改。\n使用“以管理员身份更改”后，macOS 会要求输入管理员密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新設定會套用到此 Mac 的所有使用者，因此只有管理者可以變更。\n使用「以管理者身分變更」，macOS 就會要求輸入管理者的密碼。"
          }
        }
      }
    },
