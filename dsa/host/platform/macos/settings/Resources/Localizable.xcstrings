    "ArmCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt Apps, die nur für ARM-Prozessoren gebaut sind, über einen Übersetzer aus. Gilt ab dem nächsten Start von Android.\nNur 64-Bit-ARM-Apps (arm64-v8a) können laufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs apps made only for ARM processors through a translator. Applies from the next start of Android.\nOnly 64-bit ARM apps (arm64-v8a) can run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta mediante un traductor las apps hechas solo para procesadores ARM. Se aplica desde el próximo inicio de Android.\nSolo se pueden ejecutar apps ARM de 64 bits (arm64-v8a)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute les apps conçues uniquement pour les processeurs ARM via un traducteur. S'applique au prochain démarrage d'Android.\nSeules les apps ARM 64 bits (arm64-v8a) peuvent s'exécuter."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjalankan aplikasi yang hanya dibuat untuk prosesor ARM melalui penerjemah. Berlaku sejak Android dimulai lagi.\nHanya aplikasi ARM 64-bit (arm64-v8a) yang dapat berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue tramite un traduttore le app create solo per processori ARM. Si applica dal prossimo avvio di Android.\nFunzionano solo le app ARM a 64 bit (arm64-v8a)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ARM プロセッサー専用に作られたアプリを、変換ツールを通して実行します。次に Android が起動したときから適用されます。\n動くのは 64 ビット ARM アプリ (arm64-v8a) だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ARM 프로세서용 코드만 담은 앱을 번역기로 실행합니다. 다음에 Android를 시작할 때부터 적용됩니다.\n64비트 ARM 앱(arm64-v8a)만 실행할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa por meio de um tradutor os apps feitos só para processadores ARM. Vale a partir da próxima inicialização do Android.\nSó apps ARM de 64 bits (arm64-v8a) podem ser executados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает приложения, созданные только для процессоров ARM, через транслятор. Применяется при следующем запуске Android.\nЗапускаться могут только 64-битные приложения ARM (arm64-v8a)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ARM işlemciler için yapılmış uygulamaları bir çevirmen üzerinden çalıştırır. Android'in sonraki açılışından itibaren geçerlidir.\nYalnızca 64 bit ARM uygulamaları (arm64-v8a) çalışabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy các ứng dụng chỉ dành cho bộ xử lý ARM qua một trình dịch. Áp dụng từ lần khởi động Android tiếp theo.\nChỉ ứng dụng ARM 64-bit (arm64-v8a) chạy được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过转译器运行仅为 ARM 处理器构建的应用。从 Android 下次启动时起生效。\n只有 64 位 ARM 应用（arm64-v8a）可以运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過轉譯器執行僅為 ARM 處理器建置的應用程式。從 Android 下次啟動時開始套用。\n只能執行 64 位元 ARM 應用程式（arm64-v8a）。"
          }
        }
      }
    },
    "ArmCard.More": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android verwendet den mitgelieferten Open-Source-Übersetzer.\nInstallieren Sie ein anderes ARM-Übersetzungspaket (dsa arm-translation install) oder Googles Übersetzer, nutzt Android diesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android uses the open source translator that comes with it.\nIf you install another ARM translation package (dsa arm-translation install) or Google's translator, Android uses that one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android usa el traductor de código abierto que incluye.\nSi instala otro paquete de traducción ARM (dsa arm-translation install) o el traductor de Google, Android usa ese."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android utilise le traducteur open source fourni avec lui.\nSi vous installez un autre paquet de traduction ARM (dsa arm-translation install) ou le traducteur de Google, Android utilise celui-ci."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android memakai penerjemah sumber terbuka yang disertakan dengannya.\nJika Anda menginstal paket terjemahan ARM lain (dsa arm-translation install) atau penerjemah Google, Android memakai yang itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android usa il traduttore open source incluso.\nSe installi un altro pacchetto di traduzione ARM (dsa arm-translation install) o il traduttore di Google, Android usa quello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android は、付属するオープンソースの変換ツールを使います。\n別の ARM 変換パッケージ (dsa arm-translation install) や Google の変換ツールをインストールすると、Android はそちらを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android는 함께 들어 있는 오픈 소스 번역기를 씁니다.\n다른 ARM 번역 묶음(dsa arm-translation install)이나 Google의 번역기를 설치하면 그것을 씁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android usa o tradutor de código aberto que vem com ele.\nSe você instalar outro pacote de tradução ARM (dsa arm-translation install) ou o tradutor do Google, o Android usa esse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android использует входящий в него транслятор с открытым исходным кодом.\nЕсли установить другой пакет трансляции ARM (dsa arm-translation install) или транслятор Google, Android будет использовать его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android, kendisiyle birlikte gelen açık kaynaklı çevirmeni kullanır.\nBaşka bir ARM çeviri paketi (dsa arm-translation install) veya Google'ın çevirmenini yüklerseniz Android onu kullanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android dùng trình dịch mã nguồn mở đi kèm.\nNếu bạn cài một gói dịch ARM khác (dsa arm-translation install) hoặc trình dịch của Google, Android sẽ dùng trình dịch đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 使用其自带的开源转译器。\n如果您安装了其他 ARM 转译软件包（dsa arm-translation install）或 Google 的转译器，Android 会使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 會使用其隨附的開放原始碼轉譯器。\n如果您安裝其他 ARM 轉譯套件（dsa arm-translation install）或 Google 的轉譯器，Android 就會改用該轉譯器。"
          }
        }
      }
    },
