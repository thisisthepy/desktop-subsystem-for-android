    "ProgramUpdatesCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signierte neue Versionen von DSA laden und installieren, wenn kein Android läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download signed new versions of DSA and install them when no Android is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga nuevas versiones firmadas de DSA y las instala cuando no hay ningún Android en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge les nouvelles versions signées de DSA et les installe quand aucun Android n'est en cours d'exécution."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh versi baru DSA yang bertanda tangan dan instal saat tidak ada Android yang berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica le nuove versioni firmate di DSA e le installa quando nessun Android è in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名された DSA の新しいバージョンをダウンロードし、Android が実行されていないときにインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명된 새 버전의 DSA를 내려받고, 실행 중인 Android가 없을 때 설치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixar novas versões assinadas do DSA e instalá-las quando nenhum Android estiver em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружать подписанные новые версии DSA и устанавливать их, когда Android не запущен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA'nın imzalı yeni sürümlerini indirin ve hiçbir Android çalışmıyorken yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống các phiên bản DSA mới có chữ ký và cài đặt khi không có Android nào đang chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载签名的 DSA 新版本，并在没有 Android 运行时安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載經過簽署的新版 DSA，並在沒有 Android 執行時安裝。"
          }
        }
      }
    },
