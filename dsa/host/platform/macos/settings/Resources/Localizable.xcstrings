    "Problem_Unreadable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort des Befehls dsa konnte nicht gelesen werden. Installieren Sie DSA neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer of the dsa command could not be read. Reinstall DSA."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la respuesta del comando dsa. Vuelva a instalar DSA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la réponse de la commande dsa. Réinstallez DSA."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban perintah dsa tidak dapat dibaca. Instal ulang DSA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la risposta del comando dsa. Reinstalla DSA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "dsa コマンドの応答を読み取れませんでした。DSA を再インストールしてください。"
