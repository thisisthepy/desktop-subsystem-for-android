          }
        }
      }
    },
    "ResizeTraceCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every DSA process writes each stage of each window resize, to find where a resize is slow or flickers. Off by default."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 DSA 프로세스가 창 크기 조정의 단계마다 기록해, 크기 조정이 느리거나 깜박이는 곳을 찾습니다. 기본값은 꺼짐입니다."
          }
        }
      }
    },
    "ResizeTraceCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resize trace"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 조정 추적"
          }
        }
      }
    },
