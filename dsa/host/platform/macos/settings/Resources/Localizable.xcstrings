    "AndroidDownConfirm.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-Daten löschen, um zu einer älteren Version zu wechseln?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase Android data to move to an older version?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar los datos de Android para pasar a una versión anterior?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer les données Android pour passer à une version plus ancienne ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus data Android untuk pindah ke versi lebih lama?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellare i dati Android per passare a una versione precedente?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android のデータを消去して、古いバージョンに移行しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 데이터를 지우고 이전 버전으로 옮길까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar os dados do Android para voltar a uma versão mais antiga?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стереть данные Android для перехода на более старую версию?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski bir sürüme geçmek için Android verileri silinsin mi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa dữ liệu Android để chuyển sang phiên bản cũ hơn?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除 Android 数据并切换到较旧的版本吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除 Android 資料並改用較舊的版本嗎？"
          }
        }
      }
    },
    "AndroidFilesCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den gemeinsamen Speicher von Android im Finder: Fotos, Downloads und andere Dateien von Apps. Android startet bei Bedarf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Android's shared storage in the Finder: photos, downloads and other files apps saved. Android starts if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el almacenamiento compartido de Android en el Finder: fotos, descargas y archivos de apps. Android se inicia si hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le stockage partagé d'Android dans le Finder : photos, téléchargements et autres fichiers des apps. Android démarre au besoin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka penyimpanan bersama Android di Finder: foto, unduhan, dan file lain yang disimpan aplikasi. Android dimulai jika perlu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre nel Finder l'archivio condiviso di Android: foto, download e altri file salvati dalle app. Android si avvia se necessario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android の共有ストレージを Finder で開きます: 写真やダウンロードなど、アプリが保存したファイルです。必要なら Android が起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 공유 저장소를 Finder에서 엽니다. 앱이 저장한 사진, 다운로드 등이 있습니다. 필요하면 Android가 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o armazenamento compartilhado do Android no Finder: fotos, downloads e outros arquivos dos apps. O Android inicia se preciso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает общее хранилище Android в Finder: фото, загрузки и другие файлы приложений. Android запустится, если нужно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android'in paylaşılan depolamasını Finder'da açar: fotoğraflar, indirmeler ve uygulamaların kaydettiği dosyalar. Gerekirse Android başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở bộ nhớ dùng chung của Android trong Finder: ảnh, tệp tải xuống và các tệp khác mà ứng dụng đã lưu. Android khởi động nếu cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在访达中打开 Android 的共享存储：照片、下载内容以及应用保存的其他文件。如有需要，Android 会启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中打開 Android 的共用儲存空間：照片、下載項目以及應用程式儲存的其他檔案。必要時會啟動 Android。"
          }
        }
      }
    },
