        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA se distribuye bajo la Apache License 2.0. Abra las licencias de todos los componentes que incluye."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA est distribué sous Apache License 2.0. Ouvrez les licences de chaque composant fourni avec DSA."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA dilisensikan dengan Apache License 2.0. Buka lisensi setiap komponen yang disertakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA è distribuito con la Apache License 2.0. Apri le licenze di tutti i componenti inclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA は Apache License 2.0 でライセンスされています。同梱するすべてのコンポーネントのライセンスを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA는 Apache License 2.0으로 배포합니다. 함께 배포하는 모든 구성 요소의 라이선스를 엽니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DSA é licenciado sob a Apache License 2.0. Abra as licenças de todos os componentes que ele inclui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA распространяется по лицензии Apache License 2.0. Откройте лицензии всех компонентов, входящих в поставку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA, Apache License 2.0 ile lisanslanmıştır. Birlikte gelen her bileşenin lisanslarını açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA được cấp phép theo Apache License 2.0. Mở giấy phép của mọi thành phần đi kèm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 依据 Apache License 2.0 授权。打开它附带的每个组件的许可证。"
          }
