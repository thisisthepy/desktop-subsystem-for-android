            "state": "translated",
            "value": "Verwenden Sie 1 bis 64 druckbare ASCII-Zeichen, ohne Leerzeichen am Anfang oder Ende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1 to 64 printable ASCII characters, without a space at the start or end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use de 1 a 64 caracteres ASCII imprimibles, sin espacios al principio ni al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez de 1 à 64 caractères ASCII imprimables, sans espace au début ni à la fin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan 1 hingga 64 karakter ASCII yang dapat dicetak, tanpa spasi di awal atau akhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa da 1 a 64 caratteri ASCII stampabili, senza spazi all'inizio o alla fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印刷可能な ASCII 文字を 1～64 文字使い、先頭と末尾に空白を入れないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인쇄 가능한 ASCII 문자 1~64자를 쓰고, 앞뒤에 공백을 두지 마세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use de 1 a 64 caracteres ASCII imprimíveis, sem espaço no início ou no fim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте от 1 до 64 печатаемых символов ASCII без пробелов в начале и в конце."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başında veya sonunda boşluk olmadan 1 ila 64 yazdırılabilir ASCII karakteri kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng từ 1 đến 64 ký tự ASCII in được, không có dấu cách ở đầu hoặc cuối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 1 到 64 个可打印 ASCII 字符，开头和结尾不能有空格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 1 到 64 個可列印的 ASCII 字元，開頭與結尾不可有空格。"
          }
        }
      }
    },
