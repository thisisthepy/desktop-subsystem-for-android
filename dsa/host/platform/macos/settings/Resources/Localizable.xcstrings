    },
    "ResizeTraceCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder DSA-Prozess protokolliert jede Phase jeder Fenstergrößenänderung, um langsame oder flackernde Stellen zu finden. Standardmäßig aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every DSA process writes each stage of each window resize, to find where a resize is slow or flickers. Off by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada proceso de DSA registra las fases de cada cambio de tamaño, para ver dónde es lento o parpadea. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque processus DSA note chaque étape des redimensionnements de fenêtre, pour repérer lenteurs et scintillements. Désactivé par défaut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap proses DSA mencatat tiap tahap pengubahan ukuran jendela, untuk mencari bagian yang lambat atau berkedip. Nonaktif secara bawaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni processo DSA registra le fasi di ogni ridimensionamento, per trovare dove è lento o sfarfalla. Predefinito: disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズ変更が遅い所やちらつく所を探すため、すべての DSA プロセスがウィンドウのサイズ変更の各段階を記録します。デフォルトではオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 DSA 프로세스가 창 크기 조정의 단계마다 기록해, 크기 조정이 느리거나 깜박이는 곳을 찾습니다. 기본값은 꺼짐입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo processo do DSA registra cada etapa de cada redimensionamento de janela, para achar onde fica lento ou pisca. Desativado por padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый процесс DSA записывает этапы изменения размера окон, чтобы найти, где оно тормозит или мерцает. По умолчанию выключено."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her DSA işlemi, yavaşlık veya titreme yerini bulmak için her pencere boyutlandırmasının her aşamasını kaydeder. Varsayılan olarak kapalı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi tiến trình DSA ghi lại từng giai đoạn của mỗi lần đổi kích thước cửa sổ, để tìm chỗ chậm hoặc nhấp nháy. Tắt theo mặc định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个 DSA 进程都会记录每次调整窗口大小的每个阶段，以找出调整大小时变慢或闪烁的地方。默认关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個 DSA 程序都會記錄每次調整視窗大小的各個階段，以找出調整大小變慢或閃爍的位置。預設為關閉。"
          }
        }
      }
    },
