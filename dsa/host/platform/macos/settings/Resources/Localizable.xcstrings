    "Gapps_InstalledRestart": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert. Die Apps von Google erscheinen, sobald Android neu startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed. Google's apps appear once Android starts again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalado. Las apps de Google aparecen cuando Android se vuelve a iniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installé. Les apps Google apparaissent au prochain démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terinstal. Aplikasi Google muncul setelah Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installato. Le app di Google compaiono quando Android si riavvia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールしました。Android を再び起動すると、Google のアプリが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치했습니다. Android를 다시 시작하면 Google 앱이 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalado. Os apps do Google aparecem quando o Android iniciar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установлено. Приложения Google появятся после перезапуска Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklendi. Android yeniden başladığında Google'ın uygulamaları görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cài. Các ứng dụng của Google xuất hiện khi Android khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装。Android 再次启动后，Google 的应用就会出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝。Android 再次啟動後，就會出現 Google 的應用程式。"
          }
        }
      }
    },
    "Gapps_ReinstallNeeded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteGapps Core {0} für Android {1} ({2}) aus einer älteren DSA-Version wird nicht mehr verwendet, daher startet Android ohne Google-Apps.\nInstallieren Sie Google Play erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteGapps Core {0} for Android {1} ({2}) from an older DSA is no longer used, so Android starts without Google's apps.\nInstall Google Play again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteGapps Core {0} para Android {1} ({2}) de un DSA anterior ya no se usa, así que Android se inicia sin las apps de Google.\nVuelva a instalar Google Play."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteGapps Core {0} pour Android {1} ({2}), installé par un ancien DSA, n'est plus utilisé : Android démarre sans les apps Google.\nRéinstallez Google Play."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteGapps Core {0} untuk Android {1} ({2}) dari DSA lama tidak lagi dipakai, jadi Android dimulai tanpa aplikasi Google.\nInstal Google Play lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteGapps Core {0} per Android {1} ({2}) di un DSA precedente non è più usato, quindi Android si avvia senza le app di Google.\nInstalla di nuovo Google Play."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の DSA の Android {1} ({2}) 用 LiteGapps Core {0} は使われなくなったため、Android は Google のアプリなしで起動します。\nGoogle Play をもう一度インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 DSA가 설치한 Android {1}({2})용 LiteGapps Core {0}은(는) 더 이상 쓰이지 않습니다. 그래서 Android가 Google 앱 없이 시작합니다.\nGoogle Play를 다시 설치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O LiteGapps Core {0} para Android {1} ({2}) de um DSA anterior não é mais usado, então o Android inicia sem os apps do Google.\nInstale o Google Play de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteGapps Core {0} для Android {1} ({2}) из старой DSA больше не используется, и Android запускается без приложений Google.\nУстановите Google Play снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski bir DSA'dan kalan Android {1} ({2}) için LiteGapps Core {0} artık kullanılmıyor; Android Google uygulamaları olmadan başlar.\nGoogle Play'i yeniden yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "LiteGapps Core {0} cho Android {1} ({2}) từ bản DSA cũ hơn không còn được dùng, nên Android khởi động không kèm ứng dụng Google.\nHãy cài lại Google Play."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由旧版 DSA 安装的、适用于 Android {1}（{2}）的 LiteGapps Core {0} 已不再使用，因此 Android 会在没有 Google 应用的情况下启动。\n请重新安装 Google Play。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊版 DSA 安裝的 LiteGapps Core {0}（適用於 Android {1}，{2}）已不再使用，因此 Android 會在沒有 Google 應用程式的情況下啟動。\n請重新安裝 Google Play。"
          }
        }
      }
    },
    "Gapps_RemovedRestart": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt. Die Apps von Google verschwinden, sobald Android neu startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed. Google's apps go away once Android starts again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminado. Las apps de Google desaparecen cuando Android se vuelve a iniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimé. Les apps Google disparaissent au prochain démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihapus. Aplikasi Google hilang setelah Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimosso. Le app di Google spariscono quando Android si riavvia."
          }
        },
        "ja": {
          "stringUnit": {
