    "Identity_fingerprint_Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags. When set, it is Build.FINGERPRINT, whatever the parts above say."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags. 적으면 위의 구성 요소와 상관없이 이것이 Build.FINGERPRINT가 됩니다."
          }
