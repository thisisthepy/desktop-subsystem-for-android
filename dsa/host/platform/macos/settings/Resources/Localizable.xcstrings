          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã trở về mặc định. Khởi động lại Android để dùng ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
