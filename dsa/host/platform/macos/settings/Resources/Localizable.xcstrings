    "GeneralStateCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™ führt Android in einer eigenen schlanken VM aus und zeigt jede App in einem eigenen Fenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™ runs Android in its own lightweight virtual machine and shows each app in its own window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™ ejecuta Android en su propia máquina virtual ligera y muestra cada app en su propia ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™ exécute Android dans sa propre machine virtuelle légère et affiche chaque app dans sa propre fenêtre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™ menjalankan Android di mesin virtual ringan tersendiri dan menampilkan tiap aplikasi di jendelanya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™ esegue Android in una propria macchina virtuale leggera e mostra ogni app in una sua finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™ は Android を専用の軽量な仮想マシンで実行し、各アプリをそれぞれのウィンドウで表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™는 Android를 전용 경량 가상 머신에서 실행하고, 앱마다 자기 창으로 보여 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Desktop Subsystem for Android™ executa o Android em uma máquina virtual leve própria e mostra cada app em sua própria janela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™ запускает Android в собственной лёгкой виртуальной машине и показывает каждое приложение в своём окне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™, Android'i kendi hafif sanal makinesinde çalıştırır ve her uygulamayı kendi penceresinde gösterir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™ chạy Android trong máy ảo nhẹ riêng và hiển thị mỗi ứng dụng trong cửa sổ riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™ 在自己的轻量级虚拟机中运行 Android，并把每个应用显示在单独的窗口中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™ 在專屬的輕量虛擬機器中執行 Android，並將每個應用程式顯示在各自的視窗中。"
          }
        }
      }
    },
