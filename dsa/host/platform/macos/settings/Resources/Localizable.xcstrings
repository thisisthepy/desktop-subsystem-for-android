    "AndroidRestartConfirm.Body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android restarts into Android {0}. Its app windows close; open the apps again once it has started."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0}(으)로 다시 시작합니다. 앱 창이 닫히며, 시작이 끝나면 앱을 다시 열면 됩니다."
          }
        }
      }
    },
    "ImageAutoRestartCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Android into updates by itself"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 시 Android 자동으로 다시 시작"
          }
        }
      }
    },
    "ImageAutoRestartCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default. With no app window open, Android restarts into a downloaded update at once. With windows open, DSA asks first, or waits until you close them. Off, an update is used the next time you start Android."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 켬입니다. 열린 앱 창이 없으면 내려받은 업데이트로 Android를 바로 다시 시작합니다. 창이 열려 있으면 먼저 묻거나, 창을 모두 닫을 때까지 기다립니다. 끄면 다음에 Android를 시작할 때 업데이트를 적용합니다."
          }
        }
      }
    },
    "AndroidFollowsCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version it follows"
