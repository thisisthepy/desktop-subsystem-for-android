    "AppFullScreenCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo eine App ihr Vollbild zeigt, etwa nach der Vollbildtaste eines Videos.\nAuf dem ganzen Bildschirm erscheint die Titelleiste am oberen Rand.\nDie Wahl pro App hat Vorrang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where an app's full screen request shows, such as a video's full screen button.\nOn the whole screen, the title bar appears at the top edge.\nAn app's own choice wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde va la pantalla completa de una app, como en un vídeo.\nEn toda la pantalla, la barra de título sale arriba.\nPrima el ajuste por app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où s'affiche le plein écran d'une app, comme le bouton d'une vidéo.\nSur l'écran, la barre de titre sort du haut.\nLe choix par app prime."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat permintaan layar penuh, seperti tombol layar penuh video.\nDi seluruh layar, bilah judul muncul di tepi atas.\nPilihan aplikasi menang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove si apre lo schermo intero richiesto da un'app (come il pulsante di un video).\nSu tutto lo schermo, la barra del titolo compare in alto.\nPrevale la scelta per app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の全画面ボタンなど、アプリの全画面表示の要求の表示先です。\n画面全体では上端にタイトルバーが出ます。\nアプリごとの設定が優先です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상의 전체 화면 단추처럼 앱이 전체 화면을 요청할 때 어디에 보일지 정합니다.\n화면 전체로 보이면 화면 위쪽 끝에서 제목 표시줄이 나타납니다.\n앱마다 고른 값이 우선합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde fica a tela cheia pedida por um app, como a de um vídeo.\nNa tela inteira, a barra de título surge no topo.\nO ajuste do app prevalece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где показать полный экран по запросу приложения, например кнопкой видео.\nНа весь экран заголовок выезжает сверху.\nВыбор приложения важнее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın tam ekran isteği (ör. video oynatıcıda) nerede görünür.\nTüm ekranda başlık çubuğu üstte çıkar.\nUygulama ayarı önce gelir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nơi ứng dụng hiện khi yêu cầu toàn màn hình, như nút toàn màn hình của video.\nKhi toàn màn hình, thanh tiêu đề hiện ở mép trên.\nCài đặt từng ứng dụng được ưu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用的全屏请求（例如视频的全屏按钮）显示的位置。\n占满整个屏幕时，标题栏会在屏幕顶部边缘显示。\n为单个应用所选的设置优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式的全螢幕要求（例如影片的全螢幕按鈕）要在哪裡顯示。\n佔滿整個螢幕時，標題列會出現在頂端邊緣。\n應用程式個別的選擇優先。"
          }
        }
      }
    },
