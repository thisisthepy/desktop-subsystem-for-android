    "ClipboardCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig ein. Text, den Sie auf dem Mac oder in Android kopieren, lässt sich auf der jeweils anderen Seite einsetzen.\nBilder bleiben dort, wo sie kopiert wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default. Text you copy on the Mac or in Android can be pasted on the other side.\nImages stay where they were copied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado por defecto. El texto que copie en el Mac o en Android se puede pegar en el otro lado.\nLas imágenes se quedan donde se copiaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé par défaut. Le texte copié sur le Mac ou dans Android peut être collé de l'autre côté.\nLes images restent là où elles ont été copiées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif secara bawaan. Teks yang Anda salin di Mac atau di Android dapat ditempel di sisi lainnya.\nGambar tetap di tempat gambar itu disalin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito: attivo. Il testo copiato sul Mac o in Android può essere incollato dall'altra parte.\nLe immagini restano dove sono state copiate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオンです。Mac や Android でコピーしたテキストを、もう一方でペーストできます。\n画像はコピーした側にとどまります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 켜짐입니다. Mac이나 Android에서 복사한 텍스트를 반대쪽에 붙여넣을 수 있습니다.\n이미지는 복사한 곳에만 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por padrão. O texto copiado no Mac ou no Android pode ser colado do outro lado.\nAs imagens ficam onde foram copiadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию включено. Текст, скопированный на Mac или в Android, можно вставить на другой стороне.\nИзображения остаются там, где их скопировали."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak açık. Mac'te veya Android'de kopyaladığınız metin diğer tarafta yapıştırılabilir.\nGörüntüler kopyalandıkları yerde kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật theo mặc định. Văn bản bạn sao chép trên máy Mac hoặc trong Android có thể dán ở phía bên kia.\nHình ảnh chỉ ở lại nơi chúng được sao chép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认开启。在 Mac 或 Android 中拷贝的文本可以在另一端粘贴。\n图像只保留在拷贝它的一端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為開啟。在 Mac 或 Android 中拷貝的文字，可以貼到另一端。\n影像只會留在拷貝的那一端。"
          }
        }
      }
    },
