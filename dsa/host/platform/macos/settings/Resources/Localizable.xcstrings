    "LogsNote.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android sendet sein Protokoll nur, solange diese Seite geöffnet ist, und nichts wird auf die Festplatte geschrieben.\n„Diagnosedaten sichern“ sammelt alles, was ein Problembericht braucht, in einer ZIP-Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android sends its log only while this page is open, and nothing is written to disk.\nSave diagnostics gathers what a problem report needs into one zip file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android solo envía su registro mientras esta página está abierta, y no se escribe nada en el disco.\nGuardar diagnóstico reúne en un zip lo que necesita un informe de problemas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android n'envoie son journal que tant que cette page est ouverte, et rien n'est écrit sur le disque.\nEnregistrer les diagnostics rassemble ce dont un rapport de problème a besoin dans un seul fichier zip."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android mengirim lognya hanya selama halaman ini terbuka, dan tidak ada yang ditulis ke disk.\nSimpan diagnostik mengumpulkan yang dibutuhkan laporan masalah ke dalam satu file zip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android invia il log solo mentre questa pagina è aperta, e nulla viene scritto su disco.\nSalva diagnostica raccoglie in un unico file zip ciò che serve a una segnalazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android はこのページが開いている間だけログを送り、ディスクには何も書き込みません。\n「診断情報を保存」は、問題の報告に必要なものを 1 つの zip ファイルにまとめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면이 열려 있는 동안에만 Android가 로그를 보내고, 디스크에는 아무것도 쓰지 않습니다.\n진단 정보 저장은 문제를 알릴 때 필요한 것을 zip 파일 하나로 모읍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android envia o log só enquanto esta página está aberta, e nada é gravado no disco.\nSalvar diagnóstico reúne em um arquivo zip o que um relato de problema precisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android отправляет журнал, только пока эта страница открыта, и ничего не записывается на диск.\n«Сохранить диагностику» собирает всё нужное для отчёта о проблеме в один файл zip."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android günlüğünü yalnızca bu sayfa açıkken gönderir ve diske hiçbir şey yazılmaz.\nTanılamayı kaydet, bir sorun raporunun gerektirdiği her şeyi tek bir zip dosyasında toplar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android chỉ gửi nhật ký khi trang này đang mở, và không có gì được ghi vào ổ đĩa.\nLưu thông tin chẩn đoán gom những gì cần cho báo cáo sự cố vào một tệp zip."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在此页面打开时，Android 才会发送日志，并且不会向磁盘写入任何内容。\n“存储诊断信息”会把问题报告所需的内容收集到一个 zip 文件中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 只有在此頁面打開時才會傳送記錄，且不會將任何內容寫入磁碟。\n「儲存診斷資料」會將回報問題所需的內容收集成一個 zip 檔案。"
          }
        }
      }
    },
