    "AppsIntro.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Android apps installed on this Mac. Open an app, change its permissions, storage and notifications in App info, or uninstall an app you installed. They are also in Launchpad and in the DSA Apps folder of your Applications folder. Android starts when you open this page."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 설치된 Android 앱입니다. 앱을 열거나, 앱 정보에서 권한, 저장 공간, 알림을 바꾸거나, 직접 설치한 앱을 제거합니다. Launchpad와 응용 프로그램 폴더의 DSA Apps 폴더에도 나옵니다. 이 페이지를 열면 Android가 시작됩니다."
          }
        }
      }
    },
