    "FreezeCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default: an idle Android dozes and still receives notifications. Frozen, it uses no CPU but receives nothing until you open an app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐입니다. 꺼져 있으면 유휴 상태의 Android는 Doze 상태로 들어가고 알림을 계속 받습니다. 일시 정지하면 CPU를 쓰지 않지만, 앱을 열 때까지 아무것도 받지 않습니다."
          }
        }
      }
    },
    "FreezeCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze Android when idle"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유휴 상태에서 Android 일시 정지"
          }
        }
      }
    },
    "FreezeNowButton.Content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 정지"
          }
        }
      }
    },
    "FreezeNowCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops every process in Android until you open one of its windows again. Notifications, alarms and widgets stop with it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android의 창을 다시 열 때까지 모든 프로세스를 멈춥니다. 알림, 알람, 위젯도 함께 멈춥니다."
          }
        }
      }
    },
    "FreezeNowCard.Header": {
      "extractionState": "manual",
      "localizations": {
