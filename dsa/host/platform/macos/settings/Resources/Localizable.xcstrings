    "AndroidChooseCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA unterstützt die zwei neuesten Android-Versionen. Manche Apps laufen nur auf einer davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA supports the latest two Android versions. Some apps run on only one of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA es compatible con las dos versiones más recientes de Android. Algunas apps solo funcionan en una de ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA prend en charge les deux dernières versions d'Android. Certaines apps ne fonctionnent que sur l'une d'elles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA mendukung dua versi Android terbaru. Beberapa aplikasi hanya berjalan di salah satunya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA supporta le due versioni più recenti di Android. Alcune app funzionano solo su una delle due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA は Android の最新の 2 つのバージョンに対応しています。一部のアプリは、そのうち 1 つでしか動きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA는 최신 Android 버전 두 개를 지원합니다. 어떤 앱은 그중 한 버전에서만 동작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DSA é compatível com as duas versões mais recentes do Android. Alguns apps funcionam em apenas uma delas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA поддерживает две последние версии Android. Некоторые приложения работают только в одной из них."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA en yeni iki Android sürümünü destekler. Bazı uygulamalar bunlardan yalnızca birinde çalışır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA hỗ trợ hai phiên bản Android mới nhất. Một số ứng dụng chỉ chạy trên một trong hai phiên bản đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 支持最新的两个 Android 版本。有些应用只能在其中一个版本上运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 支援最新的兩個 Android 版本。有些應用程式只能在其中一個版本上執行。"
          }
        }
      }
    },
