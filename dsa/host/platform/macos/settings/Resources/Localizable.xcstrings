    "Network_DnsFallback": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Resolver dieses Mac antwortet nicht, daher fragt Android die DNS-Server des Netzwerks: {0}"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac's resolver does not answer, so Android asks the network's DNS servers: {0}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resolvedor de este Mac no responde, así que Android consulta a los servidores DNS de la red: {0}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résolveur de ce Mac ne répond pas, donc Android interroge les serveurs DNS du réseau : {0}"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolver Mac ini tidak menjawab, jadi Android bertanya ke server DNS jaringan: {0}"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il resolver di questo Mac non risponde, quindi Android interroga i server DNS della rete: {0}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac のリゾルバーが応答しないため、Android はネットワークの DNS サーバーに問い合わせています: {0}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 해석기가 응답하지 않아 Android가 네트워크의 DNS 서버에 직접 묻습니다: {0}"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resolvedor deste Mac não responde, então o Android consulta os servidores DNS da rede: {0}"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-резолвер этого Mac не отвечает, поэтому Android обращается к DNS-серверам сети: {0}"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'in çözümleyicisi yanıt vermiyor, bu yüzden Android ağın DNS sunucularına soruyor: {0}"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình phân giải của máy Mac này không phản hồi, nên Android hỏi trực tiếp máy chủ DNS của mạng: {0}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的解析器没有响应，因此 Android 会询问网络的 DNS 服务器：{0}"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 的解析程式沒有回應，因此 Android 會詢問網路的 DNS 伺服器：{0}"
          }
        }
      }
    },
    "Network_DnsHost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwort vom Resolver dieses Mac, daher gelten seine hosts-Datei, VPN und DNS-Filter für Android-Apps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answered by this Mac's resolver, so its hosts file, VPN and DNS filters apply to Android apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde el resolvedor de este Mac, así que su archivo hosts, su VPN y sus filtros DNS se aplican a las apps de Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponses du résolveur de ce Mac : son fichier hosts, son VPN et ses filtres DNS s'appliquent aux apps Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijawab oleh resolver Mac ini, jadi file hosts, VPN, dan filter DNS-nya berlaku untuk aplikasi Android."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risponde il resolver di questo Mac, quindi il suo file hosts, la VPN e i filtri DNS valgono per le app Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac のリゾルバーが応答するため、この Mac の hosts ファイル、VPN、DNS フィルターが Android アプリにも適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 해석기가 응답합니다. 이 Mac의 hosts 파일, VPN, DNS 필터가 Android 앱에도 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respondido pelo resolvedor deste Mac, então o arquivo hosts, a VPN e os filtros de DNS dele valem para os apps Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвечает резолвер этого Mac, поэтому его файл hosts, VPN и DNS-фильтры действуют и для приложений Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'in çözümleyicisi yanıtlar; böylece hosts dosyası, VPN ve DNS filtreleri Android uygulamalarına da uygulanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Do trình phân giải của máy Mac này trả lời, nên tệp hosts, VPN và bộ lọc DNS của máy Mac cũng áp dụng cho ứng dụng Android."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由这台 Mac 的解析器应答，因此其 hosts 文件、VPN 和 DNS 过滤器对 Android 应用同样有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由此 Mac 的解析程式回應，因此它的 hosts 檔案、VPN 與 DNS 過濾器也會套用到 Android 應用程式。"
          }
        }
      }
    },
    "Network_ModeAdvanced": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als eigenes Gerät mit dem Netzwerk dieses Mac verbunden (erweitertes Netzwerk)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to this Mac's network as a device of its own (advanced networking)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado a la red de este Mac como un dispositivo propio (red avanzada)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté au réseau de ce Mac comme un appareil distinct (réseau avancé)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung ke jaringan Mac ini sebagai perangkat tersendiri (jaringan lanjutan)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connesso alla rete di questo Mac come dispositivo a sé (rete avanzata)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立したデバイスとして、この Mac のネットワークに接続しています (詳細なネットワーク)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 네트워크에 독립된 기기로 연결되어 있습니다(고급 네트워킹)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado à rede deste Mac como um dispositivo próprio (rede avançada)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключён к сети этого Mac как отдельное устройство (расширенная сеть)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'in ağına ayrı bir aygıt olarak bağlı (gelişmiş ağ)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối với mạng của máy Mac này như một thiết bị riêng (mạng nâng cao)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以独立设备的身份连接到这台 Mac 的网络（高级网络）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以獨立裝置的身分連線到此 Mac 的網路（進階網路）。"
          }
        }
      }
    },
    "Network_ModeNat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über diesen Mac verbunden (NAT). Android-Apps sehen die Verbindung als Wi-Fi, ohne Datenkosten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected through this Mac (NAT). Android apps see it as Wi-Fi, with no data charges."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado a través de este Mac (NAT). Las apps de Android lo ven como Wi-Fi, sin coste de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté via ce Mac (NAT). Les apps Android le voient comme du Wi-Fi, sans frais de données."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung melalui Mac ini (NAT). Aplikasi Android melihatnya sebagai Wi-Fi, tanpa biaya data."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connesso tramite questo Mac (NAT). Le app Android lo vedono come Wi-Fi, senza costi per i dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac を経由して接続しています (NAT)。Android アプリからは、データ通信料のかからない Wi-Fi として見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac을 거쳐 연결되어 있습니다(NAT). Android 앱에는 데이터 요금이 없는 와이파이로 보입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado por meio deste Mac (NAT). Os apps Android o veem como Wi-Fi, sem cobrança de dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключён через этот Mac (NAT). Приложения Android видят это как Wi-Fi без оплаты трафика."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac üzerinden bağlı (NAT). Android uygulamaları bunu veri ücreti olmayan Wi-Fi olarak görür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối qua máy Mac này (NAT). Ứng dụng Android thấy đây là Wi-Fi, không tính phí dữ liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过这台 Mac 连接（NAT）。Android 应用将其视为不计流量费用的 Wi-Fi。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過此 Mac 連線（NAT）。Android 應用程式會將其視為 Wi-Fi，不產生數據費用。"
          }
        }
      }
    },
    "Network_ModeOff": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android läuft nicht und hat daher noch kein Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android is not running, so it has no network yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no está en ejecución, así que aún no tiene red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android n'est pas en cours d'exécution : il n'a pas encore de réseau."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android tidak berjalan, jadi belum punya jaringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non è in esecuzione, quindi non ha ancora una rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android が実行されていないため、まだネットワークはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 실행 중이 아니어서 아직 네트워크가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android não está em execução, então ainda não tem rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android не запущен, поэтому сети у него пока нет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android çalışmıyor, bu yüzden henüz ağı yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android không chạy, nên chưa có mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 未运行，因此还没有网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 未在執行，因此還沒有網路。"
          }
        }
      }
    },
    "Network_ModeUnknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der DSA-Dienst meldet das Netzwerk nicht. Aktualisieren Sie DSA, um es zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DSA service does not report the network. Update DSA to see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de DSA no informa de la red. Actualice DSA para verla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service DSA n'indique pas le réseau. Mettez à jour DSA pour le voir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan DSA tidak melaporkan jaringan. Perbarui DSA untuk melihatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio DSA non indica la rete. Aggiorna DSA per vederla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA サービスがネットワークを報告していません。表示するには、DSA をアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 서비스가 네트워크를 알려 주지 않습니다. DSA를 업데이트하면 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço DSA não informa a rede. Atualize o DSA para vê-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба DSA не сообщает о сети. Обновите DSA, чтобы её увидеть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA hizmeti ağı bildirmiyor. Görmek için DSA'yı güncelleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ DSA không cho biết thông tin mạng. Hãy cập nhật DSA để xem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 服务没有报告网络。更新 DSA 后即可查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 服務未回報網路。請更新 DSA 以查看。"
          }
        }
      }
    },
