            "state": "translated",
            "value": "Desconocido: el servicio de DSA no indicó si Google Play está instalado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inconnu : le service DSA n'a pas indiqué si Google Play est installé."
