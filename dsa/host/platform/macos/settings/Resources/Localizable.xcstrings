      }
    },
    "Apps_RootSet_ask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} now asks an administrator of this Mac each time it uses su. If it could not see su before, it sees it from the next start of Android."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 {0}이(가) su를 부를 때마다 이 Mac의 관리자에게 승인을 받습니다. 전에 su가 보이지 않았다면 Android가 다음에 시작할 때부터 보입니다."
          }
        }
      }
    },
    "Apps_RootSet_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} cannot use root any more. su disappears for it from the next start of Android."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 {0}은(는) 루트를 쓸 수 없습니다. Android가 다음에 시작할 때부터 이 앱에게 su가 보이지 않습니다."
          }
        }
      }
    },
    "Apps_RootSet_remember": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} now uses su without asking. If it could not see su before, it sees it from the next start of Android."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 {0}은(는) 묻지 않고 su를 씁니다. 전에 su가 보이지 않았다면 Android가 다음에 시작할 때부터 보입니다."
          }
        }
      }
    },
    "Apps_RootGroup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shares its user ID with {0}. Android cannot tell these apps apart, so their root access is one setting: changing it here changes it for all of them, and if any of them is set to Not allowed, none of them can use su."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0}와(과) 사용자 ID를 함께 씁니다. 안드로이드가 이 앱들을 구별할 수 없으므로 루트 권한은 하나의 설정입니다. 여기서 바꾸면 모두 바뀌고, 하나라도 요청 불가이면 모두 su를 쓸 수 없습니다."
          }
        }
      }
    },
    "Apps_RootTip_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root access is off for this Mac. An administrator turns it on in Advanced."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 루트 권한이 꺼져 있습니다. 관리자가 고급 페이지에서 켭니다."
          }
        }
      }
    },
