    "OpenLogsCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Protokolle des Fenstermanagers und der App-Fenster, um ein Problem zu melden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The logs of the window manager and the app windows, for reporting a problem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros del gestor de ventanas y de las ventanas de las apps, para informar de un problema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journaux du gestionnaire de fenêtres et des fenêtres d'app, pour signaler un problème."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Log pengelola jendela dan jendela aplikasi, untuk melaporkan masalah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I log del gestore delle finestre e delle finestre delle app, per segnalare un problema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題を報告するための、ウィンドウ マネージャーとアプリのウィンドウのログです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 관리자와 앱 창의 로그입니다. 문제를 알릴 때 첨부합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os logs do gerenciador de janelas e das janelas dos apps, para relatar um problema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журналы диспетчера окон и окон приложений для отчёта о проблеме."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorun bildirmek için pencere yöneticisinin ve uygulama pencerelerinin günlükleri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhật ký của trình quản lý cửa sổ và các cửa sổ ứng dụng, để báo cáo sự cố."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口管理器和应用窗口的日志，用于报告问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗管理程式與應用程式視窗的記錄，用於回報問題。"
          }
        }
      }
    },
