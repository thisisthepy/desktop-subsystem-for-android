{
  "sourceLanguage": "en",
  "strings": {
    "AppsDesktopShortcutButton.Content": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create desktop shortcut"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바탕 화면 바로 가기 만들기"
          }
        }
      }
    },
    "AppsDesktopShortcutButton.ToolTip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shortcut on the Desktop that opens the app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 여는 바탕 화면의 바로 가기"
          }
        }
      }
    },
    "Apps_DesktopShortcutMade": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} is on the Desktop."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0}을(를) 바탕 화면에 두었습니다."
          }
        }
      }
    },
    "ProgramUpdateCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating DSA"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 업데이트 중"
          }
        }
      }
    },
    "ProgramUpdateDone.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA updated"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 업데이트 완료"
          }
        }
      }
    },
    "ProgramUpdate_Starting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting the update ready"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 준비하고 있습니다"
          }
        }
      }
    },
    "ProgramUpdate_Downloading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading DSA {0}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA {0} 버전을 내려받고 있습니다"
          }
        }
      }
    },
    "ProgramUpdate_StoppingAndroid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping Android to install DSA {0}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA {0} 버전을 설치하기 위해 Android를 종료하고 있습니다"
          }
        }
      }
    },
    "ProgramUpdate_Installing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing DSA {0}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA {0} 버전을 설치하고 있습니다"
          }
        }
      }
    },
    "ProgramUpdate_Restarting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA is restarting to finish the update"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 마치기 위해 DSA가 다시 시작하고 있습니다"
          }
        }
      }
    },
    "ProgramUpdate_Version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version {0}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 {0}"
          }
        }
      }
    },
    "ProgramUpdate_KeepOpen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not close DSA or start Android apps until the update is done."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트가 끝날 때까지 DSA를 닫거나 Android 앱을 시작하지 마십시오."
          }
        }
      }
    },
    "ProgramUpdate_Applied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated to {0}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 버전으로 업데이트했습니다"
          }
        }
      }
    },
    "ProgramUpdate_Failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating to {0} failed. The version before it is still installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 버전으로 업데이트하지 못했습니다. 이전 버전이 그대로 설치되어 있습니다."
          }
        }
      }
    },
    "ProgramUpdate_NotBack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA has not come back after the update to {0}. If it does not start soon, restart the computer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 버전으로 업데이트한 뒤 DSA가 다시 시작하지 않았습니다. 곧 시작하지 않으면 컴퓨터를 다시 시작하십시오."
          }
        }
      }
    },
    "AboutAndroidVersionCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Android image the next start boots. Image updates change it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 시작할 때 부팅하는 Android 이미지입니다. 이미지 업데이트가 이 버전을 바꿉니다."
          }
        }
      }
    },
    "AboutAndroidVersionCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android image version"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 이미지 버전"
          }
        }
      }
    },
    "AboutAppVersionCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA Settings version"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 설정 버전"
          }
        }
      }
    },
    "AboutIndependent.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android is an independent open source project. It is not affiliated with, endorsed by or sponsored by Apple or Google."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android는 독립된 오픈 소스 프로젝트입니다. Apple이나 Google과 제휴하거나 그 보증이나 후원을 받지 않습니다."
          }
        }
      }
    },
    "AboutLicenseCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA is licensed under the Apache License 2.0. Open the licences of every component it ships."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA는 Apache License 2.0으로 배포합니다. 함께 배포하는 모든 구성 요소의 라이선스를 엽니다."
          }
        }
      }
    },
    "AboutLicenseCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Licences"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스"
          }
        }
      }
    },
    "AboutProductCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thisisthepy"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Thisisthepy"
          }
        }
      }
    },
    "AboutProductCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Subsystem for Android™"
          }
        }
      }
    },
    "AboutServiceVersionCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA service version"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 서비스 버전"
          }
        }
      }
    },
    "AboutSourceCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source code"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 코드"
          }
        }
      }
    },
    "AboutTitle.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보"
          }
        }
      }
    },
    "AboutTrademark.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android is a trademark of Google LLC."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android is a trademark of Google LLC."
          }
        }
      }
    },
    "AdbAutoConnectCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default. While developer mode is on, Android shows up in adb devices and Android Studio without running adb connect. If you run adb disconnect, it stays off until the adb server restarts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 켜짐입니다. 개발자 모드가 켜져 있으면 adb connect를 실행하지 않아도 adb devices와 Android Studio에 Android가 나타납니다. adb disconnect로 끊으면 adb 서버가 다시 시작될 때까지 연결하지 않습니다."
          }
        }
      }
    },
    "AdbAutoConnectCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect adb automatically"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "adb 자동 연결"
          }
        }
      }
    },
    "AdbAutoConnect_Attached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected: adb lists Android."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결됨: adb 기기 목록에 Android가 있습니다."
          }
        }
      }
    },
    "AdbAutoConnect_Detached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected with adb disconnect. Android connects again when the adb server restarts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "adb disconnect로 끊었습니다. adb 서버가 다시 시작되면 Android가 다시 연결됩니다."
          }
        }
      }
    },
    "AdbAutoConnect_Off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connecting: developer mode or automatic connection is off."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결하지 않음: 개발자 모드나 자동 연결이 꺼져 있습니다."
          }
        }
      }
    },
    "AdbAutoConnect_WaitingForAndroid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for Android: it connects once Android is running."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android를 기다리는 중: Android가 실행되면 연결됩니다."
          }
        }
      }
    },
    "AdbAutoConnect_WaitingForServer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for adb: Android connects when adb starts on this Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "adb를 기다리는 중: 이 Mac에서 adb가 시작되면 Android가 연결됩니다."
          }
        }
      }
    },
    "AdbCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While developer mode is on and Android is running, run this command:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발자 모드가 켜져 있고 Android가 실행 중일 때 다음 명령을 실행하세요:"
          }
        }
      }
    },
    "AdbCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect adb"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "adb 연결"
          }
        }
      }
    },
    "AdbPortLabel.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트"
          }
        }
      }
    },
    "AdminBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update settings apply to every user of this Mac, so only an administrator can change them. Use Change as administrator, and macOS asks for an administrator's password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 설정은 이 Mac의 모든 사용자에게 적용되므로 관리자만 바꿀 수 있습니다. 관리자 권한으로 변경을 누르면 macOS가 관리자 암호를 묻습니다."
          }
        }
      }
    },
    "AdminBar.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrator rights needed"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 권한이 필요합니다"
          }
        }
      }
    },
    "AdminShield.ToolTip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an administrator can change this setting."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자만 이 설정을 바꿀 수 있습니다."
          }
        }
      }
    },
    "AdvancedNetworkingCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. When on, Android joins this Mac's network as a device of its own: other devices on the network can reach Android apps, and Android apps can reach them directly. Programs on this Mac can always reach a server in Android at the address above."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐입니다. 켜면 Android가 이 Mac의 네트워크에 독립된 기기로 들어갑니다. 네트워크의 다른 기기가 Android 앱에 닿고, Android 앱도 그 기기에 바로 닿습니다. 이 Mac의 프로그램은 언제나 위의 주소로 Android의 서버에 닿을 수 있습니다."
          }
        }
      }
    },
    "AdvancedNetworkingCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced networking"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고급 네트워킹"
          }
        }
      }
    },
    "HostCertificatesHeader.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trusted certificates"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰할 수 있는 인증서"
          }
        }
      }
    },
    "HostCertificatesCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust certificates added to this Mac"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 추가한 인증서 신뢰"
          }
        }
      }
    },
    "HostCertificatesCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default. When on, Android trusts the root certificates a user or an administrator added to this Mac, such as those an internet filter or a company proxy installs to check HTTPS. Android's own list stays as it is. A change applies at once, without restarting Android."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 켜짐입니다. 켜면 사용자나 관리자가 이 Mac에 추가한 루트 인증서를 Android가 신뢰합니다. 인터넷 필터나 회사 프록시가 HTTPS를 검사하려고 설치한 인증서가 그 예입니다. Android의 기본 목록은 그대로 둡니다. 바꾸면 Android를 다시 시작하지 않고 바로 적용됩니다."
          }
        }
      }
    },
    "HostCertificatesEmpty.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No added root certificates were found on this Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 추가된 루트 인증서를 찾지 못했습니다."
          }
        }
      }
    },
    "HostCertificatesOff.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the switch is off, Android does not trust these certificates."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치가 꺼져 있는 동안 Android는 이 인증서를 신뢰하지 않습니다."
          }
        }
      }
    },
    "HostCertificatesIssuer.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Issued by {0}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발급자: {0}"
          }
        }
      }
    },
    "HostCertificatesSource_machine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer's trusted root store"
          }
        },
        "ko": {
