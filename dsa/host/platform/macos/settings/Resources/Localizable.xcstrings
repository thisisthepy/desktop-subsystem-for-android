    "Apps_RunAsArm_system-app": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die Teil von Android sind, laufen so, wie Android sie installiert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that are part of Android run as Android installed them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que forman parte de Android se ejecutan tal como Android las instaló."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps qui font partie d'Android s'exécutent telles qu'Android les a installées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi bagian dari Android berjalan sebagaimana Android menginstalnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che fanno parte di Android funzionano come le ha installate Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android の一部であるアプリは、Android がインストールしたとおりに実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android에 포함된 앱은 Android가 설치한 대로 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que fazem parte do Android são executados como o Android os instalou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения, входящие в Android, запускаются так, как их установил Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android'in parçası olan uygulamalar, Android'in yüklediği gibi çalışır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng thuộc Android chạy theo cách Android đã cài chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "属于 Android 的应用按 Android 安装它们的方式运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "屬於 Android 的應用程式會依 Android 的安裝方式執行。"
          }
        }
      }
    },
    "Apps_RunAsArm_no-arm-libraries": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine APK dieser App auf dem Gerät enthält ihren ARM-Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No APK of this app on the device holds its ARM code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún APK de esta app en el dispositivo contiene su código ARM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun APK de cette app sur l'appareil ne contient son code ARM."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada APK aplikasi ini di perangkat yang berisi kode ARM-nya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun APK di questa app sul dispositivo contiene il suo codice ARM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスには、このアプリの ARM コードを含む APK がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 이 앱의 ARM 코드를 담은 APK가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum APK deste app no dispositivo contém o código ARM dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один APK этого приложения на устройстве не содержит его код ARM."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıtta bu uygulamanın ARM kodunu içeren bir APK yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không APK nào của ứng dụng này trên thiết bị chứa mã ARM của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备上此应用的 APK 都不包含其 ARM 代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置上此應用程式的 APK 都不含其 ARM 程式碼。"
          }
        }
      }
    },
    "Apps_RunAsArm_translation-off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ARM-Übersetzung ist nicht eingeschaltet. Schalten Sie sie unter „ARM-Apps“ ein und starten Sie Android neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ARM translation is not on. Turn it on under ARM apps and restart Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción ARM no está activada. Actívela en Apps ARM y reinicie Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction ARM n'est pas activée. Activez-la dans Apps ARM et redémarrez Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahan ARM tidak aktif. Aktifkan di Aplikasi ARM, lalu mulai ulang Android."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduzione ARM non è attiva. Attivala in App ARM e riavvia Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ARM 変換がオンになっていません。「ARM アプリ」でオンにして、Android を再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ARM 번역이 꺼져 있습니다. ARM 앱에서 켜고 Android를 다시 시작하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tradução ARM não está ativada. Ative-a em Apps ARM e reinicie o Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансляция ARM выключена. Включите её в разделе «Приложения ARM» и перезапустите Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ARM çevirisi açık değil. ARM uygulamaları altında açın ve Android'i yeniden başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch ARM chưa bật. Hãy bật trong Ứng dụng ARM và khởi động lại Android."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ARM 转译未开启。请在“ARM 应用”下开启，然后重新启动 Android。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ARM 轉譯未開啟。請在「ARM 應用程式」中將它開啟，然後重新啟動 Android。"
          }
        }
      }
    },
    "Apps_RunAsArm_arm-only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App hat nur ARM-Code und läuft daher immer als ARM."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app has only ARM code, so it always runs as ARM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app solo tiene código ARM, así que siempre se ejecuta como ARM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app ne contient que du code ARM : elle s'exécute donc toujours en ARM."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini hanya punya kode ARM, jadi selalu berjalan sebagai ARM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app ha solo codice ARM, quindi funziona sempre come ARM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリには ARM コードしかないため、常に ARM として実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 ARM 코드만 있어 늘 ARM으로 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app só tem código ARM, então sempre é executado como ARM."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого приложения есть только код ARM, поэтому оно всегда запускается как ARM."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamada yalnızca ARM kodu var, bu yüzden her zaman ARM olarak çalışır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này chỉ có mã ARM, nên luôn chạy dưới dạng ARM."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用只有 ARM 代码，因此始终以 ARM 运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式只有 ARM 程式碼，因此一律以 ARM 執行。"
          }
        }
      }
    },
    "Apps_RunAsArm_unknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von DSA kann nicht sagen, ob die App als ARM laufen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of DSA cannot say whether the app can run as ARM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de DSA no puede saber si la app se puede ejecutar como ARM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de DSA ne peut pas indiquer si l'app peut s'exécuter en ARM."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi DSA ini tidak dapat mengetahui apakah aplikasi bisa berjalan sebagai ARM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione di DSA non sa dire se l'app può funzionare come ARM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンの DSA では、このアプリを ARM として実行できるかどうかわかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전의 DSA는 앱을 ARM으로 실행할 수 있는지 알 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do DSA não sabe dizer se o app pode ser executado como ARM."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия DSA не может определить, можно ли запустить приложение как ARM."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA'nın bu sürümü, uygulamanın ARM olarak çalışıp çalışamayacağını söyleyemez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản DSA này không biết ứng dụng có thể chạy dưới dạng ARM hay không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 DSA 无法判断该应用能否以 ARM 运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 DSA 無法判斷此應用程式能否以 ARM 執行。"
          }
        }
      }
    },
