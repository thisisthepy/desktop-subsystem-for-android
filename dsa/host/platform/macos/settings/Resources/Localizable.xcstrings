    "KeyProtection_None": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüssel von Android erhalten ihren Schutz beim ersten Start von Android."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android's keys get their protection the first time Android starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de Android reciben su protección la primera vez que se inicia Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés d'Android reçoivent leur protection au premier démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci Android mendapat perlindungannya saat Android pertama kali dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi di Android ricevono la loro protezione al primo avvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android のキーは、Android の初回起動時に保護されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android를 처음 시작할 때 Android의 키 보호가 정해집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves do Android recebem proteção na primeira vez que o Android inicia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи Android получат защиту при первом запуске Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android'in anahtarları, Android ilk kez başladığında korumalarını alır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các khóa của Android được bảo vệ ở lần đầu Android khởi động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 的密钥会在 Android 首次启动时获得保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 的密鑰會在 Android 首次啟動時取得保護。"
          }
        }
      }
    },
    "KeyProtection_SecureEnclave": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiegelt durch die Secure Enclave dieses Mac.\nEine Kopie des Android-Datenträgers kann die Schlüssel der Apps und den verschlüsselten Speicher von Android nirgendwo anders öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sealed by this Mac's Secure Enclave.\nA copy of Android's disk cannot open the apps' keys or Android's encrypted storage anywhere else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selladas por el Secure Enclave de este Mac.\nUna copia del disco de Android no puede abrir en otro sitio las claves de las apps ni el almacenamiento cifrado de Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scellées par la Secure Enclave de ce Mac.\nUne copie du disque d'Android ne peut ouvrir ni les clés des apps ni le stockage chiffré d'Android ailleurs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegel oleh Secure Enclave Mac ini.\nSalinan disk Android tidak dapat membuka kunci aplikasi atau penyimpanan terenkripsi Android di tempat lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigillate dalla Secure Enclave di questo Mac.\nUna copia del disco di Android non può aprire altrove le chiavi delle app né l'archivio crittografato di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の Secure Enclave で封印されています。\nAndroid のディスクをコピーしても、ほかの場所ではアプリのキーや Android の暗号化されたストレージを開けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 Secure Enclave로 봉인되어 있습니다.\nAndroid 디스크를 복사해도 다른 곳에서는 앱의 키와 Android의 암호화된 저장소를 열 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacradas pelo Secure Enclave deste Mac.\nUma cópia do disco do Android não consegue abrir as chaves dos apps nem o armazenamento criptografado do Android em outro lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запечатаны Secure Enclave этого Mac.\nКопия диска Android не может открыть ключи приложений или зашифрованное хранилище Android где-либо ещё."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'in Secure Enclave'i ile mühürlendi.\nAndroid'in diskinin bir kopyası, uygulamaların anahtarlarını veya Android'in şifreli depolamasını başka hiçbir yerde açamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được niêm phong bằng Secure Enclave của máy Mac này.\nBản sao đĩa Android không thể mở khóa của ứng dụng hay bộ nhớ mã hóa của Android ở bất kỳ nơi nào khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已由这台 Mac 的 Secure Enclave 密封。\n即使复制了 Android 的磁盘，在其他地方也无法打开应用的密钥或 Android 的加密存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由此 Mac 的 Secure Enclave 密封。\n即使拷貝 Android 的磁碟，也無法在其他地方打開應用程式的密鑰或 Android 的加密儲存空間。"
          }
        }
      }
    },
    "KeyProtection_Keychain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in Ihrem Anmeldeschlüsselbund, da die Secure Enclave nicht nutzbar ist. Sobald sie es ist, versiegelt DSA die Schlüssel damit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept by your login keychain only, because the Secure Enclave cannot be used. Once it can, DSA seals the keys with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las guarda su llavero de inicio de sesión: el Secure Enclave no se puede usar. Cuando se pueda, DSA sellará las claves con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardées uniquement dans votre trousseau de session, car la Secure Enclave est inutilisable. Dès que possible, DSA les scellera avec elle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya disimpan oleh rantai kunci login Anda, karena Secure Enclave tidak dapat digunakan. Begitu bisa, DSA menyegel kunci dengannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservate solo nel portachiavi login, perché la Secure Enclave non è utilizzabile. Quando lo sarà, DSA vi sigillerà le chiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave を使えないため、ログインキーチェーンにのみ保管しています。使えるようになると、DSA がキーを Secure Enclave で封印します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave를 쓸 수 없어 로그인 키체인에만 보관합니다. 쓸 수 있게 되면 DSA가 키를 Secure Enclave로 봉인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardadas só no chaveiro de início de sessão, porque o Secure Enclave não pode ser usado. Quando puder, o DSA lacra as chaves com ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранятся только в связке ключей «Вход»: Secure Enclave недоступен. Когда он станет доступен, DSA запечатает ключи в нём."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure Enclave kullanılamadığı için yalnızca giriş anahtar zincirinizde tutulur. Kullanılabilir olunca DSA anahtarları onunla mühürler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ được giữ trong chuỗi khóa đăng nhập của bạn, vì không dùng được Secure Enclave. Khi dùng được, DSA sẽ niêm phong khóa bằng nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于无法使用 Secure Enclave，仅由您的登录钥匙串保管。一旦可以使用，DSA 就会用它密封这些密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為無法使用 Secure Enclave，只由您的登入鑰匙圈保管。一旦可以使用，DSA 就會以它密封密鑰。"
          }
        }
      }
    },
