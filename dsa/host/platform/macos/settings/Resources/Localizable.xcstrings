    },
    "Android_DownWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} is older than the Android {1} that runs now, and Android cannot read data a newer version wrote. Moving erases the Android data of every user of this computer: every app they installed, the accounts they signed in to and the data of every app. Each user's Android then starts as it was first installed. DSA's settings stay. This cannot be undone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0}은(는) 지금 실행 중인 Android {1}보다 오래된 버전이고, Android는 더 새 버전이 쓴 데이터를 읽지 못합니다. 옮기면 이 컴퓨터 모든 사용자의 Android 데이터가 지워집니다: 설치한 모든 앱, 로그인한 계정, 모든 앱의 데이터입니다. 각 사용자의 Android는 처음 설치한 상태로 시작합니다. DSA 설정은 그대로 남습니다. 되돌릴 수 없습니다."
          }
        }
      }
    },
    "Android_FollowsLatest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The newest supported version (now Android {0})"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원하는 가장 새 버전(지금은 Android {0})"
          }
        }
      }
    },
    "Android_FollowsMajor": {
      "extractionState": "manual",
