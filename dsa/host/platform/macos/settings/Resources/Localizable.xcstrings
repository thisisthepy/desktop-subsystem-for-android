          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia Android da solo per gli aggiornamenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動で再起動してアップデートを適用"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 시 Android 자동으로 다시 시작"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiniciar o Android sozinho para aplicar atualizações"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапускать Android для обновлений автоматически"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeler için Android'i kendiliğinden yeniden başlat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự khởi động lại Android vào bản cập nhật"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动重新启动 Android 以应用更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動重新啟動 Android 以套用更新"
          }
        }
      }
    },
    "ImageAutoRestartCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig ein. Ohne offenes App-Fenster startet Android sofort in ein geladenes Update neu. Sonst fragt DSA zuerst oder wartet.\nAusgeschaltet gilt das Update beim nächsten Start von Android."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default. With no app window open, Android restarts into a downloaded update at once. Otherwise DSA asks first or waits.\nOff, the update applies at the next start of Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado por defecto. Sin ventanas de apps abiertas, Android se reinicia ya con la actualización. Si no, DSA pregunta o espera.\nSi se desactiva, la actualización se aplica la próxima vez que se inicie Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé par défaut. Sans fenêtre d'app ouverte, Android redémarre aussitôt sur la mise à jour téléchargée. Sinon, DSA demande ou attend.\nDésactivé, la mise à jour s'applique au prochain démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif secara bawaan. Tanpa jendela aplikasi, Android segera dimulai ulang ke pembaruan yang diunduh. Jika ada, DSA bertanya atau menunggu.\nJika nonaktif, pembaruan berlaku saat Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito: attivo. Senza app aperte, Android si riavvia subito nell'aggiornamento scaricato. Altrimenti DSA chiede o attende.\nSe disattivato, l'aggiornamento si applica al prossimo avvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオンです。アプリのウィンドウがなければ、ダウンロードした更新ですぐに Android を再起動し、あれば確認するか待ちます。\nオフにすると、次に Android を起動したときに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 켜짐입니다. 열린 앱 창이 없으면 내려받은 업데이트로 Android를 바로 다시 시작합니다. 창이 있으면 묻거나 기다립니다.\n끄면 다음에 Android를 시작할 때 적용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por padrão. Sem janela de app aberta, o Android reinicia logo com a atualização baixada. Senão, o DSA pergunta antes ou espera.\nDesativado, a atualização vale na próxima inicialização do Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию включено. Без открытых окон приложений Android сразу перезапускается с обновлением. Иначе DSA спросит или подождёт.\nЕсли выключено, обновление применится при следующем запуске Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak açık. Açık uygulama penceresi yoksa Android indirilen güncellemeyle hemen yeniden başlar. Varsa DSA sorar veya bekler.\nKapalıyken güncelleme, Android bir sonraki başladığında uygulanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật theo mặc định. Khi không có cửa sổ ứng dụng mở, Android khởi động lại ngay vào bản cập nhật đã tải. Nếu có, DSA hỏi hoặc chờ.\nKhi tắt, bản cập nhật được áp dụng ở lần khởi động Android tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认开启。没有打开的应用窗口时，Android 会立即重新启动并进入已下载的更新。否则 DSA 会先询问或等待。\n关闭后，更新会在 Android 下次启动时生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為開啟。沒有開啟的應用程式視窗時，Android 會立即重新啟動並套用已下載的更新。否則 DSA 會先詢問或等待。\n關閉時，更新會在 Android 下次啟動時套用。"
          }
        }
      }
    },
