            "state": "translated",
            "value": "Recopilando el diagnóstico. Tarda un minuto o más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collecte des diagnostics. Cela prend une minute ou plus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengumpulkan diagnostik. Ini butuh satu menit atau lebih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccolta della diagnostica. Richiede un minuto o più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断情報を収集しています。1 分以上かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단 정보를 모으고 있습니다. 1분 넘게 걸립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reunindo o diagnóstico. Isso leva um minuto ou mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбор диагностических данных. Это займёт минуту или больше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanılama bilgileri toplanıyor. Bu bir dakika veya daha uzun sürer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang thu thập thông tin chẩn đoán. Việc này mất một phút hoặc lâu hơn."
          }
        },
        "zh-Hans": {
