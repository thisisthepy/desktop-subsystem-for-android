    "UpdateNowBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA stoppt das Android aller Benutzer und installiert die neueste Version.\n\nDer DSA-Dienst startet neu, wenn die Installation abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA stops every user's Android and installs the newest version.\n\nThe DSA service restarts when setup is done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA detiene el Android de todos los usuarios e instala la versión más reciente.\n\nEl servicio de DSA se reinicia al terminar la instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA arrête l'Android de chaque utilisateur et installe la version la plus récente.\n\nLe service DSA redémarre une fois l'installation terminée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA menghentikan Android setiap pengguna dan menginstal versi terbaru.\n\nLayanan DSA dimulai ulang setelah penginstalan selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA arresta l'Android di tutti gli utenti e installa la versione più recente.\n\nIl servizio DSA si riavvia al termine dell'installazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA はすべてのユーザーの Android を停止し、最新のバージョンをインストールします。\n\nセットアップが終わると、DSA サービスが再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA가 모든 사용자의 Android를 종료하고 최신 버전을 설치합니다.\n\n설치가 끝나면 DSA 서비스가 다시 시작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DSA para o Android de todos os usuários e instala a versão mais recente.\n\nO serviço DSA reinicia quando a instalação terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA остановит Android всех пользователей и установит новейшую версию.\n\nСлужба DSA перезапустится после завершения установки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA her kullanıcının Android'ini durdurur ve en yeni sürümü yükler.\n\nKurulum bitince DSA hizmeti yeniden başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA dừng Android của mọi người dùng và cài phiên bản mới nhất.\n\nDịch vụ DSA khởi động lại khi cài đặt xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 会停止每个用户的 Android，并安装最新版本。\n\n安装完成后，DSA 服务会重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 會停止所有使用者的 Android，並安裝最新版本。\n\n安裝完成後，DSA 服務會重新啟動。"
          }
        }
      }
    },
