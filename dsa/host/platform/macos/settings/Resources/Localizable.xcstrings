    "BackupRestoreCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert die Apps aus der Sicherung, die Android fehlen, und stellt die Daten aller Apps aus der Sicherung wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs the apps of the backup that Android does not have and puts every app's data back from the backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala las apps de la copia que Android no tiene y recupera de la copia los datos de cada app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe les apps de la sauvegarde absentes d'Android et restaure les données de chaque app depuis la sauvegarde."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menginstal aplikasi dari cadangan yang tidak dimiliki Android dan mengembalikan data setiap aplikasi dari cadangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa le app del backup che Android non ha e ripristina dal backup i dati di ogni app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップにあって Android にないアプリをインストールし、すべてのアプリのデータをバックアップから戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업에 있지만 Android에 없는 앱을 설치하고, 모든 앱의 데이터를 백업의 데이터로 되돌립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala os apps do backup que o Android não tem e restaura os dados de todos os apps a partir do backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает приложения из резервной копии, которых нет в Android, и восстанавливает из неё данные всех приложений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekte olup Android'de olmayan uygulamaları yükler ve her uygulamanın verilerini yedekten geri koyar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài các ứng dụng trong bản sao lưu mà Android chưa có và khôi phục dữ liệu của mọi ứng dụng từ bản sao lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装备份中有而 Android 中没有的应用，并从备份中恢复每个应用的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝備份中有但 Android 沒有的應用程式，並從備份還原每個應用程式的資料。"
          }
        }
      }
    },
