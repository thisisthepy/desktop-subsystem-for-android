        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere yöneticisini yeniden başlat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại trình quản lý cửa sổ"
          }
        },
        "zh-Hans": {
