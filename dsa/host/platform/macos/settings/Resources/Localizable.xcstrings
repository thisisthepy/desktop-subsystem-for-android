    "AppsResizable.ToolTip": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob Sie die Fenster dieser App in der Größe ändern und maximieren können. Aus: Jedes Fenster behält die Größe, mit der es öffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether you can resize and maximize this app's windows. Off keeps each window at the size it opens at."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si puede cambiar el tamaño de las ventanas de esta app y maximizarlas. Si se desactiva, cada ventana mantiene su tamaño inicial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique si vous pouvez redimensionner et agrandir les fenêtres de cette app. Désactivé, chaque fenêtre garde sa taille d'ouverture."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah jendela aplikasi ini dapat diubah ukurannya dan dimaksimalkan. Jika nonaktif, setiap jendela tetap pada ukuran saat dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puoi ridimensionare e ingrandire le finestre di questa app. Se disattivato, ogni finestra resta della dimensione di apertura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのウィンドウのサイズ変更や最大化ができるかどうかです。オフにすると、各ウィンドウは開いたときのサイズのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱 창의 크기를 바꾸거나 최대화할 수 있는지 정합니다. 끄면 창이 열린 크기 그대로 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você pode redimensionar e maximizar as janelas deste app. Desativado, cada janela mantém o tamanho com que abre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно ли менять размер окон этого приложения и разворачивать их. Если выключено, окно сохраняет размер, в котором открылось."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamanın pencerelerini yeniden boyutlandırıp büyütüp büyütemeyeceğiniz. Kapalıyken her pencere açıldığı boyutta kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đổi kích thước và phóng to cửa sổ của ứng dụng này hay không. Khi tắt, mỗi cửa sổ giữ kích thước lúc mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否可以调整此应用窗口的大小并将其最大化。关闭后，每个窗口保持打开时的大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是否可以調整此應用程式視窗的大小及將其最大化。關閉時，每個視窗都會維持打開時的大小。"
          }
        }
      }
    },
