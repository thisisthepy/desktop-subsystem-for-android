    "BackupSwitch.Header": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Daten auf diesem Mac sichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up apps' data to this Mac"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer copia de seguridad de los datos de las apps en este Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarder les données des apps sur ce Mac"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangkan data aplikasi ke Mac ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui il backup dei dati delle app su questo Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのデータをこの Mac にバックアップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 앱 데이터 백업"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazer backup dos dados dos apps neste Mac"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервное копирование данных приложений на этот Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama verilerini bu Mac'e yedekle"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao lưu dữ liệu ứng dụng vào máy Mac này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将应用数据备份到这台 Mac"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將應用程式資料備份到此 Mac"
          }
        }
      }
    },
    "Backup_SwitchDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine zweite, verschlüsselte Kopie der App-Daten auf diesem Mac, wiederherstellbar nach einem Zurücksetzen oder auf einem anderen Mac.\nAus, bis Sie es einschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps a second, encrypted copy of your Android apps' user data on this Mac, to restore after a data reset or on another Mac.\nOff until you turn it on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda en este Mac otra copia cifrada de los datos de sus apps de Android, para restaurarla tras restablecer los datos o en otro Mac.\nDesactivado hasta que lo active."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde sur ce Mac une seconde copie chiffrée des données de vos apps Android, à restaurer après une réinitialisation ou sur un autre Mac.\nDésactivé tant que vous ne l'activez pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan salinan kedua terenkripsi data aplikasi Android di Mac ini, untuk dipulihkan usai atur ulang data atau di Mac lain.\nNonaktif sampai Anda mengaktifkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva sul Mac una seconda copia crittografata dei dati delle app Android, da ripristinare dopo una reimpostazione o su un altro Mac.\nDisattivato finché non lo attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android アプリのユーザー データを暗号化してこの Mac にもう 1 つ保持し、データのリセット後や別の Mac で復元できるようにします。\nオンにするまではオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 앱의 사용자 데이터를 암호화해 이 Mac에 한 벌 더 보관합니다. 데이터를 초기화한 뒤나 다른 Mac에서 복원할 수 있습니다.\n켜기 전까지는 꺼져 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda neste Mac uma cópia extra criptografada dos dados dos seus apps Android, para restaurar após redefinir os dados ou em outro Mac.\nDesativado até você ativar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранит на этом Mac вторую зашифрованную копию данных приложений Android, чтобы восстановить их после сброса или на другом Mac.\nВыключено, пока вы не включите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android uygulama verilerinin şifreli ikinci bir kopyasını bu Mac'te tutar; veri sıfırlamadan sonra veya başka Mac'te geri yüklenebilir.\nSiz açana kadar kapalıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ thêm một bản sao mã hóa của dữ liệu ứng dụng Android trên máy Mac này, để khôi phục sau khi đặt lại dữ liệu hoặc trên máy Mac khác.\nTắt cho đến khi bạn bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上额外保存一份 Android 应用用户数据的加密副本，以便在重置数据后或在其他 Mac 上恢复。\n在您开启之前保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 Mac 上另外保存一份加密的 Android 應用程式使用者資料，以便在重置資料後或在其他 Mac 上回復。\n在您開啟前保持關閉。"
          }
        }
      }
    },
    "Backup_OffKept": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühere Sicherungen von {0} Apps ({1}) liegen weiterhin in Ihrem Ordner „DSA Backup“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier backups of {0} apps ({1}) are still kept in your DSA Backup folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias anteriores de {0} apps ({1}) siguen guardadas en su carpeta DSA Backup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes précédentes de {0} apps ({1}) sont toujours conservées dans votre dossier DSA Backup."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan lama dari {0} aplikasi ({1}) masih tersimpan di folder DSA Backup Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup precedenti di {0} app ({1}) sono ancora nella cartella DSA Backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前に作成した {0} 個のアプリのバックアップ ({1}) は、DSA Backup フォルダに残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞서 만든 앱 {0}개의 백업({1})이 DSA Backup 폴더에 아직 남아 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups anteriores de {0} apps ({1}) continuam guardados na sua pasta DSA Backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежние резервные копии приложений ({0} шт., {1}) по-прежнему хранятся в папке DSA Backup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} uygulamanın önceki yedekleri ({1}) DSA Backup klasörünüzde hâlâ duruyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản sao lưu trước đây của {0} ứng dụng ({1}) vẫn được giữ trong thư mục DSA Backup của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前 {0} 个应用的备份（{1}）仍保留在您的 DSA Backup 文件夹中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先前 {0} 個應用程式的備份（{1}）仍保存在您的 DSA Backup 資料夾中。"
          }
        }
      }
    },
    "Backup_DeleteQuestion": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherungen von {0} Apps ({1}) liegen weiterhin auf diesem Mac.\n\nSollen sie samt Schlüssel gelöscht oder für eine spätere Wiederherstellung behalten werden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backups of {0} apps ({1}) are still kept on this Mac.\n\nDelete them and their key as well, or keep them for a later restore?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad de {0} apps ({1}) siguen guardadas en este Mac.\n\n¿Quiere eliminarlas también junto con su clave, o conservarlas para restaurarlas más adelante?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes de {0} apps ({1}) sont toujours conservées sur ce Mac.\n\nLes supprimer avec leur clé, ou les garder pour une restauration ultérieure ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan {0} aplikasi ({1}) masih tersimpan di Mac ini.\n\nHapus cadangan beserta kuncinya juga, atau simpan untuk pemulihan nanti?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup di {0} app ({1}) sono ancora su questo Mac.\n\nEliminarli insieme alla loro chiave, o conservarli per un ripristino futuro?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 個のアプリのバックアップ ({1}) がこの Mac に残っています。\n\nバックアップとそのキーも削除しますか？ それとも、あとで復元できるように残しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 {0}개의 백업({1})이 이 Mac에 아직 남아 있습니다.\n\n백업과 그 키도 삭제할까요, 나중에 복원하도록 남겨 둘까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups de {0} apps ({1}) continuam guardados neste Mac.\n\nApagar também os backups e a chave deles, ou mantê-los para uma restauração futura?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии приложений ({0} шт., {1}) всё ещё хранятся на этом Mac.\n\nУдалить их вместе с ключом или сохранить для восстановления позже?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} uygulamanın yedekleri ({1}) bu Mac'te hâlâ duruyor.\n\nBunlar ve anahtarları da silinsin mi, yoksa daha sonra geri yüklemek için saklansın mı?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản sao lưu của {0} ứng dụng ({1}) vẫn được giữ trên máy Mac này.\n\nXóa cả chúng và khóa của chúng, hay giữ lại để khôi phục sau?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 个应用的备份（{1}）仍保留在这台 Mac 上。\n\n要同时删除它们及其密钥，还是保留它们以便日后恢复？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 個應用程式的備份（{1}）仍保存在此 Mac 上。\n\n要一併刪除它們及其密鑰，還是保留以便日後回復？"
          }
        }
      }
    },
