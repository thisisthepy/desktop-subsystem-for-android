          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} est téléchargé. Redémarrez Android pour l'utiliser dès maintenant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} sudah diunduh. Mulai ulang Android untuk menggunakannya sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} è stato scaricato. Riavvia Android per usarlo subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} をダウンロードしました。今すぐ使うには、Android を再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0}을(를) 내려받았습니다. 지금 적용하려면 Android를 다시 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android {0} foi baixado. Reinicie o Android para usá-lo agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} загружен. Перезапустите Android, чтобы применить его сейчас."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} indirildi. Hemen kullanmak için Android'i yeniden başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tải xuống Android {0}. Khởi động lại Android để dùng ngay."
          }
        },
        "zh-Hans": {
