    "Apps_RootSet_ask": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} fragt jetzt bei jedem su einen Administrator dieses Mac. Sah die App su bisher nicht, sieht sie es ab dem nächsten Android-Start."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} now asks an administrator of this Mac each time it uses su. If it could not see su before, it sees it from the next start of Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora {0} pide permiso a un administrador del Mac cada vez que usa su. Si antes no veía su, lo verá desde el próximo inicio de Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} demande désormais l'accord d'un administrateur pour chaque su. Si su lui était masqué, il apparaît au prochain démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} kini meminta izin administrator Mac ini tiap kali memakai su. Jika dulu tak melihat su, ia melihatnya sejak Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora {0} chiede a un amministratore di questo Mac ogni volta che usa su. Se prima non vedeva su, lo vedrà dal prossimo avvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} は今後、su を使うたびにこの Mac の管理者に確認します。これまで su が見えなかった場合は、次に Android が起動したときから見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 {0}이(가) su를 부를 때마다 이 Mac의 관리자에게 승인을 받습니다. 전에 su가 보이지 않았다면 Android가 다음에 시작할 때부터 보입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} agora consulta um administrador deste Mac sempre que usa o su. Se não via o su, passa a vê-lo na próxima inicialização do Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь {0} при каждом вызове su спрашивает администратора этого Mac. Если su не было видно, оно появится при следующем запуске Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} artık su'yu her kullanışında bu Mac'in yöneticisine sorar. Önceden su'yu görmüyorsa, Android'in sonraki açılışından itibaren görür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ {0} hỏi quản trị viên máy Mac này mỗi lần dùng su. Nếu trước đây không thấy su, ứng dụng sẽ thấy nó từ lần khởi động Android tới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在，{0} 每次使用 su 时都会询问这台 Mac 的管理员。如果它之前看不到 su，将从 Android 下次启动时起看到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 現在每次使用 su 時都會詢問此 Mac 的管理者。如果它之前看不到 su，從 Android 下次啟動起就能看到。"
          }
        }
      }
    },
    "Apps_RootSet_off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} kann Root nicht mehr verwenden. Ab dem nächsten Start von Android ist su für die App nicht mehr sichtbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} cannot use root any more. su disappears for it from the next start of Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} ya no puede usar root. Desde el próximo inicio de Android, dejará de ver su."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} ne peut plus utiliser root. su disparaît pour cette app au prochain démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} tidak dapat lagi memakai root. su hilang baginya sejak Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} non può più usare l'accesso root. su sparisce per l'app dal prossimo avvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} は今後 root を使えません。次に Android が起動したときから、このアプリには su が見えなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 {0}은(는) 루트를 쓸 수 없습니다. Android가 다음에 시작할 때부터 이 앱에게 su가 보이지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} não pode mais usar root. O su desaparece para ele na próxima inicialização do Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} больше не может использовать root. При следующем запуске Android su для него исчезнет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} artık kök kullanamaz. Android'in sonraki açılışından itibaren su onun için kaybolur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} không thể dùng root nữa. su sẽ biến mất với ứng dụng này từ lần khởi động Android tới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 不能再使用 root。从 Android 下次启动时起，它将看不到 su。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 無法再使用 root。從 Android 下次啟動起，它將看不到 su。"
          }
        }
      }
    },
    "Apps_RootSet_remember": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} verwendet su jetzt ohne Nachfrage. Sah die App su bisher nicht, sieht sie es ab dem nächsten Start von Android."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} now uses su without asking. If it could not see su before, it sees it from the next start of Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora {0} usa su sin preguntar. Si antes no veía su, lo verá desde el próximo inicio de Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} utilise désormais su sans demander. Si su lui était masqué, il apparaît au prochain démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} kini memakai su tanpa bertanya. Jika dulu tak melihat su, ia melihatnya sejak Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora {0} usa su senza chiedere. Se prima non vedeva su, lo vedrà dal prossimo avvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} は今後、確認なしで su を使います。これまで su が見えなかった場合は、次に Android が起動したときから見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 {0}은(는) 묻지 않고 su를 씁니다. 전에 su가 보이지 않았다면 Android가 다음에 시작할 때부터 보입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} agora usa o su sem perguntar. Se não via o su, passa a vê-lo na próxima inicialização do Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь {0} использует su без вопросов. Если su не было видно, оно появится при следующем запуске Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} artık su'yu sormadan kullanır. Önceden su'yu görmüyorsa, Android'in sonraki açılışından itibaren görür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ {0} dùng su mà không hỏi. Nếu trước đây không thấy su, ứng dụng sẽ thấy nó từ lần khởi động Android tới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在，{0} 会不经询问直接使用 su。如果它之前看不到 su，将从 Android 下次启动时起看到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} 現在不經詢問即可使用 su。如果它之前看不到 su，從 Android 下次啟動起就能看到。"
          }
        }
      }
    },
    "Apps_RootGroup": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilt die Benutzer-ID mit {0}, daher kann Android diese Apps nicht unterscheiden.\nIhr Root-Zugriff ist eine Einstellung: Eine Änderung hier ändert alle, und „Nicht erlaubt“ bei einer davon sperrt su für alle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shares its user ID with {0}, so Android cannot tell these apps apart.\nTheir root access is one setting: a change here changes all of them, and Not allowed on any of them blocks su for all."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte su ID de usuario con {0}, así que Android no distingue estas apps.\nComparten un solo ajuste de acceso root: un cambio aquí afecta a todas, y No permitido en una de ellas bloquea su para todas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage son ID utilisateur avec {0} : Android ne peut donc pas distinguer ces apps.\nLeur accès root est un seul réglage : le modifier ici les modifie toutes, et Non autorisé sur l'une d'elles bloque su pour toutes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbagi ID pengguna dengan {0}, jadi Android tidak dapat membedakan aplikasi-aplikasi ini.\nAkses root mereka satu pengaturan: perubahan di sini mengubah semuanya, dan Tidak diizinkan pada salah satunya memblokir su bagi semua."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condivide l'ID utente con {0}, quindi Android non distingue queste app.\nIl loro accesso root è un'unica impostazione: cambiarla qui vale per tutte, e Non consentito su una qualsiasi blocca su per tutte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} とユーザー ID を共有しているため、Android はこれらのアプリを区別できません。\nroot 権限は 1 つの設定です: ここで変更するとすべてが変わり、いずれかが「許可しない」なら、すべてで su がブロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0}와(과) 사용자 ID를 함께 써서, Android가 이 앱들을 구별하지 못합니다.\n루트 권한은 하나의 설정입니다. 여기서 바꾸면 모두 바뀌고, 하나라도 요청 불가이면 모두 su를 쓸 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilha o ID de usuário com {0}, por isso o Android não consegue distinguir esses apps.\nO acesso root deles é um único ajuste: uma alteração aqui muda todos, e Não permitido em qualquer um deles bloqueia o su para todos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует общий идентификатор пользователя с {0}, поэтому Android не различает эти приложения.\nRoot-доступ у них общий: изменение здесь меняет его для всех, а «Запрещено» у любого из них блокирует su для всех."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı kimliğini {0} ile paylaşır, bu yüzden Android bu uygulamaları birbirinden ayıramaz.\nKök erişimleri tek bir ayardır: buradaki değişiklik hepsine uygulanır, birinde İzin verilmiyor seçilirse su hepsi için engellenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng chung ID người dùng với {0}, nên Android không phân biệt được các ứng dụng này.\nQuyền root của chúng là một cài đặt: đổi ở đây là đổi tất cả, và Không cho phép ở một ứng dụng sẽ chặn su cho tất cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它与 {0} 共用用户 ID，因此 Android 无法区分这些应用。\n它们的 root 访问权限是同一个设置：在这里更改会更改所有应用，其中任一个设为“不允许”都会阻止所有应用使用 su。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 {0} 共用使用者 ID，因此 Android 無法區分這些應用程式。\n它們的 root 存取權是同一個設定：在這裡變更會同時變更全部，其中任一個設為「不允許」就會封鎖全部的 su。"
          }
        }
      }
    },
    "Apps_RootTip_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Root-Zugriff ist auf diesem Mac aus. Ein Administrator schaltet ihn unter „Erweitert“ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root access is off for this Mac. An administrator turns it on in Advanced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso root está desactivado en este Mac. Un administrador lo activa en Avanzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès root est désactivé sur ce Mac. Un administrateur l'active dans Avancé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses root nonaktif untuk Mac ini. Administrator mengaktifkannya di Lanjutan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso root è disattivato su questo Mac. Un amministratore lo attiva in Avanzate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac では root 権限がオフです。管理者が「詳細」でオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 루트 권한이 꺼져 있습니다. 관리자가 고급 페이지에서 켭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso root está desativado neste Mac. Um administrador pode ativá-lo em Avançado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Root-доступ на этом Mac выключен. Администратор включает его в разделе «Дополнительно»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac için kök erişimi kapalı. Bir yönetici bunu Gelişmiş'te açar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền root đang tắt trên máy Mac này. Quản trị viên bật nó trong Nâng cao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的 root 访问权限已关闭。管理员可以在“高级”中开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 的 root 存取權已關閉。管理者可在「進階」中將它開啟。"
          }
        }
      }
    },
    "Apps_RootTip_unknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der DSA-Dienst meldet die Root-Stufe dieser App nicht. Aktualisieren Sie DSA, um sie hier zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The DSA service does not report this app's root level. Update DSA to choose it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de DSA no indica el nivel root de esta app. Actualice DSA para elegirlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service DSA n'indique pas le niveau root de cette app. Mettez à jour DSA pour le choisir ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan DSA tidak melaporkan tingkat root aplikasi ini. Perbarui DSA untuk memilihnya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio DSA non indica il livello root di questa app. Aggiorna DSA per sceglierlo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA サービスがこのアプリの root レベルを報告していません。ここで選ぶには、DSA をアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 서비스가 이 앱의 루트 수준을 알려 주지 않습니다. DSA를 업데이트하면 여기서 고를 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço DSA não informa o nível root deste app. Atualize o DSA para escolhê-lo aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба DSA не сообщает уровень root этого приложения. Обновите DSA, чтобы выбрать его здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA hizmeti bu uygulamanın kök düzeyini bildirmiyor. Burada seçmek için DSA'yı güncelleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ DSA không cho biết mức root của ứng dụng này. Hãy cập nhật DSA để chọn ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 服务没有报告此应用的 root 级别。更新 DSA 后即可在这里选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 服務未回報此應用程式的 root 等級。請更新 DSA 以在這裡選擇。"
          }
        }
      }
    },
