    "Backup_RestoreWarning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellung ändert die Apps in Android:\n• Apps aus der Sicherung, die Android fehlen, werden installiert.\n• Die Daten jeder App in der Sicherung werden durch die gesicherten ersetzt.\n\nWas diese Apps seit der Sicherung gespeichert haben, geht verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring changes the apps in Android:\n• Apps in the backup that Android does not have are installed.\n• The data of every app in the backup is replaced with the backup's.\n\nWhat those apps saved since the backup is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración cambia las apps de Android:\n• Se instalan las apps de la copia que Android no tiene.\n• Los datos de cada app de la copia se sustituyen por los de la copia.\n\nSe pierde lo que esas apps guardaron desde la copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration modifie les apps d'Android :\n• Les apps de la sauvegarde absentes d'Android sont installées.\n• Les données de chaque app de la sauvegarde sont remplacées par celles de la sauvegarde.\n\nCe que ces apps ont enregistré depuis la sauvegarde est perdu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemulihan mengubah aplikasi di Android:\n• Aplikasi dalam cadangan yang tidak ada di Android akan diinstal.\n• Data setiap aplikasi dalam cadangan diganti dengan data cadangan.\n\nYang disimpan aplikasi tersebut sejak pencadangan akan hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino modifica le app in Android:\n• Le app del backup che Android non ha vengono installate.\n• I dati di ogni app nel backup vengono sostituiti con quelli del backup.\n\nCiò che quelle app hanno salvato dopo il backup va perso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元すると Android のアプリが変わります:\n• バックアップにあって Android にないアプリがインストールされます。\n• バックアップにあるすべてのアプリのデータが、バックアップのデータに置き換えられます。\n\nバックアップ以降にそれらのアプリが保存した内容は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원하면 Android의 앱이 바뀝니다.\n• 백업에 있지만 Android에 없는 앱을 설치합니다.\n• 백업에 있는 모든 앱의 데이터를 백업의 데이터로 바꿉니다.\n\n백업 이후 그 앱들이 저장한 내용은 사라집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A restauração muda os apps do Android:\n• Os apps do backup que o Android não tem são instalados.\n• Os dados de todos os apps do backup são substituídos pelos do backup.\n\nO que esses apps salvaram desde o backup é perdido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление изменит приложения в Android:\n• Приложения из копии, которых нет в Android, будут установлены.\n• Данные всех приложений из копии будут заменены данными копии.\n\nВсё, что эти приложения сохранили после создания копии, будет потеряно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yükleme Android'deki uygulamaları değiştirir:\n• Yedekte olup Android'de olmayan uygulamalar yüklenir.\n• Yedekteki her uygulamanın verileri yedektekiyle değiştirilir.\n\nBu uygulamaların yedekten sonra kaydettikleri kaybolur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc khôi phục sẽ thay đổi các ứng dụng trong Android:\n• Ứng dụng trong bản sao lưu mà Android chưa có sẽ được cài.\n• Dữ liệu của mọi ứng dụng trong bản sao lưu được thay bằng dữ liệu của bản sao lưu.\n\nNhững gì các ứng dụng đó lưu sau lần sao lưu sẽ bị mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复会更改 Android 中的应用：\n• 安装备份中有而 Android 中没有的应用。\n• 备份中每个应用的数据都会被替换为备份中的数据。\n\n这些应用自备份以来保存的内容将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回復會變更 Android 中的應用程式：\n• 會安裝備份中有但 Android 沒有的應用程式。\n• 備份中每個應用程式的資料都會以備份的資料取代。\n\n這些應用程式在備份後儲存的內容將會遺失。"
          }
        }
      }
    },
