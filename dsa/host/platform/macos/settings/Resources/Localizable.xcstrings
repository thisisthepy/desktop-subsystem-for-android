      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android cannot change how {0} runs and keep its data. Installing it again erases its data: sign-ins, settings and files it keeps for itself."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 데이터를 지킨 채 {0}의 실행 방식을 바꿀 수 없습니다. 다시 설치하면 로그인, 설정, 앱이 보관한 파일 같은 데이터가 지워집니다."
          }
        }
      }
    },
