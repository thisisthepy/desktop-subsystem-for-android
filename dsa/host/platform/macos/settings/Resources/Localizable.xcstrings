    "ArmGoogleFetching.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa 2 GB werden von Google geladen und der Übersetzer wird entnommen. Das dauert einige Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading about 2 GB from Google and taking out the translator. It takes minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargando unos 2 GB de Google y extrayendo el traductor. Tarda unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement d'environ 2 GB depuis Google et extraction du traducteur. Cela prend quelques minutes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunduh sekitar 2 GB dari Google dan mengambil penerjemahnya. Ini memakan waktu beberapa menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download di circa 2 GB da Google ed estrazione del traduttore. Richiede alcuni minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google から約 2 GB をダウンロードし、変換ツールを取り出しています。数分かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google에서 약 2GB를 받아 번역기를 꺼내고 있습니다. 몇 분 걸립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixando cerca de 2 GB do Google e extraindo o tradutor. Leva alguns minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка около 2 GB с серверов Google и извлечение транслятора. Это займёт несколько минут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google'dan yaklaşık 2 GB indiriliyor ve çevirmen çıkarılıyor. Bu birkaç dakika sürer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải khoảng 2 GB từ Google và tách trình dịch ra. Việc này mất vài phút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在从 Google 下载约 2 GB 并取出转译器。这需要几分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在從 Google 下載約 2 GB 並取出轉譯器。這需要幾分鐘。"
          }
        }
      }
    },
