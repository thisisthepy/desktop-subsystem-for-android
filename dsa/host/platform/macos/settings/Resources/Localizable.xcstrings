    "GappsTerms.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apps von Google gehören Google, und es gelten die Bedingungen von Google.\nDSA verbreitet sie nicht. Auf Ihren Wunsch lädt DSA das öffentliche LiteGapps-Paket von der Website von LiteGapps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google's apps belong to Google and follow Google's terms.\nDSA does not distribute them. On your request, it downloads the public LiteGapps package from LiteGapps' site."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps de Google pertenecen a Google y se rigen por sus condiciones.\nDSA no las distribuye. Si usted lo pide, descarga el paquete público LiteGapps del sitio de LiteGapps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps Google appartiennent à Google et sont soumises à ses conditions.\nDSA ne les distribue pas. À votre demande, il télécharge le paquet public LiteGapps depuis le site de LiteGapps."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi Google milik Google dan tunduk pada ketentuan Google.\nDSA tidak mendistribusikannya. Atas permintaan Anda, DSA mengunduh paket publik LiteGapps dari situs LiteGapps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app di Google appartengono a Google e seguono le condizioni di Google.\nDSA non le distribuisce. Su tua richiesta, scarica il pacchetto pubblico LiteGapps dal sito di LiteGapps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google のアプリは Google に帰属し、Google の利用規約に従います。\nDSA はこれらを配布しません。求めに応じて、LiteGapps のサイトから公開の LiteGapps パッケージをダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 앱은 Google의 것이며 Google의 약관을 따릅니다.\nDSA는 이 앱을 배포하지 않습니다. 요청하면 LiteGapps 배포처에서 공개 LiteGapps 패키지를 받을 뿐입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps do Google pertencem ao Google e seguem os termos do Google.\nO DSA não os distribui. A seu pedido, ele baixa o pacote público do LiteGapps do site do LiteGapps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения Google принадлежат Google и подчиняются условиям Google.\nDSA их не распространяет. По вашему запросу DSA загружает общедоступный пакет LiteGapps с сайта LiteGapps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google'ın uygulamaları Google'a aittir ve Google'ın koşullarına tabidir.\nDSA bunları dağıtmaz. İsteğiniz üzerine herkese açık LiteGapps paketini LiteGapps'in sitesinden indirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng của Google thuộc về Google và tuân theo điều khoản của Google.\nDSA không phân phối chúng. Khi bạn yêu cầu, DSA tải gói LiteGapps công khai từ trang của LiteGapps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 的应用归 Google 所有，并遵循 Google 的条款。\nDSA 不分发它们。在您要求时，DSA 会从 LiteGapps 的网站下载公开的 LiteGapps 软件包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 的應用程式屬於 Google，並遵循 Google 的條款。\nDSA 不散布這些應用程式。DSA 只會在您要求時，從 LiteGapps 的網站下載公開的 LiteGapps 套件。"
          }
        }
      }
    },
