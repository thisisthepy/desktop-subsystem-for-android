    "FilesNote.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien senden Sie an eine Android-App, indem Sie sie aus dem Finder auf ihr Fenster ziehen. Eine hier abgelegte APK wird installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To send a file to an Android app, drag it from the Finder onto the app's window. An APK you drop on this window is installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para enviar un archivo a una app de Android, arrástrelo desde el Finder a su ventana. Un APK soltado en esta ventana se instala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour envoyer un fichier à une app Android, faites-le glisser du Finder vers la fenêtre de l'app. Un APK déposé sur la fenêtre est installé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengirim file ke aplikasi Android, seret dari Finder ke jendela aplikasi. APK yang dijatuhkan ke jendela ini akan diinstal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per inviare un file a un'app Android, trascinalo dal Finder sulla finestra dell'app. Gli APK rilasciati qui vengono installati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは Finder から Android アプリのウィンドウにドラッグすると送れます。このウィンドウにドロップした APK はインストールされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 앱에 파일을 보내려면 Finder에서 앱 창으로 끌어 놓습니다. 이 창에 끌어 놓은 APK는 설치됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para enviar um arquivo a um app Android, arraste-o do Finder para a janela do app. Um APK solto nesta janela é instalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы отправить файл в приложение Android, перетащите его из Finder в окно приложения. APK, перетащенный в это окно, будет установлен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Android uygulamasına dosya göndermek için Finder'dan uygulamanın penceresine sürükleyin. Bu pencereye bıraktığınız APK yüklenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để gửi tệp đến một ứng dụng Android, hãy kéo tệp từ Finder vào cửa sổ của ứng dụng. APK bạn thả vào cửa sổ này sẽ được cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要向 Android 应用发送文件，请把它从访达拖到该应用的窗口上。拖到此窗口上的 APK 会被安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要傳送檔案給 Android 應用程式，請從 Finder 將它拖移到該應用程式的視窗上。拖放到此視窗上的 APK 會被安裝。"
          }
        }
      }
    },
