    "IdentityWarning.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Änderung des Modells oder des Fingerprints kann das Verhalten von Apps ändern.\nManche prüfen das Gerät vor dem Start, und Zahlungs- und Integritätsprüfungen können fehlschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the model or the fingerprint can change how apps behave.\nSome check the device before they run, and payment and integrity checks may fail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el modelo o la huella digital puede cambiar el comportamiento de las apps.\nAlgunas comprueban el dispositivo antes de ejecutarse, y los pagos y las comprobaciones de integridad pueden fallar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier le modèle ou l'empreinte peut changer le comportement des apps.\nCertaines vérifient l'appareil avant de s'exécuter, et les vérifications de paiement et d'intégrité peuvent échouer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah model atau sidik jari dapat mengubah perilaku aplikasi.\nBeberapa aplikasi memeriksa perangkat sebelum berjalan, dan pemeriksaan pembayaran serta integritas bisa gagal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare il modello o l'impronta può cambiare il comportamento delle app.\nAlcune controllano il dispositivo prima di avviarsi, e i controlli di pagamento e di integrità potrebbero non riuscire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルやフィンガープリントを変えると、アプリの動作が変わることがあります。\n実行前にデバイスを確認するアプリもあり、決済や整合性のチェックが失敗することがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이나 지문을 바꾸면 앱의 동작이 달라질 수 있습니다.\n실행 전에 기기를 확인하는 앱이 있고, 결제와 무결성 검사가 실패할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o modelo ou a impressão digital pode mudar o comportamento dos apps.\nAlguns verificam o dispositivo antes de rodar, e verificações de pagamento e de integridade podem falhar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение модели или отпечатка может изменить поведение приложений.\nНекоторые проверяют устройство перед запуском, а проверки платежей и целостности могут не пройти."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeli veya parmak izini değiştirmek uygulamaların davranışını değiştirebilir.\nBazıları çalışmadan önce aygıtı denetler; ödeme ve bütünlük denetimleri başarısız olabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi kiểu máy hoặc dấu vân tay có thể thay đổi cách ứng dụng hoạt động.\nMột số ứng dụng kiểm tra thiết bị trước khi chạy, và việc kiểm tra thanh toán và tính toàn vẹn có thể thất bại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改型号或指纹可能会改变应用的行为。\n有些应用会在运行前检查设备，支付和完整性检查可能会失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更型號或指紋可能會改變應用程式的行為。\n有些應用程式會在執行前檢查裝置，付款與完整性檢查也可能失敗。"
          }
        }
      }
    },
