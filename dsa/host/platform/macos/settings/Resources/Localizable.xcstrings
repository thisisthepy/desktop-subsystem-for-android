    "Backup_TurnedOn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung ist ein. Android sichert die Daten seiner Apps ab jetzt auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup is on. Android backs up its apps' data to this Mac from now on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad está activada. A partir de ahora, Android copia los datos de sus apps en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde est activée. Android sauvegarde désormais les données de ses apps sur ce Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencadangan aktif. Mulai sekarang Android mencadangkan data aplikasinya ke Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup è attivo. Da ora Android esegue il backup dei dati delle app su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップをオンにしました。今後、Android はアプリのデータをこの Mac にバックアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 켰습니다. 이제부터 Android가 앱 데이터를 이 Mac에 백업합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup está ativado. A partir de agora, o Android faz backup dos dados dos apps neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервное копирование включено. С этого момента Android сохраняет данные приложений на этот Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleme açık. Android bundan sonra uygulamalarının verilerini bu Mac'e yedekler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bật sao lưu. Từ giờ Android sao lưu dữ liệu ứng dụng vào máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份已开启。从现在起，Android 会把其应用的数据备份到这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份已開啟。從現在起，Android 會將其應用程式資料備份到此 Mac。"
          }
        }
      }
    },
    "Backup_TurnedOff": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung ist aus. Die bisherigen Sicherungen bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup is off. The backups made so far are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad está desactivada. Las copias hechas hasta ahora se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde est désactivée. Les sauvegardes déjà faites sont conservées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencadangan nonaktif. Cadangan yang sudah dibuat tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup è disattivato. I backup creati finora vengono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップをオフにしました。これまでのバックアップは残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 껐습니다. 지금까지 만든 백업은 남아 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup está desativado. Os backups feitos até agora são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервное копирование выключено. Созданные копии сохранены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleme kapalı. Şimdiye kadar alınan yedekler saklanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tắt sao lưu. Các bản sao lưu đã tạo vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份已关闭。迄今为止创建的备份会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份已關閉。目前為止建立的備份會保留。"
          }
        }
      }
    },
    "Backup_TurnedOffDeleted": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung ist aus, und die Sicherungen samt Schlüssel wurden gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup is off, and the backups and their key were deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad está desactivada, y se eliminaron las copias y su clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde est désactivée, et les sauvegardes et leur clé ont été supprimées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencadangan nonaktif, dan cadangan beserta kuncinya telah dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup è disattivato, e i backup e la loro chiave sono stati eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップをオフにし、バックアップとそのキーを削除しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 끄고, 백업과 그 키를 삭제했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup está desativado, e os backups e a chave deles foram apagados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервное копирование выключено, копии и их ключ удалены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleme kapalı; yedekler ve anahtarları silindi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tắt sao lưu, và đã xóa các bản sao lưu cùng khóa của chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份已关闭，备份及其密钥已删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份已關閉，備份及其密鑰已刪除。"
          }
        }
      }
    },
    "KeyProtectionCard.Header": {
