    "FreezeCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus: Ein inaktives Android wechselt in Doze und erhält weiter Mitteilungen.\nEingefroren nutzt es keine CPU, erhält aber nichts, bis Sie eine App öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default: an idle Android dozes and still gets notifications.\nFrozen, it uses no CPU but gets nothing until you open an app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto: un Android inactivo entra en Doze y sigue recibiendo notificaciones.\nCongelado, no usa CPU, pero no recibe nada hasta que abra una app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut : au repos, Android passe en Doze et reçoit toujours les notifications.\nGelé, il n'utilise pas le processeur mais ne reçoit rien jusqu'à ce que vous ouvriez une app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonaktif secara bawaan: Android yang menganggur masuk Doze dan tetap menerima pemberitahuan.\nJika dibekukan, Android tidak memakai CPU, tetapi tidak menerima apa pun sampai Anda membuka aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito: disattivato. Da inattivo, Android entra in Doze e riceve ancora le notifiche.\nCongelato, non usa la CPU ma non riceve nulla finché non apri un'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオフです: アイドル状態の Android は Doze に入り、通知を受け取り続けます。\nフリーズすると CPU を使いませんが、アプリを開くまで何も受け取りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐입니다. 유휴 상태의 Android는 Doze로 들어가 알림을 계속 받습니다.\n일시 정지하면 CPU를 쓰지 않지만, 앱을 열 때까지 아무것도 받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão: um Android ocioso entra em soneca e continua recebendo notificações.\nCongelado, ele não usa a CPU, mas não recebe nada até você abrir um app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено: простаивающий Android переходит в Doze и продолжает получать уведомления.\nЗамороженный, он не использует CPU, но ничего не получает, пока вы не откроете приложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak kapalı: boştaki Android Doze moduna geçer ve bildirim almaya devam eder.\nDondurulduğunda işlemci kullanmaz, ancak siz bir uygulama açana kadar hiçbir şey almaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt theo mặc định: Android nhàn rỗi sẽ chuyển sang Doze và vẫn nhận thông báo.\nKhi bị đóng băng, Android không dùng CPU nhưng không nhận gì cho đến khi bạn mở một ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭：空闲的 Android 会进入 Doze，仍会收到通知。\n冻结后，它不占用 CPU，但在您打开应用之前收不到任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為關閉：閒置的 Android 會進入 Doze，仍會收到通知。\n凍結後，它不使用 CPU，但在您打開應用程式前不會收到任何內容。"
          }
        }
      }
    },
    "FreezeCard.Header": {
