          }
        }
      }
    },
    "Install_Reason_conflicting-signature": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the app is installed already, signed with another key. Uninstall it in Android first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 키로 서명된 같은 앱이 이미 설치되어 있습니다. 먼저 Android에서 제거하세요."
          }
        }
      }
    },
    "Install_Reason_downgrade": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a newer version of the app is installed. Uninstall it in Android first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 새로운 버전의 앱이 설치되어 있습니다. 먼저 Android에서 제거하세요."
          }
        }
      }
    },
    "Install_Reason_incompatible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the app does not run on this Android: it needs another processor type, a newer Android version or a feature this device does not have."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Android에서 실행되지 않는 앱입니다. 다른 프로세서 종류, 더 새로운 Android 버전 또는 이 기기에 없는 기능이 필요합니다."
          }
        }
      }
    },
    "Install_Reason_insufficient-storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android has no room for the app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android에 앱을 설치할 공간이 없습니다."
          }
        }
      }
    },
    "Install_Reason_invalid-apk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the file is not a signed APK that Android can read."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 읽을 수 있는 서명된 APK가 아닙니다."
          }
        }
      }
    },
    "Install_Reason_other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android did not install the app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 앱을 설치하지 않았습니다."
          }
        }
      }
    },
    "Install_Reason_app-bundle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "it is an Android App Bundle, made to be uploaded to an app store. Get the app as an APK, or as an .xapk, .apks or .apkm bundle."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 스토어에 올리는 Android App Bundle입니다. 앱을 APK나 .xapk, .apks, .apkm 묶음으로 받으세요."
          }
        }
      }
    },
    "Install_Reason_encrypted-bundle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the bundle is encrypted, so its APKs cannot be read. Get the app as an APK, or as a newer bundle."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 묶음이라 APK를 읽을 수 없습니다. 앱을 APK나 새 묶음으로 받으세요."
          }
        }
      }
    },
    "Install_Reason_split-signature-mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a split APK of the bundle is signed with another key than its base APK, so Android would refuse it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "묶음의 분할 APK가 기본 APK와 다른 키로 서명되어 있어 Android가 설치하지 않습니다."
          }
        }
      }
    },
    "Install_Reason_invalid-bundle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the bundle is not one app that Android can install."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 설치할 수 있는 하나의 앱으로 된 묶음이 아닙니다."
          }
        }
      }
    },
