          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke bawaan. Mulai ulang Android untuk memakainya sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori predefiniti ripristinati. Riavvia Android per usarli subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトに戻しました。今すぐ使うには、Android を再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값으로 되돌렸습니다. 지금 쓰려면 Android를 다시 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores padrão restaurados. Reinicie o Android para usá-los agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановлены значения по умолчанию. Перезапустите Android, чтобы применить их сейчас."
          }
