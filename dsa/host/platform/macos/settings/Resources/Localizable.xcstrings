    "GappsRemoveCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Apps von Google von Ihrem Add-on-Datenträger. Ab dem nächsten Start von Android sind sie weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes Google's apps from your add-on disk. They are gone from the next start of Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las apps de Google de su disco de complementos. Desaparecen a partir del próximo inicio de Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les apps Google de votre disque d'extensions. Elles disparaissent au prochain démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus aplikasi Google dari disk add-on Anda. Aplikasi itu hilang sejak Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina le app di Google dal disco dei componenti aggiuntivi. Spariscono dal prossimo avvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドオン用ディスクから Google のアプリを削除します。次に Android が起動したときからなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 구성 요소 디스크에서 Google 앱을 지웁니다. 다음에 Android를 시작할 때부터 사라집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga os apps do Google do disco de complementos. Eles somem a partir da próxima inicialização do Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет приложения Google с диска дополнений. Они исчезнут при следующем запуске Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google'ın uygulamalarını eklenti diskinizden siler. Android'in sonraki açılışından itibaren kaybolurlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa các ứng dụng của Google khỏi đĩa tiện ích bổ sung. Chúng biến mất từ lần khởi động Android tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从附加组件磁盘中删除 Google 的应用。从 Android 下次启动时起，它们将消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從您的附加元件磁碟刪除 Google 的應用程式。從 Android 下次啟動起，它們就會消失。"
          }
        }
      }
    },
