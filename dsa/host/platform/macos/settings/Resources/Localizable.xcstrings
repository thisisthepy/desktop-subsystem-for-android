    "IdentityTitle.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device identity"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 정보"
          }
        }
      }
    },
    "IdentityWarning.Message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the model or the fingerprint can change how apps behave: some check the device before they run, and payment and integrity checks may fail."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이나 지문을 바꾸면 앱의 동작이 달라질 수 있습니다. 실행 전에 기기를 확인하는 앱이 있고, 결제와 무결성 검사가 실패할 수 있습니다."
          }
        }
      }
    },
    "IdentityWarning.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps may notice"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 알아챌 수 있습니다"
          }
        }
      }
    },
    "ImageUpdatesCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download signed security updates and new versions of Android. They apply when Android restarts, as the setting below says."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명된 보안 업데이트와 새 Android 버전을 내려받습니다. 아래 설정에 따라 Android가 다시 시작할 때 적용됩니다."
          }
        }
      }
    },
    "ImageUpdatesCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the Android image automatically"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 이미지 자동 업데이트"
          }
        }
      }
    },
    "InputTraceCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every DSA process writes when each touch, click and key reaches it, so the delay from your input to the picture can be measured. Off by default."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 DSA 프로세스가 터치, 클릭, 키가 언제 닿았는지 기록해, 입력에서 화면까지의 지연을 잴 수 있습니다. 기본값은 꺼짐입니다."
          }
        }
      }
    },
    "InputTraceCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input trace"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 추적"
          }
        }
      }
    },
