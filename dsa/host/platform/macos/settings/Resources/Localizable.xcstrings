    "RestartWindowManagerBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fenster der Android-Apps schließen sich kurz.\n\nAndroid und seine Apps laufen weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The windows of Android apps close for a moment.\n\nAndroid and its apps keep running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas de las apps de Android se cierran un momento.\n\nAndroid y sus apps siguen ejecutándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres des apps Android se ferment un instant.\n\nAndroid et ses apps continuent de s'exécuter."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela aplikasi Android ditutup sejenak.\n\nAndroid dan aplikasinya tetap berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre delle app Android si chiudono per un momento.\n\nAndroid e le sue app restano in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android アプリのウィンドウが一時的に閉じます。\n\nAndroid とアプリは実行を続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 앱 창이 잠시 닫힙니다.\n\nAndroid와 앱은 계속 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As janelas dos apps Android fecham por um momento.\n\nO Android e os apps continuam em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна приложений Android ненадолго закроются.\n\nAndroid и его приложения продолжат работать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android uygulamalarının pencereleri bir anlığına kapanır.\n\nAndroid ve uygulamaları çalışmaya devam eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cửa sổ ứng dụng Android sẽ đóng trong giây lát.\n\nAndroid và các ứng dụng vẫn tiếp tục chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 应用的窗口会暂时关闭。\n\nAndroid 及其应用会继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 應用程式的視窗會暫時關閉。\n\nAndroid 及其應用程式會繼續執行。"
          }
        }
      }
    },
