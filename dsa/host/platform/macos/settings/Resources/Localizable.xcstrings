    "UpdatesMachineNote.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungen gelten für alle Benutzer dieses Mac, daher kann nur ein Administrator sie ändern.\nEin Schalter, der aus bleibt, wird von dieser Installation nicht angeboten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These settings apply to every user of this Mac, so only an administrator can change them.\nA switch that stays off is not offered by this installation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos ajustes se aplican a todos los usuarios de este Mac, así que solo un administrador puede cambiarlos.\nUn interruptor que sigue desactivado no lo ofrece esta instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces réglages s'appliquent à tous les utilisateurs de ce Mac : seul un administrateur peut les modifier.\nUn interrupteur qui reste désactivé n'est pas proposé par cette installation."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan ini berlaku untuk setiap pengguna Mac ini, jadi hanya administrator yang dapat mengubahnya.\nSakelar yang tetap nonaktif tidak ditawarkan oleh instalasi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste impostazioni valgono per tutti gli utenti di questo Mac, quindi solo un amministratore può modificarle.\nUn interruttore che resta disattivato non è offerto da questa installazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの設定はこの Mac のすべてのユーザーに適用されるため、管理者だけが変更できます。\nオフのまま変わらないスイッチは、このインストールでは提供されていない機能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정은 이 Mac의 모든 사용자에게 적용되므로 관리자만 바꿀 수 있습니다.\n꺼진 채 바뀌지 않는 스위치는 이 설치에서 제공하지 않는 기능입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes ajustes valem para todos os usuários deste Mac, por isso só um administrador pode alterá-los.\nUm botão que continua desativado não é oferecido por esta instalação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти настройки действуют для всех пользователей этого Mac, поэтому изменить их может только администратор.\nПереключатель, который остаётся выключенным, недоступен в этой установке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayarlar bu Mac'in tüm kullanıcılarına uygulanır, bu yüzden yalnızca bir yönetici bunları değiştirebilir.\nKapalı kalan bir anahtar, bu kurulumda sunulmayan bir özelliktir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cài đặt này áp dụng cho mọi người dùng của máy Mac này, nên chỉ quản trị viên mới có thể thay đổi.\nCông tắc luôn tắt là tính năng mà bản cài đặt này không cung cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些设置适用于这台 Mac 的所有用户，因此只有管理员可以更改。\n始终保持关闭的开关表示此安装不提供该功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些設定會套用到此 Mac 的所有使用者，因此只有管理者可以變更。\n一直保持關閉的開關，表示此安裝未提供該功能。"
          }
        }
      }
    },
