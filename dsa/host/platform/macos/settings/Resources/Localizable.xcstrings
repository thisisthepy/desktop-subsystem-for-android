    "BackgroundAskCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie dies wieder ein, wenn Sie gewählt haben, nicht mehr gefragt zu werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this back on if you chose not to be asked again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva a activarlo si eligió que no se le preguntara de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réactivez cette option si vous aviez choisi de ne plus être interrogé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan lagi jika sebelumnya Anda memilih untuk tidak ditanya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riattiva questa opzione se avevi scelto di non ricevere più la domanda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今後確認しない」を選んだ場合は、ここで再びオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 묻지 않도록 골랐다면 여기서 다시 켤 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative de novo se você escolheu não ser perguntado outra vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите снова, если вы выбрали больше не спрашивать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir daha sorulmamasını seçtiyseniz bunu yeniden açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật lại mục này nếu bạn đã chọn không hỏi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您选择了不再询问，可以在这里重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您先前選擇不再詢問，可以在這裡重新開啟。"
          }
        }
      }
    },
