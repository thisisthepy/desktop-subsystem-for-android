        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "dsa 명령의 응답을 읽을 수 없습니다. DSA를 다시 설치하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
