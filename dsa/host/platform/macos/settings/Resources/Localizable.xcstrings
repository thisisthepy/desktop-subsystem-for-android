    "RootElevation_LogUnknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Anfrage wird im Dienstprotokoll mit App, Zeit, Zustimmung und Befehl festgehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each request is kept in the service log with the app, the time, whether it was approved and the command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada solicitud queda en el registro del servicio con la app, la hora, si se aprobó y el comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque demande est consignée dans le journal du service avec l'app, l'heure, la décision et la commande."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap permintaan dicatat di log layanan beserta aplikasi, waktu, apakah disetujui, dan perintahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni richiesta resta nel log del servizio con l'app, l'ora, l'esito dell'approvazione e il comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各要求は、アプリ、時刻、承認されたかどうか、コマンドとともにサービスのログに記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청마다 앱, 시각, 승인 여부, 실행한 명령이 서비스 로그에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pedido fica no log do serviço com o app, a hora, se foi aprovado e o comando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый запрос записывается в журнал службы с приложением, временем, решением и командой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her istek; uygulama, zaman, onaylanıp onaylanmadığı ve komutla birlikte hizmet günlüğünde tutulur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi yêu cầu được lưu trong nhật ký dịch vụ cùng ứng dụng, thời gian, kết quả chấp thuận và lệnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个请求都会连同应用、时间、是否获批和命令记录在服务日志中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次要求都會連同應用程式、時間、是否核准與指令記錄在服務記錄中。"
          }
        }
      }
    },
