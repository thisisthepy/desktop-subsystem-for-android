      }
    },
    "Problem_Unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer of the dsa command could not be read. Reinstall DSA."
          }
        },
        "ko": {
