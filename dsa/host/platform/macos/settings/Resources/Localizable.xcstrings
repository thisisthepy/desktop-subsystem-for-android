    "BackupKeySheet.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie diesen Schlüssel auf und bewahren Sie ihn sicher auf.\n\nOhne ihn lässt sich die Sicherung nicht auf einem anderen Computer wiederherstellen. Wer ihn hat, kann die Sicherung lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write this key down and keep it somewhere safe.\n\nWithout it, the backup cannot be restored on another computer. Anyone who has it can read the backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote esta clave y guárdela en un lugar seguro.\n\nSin ella, la copia de seguridad no se puede restaurar en otro equipo. Cualquiera que la tenga puede leer la copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez cette clé et conservez-la en lieu sûr.\n\nSans elle, la sauvegarde ne peut pas être restaurée sur un autre ordinateur. Quiconque la possède peut lire la sauvegarde."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat kunci ini dan simpan di tempat yang aman.\n\nTanpanya, cadangan tidak dapat dipulihkan di komputer lain. Siapa pun yang memilikinya dapat membaca cadangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota questa chiave e conservala in un luogo sicuro.\n\nSenza di essa, il backup non può essere ripristinato su un altro computer. Chiunque la possieda può leggere il backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーを書き留めて、安全な場所に保管してください。\n\nこれがないと、別のコンピューターでバックアップを復元できません。このキーを持っている人は誰でもバックアップを読み取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키를 적어 안전한 곳에 보관하세요.\n\n이 키가 없으면 다른 컴퓨터에서 백업을 복원할 수 없습니다. 이 키를 가진 사람은 누구나 백업을 읽을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote esta chave e guarde-a em um lugar seguro.\n\nSem ela, o backup não pode ser restaurado em outro computador. Quem tiver a chave pode ler o backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите этот ключ и храните его в надёжном месте.\n\nБез него резервную копию нельзя восстановить на другом компьютере. Любой, у кого он есть, может прочитать копию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anahtarı not edin ve güvenli bir yerde saklayın.\n\nBu anahtar olmadan yedek başka bir bilgisayarda geri yüklenemez. Anahtara sahip olan herkes yedeği okuyabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy ghi lại khóa này và cất ở nơi an toàn.\n\nKhông có khóa này, không thể khôi phục bản sao lưu trên máy tính khác. Bất kỳ ai có khóa đều đọc được bản sao lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请记下此密钥并妥善保管。\n\n没有它，就无法在其他电脑上恢复备份。任何拥有它的人都可以读取备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將此密鑰抄下，並存放在安全的地方。\n\n沒有它，就無法在其他電腦上回復備份。任何擁有它的人都能讀取備份。"
          }
        }
      }
    },
