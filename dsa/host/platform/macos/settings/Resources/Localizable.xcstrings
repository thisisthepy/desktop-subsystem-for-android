    "HostCertificatesCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig ein. Android vertraut den diesem Mac hinzugefügten Root-Zertifikaten, etwa eines Firmenproxys oder Internetfilters.\nDie eigene Liste von Android bleibt unverändert. Eine Änderung gilt sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default. Android trusts the root certificates added to this Mac, such as a company proxy's or an internet filter's.\nAndroid's own list stays as it is. A change applies at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado por defecto. Android confía en los certificados raíz añadidos a este Mac, como el de un proxy corporativo o un filtro web.\nLa lista propia de Android no cambia. Los cambios se aplican al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé par défaut. Android approuve les certificats racine ajoutés à ce Mac, comme ceux d'un proxy d'entreprise ou d'un filtre web.\nLa liste propre d'Android reste inchangée. Un changement s'applique immédiatement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif secara bawaan. Android memercayai sertifikat root yang ditambahkan ke Mac ini, seperti milik proxy kantor atau filter internet.\nDaftar milik Android tetap apa adanya. Perubahan langsung berlaku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito: attivo. Android considera attendibili i certificati radice aggiunti al Mac, come quelli di proxy aziendali o filtri Internet.\nL'elenco di Android resta invariato. Le modifiche si applicano subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオンです。会社のプロキシやインターネット フィルターの証明書など、この Mac に追加されたルート証明書を Android が信頼します。\nAndroid 自体の一覧はそのままです。変更はすぐに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 켜짐입니다. 회사 프록시나 인터넷 필터의 인증서처럼 이 Mac에 추가된 루트 인증서를 Android가 신뢰합니다.\nAndroid의 기본 목록은 그대로입니다. 바꾸면 바로 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por padrão. O Android confia nos certificados raiz adicionados a este Mac, como o de um proxy da empresa ou de um filtro web.\nA lista própria do Android não muda. Uma alteração vale na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию включено. Android доверяет добавленным на Mac корневым сертификатам, например прокси компании или интернет-фильтра.\nСобственный список Android не меняется. Изменение применяется сразу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak açık. Android, bu Mac'e eklenen kök sertifikalara (ör. bir şirket proxy'sinin veya internet filtresinin) güvenir.\nAndroid'in kendi listesi olduğu gibi kalır. Değişiklik hemen uygulanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật theo mặc định. Android tin cậy các chứng chỉ gốc đã thêm vào máy Mac này, chẳng hạn của proxy công ty hoặc bộ lọc internet.\nDanh sách riêng của Android vẫn giữ nguyên. Thay đổi được áp dụng ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认开启。Android 会信任添加到这台 Mac 的根证书，例如公司代理或互联网过滤器的证书。\nAndroid 自己的列表保持不变。更改会立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為開啟。Android 會信任新增到此 Mac 的根憑證，例如公司代理伺服器或網路過濾器的憑證。\nAndroid 本身的清單維持不變。變更會立即套用。"
          }
        }
      }
    },
