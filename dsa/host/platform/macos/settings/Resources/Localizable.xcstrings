          }
        }
      }
    },
    "BackupImportSheet.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie den Wiederherstellungsschlüssel ein, den Sie für den Sicherungsordner notiert haben.\n\nDSA liest die Sicherung dann damit, und Sie können daraus wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the recovery key you wrote down for the backup folder.\n\nDSA then reads that backup with it, and you can restore from it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca la clave de recuperación que anotó para la carpeta de copia de seguridad.\n\nDSA leerá esa copia con ella y podrá restaurar desde ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez la clé de récupération que vous avez notée pour le dossier de sauvegarde.\n\nDSA lit alors cette sauvegarde avec elle, et vous pouvez la restaurer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kunci pemulihan yang Anda catat untuk folder cadangan.\n\nDSA lalu membaca cadangan itu dengan kunci tersebut, dan Anda dapat memulihkan darinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la chiave di recupero che hai annotato per la cartella di backup.\n\nDSA la usa per leggere quel backup, e potrai ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ フォルダ用に書き留めた復旧キーを入力してください。\n\nDSA がそのキーでバックアップを読み取り、そこから復元できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 폴더용으로 적어 둔 복구 키를 넣으세요.\n\n그러면 DSA가 이 키로 백업을 읽고, 그 백업에서 복원할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a chave de recuperação que você anotou para a pasta de backup.\n\nO DSA então lê esse backup com ela, e você pode restaurá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ключ восстановления, записанный для папки резервных копий.\n\nDSA прочитает с ним эту копию, и вы сможете восстановить из неё данные."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekleme klasörü için not ettiğiniz kurtarma anahtarını girin.\n\nDSA ardından o yedeği bu anahtarla okur ve ondan geri yükleyebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập khóa khôi phục bạn đã ghi lại cho thư mục sao lưu.\n\nSau đó DSA dùng khóa này để đọc bản sao lưu, và bạn có thể khôi phục từ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入您为备份文件夹记下的恢复密钥。\n\n之后 DSA 会用它读取该备份，您就可以从中恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入您為此備份資料夾抄下的復原密鑰。\n\nDSA 接著會用它讀取該備份，您就能從中回復。"
          }
        }
      }
    },
