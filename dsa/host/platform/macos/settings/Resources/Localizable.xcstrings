    "GappsStatusCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play ist nicht Teil von DSA. DSA kann es für Sie laden und in Android installieren. Android funktioniert auch ohne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play is not part of DSA. You can have DSA download it and install it in Android. Android works without it too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play no forma parte de DSA. DSA puede descargarlo e instalarlo en Android si lo desea. Android también funciona sin él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play ne fait pas partie de DSA. DSA peut le télécharger et l'installer dans Android. Android fonctionne aussi sans."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play bukan bagian dari DSA. Anda dapat meminta DSA mengunduh dan menginstalnya di Android. Android juga berfungsi tanpanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play non fa parte di DSA. Puoi farlo scaricare a DSA e installarlo in Android. Android funziona anche senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play は DSA に含まれていません。DSA でダウンロードして Android にインストールできます。なくても Android は動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play는 DSA에 들어 있지 않습니다. 원하면 DSA가 받아서 Android에 설치합니다. 설치하지 않아도 Android는 그대로 쓸 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Google Play não faz parte do DSA. Você pode pedir ao DSA que o baixe e instale no Android. O Android também funciona sem ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play не входит в DSA. DSA может загрузить его и установить в Android. Android работает и без него."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play, DSA'nın parçası değildir. DSA'nın onu indirip Android'e yüklemesini sağlayabilirsiniz. Android onsuz da çalışır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play không phải là một phần của DSA. Bạn có thể để DSA tải xuống và cài nó vào Android. Android vẫn hoạt động khi không có nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play 不属于 DSA。您可以让 DSA 下载它并安装到 Android 中。没有它，Android 也能正常工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Play 不是 DSA 的一部分。您可以讓 DSA 下載它並安裝到 Android 中。沒有它，Android 也能運作。"
          }
        }
      }
    },
    "Gapps_Unknown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannt: Der DSA-Dienst hat nicht gemeldet, ob Google Play installiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not known: the DSA service did not say whether Google Play is installed."
          }
        },
        "es": {
