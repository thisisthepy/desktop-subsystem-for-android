      }
    },
    "AppsRunAsArmEraseBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android kann die Ausführungsart von {0} nicht ändern und dabei die Daten behalten.\n\nEine Neuinstallation löscht Anmeldungen, Einstellungen und die Dateien, die die App für sich speichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android cannot change how {0} runs and keep its data.\n\nInstalling it again erases its sign-ins, its settings and the files it keeps for itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no puede cambiar cómo se ejecuta {0} y conservar sus datos.\n\nVolver a instalarla borra sus inicios de sesión, sus ajustes y los archivos que guarda para sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ne peut pas changer le mode d'exécution de {0} en conservant ses données.\n\nSa réinstallation efface ses connexions, ses réglages et les fichiers qu'elle garde pour elle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android tidak dapat mengubah cara {0} berjalan sambil mempertahankan datanya.\n\nMenginstalnya ulang menghapus info masuk, pengaturan, dan file yang disimpannya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non può cambiare il modo in cui funziona {0} mantenendone i dati.\n\nReinstallarla cancella gli accessi, le impostazioni e i file che conserva per sé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android は、データを残したまま {0} の実行方法を変えることはできません。\n\n再インストールすると、サインイン情報、設定、アプリが保存しているファイルが消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 데이터를 지킨 채 {0}의 실행 방식을 바꿀 수 없습니다.\n\n다시 설치하면 로그인, 설정, 앱이 보관한 파일 같은 데이터가 지워집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android não consegue mudar como {0} é executado e manter os dados dele.\n\nInstalá-lo de novo apaga os logins, os ajustes e os arquivos que ele guarda para si."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android не может изменить способ запуска {0}, сохранив его данные.\n\nПереустановка сотрёт входы в аккаунты, настройки и файлы, которые приложение хранит для себя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android, {0} uygulamasının çalışma biçimini verilerini koruyarak değiştiremez.\n\nYeniden yüklemek, oturum açma bilgilerini, ayarlarını ve kendisi için tuttuğu dosyaları siler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android không thể thay đổi cách {0} chạy mà vẫn giữ dữ liệu của nó.\n\nViệc cài lại sẽ xóa thông tin đăng nhập, cài đặt và các tệp ứng dụng giữ cho riêng mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 无法在保留数据的同时更改 {0} 的运行方式。\n\n重新安装会清除它的登录信息、设置以及它为自己保存的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 無法在保留資料的情況下變更 {0} 的執行方式。\n\n重新安裝會清除它的登入資訊、設定，以及它為自己保存的檔案。"
          }
        }
      }
    },
