            "state": "translated",
            "value": "Démarrer sous la barre de titre"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai di bawah bilah judul"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia sotto la barra del titolo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルバーの下から開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 표시줄 아래에서 시작"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar abaixo da barra de título"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинать под строкой заголовка"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlık çubuğunun altından başlat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu bên dưới thanh tiêu đề"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从标题栏下方开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從標題列下方開始"
          }
        }
      }
