    "Backup_BackingUp": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten aller Apps werden gesichert. Das kann eine Weile dauern; Android wartet auf jede App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backing up the data of every app. This can take a while; Android waits for each app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiando los datos de todas las apps. Puede tardar un rato; Android espera a cada app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde des données de chaque app. Cela peut prendre un moment ; Android attend chaque app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencadangkan data setiap aplikasi. Ini dapat memakan waktu; Android menunggu setiap aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup dei dati di ogni app in corso. Può richiedere un po' di tempo; Android attende ogni app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアプリのデータをバックアップしています。Android がアプリごとに待つため、時間がかかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 앱의 데이터를 백업하는 중입니다. Android가 앱마다 기다리므로 시간이 걸릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazendo backup dos dados de todos os apps. Isso pode demorar; o Android espera por cada app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создание резервной копии данных всех приложений. Это может занять время: Android ждёт каждое приложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uygulamanın verileri yedekleniyor. Bu biraz zaman alabilir; Android her uygulamayı bekler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang sao lưu dữ liệu của mọi ứng dụng. Việc này có thể mất một lúc; Android chờ từng ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在备份每个应用的数据。这可能需要一段时间；Android 会逐个等待每个应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在備份所有應用程式的資料。這可能需要一段時間；Android 會逐一等待每個應用程式。"
          }
        }
      }
    },
