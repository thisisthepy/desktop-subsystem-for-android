    "LinksCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default: a web link you tap in an Android app opens in your default browser on the Mac. On, it opens in an Android app, as on a phone. A link an installed app has verified as its own opens in that app either way."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐입니다. 꺼져 있으면 Android 앱에서 누른 웹 링크가 Mac의 기본 브라우저에서 열립니다. 켜면 휴대폰에서처럼 Android 앱에서 열립니다. 설치된 앱이 자기 것으로 확인한 링크는 어느 쪽이든 그 앱에서 열립니다."
          }
        }
      }
    },
