    "AdvancedNetworkingCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Eingeschaltet ist Android ein eigenes Gerät im Netzwerk dieses Mac, und es und andere Geräte erreichen sich direkt.\nProgramme auf diesem Mac erreichen Android in jedem Fall unter der Adresse oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. On, Android joins this Mac's network as a device of its own, and it and other devices reach each other directly.\nPrograms on this Mac reach Android at the address above either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Si se activa, Android es un dispositivo más en la red de este Mac y se conecta directamente con otros.\nEn ambos casos, los programas de este Mac llegan a Android en la dirección de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Activé, Android rejoint le réseau de ce Mac comme un appareil distinct et communique directement avec les autres.\nLes programmes de ce Mac accèdent à Android à l'adresse ci-dessus dans les deux cas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonaktif secara bawaan. Jika aktif, Android menjadi perangkat sendiri di jaringan Mac ini, dan langsung terhubung dengan perangkat lain.\nProgram di Mac ini menjangkau Android di alamat di atas, apa pun pilihannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito: disattivato. Se attivo, Android entra nella rete di questo Mac come dispositivo a sé e comunica direttamente con gli altri.\nI programmi di questo Mac raggiungono comunque Android all'indirizzo qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオフです。オンにすると、Android はこの Mac のネットワークに独立したデバイスとして参加し、ほかのデバイスと直接つながります。\nこの Mac のプログラムは、どちらの場合も上のアドレスで Android に接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐입니다. 켜면 Android가 이 Mac의 네트워크에 독립된 기기로 들어가, 다른 기기와 서로 바로 닿습니다.\n이 Mac의 프로그램은 어느 쪽이든 위의 주소로 Android에 닿습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão. Ativado, o Android entra na rede deste Mac como dispositivo próprio e fala direto com os outros dispositivos.\nOs programas deste Mac alcançam o Android no endereço acima de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Если включить, Android входит в сеть этого Mac как отдельное устройство и общается с другими напрямую.\nПрограммы на этом Mac в любом случае обращаются к Android по адресу выше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak kapalı. Açıkken Android, bu Mac'in ağına ayrı bir aygıt olarak katılır ve diğer aygıtlarla doğrudan iletişim kurar.\nBu Mac'teki programlar her iki durumda da Android'e yukarıdaki adresten ulaşır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt theo mặc định. Khi bật, Android vào mạng của máy Mac này như một thiết bị riêng, và kết nối trực tiếp với các thiết bị khác.\nDù bật hay tắt, các chương trình trên máy Mac này đều kết nối với Android qua địa chỉ ở trên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。开启后，Android 会作为独立设备加入这台 Mac 的网络，它与其他设备可以直接互相访问。\n无论是否开启，这台 Mac 上的程序都可以通过上面的地址访问 Android。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為關閉。開啟後，Android 會以獨立裝置的身分加入此 Mac 的網路，與其他裝置直接互通。\n無論是否開啟，此 Mac 上的程式都能透過上方的位址連到 Android。"
          }
        }
      }
    },
