    "NetworkRestartBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung gilt beim nächsten Start von Android. Beenden Sie Android auf der Seite „Allgemein“ und öffnen Sie dann eine App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change applies the next time Android starts. Stop Android on the General page, then open an app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio se aplica la próxima vez que se inicie Android. Detenga Android en la página General y luego abra una app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement s'applique au prochain démarrage d'Android. Arrêtez Android dans la page Général, puis ouvrez une app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan berlaku saat Android dimulai lagi. Hentikan Android di halaman Umum, lalu buka aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica si applica al prossimo avvio di Android. Arresta Android nella pagina Generali, poi apri un'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は次に Android が起動したときに適用されます。「一般」ページで Android を停止してから、アプリを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바뀐 설정은 Android가 다음에 시작할 때 적용됩니다. 일반 페이지에서 Android를 중지한 뒤 앱을 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração vale na próxima vez que o Android iniciar. Pare o Android na página Geral e depois abra um app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение применится при следующем запуске Android. Остановите Android на странице «Основные», затем откройте приложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklik, Android bir sonraki başladığında uygulanır. Genel sayfasında Android'i durdurun, ardından bir uygulama açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi được áp dụng ở lần khởi động Android tiếp theo. Hãy dừng Android trên trang Cài đặt chung, rồi mở một ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改会在 Android 下次启动时生效。请在“通用”页面上停止 Android，然后打开一个应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更會在 Android 下次啟動時套用。請在「一般」頁面停止 Android，然後打開應用程式。"
          }
        }
      }
    },
