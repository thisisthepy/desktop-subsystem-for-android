    "AppsIntro.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-Apps auf diesem Mac: öffnen, in „App-Info“ Berechtigungen, Speicher und Mitteilungen ändern oder eigene Apps deinstallieren.\nSie sind auch im Launchpad und im Ordner „DSA Apps“ unter „Programme“. Android startet, wenn Sie diese Seite öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Android apps on this Mac. Open an app, change its permissions, storage and notifications in App info, or uninstall one you installed.\nThey are also in Launchpad and in the DSA Apps folder in Applications. Android starts when you open this page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps de Android en este Mac: ábralas, cambie permisos, almacenamiento y notificaciones en Información de la app o desinstale las suyas.\nTambién están en Launchpad y en la carpeta DSA Apps de Aplicaciones. Android se inicia al abrir esta página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps Android de ce Mac. Ouvrez-les, gérez autorisations, stockage et notifications dans Infos sur l'app, ou désinstallez les vôtres.\nElles figurent aussi dans Launchpad et dans le dossier DSA Apps d'Applications. Android démarre à l'ouverture de cette page."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi Android di Mac ini. Buka aplikasi, ubah izin, penyimpanan, dan pemberitahuannya di Info aplikasi, atau copot yang Anda instal.\nAplikasi juga ada di Launchpad dan di folder DSA Apps di Aplikasi. Android dimulai saat Anda membuka halaman ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app Android di questo Mac. Apri un'app, cambiane autorizzazioni, spazio e notifiche in Info app o rimuovi quelle che hai installato.\nSono anche in Launchpad e nella cartella DSA Apps in Applicazioni. Android si avvia quando apri questa pagina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の Android アプリです。開いたり、「アプリ情報」で権限、ストレージ、通知を変えたり、自分で入れたアプリを削除したりできます。\nLaunchpad と、「アプリケーション」の DSA Apps フォルダにもあります。このページを開くと Android が起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 Android 앱입니다. 앱을 열거나, 앱 정보에서 권한, 저장 공간, 알림을 바꾸거나, 직접 설치한 앱을 제거합니다.\nLaunchpad와 응용 프로그램의 DSA Apps 폴더에도 있습니다. 이 페이지를 열면 Android가 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps Android deste Mac. Abra um app, mude permissões, armazenamento e notificações em Informações do app ou desinstale os que instalou.\nEles também estão no Launchpad e na pasta DSA Apps em Aplicativos. O Android inicia quando você abre esta página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения Android на этом Mac. Открывайте их, меняйте разрешения, хранилище и уведомления в «О приложении», удаляйте установленные вами.\nОни также есть в Launchpad и в папке DSA Apps в «Программах». При открытии этой страницы запускается Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'teki Android uygulamaları. Açın, Uygulama bilgisi'nde izin, depolama ve bildirimleri değiştirin ya da yüklediğinizi kaldırın.\nLaunchpad'de ve Uygulamalar'daki DSA Apps klasöründe de bulunurlar. Bu sayfayı açtığınızda Android başlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng Android trên máy Mac này. Mở ứng dụng, đổi quyền, bộ nhớ và thông báo trong Thông tin ứng dụng, hoặc gỡ ứng dụng bạn đã cài.\nChúng cũng có trong Launchpad và trong thư mục DSA Apps của Ứng dụng. Android khởi động khi bạn mở trang này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的 Android 应用。可以打开应用，在“应用信息”中更改权限、存储空间和通知，或卸载您安装的应用。\n它们也位于启动台和“应用程序”中的 DSA Apps 文件夹里。打开此页面时，Android 会启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上的 Android 應用程式。您可以打開應用程式、在「應用程式資訊」中變更其權限、儲存空間與通知，或解除安裝您安裝的應用程式。\n它們也會出現在 Launchpad 及「應用程式」中的 DSA Apps 資料夾。打開此頁面時會啟動 Android。"
          }
        }
      }
    },
