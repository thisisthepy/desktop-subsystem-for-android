    "ArmGoogleCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert den ARM-Übersetzer von Google aus dem Android-Emulator-Abbild von Google.\nNichts wird geladen, bevor Sie den Bedingungen von Google zustimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs Google's ARM translator, taken from Google's Android emulator image.\nNothing is downloaded until you agree to Google's terms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala el traductor ARM de Google, extraído de la imagen del emulador de Android de Google.\nNo se descarga nada hasta que acepte las condiciones de Google."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe le traducteur ARM de Google, extrait de l'image de l'émulateur Android de Google.\nRien n'est téléchargé tant que vous n'acceptez pas les conditions de Google."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menginstal penerjemah ARM Google, yang diambil dari image emulator Android milik Google.\nTidak ada yang diunduh sampai Anda menyetujui ketentuan Google."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa il traduttore ARM di Google, preso dall'immagine dell'emulatore Android di Google.\nNon viene scaricato nulla finché non accetti le condizioni di Google."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google の Android エミュレーター イメージから取り出した、Google の ARM 変換ツールをインストールします。\nGoogle の利用規約に同意するまで、何もダウンロードしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google의 Android 에뮬레이터 이미지에서 꺼낸 Google의 ARM 번역기를 설치합니다.\nGoogle의 약관에 동의하기 전에는 아무것도 받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala o tradutor ARM do Google, retirado da imagem do emulador Android do Google.\nNada é baixado até você aceitar os termos do Google."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает транслятор ARM от Google, извлечённый из образа эмулятора Android от Google.\nНичего не загружается, пока вы не примете условия Google."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google'ın Android öykünücü görüntüsünden alınan Google ARM çevirmenini yükler.\nGoogle'ın koşullarını kabul edene kadar hiçbir şey indirilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài trình dịch ARM của Google, lấy từ ảnh trình giả lập Android của Google.\nKhông có gì được tải xuống cho đến khi bạn đồng ý với điều khoản của Google."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装从 Google 的 Android 模拟器映像中取出的 Google ARM 转译器。\n在您同意 Google 的条款之前，不会下载任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝取自 Google Android 模擬器映像的 Google ARM 轉譯器。\n在您同意 Google 的條款前，不會下載任何內容。"
          }
        }
      }
    },
    "ArmGoogleCard.More": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Mac lädt das Abbild für diese Android-Version (etwa 2 GB) von Google, unter der Android SDK License von Google.\nDSA behält nur den Übersetzer und löscht den Rest. Der Übersetzer von Google ist nicht in DSA enthalten und wird nicht weitergegeben.\nEin Paket aus einem anderen Übersetzer, etwa Digitalis, erfüllt denselben Zweck."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac downloads the image for this Android version (about 2 GB) from Google, under Google's Android SDK License.\nDSA keeps only the translator and deletes the rest. It does not include or pass on Google's translator.\nA package built from another translator, such as Digitalis, does the same job."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su Mac descarga de Google la imagen para esta versión de Android (unos 2 GB), según la Licencia del SDK de Android de Google.\nDSA solo conserva el traductor y elimina el resto. No incluye ni redistribuye el traductor de Google.\nUn paquete creado con otro traductor, como Digitalis, cumple la misma función."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac télécharge auprès de Google l'image de cette version d'Android (environ 2 GB), selon l'Android SDK License de Google.\nDSA ne conserve que le traducteur et supprime le reste. Il n'inclut ni ne redistribue le traducteur de Google.\nUn paquet issu d'un autre traducteur, comme Digitalis, fait le même travail."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Anda mengunduh image untuk versi Android ini (sekitar 2 GB) dari Google, di bawah Lisensi Android SDK Google.\nDSA hanya menyimpan penerjemahnya dan menghapus sisanya. DSA tidak menyertakan atau meneruskan penerjemah Google.\nPaket yang dibuat dari penerjemah lain, seperti Digitalis, melakukan hal yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac scarica da Google l'immagine di questa versione di Android (circa 2 GB), secondo la Android SDK License di Google.\nDSA conserva solo il traduttore ed elimina il resto. Non include né ridistribuisce il traduttore di Google.\nUn pacchetto creato da un altro traduttore, come Digitalis, svolge lo stesso compito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac が Google の Android SDK ライセンスに基づき、この Android バージョン用のイメージ (約 2 GB) を Google からダウンロードします。\nDSA は変換ツールだけを残し、残りは削除します。Google の変換ツールを同梱したり再配布したりはしません。\nDigitalis など、別の変換ツールから作ったパッケージでも同じことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac이 Google의 Android SDK 라이선스에 따라 Google에서 이 Android 버전용 이미지(약 2GB)를 직접 받습니다.\nDSA는 번역기만 남기고 나머지는 지웁니다. Google의 번역기를 담거나 다시 배포하지 않습니다.\nDigitalis 같은 다른 번역기로 만든 묶음으로도 같은 일을 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Mac baixa do Google a imagem desta versão do Android (cerca de 2 GB), sob a Android SDK License do Google.\nO DSA mantém só o tradutor e apaga o resto. Ele não inclui nem redistribui o tradutor do Google.\nUm pacote feito a partir de outro tradutor, como o Digitalis, faz o mesmo trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Mac загружает у Google образ для этой версии Android (около 2 GB) на условиях лицензии Android SDK от Google.\nDSA оставляет только транслятор, а остальное удаляет. DSA не включает и не распространяет транслятор Google.\nПакет на основе другого транслятора, например Digitalis, делает то же самое."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'iniz bu Android sürümünün görüntüsünü (yaklaşık 2 GB) Google'ın Android SDK Lisansı kapsamında Google'dan indirir.\nDSA yalnızca çevirmeni tutar ve gerisini siler. Google'ın çevirmenini içermez veya başkasına aktarmaz.\nDigitalis gibi başka bir çevirmenden yapılmış bir paket de aynı işi görür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac của bạn tải ảnh cho phiên bản Android này (khoảng 2 GB) từ Google, theo Giấy phép Android SDK của Google.\nDSA chỉ giữ trình dịch và xóa phần còn lại. DSA không chứa hay phân phối lại trình dịch của Google.\nMột gói dựng từ trình dịch khác, chẳng hạn Digitalis, cũng làm được việc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Mac 会依据 Google 的 Android SDK 许可协议，从 Google 下载适用于此 Android 版本的映像（约 2 GB）。\nDSA 只保留转译器，删除其余部分。DSA 不包含也不转发 Google 的转译器。\n用其他转译器（例如 Digitalis）构建的软件包也能完成同样的工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Mac 會依據 Google 的 Android SDK 授權合約，從 Google 下載此 Android 版本的映像（約 2 GB）。\nDSA 只保留轉譯器，並刪除其餘部分。DSA 不包含也不轉發 Google 的轉譯器。\n以其他轉譯器（例如 Digitalis）建置的套件也能達到相同效果。"
          }
        }
      }
    },
