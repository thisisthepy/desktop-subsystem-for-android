    "AppsImmersive.ToolTip": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo diese App erscheint, wenn sie ihre Leisten ohne Vollbildanforderung ausblendet, wie ein Feed mit kurzen Videos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where this app shows when it hides its bars without asking for full screen, as a feed of short videos does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde se muestra esta app cuando oculta sus barras sin pedir pantalla completa, como hace un feed de vídeos cortos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où s'affiche cette app quand elle masque ses barres sans demander le plein écran, comme un flux de vidéos courtes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat aplikasi ini tampil saat menyembunyikan bilahnya tanpa meminta layar penuh, seperti feed video pendek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove appare l'app quando nasconde le barre senza chiedere lo schermo intero, come fa un feed di video brevi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショート動画のフィードのように、このアプリが全画面表示を求めずにバーを隠すときの表示先です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 동영상 피드처럼 이 앱이 전체 화면 요청 없이 막대만 숨길 때 어디에 보일지 정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde este app aparece quando oculta as barras sem pedir tela cheia, como faz um feed de vídeos curtos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где показывать приложение, когда оно скрывает панели без запроса полного экрана, как лента коротких видео."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama, kısa video akışlarında olduğu gibi tam ekran istemeden çubuklarını gizlediğinde nerede görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nơi ứng dụng này hiển thị khi nó ẩn các thanh mà không yêu cầu toàn màn hình, như một luồng video ngắn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用未请求全屏而只隐藏其栏时（例如短视频信息流）显示的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式未要求全螢幕、只隱藏其列時（例如短影片動態）要在哪裡顯示。"
          }
        }
      }
    },
