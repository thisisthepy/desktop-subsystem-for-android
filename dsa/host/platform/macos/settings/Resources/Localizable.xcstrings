    "LinksCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus: Links aus Android-Apps öffnen sich im Standardbrowser des Mac. Eingeschaltet in einer Android-App, wie am Smartphone.\nEin Link, den eine App als ihren eigenen bestätigt hat, öffnet sich in jedem Fall in dieser App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default: links you tap in Android apps open in the Mac's default browser. On, they open in an Android app, as on a phone.\nA link an app has verified as its own opens in that app either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto: los enlaces de apps de Android se abren en el navegador del Mac. Activado, en una app, como en un móvil.\nUn enlace que una app ha verificado como suyo se abre en esa app en ambos casos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut : les liens des apps Android s'ouvrent dans le navigateur du Mac. Activé, dans une app Android, comme sur un téléphone.\nUn lien qu'une app a vérifié comme le sien s'ouvre dans cette app dans les deux cas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonaktif secara bawaan: tautan di aplikasi Android dibuka di browser bawaan Mac. Jika aktif, dibuka di aplikasi Android, seperti ponsel.\nTautan yang telah diverifikasi aplikasi sebagai miliknya tetap dibuka di aplikasi itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito: disattivato. I link nelle app Android si aprono nel browser predefinito del Mac, o, se attivo, in un'app come sul telefono.\nUn link che un'app ha verificato come proprio si apre comunque in quell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオフで、Android アプリでタップしたリンクは Mac の標準ブラウザで開きます。オンなら、スマホのように Android で開きます。\nアプリが自分のものとして確認済みのリンクは、どちらの場合もそのアプリで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 꺼짐입니다. Android 앱에서 누른 링크가 Mac의 기본 브라우저에서 열립니다. 켜면 휴대폰처럼 Android 앱에서 열립니다.\n설치된 앱이 자기 것으로 확인한 링크는 어느 쪽이든 그 앱에서 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão: links tocados em apps Android abrem no navegador padrão do Mac. Ativado, abrem num app Android, como num celular.\nUm link que um app verificou como seu abre nesse app de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено: ссылки в Android открываются в основном браузере Mac. Если включить, в приложении Android, как на телефоне.\nСсылка, которую приложение подтвердило как свою, в любом случае открывается в нём."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak kapalı: uygulamalardaki bağlantılar Mac'in varsayılan tarayıcısında açılır. Açıkken telefondaki gibi Android'de açılır.\nBir uygulamanın kendisine ait olarak doğruladığı bağlantı her iki durumda da o uygulamada açılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt theo mặc định: liên kết trong ứng dụng Android mở bằng trình duyệt mặc định của Mac. Khi bật, mở bằng ứng dụng Android, như điện thoại.\nLiên kết mà một ứng dụng đã xác minh là của mình luôn mở trong ứng dụng đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭：在 Android 应用中点按的链接会在 Mac 的默认浏览器中打开。开启后，它们会像在手机上一样在 Android 应用中打开。\n应用已验证为其所有的链接，无论哪种设置都会在该应用中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為關閉：您在 Android 應用程式中點選的連結，會在 Mac 的預設瀏覽器中打開。開啟後，會像在手機上一樣於 Android 應用程式中打開。\n應用程式已驗證為自身所有的連結，無論如何都會在該應用程式中打開。"
          }
        }
      }
    },
