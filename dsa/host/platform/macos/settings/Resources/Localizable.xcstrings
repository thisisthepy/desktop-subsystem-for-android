    "Memory_KernelVmallocDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Große Puffer, die der Kernel und seine Treiber reservieren, unter anderem für Grafik. Sie werden frei, wenn sie nicht mehr gebraucht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large buffers the kernel and its drivers set aside, for graphics among others. They are freed when no longer needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Búferes grandes que reservan el kernel y sus controladores, entre otros para gráficos. Se liberan cuando ya no hacen falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grands tampons que le noyau et ses pilotes mettent de côté, entre autres pour l'affichage. Ils sont libérés quand ils ne servent plus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buffer besar yang disisihkan kernel dan drivernya, antara lain untuk grafis. Dilepas saat tidak diperlukan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandi buffer che il kernel e i suoi driver tengono da parte, tra l'altro per la grafica. Vengono liberati quando non servono più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーネルとドライバーが確保する大きなバッファです。グラフィックスなどに使います。不要になると解放されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커널과 드라이버가 따로 잡아 두는 큰 버퍼입니다. 그래픽 등에 씁니다. 필요 없어지면 풀립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Buffers grandes que o kernel e seus drivers reservam, entre outros para gráficos. São liberados quando não são mais necessários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большие буферы, которые выделяют ядро и его драйверы, в том числе для графики. Освобождаются, когда больше не нужны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekirdeğin ve sürücülerinin ayırdığı büyük arabellekler; grafik bunlardan biri. Artık gerekmediğinde serbest kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bộ đệm lớn kernel và trình điều khiển dành riêng, trong đó có cho đồ họa. Được giải phóng khi không còn cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内核及其驱动预留的大块缓冲区，用于图形等。不再需要时释放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核心及其驅動程式預留的大型緩衝區，用於圖形等。不再需要時釋放。"
          }
        }
      }
    },
