    "Memory_CacheDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateiinhalte im Speicher. Android verwirft sie, wenn es den Speicher braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File contents kept in memory. Android drops them when it needs the memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenido de archivos guardado en memoria. Android lo libera cuando necesita la memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu de fichiers gardé en mémoire. Android le libère quand il a besoin de la mémoire."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi file yang disimpan di memori. Android membuangnya saat memerlukan memori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenuti di file tenuti in memoria. Android li scarta quando ha bisogno di memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリに保持しているファイルの内容です。メモリが必要になると Android が破棄します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리에 올려 둔 파일 내용입니다. 메모리가 필요하면 Android가 비웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteúdo de arquivos mantido na memória. O Android o descarta quando precisa da memória."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое файлов в памяти. Android освобождает его, когда нужна память."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bellekte tutulan dosya içerikleri. Android belleğe ihtiyaç duyduğunda bunları bırakır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung tệp được giữ trong bộ nhớ. Android bỏ chúng khi cần bộ nhớ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留在内存中的文件内容。Android 需要内存时会丢弃它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留在記憶體中的檔案內容。Android 需要記憶體時會將其捨棄。"
          }
        }
      }
    },
