    "Apps_RootNotChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The root level of {0} was not changed: {1}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{0}의 루트 수준을 바꾸지 않았습니다: {1}"
          }
