    "ImageUpdatesCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signierte Sicherheitsupdates und neue Android-Versionen laden. Sie gelten beim Neustart von Android, wie unten festgelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download signed security updates and new versions of Android. They apply when Android restarts, as the setting below says."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga actualizaciones de seguridad firmadas y nuevas versiones de Android. Se aplican al reiniciar Android, según el ajuste de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge les mises à jour de sécurité signées et les nouvelles versions d'Android. Elles s'appliquent au redémarrage (voir ci-dessous)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh pembaruan keamanan bertanda tangan dan versi Android baru. Berlaku saat Android dimulai ulang, sesuai pengaturan di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica aggiornamenti di sicurezza firmati e nuove versioni di Android, applicati al riavvio di Android come indicato qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名されたセキュリティ アップデートと Android の新しいバージョンをダウンロードします。下の設定に従って、Android の再起動時に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명된 보안 업데이트와 새 Android 버전을 내려받습니다. 아래 설정에 따라 Android가 다시 시작할 때 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixar atualizações de segurança assinadas e novas versões do Android. Elas valem quando o Android reinicia, conforme o ajuste abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружать подписанные обновления безопасности и новые версии Android. Применяются при перезапуске Android согласно настройке ниже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmzalı güvenlik güncellemelerini ve yeni Android sürümlerini indirin. Aşağıdaki ayara göre Android yeniden başlayınca uygulanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống các bản cập nhật bảo mật có chữ ký và phiên bản Android mới. Chúng được áp dụng khi Android khởi động lại, theo cài đặt bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载签名的安全更新和 Android 新版本。它们会按照下面的设置，在 Android 重新启动时生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載經過簽署的安全性更新與新版 Android。它們會依照下方設定，在 Android 重新啟動時套用。"
          }
        }
      }
    },
