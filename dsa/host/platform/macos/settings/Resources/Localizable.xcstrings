    "Identity_name_Invalid": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie bis zu 32 Buchstaben, Ziffern, '.', '_' oder '-', beginnend mit einem Buchstaben oder einer Ziffer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use up to 32 letters, digits, '.', '_' or '-', starting with a letter or a digit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use hasta 32 letras, dígitos, '.', '_' o '-', empezando por una letra o un dígito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez jusqu'à 32 lettres, chiffres, '.', '_' ou '-', en commençant par une lettre ou un chiffre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan hingga 32 huruf, angka, '.', '_', atau '-', diawali huruf atau angka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa fino a 32 lettere, cifre, '.', '_' o '-', iniziando con una lettera o una cifra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字または数字で始まる、32 文字以内の英字、数字、'.'、'_'、'-' を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영문자나 숫자로 시작하는 32자 이하의 영문자, 숫자, '.', '_', '-'를 쓰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use até 32 letras, dígitos, '.', '_' ou '-', começando com uma letra ou um dígito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте до 32 букв, цифр, '.', '_' или '-', начиная с буквы или цифры."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir harf veya rakamla başlayan, en fazla 32 harf, rakam, '.', '_' veya '-' kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng tối đa 32 chữ cái, chữ số, '.', '_' hoặc '-', bắt đầu bằng chữ cái hoặc chữ số."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用不超过 32 个字母、数字、'.'、'_' 或 '-'，并以字母或数字开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用最多 32 個字母、數字、'.'、'_' 或 '-'，並以字母或數字開頭。"
          }
        }
      }
    },
    "Identity_Reset": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Standardwerte zurückgesetzt. Android verwendet sie ab seinem nächsten Start."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to the defaults. Android uses them from its next start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restablecieron los valores predeterminados. Android los usará desde su próximo inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs par défaut rétablies. Android les utilise dès son prochain démarrage."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke bawaan. Android memakainya sejak dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori predefiniti ripristinati. Android li usa dal prossimo avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトに戻しました。次に Android が起動したときから使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값으로 되돌렸습니다. Android를 다음에 시작할 때부터 씁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores padrão restaurados. O Android os usa a partir da próxima inicialização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановлены значения по умолчанию. Android применит их при следующем запуске."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılanlara dönüldü. Android bunları sonraki açılışından itibaren kullanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã trở về mặc định. Android dùng các giá trị này từ lần khởi động tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢复默认值。Android 将从下次启动时起使用它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢復為預設值。Android 會從下次啟動起使用。"
          }
        }
      }
    },
    "Identity_ResetRestart": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Standardwerte zurückgesetzt. Starten Sie Android neu, um sie jetzt zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
