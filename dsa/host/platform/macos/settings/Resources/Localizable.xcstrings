    "RootNote.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Stufe jeder App auf der Seite „Apps“. Jeder Benutzer wählt für die Apps in seinem eigenen Android."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose each app's level on the Apps page. Each user chooses for the apps in their own Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija el nivel de cada app en la página Apps. Cada usuario elige para las apps de su propio Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le niveau de chaque app dans la page Apps. Chaque utilisateur choisit pour les apps de son propre Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tingkat tiap aplikasi di halaman Aplikasi. Setiap pengguna memilih untuk aplikasi di Android miliknya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il livello di ogni app nella pagina App. Ogni utente sceglie per le app del proprio Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各アプリのレベルは「アプリ」ページで選びます。ユーザーはそれぞれ、自分の Android のアプリについて選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱마다의 수준은 앱 페이지에서 고릅니다. 사용자마다 자기 Android의 앱을 정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o nível de cada app na página Apps. Cada usuário escolhe para os apps do próprio Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровень для каждого приложения выбирается на странице «Приложения». Каждый пользователь выбирает для приложений в своём Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uygulamanın düzeyini Uygulamalar sayfasında seçin. Her kullanıcı kendi Android'indeki uygulamalar için seçer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn mức cho từng ứng dụng trên trang Ứng dụng. Mỗi người dùng chọn cho các ứng dụng trong Android của riêng mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“应用”页面上为每个应用选择级别。每个用户为自己 Android 中的应用进行选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「應用程式」頁面選擇每個應用程式的等級。每位使用者各自為自己 Android 中的應用程式選擇。"
          }
        }
      }
    },
