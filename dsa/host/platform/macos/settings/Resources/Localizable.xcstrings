    "Memory_KernelSlabDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher, den der Kernel für eigene Daten behält und nicht zurückgewinnen kann"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory the kernel keeps for its own data and cannot reclaim"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria que el kernel reserva para sus propios datos y no puede recuperar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoire que le noyau garde pour ses propres données et ne peut pas récupérer"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memori yang disimpan kernel untuk datanya sendiri dan tidak dapat diambil kembali"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria che il kernel tiene per i propri dati e non può recuperare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーネルが自身のデータ用に保持し、回収できないメモリ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커널이 자기 데이터에 쓰고 회수할 수 없는 메모리"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória que o kernel mantém para os próprios dados e não pode recuperar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Память, которую ядро держит для своих данных и не может вернуть"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekirdeğin kendi verileri için tuttuğu ve geri alamadığı bellek"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ kernel giữ cho dữ liệu của chính nó và không thể thu hồi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内核为自身数据保留且无法回收的内存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核心為自身資料保留且無法回收的記憶體"
          }
        }
      }
    },
