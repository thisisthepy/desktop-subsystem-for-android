    "MemoryVmSizeCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher, den die VM auf diesem Mac belegt, und wie viel davon Android nutzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The memory the VM holds on this Mac, and how much of it Android uses"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria que ocupa la máquina virtual en este Mac y cuánta usa Android"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire que la VM occupe sur ce Mac, et la part qu'en utilise Android"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memori yang dipakai VM di Mac ini, dan berapa banyak yang dipakai Android"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria che la VM occupa su questo Mac, e quanta ne usa Android"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VM がこの Mac で確保しているメモリと、そのうち Android が使っている量"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VM이 이 Mac에서 차지한 메모리와 그중 Android가 쓰는 양"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória que a VM ocupa neste Mac e quanto dela o Android usa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Память, которую ВМ занимает на этом Mac, и сколько из неё использует Android"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanal makinenin bu Mac'te tuttuğu bellek ve bunun ne kadarını Android'in kullandığı"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ VM đang giữ trên máy Mac này, và Android dùng bao nhiêu trong đó"
          }
        },
        "zh-Hans": {
          "stringUnit": {
