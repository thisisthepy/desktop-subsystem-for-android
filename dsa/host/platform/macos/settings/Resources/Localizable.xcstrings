          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 조정 수행 주체: 시스템"
          }
        }
      }
    },
    "Apps_DpiScaling_SystemForced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaling performed by: system (forced)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 조정 수행 주체: 시스템(강제)"
          }
        }
      }
    },
    "Apps_DpiScaling_SystemForcedNotYet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaling performed by: system (forced), not available yet"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 조정 수행 주체: 시스템(강제), 아직 사용할 수 없음"
          }
        }
      }
    },
    "Apps_DpiScaling_SystemForcedTip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System (forced) gives the app the new scale without restarting it, even if it does not say it handles one. It is not available yet: it needs a change to Android's framework that this build does not have, so until then it works like System."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템(강제)은 배율 변화를 처리한다고 밝히지 않은 앱에도 재시작 없이 새 배율을 넘깁니다. 아직 사용할 수 없습니다. 이 빌드에 없는 Android 프레임워크 변경이 필요하므로, 그때까지는 시스템처럼 동작합니다."
          }
        }
      }
    },
