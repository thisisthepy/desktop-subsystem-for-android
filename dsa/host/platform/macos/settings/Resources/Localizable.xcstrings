    "Identity_fingerprint_Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\nWenn gesetzt, ist dies Build.FINGERPRINT, unabhängig von den Teilen oben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\nWhen set, it is Build.FINGERPRINT, whatever the parts above say."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\nSi se indica, es Build.FINGERPRINT, digan lo que digan los campos de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\nSi elle est définie, elle devient Build.FINGERPRINT, quelles que soient les parties ci-dessus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\nJika diisi, nilai ini menjadi Build.FINGERPRINT, apa pun isi bagian di atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\nSe impostata, è Build.FINGERPRINT, qualunque cosa dicano le parti sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\n設定すると、上の各項目に関係なく、これが Build.FINGERPRINT になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\n적으면 위의 구성 요소와 상관없이 이것이 Build.FINGERPRINT가 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\nQuando definida, ela é o Build.FINGERPRINT, independentemente das partes acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\nЕсли задан, он становится Build.FINGERPRINT независимо от частей выше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\nAyarlandığında, yukarıdaki parçalar ne derse desin Build.FINGERPRINT budur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\nKhi được đặt, đây là Build.FINGERPRINT, bất kể các phần ở trên là gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\n设置后，无论上面各部分如何，它都会成为 Build.FINGERPRINT。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "brand/name/device:release/id/incremental:type/tags\n設定後，它就是 Build.FINGERPRINT，不論上方各部分的內容為何。"
          }
        }
      }
    },
