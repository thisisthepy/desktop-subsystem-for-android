    "ResetDoneBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste App, die Sie öffnen, startet Android wie nach der ersten Installation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next app you open starts Android as it was first installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima app que abra iniciará Android como recién instalado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine app que vous ouvrez démarre Android tel qu'à sa première installation."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi berikutnya yang Anda buka memulai Android seperti saat pertama diinstal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prossima app che apri avvia Android come appena installato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にアプリを開くと、最初にインストールしたときの状態で Android が起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 앱을 열면 처음 설치했을 때의 Android가 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próximo app que você abrir inicia o Android como recém-instalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующее открытое приложение запустит Android в состоянии после первой установки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açacağınız bir sonraki uygulama, Android'i ilk yüklendiği haliyle başlatır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng tiếp theo bạn mở sẽ khởi động Android như lúc mới cài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您打开的下一个应用会启动处于初次安装状态的 Android。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您下次打開應用程式時，Android 會以初次安裝時的狀態啟動。"
          }
        }
      }
    },
