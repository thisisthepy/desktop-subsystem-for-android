    "AdbAutoConnect_Detached": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit adb disconnect getrennt. Android verbindet sich wieder, wenn der adb-Server neu startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected with adb disconnect. Android connects again when the adb server restarts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado con adb disconnect. Android se vuelve a conectar cuando se reinicia el servidor adb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté par adb disconnect. Android se reconnecte au redémarrage du serveur adb."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diputus dengan adb disconnect. Android terhubung lagi saat server adb dimulai ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scollegato con adb disconnect. Android si ricollega quando il server adb si riavvia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "adb disconnect で切断しました。adb サーバーが再起動すると、Android は再び接続されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "adb disconnect로 끊었습니다. adb 서버가 다시 시작되면 Android가 다시 연결됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado com adb disconnect. O Android se conecta de novo quando o servidor adb reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключено командой adb disconnect. Android подключится снова после перезапуска сервера adb."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "adb disconnect ile bağlantı kesildi. adb sunucusu yeniden başladığında Android tekrar bağlanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ngắt bằng adb disconnect. Android kết nối lại khi máy chủ adb khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过 adb disconnect 断开。adb 服务器重新启动后，Android 会再次连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已透過 adb disconnect 中斷連線。adb 伺服器重新啟動時，Android 會再次連線。"
          }
        }
      }
    },
    "AdbAutoConnect_Off": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung: Der Entwicklermodus oder die automatische Verbindung ist aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not connecting: developer mode or automatic connection is off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión: el modo de desarrollador o la conexión automática están desactivados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion : le mode développeur ou la connexion automatique est désactivé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak menghubungkan: mode pengembang atau koneksi otomatis nonaktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non collegato: la modalità sviluppatore o il collegamento automatico è disattivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続しません: 開発者モードまたは自動接続がオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결하지 않음: 개발자 모드나 자동 연결이 꺼져 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão: o modo de desenvolvedor ou a conexão automática está desativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не подключается: режим разработчика или автоподключение выключены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlanmıyor: geliştirici modu veya otomatik bağlantı kapalı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối: chế độ nhà phát triển hoặc kết nối tự động đang tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接：开发者模式或自动连接已关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未連線：開發人員模式或自動連線已關閉。"
          }
        }
      }
    },
    "AdbAutoConnect_WaitingForAndroid": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Android: Die Verbindung folgt, sobald Android läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for Android: it connects once Android is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a Android: se conecta en cuanto Android esté en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d'Android : la connexion se fait dès qu'Android est en cours d'exécution."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu Android: koneksi dibuat begitu Android berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di Android: si collega appena Android è in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android を待っています: Android が実行されると接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android를 기다리는 중: Android가 실행되면 연결됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando o Android: a conexão acontece assim que o Android estiver em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание Android: подключение произойдёт, как только Android запустится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android bekleniyor: Android çalışmaya başlayınca bağlanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ Android: sẽ kết nối khi Android chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 Android：Android 运行后即会连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 Android：Android 開始執行後就會連線。"
          }
        }
      }
    },
