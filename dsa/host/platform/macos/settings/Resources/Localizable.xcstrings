    "GappsRestartBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android wurde vor dieser Änderung gestartet. Beenden und starten Sie Android, damit Google Play ihr folgt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android started before this change. Stop and start Android for Google Play to follow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android se inició antes de este cambio. Detenga e inicie Android para que Google Play lo aplique."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android a démarré avant ce changement. Arrêtez puis redémarrez Android pour que Google Play en tienne compte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android dimulai sebelum perubahan ini. Hentikan lalu mulai Android agar Google Play mengikutinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android si è avviato prima di questa modifica. Arresta e avvia Android perché Google Play la segua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android はこの変更より前に起動しています。Google Play に反映するには、Android を停止してから起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 이 변경 전에 시작되었습니다. Android를 멈췄다가 다시 시작하면 Google Play에 반영됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android iniciou antes desta alteração. Pare e inicie o Android para que o Google Play a siga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android запущен до этого изменения. Остановите и снова запустите Android, чтобы оно применилось к Google Play."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android bu değişiklikten önce başladı. Google Play'in buna uyması için Android'i durdurup yeniden başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android đã khởi động trước thay đổi này. Hãy dừng rồi khởi động Android để Google Play áp dụng thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 在此更改之前就已启动。停止并重新启动 Android，Google Play 才会采用此更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 在此變更之前就已啟動。請停止並再次啟動 Android，讓 Google Play 套用變更。"
          }
        }
      }
    },
