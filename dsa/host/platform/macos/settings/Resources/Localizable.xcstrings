        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço DSA ainda não tem uma chave de recuperação para o backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У службы DSA пока нет ключа восстановления для резервной копии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA hizmetinde yedek için henüz bir kurtarma anahtarı yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ DSA chưa có khóa khôi phục cho bản sao lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 服务尚无此备份的恢复密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 服務尚未擁有此備份的復原密鑰。"
          }
        }
      }
    },
    "Backup_KeyImported": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wiederherstellungsschlüssel ist gespeichert. Der Sicherungsordner wird jetzt damit gelesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery key is kept. The backup folder is now read with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de recuperación está guardada. Ahora la carpeta de copia de seguridad se lee con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de récupération est conservée. Le dossier de sauvegarde est désormais lu avec elle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci pemulihan disimpan. Folder cadangan kini dibaca dengan kunci itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di recupero è stata conservata. Ora la cartella di backup viene letta con essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーを保存しました。今後はこのキーでバックアップ フォルダを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 키를 저장했습니다. 이제 이 키로 백업 폴더를 읽습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de recuperação foi guardada. A pasta de backup agora é lida com ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ восстановления сохранён. Теперь папка резервных копий читается с его помощью."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma anahtarı saklandı. Yedekleme klasörü artık bu anahtarla okunuyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu khóa khôi phục. Giờ đây thư mục sao lưu được đọc bằng khóa này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复密钥已保存。现在会用它读取备份文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存復原密鑰。現在會用它讀取備份資料夾。"
          }
        }
      }
    },
