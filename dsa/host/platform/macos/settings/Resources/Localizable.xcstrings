    "Identity_brand_Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND und der erste Teil des Fingerprints. Buchstaben, Ziffern, '.', '_' und '-'."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND, and the first part of the fingerprint. Letters, digits, '.', '_' and '-'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND, y la primera parte de la huella digital. Letras, dígitos, '.', '_' y '-'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND, et la première partie de l'empreinte. Lettres, chiffres, '.', '_' et '-'."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND, dan bagian pertama sidik jari. Huruf, angka, '.', '_', dan '-'."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND, e la prima parte dell'impronta. Lettere, cifre, '.', '_' e '-'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND で、フィンガープリントの最初の部分です。英字、数字、'.'、'_'、'-' を使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND이자 지문의 첫 부분입니다. 영문자, 숫자, '.', '_', '-'를 씁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND e a primeira parte da impressão digital. Letras, dígitos, '.', '_' e '-'."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND и первая часть отпечатка. Буквы, цифры, '.', '_' и '-'."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND ve parmak izinin ilk bölümü. Harfler, rakamlar, '.', '_' ve '-'."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND, và phần đầu của dấu vân tay. Chữ cái, chữ số, '.', '_' và '-'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND，也是指纹的第一部分。可使用字母、数字、'.'、'_' 和 '-'。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Build.BRAND，也是指紋的第一部分。可使用字母、數字、'.'、'_' 與 '-'。"
          }
        }
      }
    },
    "Identity_brand_Invalid": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie bis zu 32 Buchstaben, Ziffern, '.', '_' oder '-', beginnend mit einem Buchstaben oder einer Ziffer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use up to 32 letters, digits, '.', '_' or '-', starting with a letter or a digit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use hasta 32 letras, dígitos, '.', '_' o '-', empezando por una letra o un dígito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez jusqu'à 32 lettres, chiffres, '.', '_' ou '-', en commençant par une lettre ou un chiffre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan hingga 32 huruf, angka, '.', '_', atau '-', diawali huruf atau angka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa fino a 32 lettere, cifre, '.', '_' o '-', iniziando con una lettera o una cifra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字または数字で始まる、32 文字以内の英字、数字、'.'、'_'、'-' を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영문자나 숫자로 시작하는 32자 이하의 영문자, 숫자, '.', '_', '-'를 쓰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use até 32 letras, dígitos, '.', '_' ou '-', começando com uma letra ou um dígito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте до 32 букв, цифр, '.', '_' или '-', начиная с буквы или цифры."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir harf veya rakamla başlayan, en fazla 32 harf, rakam, '.', '_' veya '-' kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng tối đa 32 chữ cái, chữ số, '.', '_' hoặc '-', bắt đầu bằng chữ cái hoặc chữ số."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用不超过 32 个字母、数字、'.'、'_' 或 '-'，并以字母或数字开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用最多 32 個字母、數字、'.'、'_' 或 '-'，並以字母或數字開頭。"
          }
        }
      }
    },
