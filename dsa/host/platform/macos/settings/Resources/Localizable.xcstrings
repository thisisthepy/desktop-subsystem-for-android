    "RenderGpuAppliesBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Render-GPU gilt, wenn der Fenstermanager neu startet: bei der nächsten Anmeldung oder wenn Sie ihn unten neu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new render GPU takes effect when the window manager starts again: at the next login, or when you restart it below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nueva GPU de renderizado se aplica cuando el gestor de ventanas se reinicia: al próximo inicio de sesión, o si lo reinicia abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau GPU de rendu s'applique quand le gestionnaire de fenêtres redémarre : à la prochaine connexion, ou via le bouton ci-dessous."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU render baru berlaku saat pengelola jendela dimulai lagi: saat login berikutnya, atau saat Anda memulainya ulang di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nuova GPU di rendering ha effetto al riavvio del gestore delle finestre: al prossimo accesso o quando lo riavvii qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい描画用 GPU は、ウィンドウ マネージャーが再起動したときに有効になります: 次回のログイン時か、下で再起動したときです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바꾼 렌더링 GPU는 창 관리자가 다시 시작할 때 적용됩니다. 다음에 로그인할 때 적용되며, 아래에서 바로 다시 시작할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova GPU de renderização passa a valer quando o gerenciador de janelas iniciar de novo: no próximo login ou ao reiniciá-lo abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый GPU рендеринга начнёт работать после перезапуска диспетчера окон: при следующем входе в систему или после перезапуска ниже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni işleme GPU'su, pencere yöneticisi yeniden başlayınca geçerli olur: sonraki oturum açışta ya da aşağıdan yeniden başlatınca."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU kết xuất mới có hiệu lực khi trình quản lý cửa sổ khởi động lại: lần đăng nhập tới, hoặc khi bạn khởi động lại nó bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的渲染 GPU 会在窗口管理器再次启动时生效：下次登录时，或在下面重新启动它时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新的繪製 GPU 會在視窗管理程式再次啟動時生效：也就是下次登入時，或您在下方將它重新啟動時。"
          }
        }
      }
    },
    "RenderGpuCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die GPU, die Android-Apps zeichnet. Standardmäßig ist es die GPU des Hauptdisplays, sodass Frames nie zwischen GPUs wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The GPU that draws Android apps. By default it is the one that drives the main display, so frames never cross between GPUs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La GPU que dibuja las apps de Android. Por defecto, la de la pantalla principal, para que los fotogramas no pasen entre GPU."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPU qui dessine les apps Android. Par défaut, c'est celui qui pilote l'écran principal : les images ne changent jamais de GPU."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU yang menggambar aplikasi Android. Secara bawaan, GPU yang menjalankan layar utama, jadi frame tidak pernah berpindah antar-GPU."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La GPU che disegna le app Android. Di norma è quella che gestisce il monitor principale, così i fotogrammi non cambiano mai GPU."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android アプリを描画する GPU です。デフォルトではメインディスプレイを駆動する GPU なので、フレームが GPU 間を移動することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 앱을 그리는 GPU입니다. 기본값은 주 디스플레이를 구동하는 GPU입니다. 그래서 프레임이 GPU 사이를 건너지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A GPU que desenha os apps Android. Por padrão, é a que controla o monitor principal, então os quadros nunca trocam de GPU."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU, рисующий приложения Android. По умолчанию это GPU основного дисплея, и кадры не передаются между GPU."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android uygulamalarını çizen GPU. Varsayılan olarak ana ekranı süren GPU'dur, böylece kareler hiçbir zaman GPU'lar arasında geçmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU vẽ các ứng dụng Android. Theo mặc định, đó là GPU điều khiển màn hình chính, nên khung hình không bao giờ chuyển giữa các GPU."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制 Android 应用的 GPU。默认是驱动主显示器的 GPU，因此帧不会在 GPU 之间传递。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪製 Android 應用程式的 GPU。預設是驅動主顯示器的 GPU，因此畫面影格永遠不會在 GPU 之間傳遞。"
          }
        }
      }
    },
