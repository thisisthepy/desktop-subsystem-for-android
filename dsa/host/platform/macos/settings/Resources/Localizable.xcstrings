    "DiagnosticsNote.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Traces landen in den DSA-Protokollen unten und vergrößern sie, schalten Sie sie also nur ein, um ein Problem zu melden.\nNur ein Administrator kann sie ändern, weil sie für alle Benutzer dieses Mac gelten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The traces go to the DSA logs below and make them grow, so turn them on only to report a problem.\nOnly an administrator can change them, because they apply to every user of this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los seguimientos van a los registros de DSA de abajo y los hacen crecer, así que actívelos solo para informar de un problema.\nSolo un administrador puede cambiarlos, porque se aplican a todos los usuarios de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les traces vont dans les journaux DSA ci-dessous et les font grossir : activez-les seulement pour signaler un problème.\nSeul un administrateur peut les modifier, car elles s'appliquent à tous les utilisateurs de ce Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejak ini masuk ke log DSA di bawah dan membuatnya membesar, jadi aktifkan hanya untuk melaporkan masalah.\nHanya administrator yang dapat mengubahnya, karena berlaku untuk setiap pengguna Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tracce finiscono nei log di DSA qui sotto e li fanno crescere, quindi attivale solo per segnalare un problema.\nSolo un amministratore può modificarle, perché valgono per tutti gli utenti di questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレースは下の DSA のログに書き込まれてログが大きくなるため、問題を報告するときだけオンにしてください。\nこの Mac のすべてのユーザーに適用されるため、変更できるのは管理者だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적은 아래의 DSA 로그에 쌓여 로그를 키우므로, 문제를 알릴 때만 켜세요.\n이 Mac의 모든 사용자에게 적용되므로 관리자만 바꿀 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os rastreamentos vão para os logs do DSA abaixo e os fazem crescer, então ative-os só para relatar um problema.\nSó um administrador pode alterá-los, porque valem para todos os usuários deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трассировки пишутся в журналы DSA ниже и увеличивают их, поэтому включайте их только для отчёта о проблеме.\nИзменить их может только администратор, так как они действуют для всех пользователей этого Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzler aşağıdaki DSA günlüklerine yazılır ve onları büyütür, bu yüzden yalnızca bir sorunu bildirmek için açın.\nBu Mac'in tüm kullanıcılarına uygulandıkları için yalnızca bir yönetici bunları değiştirebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản theo dõi được ghi vào nhật ký DSA bên dưới và làm nhật ký lớn lên, nên chỉ bật khi cần báo cáo sự cố.\nChỉ quản trị viên mới thay đổi được, vì chúng áp dụng cho mọi người dùng của máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟踪记录会写入下面的 DSA 日志并使其增大，因此只在报告问题时开启。\n只有管理员可以更改它们，因为它们适用于这台 Mac 的所有用户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "追蹤資料會寫入下方的 DSA 記錄並使記錄變大，因此請只在回報問題時開啟。\n由於它們會套用到此 Mac 的所有使用者，因此只有管理者可以變更。"
          }
        }
      }
    },
    "DisplayGpuCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worauf die Standardauswahl derzeit rendert."
