    "ResetDataCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht Ihre Apps, Konten und die Daten aller Apps, sodass Android wie nach der ersten Installation startet.\nDas Android-Abbild und diese Einstellungen bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erases your apps, accounts and every app's data, so Android starts as it was first installed.\nThe Android image and these settings stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra sus apps, sus cuentas y los datos de cada app, para que Android se inicie como recién instalado.\nLa imagen de Android y estos ajustes se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface vos apps, vos comptes et les données de chaque app : Android démarre comme à sa première installation.\nL'image Android et ces réglages sont conservés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus aplikasi, akun, dan data setiap aplikasi Anda, sehingga Android dimulai seperti saat pertama diinstal.\nImage Android dan pengaturan ini tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella le tue app, gli account e i dati di ogni app, così Android riparte come appena installato.\nL'immagine Android e queste impostazioni restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ、アカウント、すべてのアプリのデータを消去し、Android を最初にインストールしたときの状態に戻します。\nAndroid イメージとこれらの設定は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치한 앱, 계정, 모든 앱의 데이터를 지워 Android를 처음 설치한 상태로 되돌립니다.\nAndroid 이미지와 이 설정은 그대로 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga seus apps, contas e os dados de todos os apps, para que o Android inicie como recém-instalado.\nA imagem do Android e estes ajustes são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стирает ваши приложения, учётные записи и данные всех приложений, и Android запускается как после первой установки.\nОбраз Android и эти настройки сохраняются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalarınızı, hesaplarınızı ve tüm uygulamaların verilerini siler; Android ilk yüklendiği haliyle başlar.\nAndroid görüntüsü ve bu ayarlar korunur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa ứng dụng, tài khoản và dữ liệu của mọi ứng dụng, để Android khởi động như lúc mới cài.\nẢnh Android và các cài đặt này vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除您的应用、账号和每个应用的数据，使 Android 以初次安装时的状态启动。\nAndroid 映像和这些设置会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除您的應用程式、帳號與所有應用程式的資料，讓 Android 以初次安裝時的狀態啟動。\nAndroid 映像與這些設定會保留。"
          }
        }
      }
    },
    "ResetDataCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-Daten zurücksetzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Android's data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer los datos de Android"
          }
        },
