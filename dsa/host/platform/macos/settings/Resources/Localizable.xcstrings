    "Elevation_Prompt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA Settings möchte eine Einstellung ändern, die für alle Benutzer dieses Mac gilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA Settings wants to change a setting that applies to every user of this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes de DSA quiere cambiar un ajuste que se aplica a todos los usuarios de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA Settings veut modifier un réglage qui s'applique à tous les utilisateurs de ce Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan DSA ingin mengubah pengaturan yang berlaku untuk setiap pengguna Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni DSA vuole modificare un'impostazione che vale per tutti gli utenti di questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA Settings が、この Mac のすべてのユーザーに適用される設定を変更しようとしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 설정이 이 Mac의 모든 사용자에게 적용되는 설정을 바꾸려고 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Ajustes do DSA querem alterar um ajuste que vale para todos os usuários deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «Настройки DSA» пытается изменить настройку, которая действует для всех пользователей этого Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA Ayarları, bu Mac'in tüm kullanıcılarına uygulanan bir ayarı değiştirmek istiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt DSA muốn thay đổi một cài đặt áp dụng cho mọi người dùng của máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA Settings 想要更改一项适用于这台 Mac 所有用户的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DSA 設定想要變更一項會套用到此 Mac 所有使用者的設定。"
          }
        }
      }
    },
    "ElevationDeclined": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellung wurde nicht geändert, weil keine Administratorrechte erteilt wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The setting was not changed, because administrator rights were not given."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se cambió el ajuste, porque no se concedieron permisos de administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage n'a pas été modifié, car les droits d'administrateur n'ont pas été accordés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan tidak diubah, karena hak administrator tidak diberikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'impostazione non è stata modificata, perché i privilegi di amministratore non sono stati concessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者権限が与えられなかったため、設定は変更されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 권한을 받지 못해 설정을 바꾸지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ajuste não foi alterado porque os direitos de administrador não foram concedidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка не изменена: права администратора не предоставлены."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yönetici izinleri verilmediği için ayar değiştirilmedi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt chưa được thay đổi vì không được cấp quyền quản trị viên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置未更改，因为未获得管理员权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定未變更，因為未取得管理者權限。"
          }
        }
      }
    },
    "FileSharingCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig ein. Die Ordner unten erscheinen im gemeinsamen Android-Speicher unter Host, wo Android-Apps Dateien öffnen und sichern.\nApps benötigen die Speicherberechtigung von Android, und macOS erlaubt ihnen nur, was Ihr Benutzerkonto darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default. The folders chosen below appear in Android's shared storage, in Host, for Android apps to open and save files.\nApps need Android's storage permission, and macOS lets them do only what your account may do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado por defecto. Las carpetas elegidas aparecen en Host, en el almacenamiento compartido de Android, para que las apps las usen.\nLas apps necesitan el permiso de almacenamiento de Android, y macOS solo les permite lo que su cuenta puede hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé par défaut. Les dossiers choisis figurent dans Host (stockage partagé d'Android) : les apps y lisent et écrivent des fichiers.\nLes apps ont besoin de l'autorisation de stockage d'Android, et macOS ne leur permet que ce que votre compte peut faire."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif secara bawaan. Folder pilihan di bawah muncul di Host, dalam penyimpanan bersama Android, tempat aplikasi membuka dan menyimpan file.\nAplikasi memerlukan izin penyimpanan Android, dan macOS hanya mengizinkan yang boleh dilakukan akun Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito: attivo. Le cartelle scelte sotto appaiono in Host, nell'archivio condiviso di Android, dove le app aprono e salvano file.\nLe app richiedono l'autorizzazione di archiviazione di Android, e macOS consente loro solo ciò che il tuo account può fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオンです。下で選んだフォルダが Android の共有ストレージの Host に表示され、Android アプリがファイルを開いて保存できます。\nアプリには Android のストレージの権限が必要で、macOS はあなたのアカウントに許されたことだけを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 켜짐입니다. 아래에서 고른 폴더가 Android 공유 저장소의 Host 폴더에 보여, Android 앱이 파일을 열고 저장합니다.\n앱에는 Android의 저장소 권한이 필요하고, macOS는 내 계정이 할 수 있는 일만 허락합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por padrão. As pastas abaixo aparecem em Host, no armazenamento compartilhado do Android, para apps abrirem e salvarem arquivos.\nOs apps precisam da permissão de armazenamento do Android, e o macOS só os deixa fazer o que a sua conta pode fazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию включено. Выбранные ниже папки видны в общем хранилище Android, в Host: приложения открывают и сохраняют в них файлы.\nПриложениям нужно разрешение Android на доступ к хранилищу, а macOS разрешает им лишь то, что может ваша учётная запись."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak açık. Aşağıdaki klasörler Android'in paylaşılan depolamasında Host altında görünür; uygulamalar dosya açıp kaydedebilir.\nUygulamalar Android'in depolama iznine ihtiyaç duyar ve macOS yalnızca hesabınızın yapabileceklerine izin verir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật theo mặc định. Các thư mục chọn dưới đây hiện trong bộ nhớ dùng chung của Android, ở Host, để ứng dụng Android mở và lưu tệp.\nỨng dụng cần quyền bộ nhớ của Android, và macOS chỉ cho phép chúng làm những gì tài khoản của bạn được phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认开启。下面选择的文件夹会出现在 Android 共享存储的 Host 中，供 Android 应用打开和保存文件。\n应用需要 Android 的存储权限，而且 macOS 只允许它们做您的账户可以做的事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為開啟。下方選擇的資料夾會出現在 Android 共用儲存空間的 Host 中，讓 Android 應用程式打開及儲存檔案。\n應用程式需要 Android 的儲存空間權限，而 macOS 只允許它們做您的帳號可以做的事。"
          }
        }
      }
    },
