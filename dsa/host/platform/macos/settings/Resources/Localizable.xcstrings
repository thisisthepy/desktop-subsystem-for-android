    "Arm_NotRunning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android läuft nicht, daher ist nicht bekannt, was es derzeit unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android is not running, so what it supports now is not known."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no está en ejecución, así que no se sabe qué admite ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android n'est pas en cours d'exécution : ce qu'il prend en charge actuellement est inconnu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android tidak berjalan, jadi dukungannya saat ini tidak diketahui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non è in esecuzione, quindi non si sa che cosa supporta ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android が実行されていないため、現在の対応状況はわかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 실행 중이 아니어서 지금 지원하는 것을 알 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android não está em execução, por isso não se sabe o que ele suporta agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android не запущен, поэтому неизвестно, что он поддерживает сейчас."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android çalışmıyor, bu yüzden şu an neyi desteklediği bilinmiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android không chạy, nên chưa biết hiện nó hỗ trợ những gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 未运行，因此无法得知它当前支持什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 未在執行，因此無法得知它目前支援哪些項目。"
          }
        }
      }
    },
