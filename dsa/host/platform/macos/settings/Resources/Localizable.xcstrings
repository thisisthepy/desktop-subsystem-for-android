    "MemoryLimitCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viel Speicher Android höchstens belegen darf. Android nimmt Speicher nach Bedarf und gibt ungenutzten zurück.\nAutomatisch endet bei der Hälfte des Speichers dieses Mac. Eine Änderung gilt beim nächsten Start von Android."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most memory Android may grow to. Android takes memory as it needs it and returns it when it no longer does.\nAutomatic stops at half of this Mac's memory. A change applies at the next start of Android."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria máxima que puede llegar a usar Android. Android toma memoria según la necesita y la devuelve cuando ya no la necesita.\nAutomático llega como máximo a la mitad de la memoria de este Mac. Un cambio se aplica en el próximo inicio de Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire maximale que peut atteindre Android. Android prend de la mémoire selon ses besoins et la rend quand il n'en a plus besoin.\nAutomatique s'arrête à la moitié de la mémoire de ce Mac. Un changement s'applique au prochain démarrage d'Android."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memori maksimum yang dapat dipakai Android. Android mengambil memori sesuai kebutuhan dan mengembalikannya saat tidak lagi diperlukan.\nOtomatis berhenti di separuh memori Mac ini. Perubahan berlaku saat Android dimulai lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria massima che Android può raggiungere. Android prende memoria quando ne ha bisogno e la restituisce quando non serve più.\nAutomatico si ferma a metà della memoria di questo Mac. Una modifica si applica al prossimo avvio di Android."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android が使えるメモリの上限です。Android は必要なときにメモリを使い、不要になると返します。\n「自動」はこの Mac のメモリの半分までです。変更は次に Android が起動したときに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android가 늘어날 수 있는 최대 메모리입니다. Android는 필요한 만큼만 쓰고, 필요 없으면 바로 돌려줍니다.\n자동이면 이 Mac 메모리의 절반까지입니다. 바꾸면 다음에 Android를 시작할 때 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O máximo de memória que o Android pode alcançar. O Android pega memória conforme precisa e a devolve quando não precisa mais.\nAutomático para na metade da memória deste Mac. Uma alteração vale na próxima inicialização do Android."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предел, до которого может расти память Android. Android берёт память по мере надобности и возвращает её, когда она не нужна.\nАвтоматически: не больше половины памяти этого Mac. Изменение применится при следующем запуске Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android'in büyüyebileceği en fazla bellek. Android belleği gerektikçe alır ve artık gerekmediğinde geri verir.\nOtomatik, bu Mac'in belleğinin yarısında durur. Değişiklik Android'in sonraki açılışında uygulanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượng bộ nhớ tối đa Android có thể dùng. Android lấy bộ nhớ khi cần và trả lại khi không còn cần.\nTự động dừng ở một nửa bộ nhớ của máy Mac này. Thay đổi được áp dụng ở lần khởi động Android tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 最多可增长到的内存。Android 按需占用内存，不再需要时就归还。\n“自动”最多使用这台 Mac 内存的一半。更改会在 Android 下次启动时生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 最多可使用的記憶體。Android 會依需要取用記憶體，不再需要時就歸還。\n「自動」最多使用此 Mac 記憶體的一半。變更會在 Android 下次啟動時套用。"
          }
        }
      }
    },
