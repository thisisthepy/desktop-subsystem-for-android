    "Memory_KernelPageTablesDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tabellen, die dem Prozessor zeigen, wo der Speicher jeder App im RAM liegt. Sie schrumpfen, wenn Apps geschlossen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The maps that tell the processor where each app's memory is in RAM. They shrink as apps close."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mapas que indican al procesador dónde está en la RAM la memoria de cada app. Se reducen al cerrar apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tables qui indiquent au processeur où se trouve en RAM la mémoire de chaque appli. Elles diminuent quand des applis se ferment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peta yang memberi tahu prosesor letak memori setiap aplikasi di RAM. Mengecil saat aplikasi ditutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tabelle che dicono al processore dove si trova nella RAM la memoria di ogni app. Si riducono quando le app si chiudono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各アプリのメモリが RAM のどこにあるかをプロセッサーに伝える対応表です。アプリを閉じると減ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 앱의 메모리가 RAM의 어디에 있는지 프로세서에 알려 주는 지도입니다. 앱을 닫으면 줄어듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os mapas que dizem ao processador onde a memória de cada app está na RAM. Diminuem quando apps fecham."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблицы, по которым процессор находит память каждого приложения в ОЗУ. Уменьшаются, когда приложения закрываются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemciye her uygulamanın belleğinin RAM'de nerede olduğunu söyleyen tablolar. Uygulamalar kapandıkça küçülür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bảng cho bộ xử lý biết bộ nhớ của mỗi ứng dụng nằm ở đâu trong RAM. Giảm khi đóng ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉处理器每个应用的内存位于内存条何处的映射表。关闭应用后会减少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴處理器每個應用程式的記憶體位於 RAM 何處的對應表。關閉應用程式後會減少。"
          }
        }
      }
    },
