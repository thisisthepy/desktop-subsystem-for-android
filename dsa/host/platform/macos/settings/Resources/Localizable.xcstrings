    "RootElevationAdminReason.Text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an administrator can change this, because it applies to every user of this Mac. Use Change as administrator, and macOS asks for an administrator's password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 모든 사용자에게 적용되므로 관리자만 바꿀 수 있습니다. 관리자 권한으로 변경을 누르면 macOS가 관리자 암호를 묻습니다."
          }
        }
      }
    },
    "RootElevationCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An app you allow on the Apps page can run commands as root once an administrator of this Mac approves, as sudo does. Off by default. The Android image, its build properties and SELinux stay as they are."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 페이지에서 허용한 앱은 이 Mac의 관리자가 승인하면 루트로 명령을 실행할 수 있습니다. sudo와 같은 방식입니다. 기본은 끔입니다. Android 이미지, 빌드 속성, SELinux는 그대로입니다."
          }
        }
      }
    },
