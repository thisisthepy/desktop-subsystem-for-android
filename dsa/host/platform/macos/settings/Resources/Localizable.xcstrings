    "AppsBelowTitleBar.Content": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter der Titelleiste beginnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start below the title bar"
          }
        },
        "es": {
          "stringUnit": {
