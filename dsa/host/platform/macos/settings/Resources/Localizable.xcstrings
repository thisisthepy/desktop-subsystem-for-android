    "AdbAutoConnectCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig ein. Bei aktivem Entwicklermodus erscheint Android ohne adb connect in adb devices und Android Studio.\nNach adb disconnect bleibt die Verbindung getrennt, bis der adb-Server neu startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default. While developer mode is on, Android shows up in adb devices and Android Studio without adb connect.\nAfter adb disconnect, it stays off until the adb server restarts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado por defecto. Con el modo de desarrollador activo, Android aparece en adb devices y en Android Studio sin adb connect.\nTras adb disconnect, no se vuelve a conectar hasta que se reinicie el servidor adb."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé par défaut. Tant que le mode développeur est activé, Android apparaît dans adb devices et Android Studio sans adb connect.\nAprès adb disconnect, la connexion reste coupée jusqu'au redémarrage du serveur adb."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif secara bawaan. Selama mode pengembang aktif, Android muncul di adb devices dan Android Studio tanpa adb connect.\nSetelah adb disconnect, koneksi tetap mati sampai server adb dimulai ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito: attivo. Con la modalità sviluppatore attiva, Android compare in adb devices e in Android Studio senza adb connect.\nDopo adb disconnect, resta scollegato finché il server adb non si riavvia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオンです。開発者モードがオンの間は、adb connect を使わなくても adb devices と Android Studio に Android が表示されます。\nadb disconnect で切断すると、adb サーバーが再起動するまで接続しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 켜짐입니다. 개발자 모드가 켜져 있으면 adb connect 없이도 adb devices와 Android Studio에 Android가 나타납니다.\nadb disconnect로 끊으면 adb 서버가 다시 시작될 때까지 연결하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por padrão. Com o modo de desenvolvedor ativado, o Android aparece em adb devices e no Android Studio sem adb connect.\nApós adb disconnect, ele fica desconectado até o servidor adb reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию включено. Пока включён режим разработчика, Android виден в adb devices и Android Studio без adb connect.\nПосле adb disconnect подключение не выполняется до перезапуска сервера adb."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak açık. Geliştirici modu açıkken Android, adb connect olmadan adb devices ve Android Studio'da görünür.\nadb disconnect sonrasında adb sunucusu yeniden başlayana kadar kapalı kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật theo mặc định. Khi chế độ nhà phát triển bật, Android xuất hiện trong adb devices và Android Studio mà không cần adb connect.\nSau adb disconnect, tính năng này tắt cho đến khi máy chủ adb khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认开启。开发者模式开启时，无需 adb connect，Android 就会出现在 adb devices 和 Android Studio 中。\n执行 adb disconnect 后，它会保持断开，直到 adb 服务器重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為開啟。開發人員模式開啟時，不必執行 adb connect，Android 就會出現在 adb devices 與 Android Studio 中。\n執行 adb disconnect 後，會保持中斷，直到 adb 伺服器重新啟動。"
          }
        }
      }
    },
