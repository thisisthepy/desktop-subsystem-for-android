          "stringUnit": {
            "state": "translated",
            "value": "Use de 1 a 64 caracteres ASCII imprimibles, sin espacios al principio ni al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez de 1 à 64 caractères ASCII imprimables, sans espace au début ni à la fin."
          }
