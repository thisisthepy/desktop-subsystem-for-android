    "Memory_FreeDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher, den gerade nichts nutzt. Android gibt ihn an den PC zurück, er belegt also keinen RAM des PCs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory nothing uses right now. Android hands it back to the PC, so it does not take up the PC's RAM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria que nada usa ahora. Android la devuelve al PC, así que no ocupa la RAM del PC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoire que rien n'utilise pour l'instant. Android la rend au PC, elle n'occupe donc pas sa RAM."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memori yang saat ini tidak dipakai apa pun. Android mengembalikannya ke PC, jadi tidak memakan RAM PC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria che al momento nulla usa. Android la restituisce al PC, quindi non occupa la RAM del PC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は何も使っていないメモリです。Android が PC に返すので、PC の RAM を占めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 아무것도 쓰지 않는 메모리입니다. Android가 PC에 돌려주므로 PC의 RAM을 차지하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória que nada está usando agora. O Android a devolve ao PC, então ela não ocupa a RAM do PC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Память, которую сейчас ничто не использует. Android возвращает её компьютеру, поэтому она не занимает его оперативную память."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda hiçbir şeyin kullanmadığı bellek. Android onu bilgisayara geri verir, bu yüzden bilgisayarın RAM'ini kaplamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ hiện không có gì dùng. Android trả lại cho PC, nên nó không chiếm RAM của PC."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有任何东西在用的内存。Android 会把它还给电脑，因此不占用电脑的内存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有任何東西在用的記憶體。Android 會把它還給電腦，因此不佔用電腦的記憶體。"
          }
        }
      }
    },
