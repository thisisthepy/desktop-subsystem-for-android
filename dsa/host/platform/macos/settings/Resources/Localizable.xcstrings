    "FreezeNowCard.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält alle Prozesse in Android an, bis Sie eines seiner Fenster wieder öffnen. Mitteilungen, Alarme und Widgets halten mit an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops every process in Android until you open one of its windows again. Notifications, alarms and widgets stop with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene cada proceso de Android hasta que vuelva a abrir una de sus ventanas. Notificaciones, alarmas y widgets se detienen con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête tous les processus d'Android jusqu'à ce que vous rouvriez une de ses fenêtres. Notifications, alarmes et widgets s'arrêtent aussi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan setiap proses di Android sampai Anda membuka lagi salah satu jendelanya. Pemberitahuan, alarm, dan widget ikut berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arresta ogni processo di Android finché non riapri una delle sue finestre. Notifiche, sveglie e widget si fermano con esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android のウィンドウをもう一度開くまで、Android のすべてのプロセスを停止します。通知、アラーム、ウィジェットも停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android의 창을 다시 열 때까지 모든 프로세스를 멈춥니다. 알림, 알람, 위젯도 함께 멈춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para todos os processos do Android até você abrir uma das janelas dele de novo. Notificações, alarmes e widgets param junto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Останавливает все процессы в Android, пока вы снова не откроете одно из его окон. Уведомления, будильники и виджеты тоже замрут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencerelerinden birini yeniden açana kadar Android'deki tüm işlemleri durdurur. Bildirimler, alarmlar ve widget'lar da onunla durur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng mọi tiến trình trong Android cho đến khi bạn mở lại một cửa sổ của nó. Thông báo, báo thức và widget cũng dừng theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止 Android 中的所有进程，直到您再次打开它的某个窗口。通知、闹钟和小部件也会随之停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止 Android 中的所有程序，直到您再次打開它的任一視窗。通知、鬧鐘與小工具也會一併停止。"
          }
        }
      }
    },
