        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang Android mới hơn?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要切换到较新的 Android 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要改用較新的 Android 嗎？"
          }
        }
      }
    },
    "Android_UpToDate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Android-Update steht aus. DSA prüft täglich und startet Android in ein Update neu, sobald kein App-Fenster geöffnet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Android update is waiting. DSA checks every day, and restarts Android into an update once no app window is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay actualizaciones de Android pendientes. DSA busca a diario y, sin ventanas de apps abiertas, reinicia Android para actualizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune mise à jour en attente. DSA vérifie chaque jour et redémarre Android pour l'appliquer dès qu'aucune fenêtre d'app n'est ouverte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pembaruan Android yang menunggu. DSA memeriksa tiap hari dan memulai ulang Android ke pembaruan saat tak ada jendela terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun aggiornamento Android in attesa. DSA controlla ogni giorno e riavvia Android per aggiornarlo quando nessuna app ha finestre aperte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中の Android アップデートはありません。DSA は毎日確認し、アプリのウィンドウがないときに Android を再起動して適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기다리는 Android 업데이트가 없습니다. DSA가 매일 확인하며, 열린 앱 창이 없을 때 Android를 다시 시작해 업데이트를 적용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma atualização do Android pendente. O DSA verifica todo dia e reinicia o Android com a atualização quando não há janela de app aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновлений Android нет. DSA проверяет их ежедневно и перезапускает Android с обновлением, когда окна приложений закрыты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen Android güncellemesi yok. DSA her gün denetler ve açık uygulama penceresi kalmayınca Android'i güncellemeyle yeniden başlatır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có bản cập nhật Android đang chờ. DSA kiểm tra hằng ngày, và khởi động lại Android để cập nhật khi không có cửa sổ ứng dụng mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有待安装的 Android 更新。DSA 每天检查一次，并在没有打开的应用窗口时重新启动 Android 以应用更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有等待中的 Android 更新。DSA 每天都會檢查，並在沒有開啟的應用程式視窗時重新啟動 Android 以套用更新。"
          }
        }
      }
    },
    "AppsRoot.Name": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Root-Zugriff"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso root"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès root"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses root"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso root"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "root 権限"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루트 권한"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso root"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Root-доступ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kök erişimi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền root"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "root 访问权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "root 存取權"
          }
        }
      }
    },
    "AppsRootNote.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Root-Zugriff für jede App:\n• Nicht erlaubt: Die App sieht su nicht.\n• Jedes Mal fragen: Jede Anfrage zeigt eine Administratorabfrage mit dem App-Namen. Nach Zustimmung wird 15 Minuten lang nicht gefragt.\n• Merken: Stimmt ohne Nachfrage zu, daher erfordert diese Wahl einen Administrator."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root access for each app:\n• Not allowed: the app cannot see su.\n• Ask each time: each request shows an administrator prompt naming the app. After an approval, it is not asked again for 15 minutes.\n• Remember: approves without asking, so choosing it needs an administrator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso root de cada app:\n• No permitido: la app no puede ver su.\n• Preguntar cada vez: cada solicitud abre un aviso de administrador que nombra la app. Tras aprobarla, no se repite en 15 minutos.\n• Recordar: aprueba sin preguntar, así que elegirlo requiere un administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès root pour chaque app :\n• Non autorisé : l'app ne voit pas su.\n• Demander à chaque fois : chaque demande ouvre une invite d'administrateur nommant l'app. Après accord, aucune pendant 15 minutes.\n• Mémoriser : approuve sans demander, donc ce choix nécessite un administrateur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses root untuk setiap aplikasi:\n• Tidak diizinkan: aplikasi tidak dapat melihat su.\n• Tanya setiap kali: tiap permintaan menampilkan prompt administrator berisi nama aplikasi. Setelah disetujui, 15 menit tak ditanya lagi.\n• Ingat: menyetujui tanpa bertanya, jadi memilihnya memerlukan administrator."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso root per ogni app:\n• Non consentito: l'app non vede su.\n• Chiedi ogni volta: ogni richiesta chiede a un amministratore, nominando l'app. Dopo l'approvazione, non chiede di nuovo per 15 minuti.\n• Ricorda: approva senza chiedere, quindi per sceglierlo serve un amministratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとの root 権限:\n• 許可しない: アプリから su が見えません。\n• 毎回確認: 要求のたびに、アプリ名を示した管理者の確認が表示されます。承認後 15 分間は再び確認しません。\n• 記憶: 確認せずに承認するため、選ぶには管理者が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱마다 루트 권한을 고릅니다.\n• 요청 불가: 앱에 su가 보이지 않습니다.\n• 요청할 때 묻기: 요청마다 앱 이름이 적힌 관리자 승인 창이 뜹니다. 승인한 뒤 15분 동안은 다시 묻지 않습니다.\n• 기억: 묻지 않고 승인하므로, 고르려면 관리자 승인이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso root de cada app:\n• Não permitido: o app não vê o su.\n• Perguntar sempre: cada pedido abre um aviso de administrador com o nome do app. Após aprovar, não pergunta de novo por 15 minutos.\n• Lembrar: aprova sem perguntar, por isso escolhê-lo exige um administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Root-доступ для каждого приложения:\n• Запрещено: приложение не видит su.\n• Спрашивать каждый раз: на каждый запрос появляется окно администратора с именем приложения. Одобрение действует 15 минут.\n• Запомнить: одобряет без вопросов, поэтому для выбора нужен администратор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uygulama için kök erişimi:\n• İzin verilmiyor: uygulama su'yu göremez.\n• Her seferinde sor: her istek, uygulamanın adını gösteren bir yönetici istemi açar. Onaydan sonra 15 dakika boyunca tekrar sorulmaz.\n• Hatırla: sormadan onaylar, bu yüzden bunu seçmek için yönetici gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền root cho từng ứng dụng:\n• Không cho phép: ứng dụng không thấy su.\n• Hỏi mỗi lần: mỗi yêu cầu hiện lời nhắc quản trị viên ghi tên ứng dụng. Sau khi chấp thuận, sẽ không hỏi lại trong 15 phút.\n• Ghi nhớ: chấp thuận mà không hỏi, nên cần quản trị viên để chọn mục này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个应用的 root 访问权限：\n• 不允许：应用看不到 su。\n• 每次询问：每个请求都会显示注明该应用的管理员提示。批准后，15 分钟内不会再次询问。\n• 记住：不经询问直接批准，因此选择它需要管理员权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個應用程式的 root 存取權：\n• 不允許：應用程式看不到 su。\n• 每次詢問：每次要求都會顯示註明該應用程式的管理者提示。核准後，15 分鐘內不會再次詢問。\n• 記住：不經詢問直接核准，因此選擇此項需要管理者。"
          }
        }
      }
    },
    "AppsRootOffBar.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine App kann su nutzen. Ein Administrator dieses Mac aktiviert Root-Zugriff in „Erweitert“, dann wählen Sie hier die Stufe pro App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app can use su. An administrator of this Mac can turn root access on in Advanced, and then you choose each app's level here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna app puede usar su. Un administrador del Mac puede activar el acceso root en Avanzado; luego elija aquí el nivel de cada app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app ne peut utiliser su. Un administrateur de ce Mac peut activer l'accès root dans Avancé, puis vous réglez ici chaque app."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak ada aplikasi yang bisa memakai su. Administrator Mac ini dapat mengaktifkan root di Lanjutan; lalu pilih tingkat tiap aplikasi di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna app può usare su. Un amministratore di questo Mac può attivare l'accesso root in Avanzate, poi qui scegli il livello di ogni app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリも su を使えません。この Mac の管理者が「詳細」で root 権限をオンにすると、ここでアプリごとのレベルを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 앱도 su를 쓸 수 없습니다. 이 Mac의 관리자가 고급 페이지에서 루트 권한을 켜면, 여기서 앱마다 수준을 고를 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app pode usar su. Um administrador deste Mac pode ativar o acesso root em Avançado, e então você escolhe o nível de cada app aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "su недоступен приложениям. Root-доступ включает администратор этого Mac в разделе «Дополнительно», затем уровни выбираются здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir uygulama su kullanamaz. Bu Mac'in yöneticisi kök erişimini Gelişmiş'te açabilir, sonra her uygulamanın düzeyini burada seçersiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ứng dụng nào dùng được su. Quản trị viên máy Mac này có thể bật quyền root trong Nâng cao, rồi chọn mức cho từng ứng dụng ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有应用可以使用 su。这台 Mac 的管理员可以在“高级”中开启 root 访问权限，然后您可以在这里为每个应用选择级别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有應用程式可以使用 su。此 Mac 的管理者可以在「進階」中開啟 root 存取權，之後您就能在這裡選擇每個應用程式的等級。"
          }
        }
      }
    },
