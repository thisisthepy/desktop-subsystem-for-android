    "AppsNone.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Android ist noch keine App installiert. Öffnen Sie eine APK-Datei, um eine zu installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app is installed in Android yet. Open an APK file to install one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ninguna app instalada en Android. Abra un archivo APK para instalar una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app n'est encore installée dans Android. Ouvrez un fichier APK pour en installer une."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada aplikasi yang terinstal di Android. Buka file APK untuk menginstalnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora app installate in Android. Apri un file APK per installarne una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android にはまだアプリがインストールされていません。APK ファイルを開いてインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android에 설치된 앱이 아직 없습니다. APK 파일을 열어 설치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há apps instalados no Android. Abra um arquivo APK para instalar um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Android пока не установлено ни одного приложения. Откройте файл APK, чтобы установить его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android'de henüz yüklü uygulama yok. Yüklemek için bir APK dosyası açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có ứng dụng nào được cài trong Android. Mở một tệp APK để cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 中尚未安装任何应用。打开 APK 文件即可安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 中尚未安裝任何應用程式。打開 APK 檔案即可安裝。"
          }
        }
      }
    },
