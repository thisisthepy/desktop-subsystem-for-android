    "AndroidUpConfirm.Body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} wird geladen und ab dem nächsten Start von Android verwendet.\n\nIhre Apps und ihre Daten werden übernommen. Ein späterer Wechsel zurück löscht die Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} is downloaded and used from the next start of Android.\n\nYour apps and their data move along. Moving back later erases the data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} se descarga y se usa a partir del próximo inicio de Android.\n\nSus apps y sus datos se conservan. Volver atrás más adelante borra los datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} est téléchargé et utilisé dès le prochain démarrage d'Android.\n\nVos apps et leurs données suivent. Revenir en arrière plus tard efface les données."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} diunduh dan digunakan sejak Android dimulai lagi.\n\nAplikasi dan datanya ikut pindah. Kembali ke versi lama nanti akan menghapus data."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} viene scaricato e usato dal prossimo avvio di Android.\n\nLe app e i loro dati vengono trasferiti. Tornare indietro in seguito cancella i dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} をダウンロードし、次に Android が起動したときから使います。\n\nアプリとそのデータは引き継がれます。あとで元に戻すと、データは消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0}을(를) 내려받아 다음에 Android가 시작될 때부터 씁니다.\n\n앱과 데이터는 함께 옮겨집니다. 나중에 되돌리면 데이터가 지워집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android {0} é baixado e usado a partir da próxima inicialização do Android.\n\nSeus apps e os dados deles são levados junto. Voltar depois apaga os dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} будет загружен и использован начиная со следующего запуска Android.\n\nВаши приложения и их данные перейдут вместе с ним. Возврат назад позже сотрёт данные."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} indirilir ve Android'in sonraki açılışından itibaren kullanılır.\n\nUygulamalarınız ve verileri de taşınır. Daha sonra geri dönmek verileri siler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} được tải xuống và dùng từ lần khởi động Android tiếp theo.\n\nỨng dụng và dữ liệu của bạn được chuyển theo. Chuyển ngược lại sau này sẽ xóa dữ liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} 将被下载，并从 Android 下次启动时开始使用。\n\n您的应用及其数据会一并迁移。以后再切换回来会清除数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} 會下載，並從 Android 下次啟動時開始使用。\n\n您的應用程式及其資料會一併移轉。之後若改回舊版，資料會被清除。"
          }
        }
      }
    },
    "AndroidUpConfirm.Title": {
