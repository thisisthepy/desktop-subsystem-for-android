    "BackgroundErrorBar.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apps, die im Hintergrund laufen, konnten nicht gelesen oder geändert werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The apps that run in the background could not be read or changed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer ni cambiar las apps que se ejecutan en segundo plano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire ou de modifier les apps exécutées en arrière-plan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi yang berjalan di latar belakang tidak dapat dibaca atau diubah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere o modificare le app in esecuzione in background"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドで実行中のアプリを読み取れないか、変更できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 실행 중인 앱을 읽거나 바꾸지 못했습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler ou alterar os apps executados em segundo plano"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать или изменить фоновые приложения"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planda çalışan uygulamalar okunamadı veya değiştirilemedi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc hoặc thay đổi các ứng dụng chạy nền"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取或更改在后台运行的应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取或變更在背景執行的應用程式"
          }
        }
      }
    },
    "BackgroundIntro.Text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Android-Apps laufen nach dem Schließen ihrer Fenster weiter, um Musik abzuspielen, Dateien zu laden oder ein VPN aktiv zu halten.\nJede hat auch einen Eintrag in der Menüleiste. Eine beendete App hört auf zu arbeiten und gibt ihren Speicher frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These Android apps keep running after their windows close, to play music, download files or keep a VPN on.\nEach also has an item in the menu bar. Stopping an app ends its work and frees its memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas apps de Android siguen ejecutándose tras cerrar sus ventanas, para reproducir música, descargar archivos o mantener una VPN.\nCada una tiene también un elemento en la barra de menús. Al detener una app, termina su trabajo y libera su memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces apps Android restent actives après la fermeture de leurs fenêtres : musique, téléchargement de fichiers ou VPN.\nChacune a aussi un élément dans la barre des menus. Arrêter une app met fin à son travail et libère sa mémoire."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi Android ini tetap berjalan setelah jendelanya ditutup, untuk memutar musik, mengunduh file, atau menjaga VPN tetap aktif.\nMasing-masing juga punya item di bar menu. Menghentikan aplikasi mengakhiri pekerjaannya dan membebaskan memorinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste app Android restano in esecuzione a finestre chiuse, per riprodurre musica, scaricare file o mantenere attiva una VPN.\nOgnuna ha anche un elemento nella barra dei menu. Interrompere un'app ne termina il lavoro e ne libera la memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの Android アプリは、音楽の再生、ファイルのダウンロード、VPN の維持などのため、ウィンドウを閉じた後も実行を続けます。\nそれぞれメニューバーにも項目があります。アプリを停止すると、その処理が終わり、メモリが解放されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Android 앱들은 창을 닫은 뒤에도 음악 재생, 파일 내려받기, VPN 같은 일을 하며 계속 실행됩니다.\n앱마다 메뉴 막대에도 항목이 있습니다. 앱을 중지하면 하던 일을 멈추고 쓰던 메모리를 돌려받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes apps Android continuam em execução depois que as janelas fecham, para tocar música, baixar arquivos ou manter uma VPN ligada.\nCada um também tem um item na barra de menus. Parar um app encerra o trabalho dele e libera a memória que ele usava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти приложения Android продолжают работать после закрытия окон, чтобы играть музыку, загружать файлы или держать VPN.\nУ каждого также есть пункт в строке меню. Остановка приложения завершает его работу и освобождает память."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Android uygulamaları, müzik çalmak, dosya indirmek veya VPN'i açık tutmak için pencereleri kapandıktan sonra da çalışmaya devam eder.\nHer birinin menü çubuğunda da bir öğesi vardır. Bir uygulamayı durdurmak işini bitirir ve belleğini boşaltır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng Android này tiếp tục chạy sau khi cửa sổ của chúng đóng, để phát nhạc, tải tệp xuống hoặc giữ VPN.\nMỗi ứng dụng cũng có một mục trên thanh menu. Dừng một ứng dụng sẽ kết thúc công việc của nó và giải phóng bộ nhớ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 Android 应用在窗口关闭后继续运行，以播放音乐、下载文件或保持 VPN 连接。\n每个应用在菜单栏中也有一项。停止应用会结束其工作并释放其内存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些 Android 應用程式在視窗關閉後仍會繼續執行，以播放音樂、下載檔案或保持 VPN 連線。\n每個應用程式在選單列中也有一個項目。停止應用程式會結束其工作並釋放記憶體。"
          }
        }
      }
    },
