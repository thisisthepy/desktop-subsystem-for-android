    "AndroidRestartConfirm.Body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android startet mit Android {0} neu.\n\nSeine App-Fenster werden geschlossen. Öffnen Sie die Apps erneut, sobald es gestartet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android restarts into Android {0}.\n\nIts app windows close. Open the apps again once it has started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android se reiniciará con Android {0}.\n\nSus ventanas de apps se cerrarán. Vuelva a abrir las apps cuando se haya iniciado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android redémarre sous Android {0}.\n\nSes fenêtres d'app se ferment. Rouvrez les apps une fois le démarrage terminé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Android dimulai ulang ke Android {0}.\n\nJendela aplikasinya ditutup. Buka lagi aplikasinya setelah Android dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android si riavvia con Android {0}.\n\nLe finestre delle sue app si chiudono. Riapri le app quando l'avvio è terminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0} で再起動します。\n\nアプリのウィンドウは閉じます。起動が完了したら、もう一度アプリを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android {0}(으)로 다시 시작합니다.\n\n앱 창이 닫힙니다. 시작이 끝나면 앱을 다시 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Android reinicia no Android {0}.\n\nAs janelas dos apps fecham. Abra os apps de novo quando ele tiver iniciado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android перезапустится в версии Android {0}.\n\nОкна его приложений закроются. Когда запуск завершится, откройте приложения снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android, Android {0} ile yeniden başlar.\n\nUygulama pencereleri kapanır. Başladıktan sonra uygulamaları yeniden açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Android khởi động lại vào Android {0}.\n\nCác cửa sổ ứng dụng của Android sẽ đóng. Hãy mở lại ứng dụng khi Android đã khởi động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 将重新启动并进入 Android {0}。\n\n其应用窗口会关闭。启动完成后，请重新打开这些应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 會重新啟動並進入 Android {0}。\n\n它的應用程式視窗會關閉。啟動完成後，請再次打開應用程式。"
          }
        }
      }
    },
    "ImageAutoRestartCard.Header": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android für Updates selbst neu starten"
          }
        },
        "en": {
