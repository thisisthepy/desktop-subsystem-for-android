<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded in dsa-devices (its __TEXT,__info_plist section). The device lender runs from a
     launchd agent, not as an app, so this is where macOS finds its identity and the reasons it
     shows when it asks the user for the camera, the microphone and the location. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>org.thisisthepy.dsa.devices</string>
	<key>CFBundleName</key>
	<string>DSA Devices</string>
	<key>CFBundleDisplayName</key>
	<string>Desktop Subsystem for Android</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Apps in Desktop Subsystem for Android use the camera when you allow them to.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Apps in Desktop Subsystem for Android record sound when you allow them to.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Apps in Desktop Subsystem for Android recognise what you say when you allow them to.</string>
	<key>NSLocationUsageDescription</key>
	<string>Apps in Desktop Subsystem for Android use your location when you allow them to.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Apps in Desktop Subsystem for Android use your location when you allow them to.</string>
</dict>
</plist>
