<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The device lender (dsa-devices) signed to use the Mac's passkeys for Android apps: what
     dsa.entitlements grants every program, and the browser passkey entitlement.

     com.apple.developer.web-browser.public-key-credential lets a program perform passkey
     requests for others (web pages, here Android apps whose relying party DSA checked), with
     client data it gives. It is a restricted entitlement: Apple grants it on request, and a
     program carrying it starts only with a provisioning profile that grants it. So
     build-app.sh uses this file only when DSA_PASSKEY_PROFILE names such a profile, and merges
     the profile's own identifiers into it; every other build signs dsa-devices with
     dsa.entitlements, and the Mac's passkeys are then reported unavailable to Android. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.virtualization</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.developer.web-browser.public-key-credential</key>
	<true/>
</dict>
</plist>
