<Application
    x:Class="Dsa.Settings.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- The title bar's colours, active and inactive, after the library's style it extends. -->
                <ResourceDictionary Source="/TitleBarStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Visible" />

            <!-- The Windows type ramp, as the Windows Settings app uses it: Segoe UI Variable
                 (Text for 14 px and smaller, Display for the page title), with Segoe UI where
                 Windows 10 lacks it and Malgun Gothic for Korean. Every page takes its text
                 styles from here.
                   Title       28 px   page title
                   Body Strong 14 px   section header
                   Body        14 px   setting (card) header
                   Caption     12 px   description, secondary colour
                 Malgun Gothic has no Semibold, so a Semibold request draws Korean in its Bold,
                 even when the Semibold comes from a family name in the list, because WPF applies
                 that weight to the whole list. The Settings app shows Korean titles in Regular,
                 so App.OnStartup points the strong fonts at the regular ones in Korean. -->
            <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Malgun Gothic</FontFamily>
            <FontFamily x:Key="StrongTextFont">Segoe UI Variable Text Semibold, Segoe UI Semibold, Malgun Gothic</FontFamily>
            <FontFamily x:Key="StrongDisplayFont">Segoe UI Variable Display Semibold, Segoe UI Semibold, Malgun Gothic</FontFamily>
            <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>

            <!-- The page layout of the Windows Settings app and the WinUI Gallery: the title
                 stays above the page while the page scrolls under it, both 56 px from the edges
                 in a wide window and 36 px in a narrow one, and at most 1000 px wide; cards 4 px
                 apart, sections 30 px apart (the toolkit's section header margin). MainWindow
                 swaps the margins when its width crosses 1008 px, the WinUI wide breakpoint. -->
            <sys:Double x:Key="PageMaxWidth">1000</sys:Double>
            <Thickness x:Key="PageHeaderMargin">36,16,36,20</Thickness>
            <Thickness x:Key="PageContentMargin">36,0,36,24</Thickness>
            <!-- The 4 px between two cards, or a card and a notice bar. Every card, expander and
                 notice bar takes it from its style, never from the page, so no card in a section
                 sits further from its neighbours than the others. -->
            <Thickness x:Key="CardSpacing">0,0,0,4</Thickness>
            <Style x:Key="PageHeader" TargetType="Grid">
                <Setter Property="Margin" Value="{DynamicResource PageHeaderMargin}" />
                <Setter Property="MaxWidth" Value="{StaticResource PageMaxWidth}" />
            </Style>
            <Style x:Key="PageContent" TargetType="StackPanel">
                <Setter Property="Margin" Value="{DynamicResource PageContentMargin}" />
                <Setter Property="MaxWidth" Value="{StaticResource PageMaxWidth}" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource StrongDisplayFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="LineHeight" Value="36" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource StrongTextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="Margin" Value="1,30,0,6" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <!-- No colour of its own: it takes the card's, which turns grey when the card is
                 disabled, as a WinUI settings card's header does. -->
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardDescription" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- A value a card shows on its right, as the Windows Settings app shows one: against
                 the card's right edge, wrapped lines right-aligned too, and never wider than
                 320 px, on every page. The card keeps at least 120 px for its control, so a value
                 that only took the box's right side would still start 120 px from the edge and
                 a short one would hang in the middle; TextAlignment puts every line against the
                 edge. No colour of its own, so a disabled card greys it. Every text in a card's
                 content uses this style or one based on it. -->
            <Style x:Key="CardValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MaxWidth" Value="320" />
            </Style>
            <!-- A smaller line under a card's value, in the description's size and colour. -->
            <Style x:Key="CardValueCaption" TargetType="TextBlock" BasedOn="{StaticResource CardValue}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- A value that leads a card, in the type ramp's Subtitle: 20 px on a 28 px line. -->
            <Style x:Key="CardValueSubtitle" TargetType="TextBlock" BasedOn="{StaticResource CardValue}">
                <Setter Property="FontFamily" Value="{DynamicResource StrongDisplayFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="LineHeight" Value="28" />
            </Style>
            <Style x:Key="Note" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="1,6,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <!-- A note that introduces what follows it, 12 px above the first card or bar. -->
            <Style x:Key="PageIntro" TargetType="TextBlock" BasedOn="{StaticResource Note}">
                <Setter Property="Margin" Value="1,6,0,12" />
            </Style>

            <!-- WinUI's text box and combo box are 32 px high: the library's are 36 to 38 px.
                 These keys are the ones the library's templates read. -->
            <Thickness x:Key="TextControlThemePadding">10,5,6,6</Thickness>
            <sys:Double x:Key="TextControlThemeMinHeight">32</sys:Double>
            <Thickness x:Key="ComboBoxPadding">12,5,0,7</Thickness>

            <!-- "On" and "Off" beside every switch, in the app's language; App.OnStartup sets
                 them once the language is known. -->
            <sys:String x:Key="ToggleOnText">On</sys:String>
            <sys:String x:Key="ToggleOffText">Off</sys:String>

            <!-- These styles are based on the library's named styles, never on
                 {StaticResource {x:Type ...}}. Inside this dictionary a style's own type is its own
                 key, and a style based on that key loses the library's setters: ui:Button fell
                 back to the default Win32 button template. The library names no style for
                 ui:InfoBar, so the info bar style below sets every property itself, its margin
                 included. -->

            <!-- Pop-ups do not inherit the window's font. -->
            <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
            </Style>
            <Style TargetType="ContextMenu" BasedOn="{StaticResource UiContextMenu}">
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
            </Style>

            <!-- A WinUI button in a settings card is at least 120 px wide (the toolkit's
                 content minimum), so a short label such as "Stop" still reads as a button. -->
            <Style TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Setter Property="MinWidth" Value="120" />
            </Style>

            <!-- WinUI's text box shows focus by its 2 px accent line alone, and centres its text.
                 The library adds its 1 px dark focus rectangle around every text box. -->
            <Style TargetType="ui:TextBox" BasedOn="{StaticResource DefaultUiTextBoxStyle}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- A value to read and copy, as WinUI's TextBlock with IsTextSelectionEnabled: plain
                 text with no frame, no tab stop and no focus mark. WPF's TextBlock cannot be
                 selected, so this is a read-only TextBox with only its text host. A Decorator
                 host lets the wheel scroll the page, and the -2 px margin cancels the text host's
                 own inset, so the text lines up with the text above it. -->
            <Style x:Key="SelectableText" TargetType="TextBox">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ContextMenu" Value="{DynamicResource DefaultControlContextMenu}" />
                <Setter Property="Cursor" Value="IBeam" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Decorator x:Name="PART_ContentHost" Margin="-2,0,-2,0" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Cascadia Mono and Consolas have no Hangul, so Korean falls to Malgun Gothic. -->
            <Style x:Key="SelectableCode" TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Malgun Gothic" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <!-- A command to copy: a subtle filled block in the card's text column, on its own row
                 8 px under the description, as WinUI Gallery frames code it offers to copy. -->
            <Style x:Key="CodeBlock" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12,4,4,4" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>

            <!-- Task Manager's navigation items: a 36 px highlight every 40 px. -->
            <Style TargetType="ui:NavigationViewItem" BasedOn="{StaticResource NavigationViewItemDefaultStyle}">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Margin" Value="0,2,0,2" />
            </Style>

            <!-- A settings card as WinUI's SettingsCard draws it: 16 px padding, at least 68 px
                 high, a 20 px icon 20 px before the header, the control 24 px after it on the
                 right. A card that is not a button does not light up under the pointer or when
                 pressed; the library's card does both. -->
            <Style TargetType="ui:CardControl" BasedOn="{StaticResource DefaultUiCardControlStyle}">
                <Setter Property="Margin" Value="{StaticResource CardSpacing}" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:CardControl">
                            <Border x:Name="ContentBorder"
                                    MinHeight="{TemplateBinding MinHeight}"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource CardCornerRadius}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl x:Name="ControlIcon" Grid.Column="0" Margin="2,0,20,0"
                                                    VerticalAlignment="Center" Focusable="False" IsTabStop="False"
                                                    Content="{TemplateBinding Icon}" FontSize="20"
                                                    Foreground="{TemplateBinding Foreground}" />
                                    <ContentPresenter x:Name="HeaderContentPresenter" Grid.Column="1"
                                                      VerticalAlignment="Center" Content="{TemplateBinding Header}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <ContentPresenter x:Name="ContentPresenter" Grid.Column="2" Margin="24,0,0,0" MinWidth="120"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Content="{TemplateBinding Content}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundDisabled}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrushDisabled}" />
                                    <Setter TargetName="HeaderContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource CardForegroundDisabled}" />
                                    <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource CardForegroundDisabled}" />
                                    <Setter TargetName="ControlIcon" Property="Foreground" Value="{DynamicResource CardForegroundDisabled}" />
                                </Trigger>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter TargetName="ContentPresenter" Property="Margin" Value="0" />
                                    <Setter TargetName="ContentPresenter" Property="MinWidth" Value="0" />
                                </Trigger>
                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
                                    <Setter TargetName="ControlIcon" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A clickable settings card: the same layout, and a 13 px chevron 14 px after the
                 header in place of the library's 16 px one 4 px after it. -->
            <Style TargetType="ui:CardAction" BasedOn="{StaticResource DefaultUiCardActionStyle}">
                <Setter Property="Margin" Value="{StaticResource CardSpacing}" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:CardAction">
                            <Border x:Name="ContentBorder"
                                    MinHeight="{TemplateBinding MinHeight}"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource CardCornerRadius}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl x:Name="ControlIcon" Grid.Column="0" Margin="2,0,20,0"
                                                    VerticalAlignment="Center" Focusable="False" IsTabStop="False"
                                                    Content="{TemplateBinding Icon}" FontSize="20"
                                                    Foreground="{TemplateBinding Foreground}" />
                                    <ContentPresenter x:Name="ContentPresenter" Grid.Column="1" VerticalAlignment="Center"
                                                      Content="{TemplateBinding Content}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <ui:SymbolIcon x:Name="ChevronIcon" Grid.Column="2" Margin="14,0,0,0"
                                                   VerticalAlignment="Center" FontSize="13" Symbol="ChevronRight24" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundPointerOver}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundPressed}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrushPressed}" />
                                    <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource CardForegroundPressed}" />
                                    <Setter TargetName="ControlIcon" Property="Foreground" Value="{DynamicResource CardForegroundPressed}" />
                                    <Setter TargetName="ChevronIcon" Property="Foreground" Value="{DynamicResource CardForegroundPressed}" />
                                </Trigger>
                                <Trigger Property="IsChevronVisible" Value="False">
                                    <Setter TargetName="ChevronIcon" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundDisabled}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrushDisabled}" />
                                    <Setter TargetName="ContentPresenter" Property="TextElement.Foreground" Value="{DynamicResource CardForegroundDisabled}" />
                                    <Setter TargetName="ControlIcon" Property="Foreground" Value="{DynamicResource CardForegroundDisabled}" />
                                    <Setter TargetName="ChevronIcon" Property="Foreground" Value="{DynamicResource CardForegroundDisabled}" />
                                </Trigger>
                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter TargetName="ControlIcon" Property="Margin" Value="0" />
                                    <Setter TargetName="ControlIcon" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A card that opens to show more: the library's, with the cards' spacing. -->
            <Style TargetType="ui:CardExpander" BasedOn="{StaticResource DefaultUiCardExpanderStyle}">
                <Setter Property="Margin" Value="{StaticResource CardSpacing}" />
            </Style>

            <!-- Several controls in one card (a button beside a switch, a progress ring beside a
                 button), in a row against the card's right edge. A row left at Stretch fills
                 the card's 120 px control box from the left, so a switch alone in it stopped
                 short of the edge when the button beside it was hidden. -->
            <Style x:Key="CardControls" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A notice bar in the cards' columns: its icon centred where a card's 20 px icon
                 sits (16 px padding, 2 px in, 20 px wide) and its title where a card's title
                 starts (20 px after the icon), so a notice between two cards lines up with them.
                 The library's template hard-codes its own padding and puts the title 30 px from
                 the bar's edge, 12 px left of the card titles around it, and its icon 4 px left
                 of theirs. The rest is the library's (WPF UI, MIT licence, Leszek Pomianowski
                 and WPF UI contributors). -->
            <Style TargetType="ui:InfoBar">
                <Setter Property="Margin" Value="{StaticResource CardSpacing}" />
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{DynamicResource InfoBarTitleForeground}" />
                <Setter Property="Padding" Value="16,14,16,14" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="BorderBrush" Value="{DynamicResource InfoBarBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Border.CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:InfoBar">
                            <Grid x:Name="InfoBarRoot">
                                <Border x:Name="ContentBorder"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding Border.CornerRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="IconBox" Grid.Column="0" Width="20" Margin="2,2,20,0" VerticalAlignment="Top">
                                            <ui:SymbolIcon x:Name="SymbolIcon" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                           Filled="True" FontSize="16" />
                                        </Border>
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                                            <TextBlock Margin="0,0,14,0" Text="{TemplateBinding Title}" TextWrapping="Wrap"
                                                       FontFamily="{DynamicResource StrongTextFont}" />
                                            <TextBlock Text="{TemplateBinding Message}" TextWrapping="Wrap" />
                                        </WrapPanel>
                                        <Border Grid.Column="2" Margin="12,-2,0,0" VerticalAlignment="Top">
                                            <ui:Button x:Name="CloseButton" MinWidth="0" Padding="4" Background="Transparent" BorderThickness="0"
                                                       Command="{Binding Path=TemplateButtonCommand, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Dismiss24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsClosable" Value="False">
                                    <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsOpen" Value="False">
                                    <Setter TargetName="InfoBarRoot" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="Severity" Value="Informational">
                                    <Setter TargetName="SymbolIcon" Property="Foreground">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="SymbolIcon" Property="Symbol" Value="Info24" />
                                    <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="Severity" Value="Success">
                                    <Setter TargetName="SymbolIcon" Property="Foreground" Value="{DynamicResource InfoBarSuccessSeverityIconBackground}" />
                                    <Setter TargetName="SymbolIcon" Property="Symbol" Value="CheckmarkCircle24" />
                                    <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarSuccessSeverityBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="Severity" Value="Warning">
                                    <Setter TargetName="SymbolIcon" Property="Foreground" Value="{DynamicResource InfoBarWarningSeverityIconBackground}" />
                                    <Setter TargetName="SymbolIcon" Property="Symbol" Value="ErrorCircle24" />
                                    <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarWarningSeverityBackgroundBrush}" />
                                </Trigger>
                                <Trigger Property="Severity" Value="Error">
                                    <Setter TargetName="SymbolIcon" Property="Foreground" Value="{DynamicResource InfoBarErrorSeverityIconBackground}" />
                                    <Setter TargetName="SymbolIcon" Property="Symbol" Value="DismissCircle24" />
                                    <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource InfoBarErrorSeverityBackgroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- A closed bar takes no room: collapsing only its template left its margin,
                     so two closed bars between two cards put 12 px between them instead of 4. -->
                <Style.Triggers>
                    <Trigger Property="IsOpen" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A toggle switch as the Windows Settings app shows it: "On" or "Off" to the left
                 of the switch, 12 px from it. The library puts the text on the right. The
                 track, its brushes and the animation are the library's (WPF UI, MIT licence,
                 Leszek Pomianowski and WPF UI contributors). The on fill is the library style's
                 Background, ToggleSwitchFillOn, so this style must stay based on that style.
                 The knob is as in WinUI, which the library does not do: 12 px and 4 px from the
                 end at rest, 14 px under the pointer, and 17 by 14 px when pressed, 3 px from
                 the end it rests at. -->
            <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource DefaultUiToggleSwitchStyle}">
                <!-- Against the card's right edge, as every switch in the Windows Settings app:
                     the card keeps at least 120 px for its control, and a switch left at Stretch
                     filled that box with its text and switch on the left, so the switch ended
                     about 50 px before the edge while the buttons and values beside it reached
                     it. The "On" or "Off" text grows to the left, so the switch never moves. -->
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="OnContent" Value="{DynamicResource ToggleOnText}" />
                <Setter Property="OffContent" Value="{DynamicResource ToggleOffText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:ToggleSwitch">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentPresenter" Grid.Column="0" Margin="0,0,12,0"
                                                  VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Grid Grid.Column="1" Width="40" Height="20">
                                    <Rectangle x:Name="ToggleRectangle" Width="40" Height="20" RadiusX="10" RadiusY="10"
                                               Fill="{DynamicResource ToggleSwitchFillOff}"
                                               Stroke="{DynamicResource ToggleSwitchStrokeOff}" StrokeThickness="1" />
                                    <Rectangle x:Name="ActiveToggleRectangle" Width="40" Height="20" RadiusX="10" RadiusY="10"
                                               Fill="{TemplateBinding Background}" Opacity="0" StrokeThickness="0" />
                                    <Ellipse x:Name="ToggleEllipse" Width="12" Height="12"
                                             Fill="{DynamicResource ToggleSwitchKnobFillOff}">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="-10" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="ActiveToggleEllipse" Width="12" Height="12" Opacity="0"
                                             Fill="{DynamicResource ToggleSwitchKnobFillOn}">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="-10" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ToggleRectangle" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.167" />
                                                <DoubleAnimation Storyboard.TargetName="ActiveToggleRectangle" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.167" />
                                                <DoubleAnimation Storyboard.TargetName="ToggleEllipse" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.167" />
                                                <DoubleAnimation Storyboard.TargetName="ActiveToggleEllipse" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.167" />
                                                <DoubleAnimation Storyboard.TargetName="ToggleEllipse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="10" Duration="0:0:0.167" />
                                                <DoubleAnimation Storyboard.TargetName="ActiveToggleEllipse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="10" Duration="0:0:0.167" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ToggleRectangle" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.167" />
                                                <DoubleAnimation Storyboard.TargetName="ActiveToggleRectangle" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.167" />
                                                <DoubleAnimation Storyboard.TargetName="ToggleEllipse" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.167" />
                                                <DoubleAnimation Storyboard.TargetName="ActiveToggleEllipse" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.167" />
                                                <DoubleAnimation Storyboard.TargetName="ToggleEllipse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-10" Duration="0:0:0.167" />
                                                <DoubleAnimation Storyboard.TargetName="ActiveToggleEllipse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-10" Duration="0:0:0.167" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Content" Value="{x:Null}" />
                                        <Condition Property="IsChecked" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ContentPresenter" Property="Content" Value="{Binding OnContent, RelativeSource={RelativeSource TemplatedParent}}" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Content" Value="{x:Null}" />
                                        <Condition Property="IsChecked" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ContentPresenter" Property="Content" Value="{Binding OffContent, RelativeSource={RelativeSource TemplatedParent}}" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="False" />
                                        <Condition Property="IsEnabled" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ToggleRectangle" Property="Fill" Value="{DynamicResource ToggleSwitchFillOffPointerOver}" />
                                    <Setter TargetName="ToggleRectangle" Property="Stroke" Value="{DynamicResource ToggleSwitchStrokeOffPointerOver}" />
                                    <Setter TargetName="ToggleEllipse" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffPointerOver}" />
                                    <Setter TargetName="ToggleEllipse" Property="Width" Value="14" />
                                    <Setter TargetName="ToggleEllipse" Property="Height" Value="14" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsEnabled" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource ToggleSwitchFillOnPointerOver}" />
                                    <Setter TargetName="ActiveToggleEllipse" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOnPointerOver}" />
                                    <Setter TargetName="ActiveToggleEllipse" Property="Width" Value="14" />
                                    <Setter TargetName="ActiveToggleEllipse" Property="Height" Value="14" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsPressed" Value="True" />
                                        <Condition Property="IsChecked" Value="False" />
                                        <Condition Property="IsEnabled" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ToggleRectangle" Property="Fill" Value="{DynamicResource ControlAltFillColorQuarternaryBrush}" />
                                    <Setter TargetName="ToggleEllipse" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffPressed}" />
                                    <Setter TargetName="ToggleEllipse" Property="Width" Value="17" />
                                    <Setter TargetName="ToggleEllipse" Property="Height" Value="14" />
                                    <Setter TargetName="ToggleEllipse" Property="Margin" Value="3,0,0,0" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsPressed" Value="True" />
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsEnabled" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
                                    <Setter TargetName="ActiveToggleEllipse" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOnPressed}" />
                                    <Setter TargetName="ActiveToggleEllipse" Property="Width" Value="17" />
                                    <Setter TargetName="ActiveToggleEllipse" Property="Height" Value="14" />
                                    <Setter TargetName="ActiveToggleEllipse" Property="Margin" Value="0,0,3,0" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="False" />
                                        <Condition Property="IsEnabled" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ToggleRectangle" Property="Stroke" Value="{DynamicResource ToggleSwitchStrokeOffDisabled}" />
                                    <Setter TargetName="ToggleRectangle" Property="Fill" Value="{DynamicResource ToggleSwitchFillOffDisabled}" />
                                    <Setter TargetName="ToggleEllipse" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffDisabled}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ToggleSwitchContentForegroundDisabled}" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsEnabled" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ActiveToggleRectangle" Property="Fill" Value="{DynamicResource ToggleSwitchFillOnDisabled}" />
                                    <Setter TargetName="ActiveToggleEllipse" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOnDisabled}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ToggleSwitchContentForegroundDisabled}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
