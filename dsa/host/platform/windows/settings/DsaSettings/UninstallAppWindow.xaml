<!--
    The window Windows' list of installed apps opens to uninstall an Android app. Windows has
    already asked, so it does not ask again: it uninstalls at once and shows the result. It is laid out
    as setup's screens are, with setup's styles and colours: the caption bar, the hero with
    the app, a panel for the screen, and the footer layer with its buttons.
-->
<Window x:Class="Dsa.Settings.UninstallAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource TextFont}" FontSize="14"
        Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="UninstallAppWindow">
    <Window.Resources>
        <ResourceDictionary Source="/SetupStyle/Styles.xaml" />
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="Chrome" CaptionHeight="32" ResizeBorderThickness="0" CornerRadius="0"
                      GlassFrameThickness="-1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button x:Name="CaptionClose" DockPanel.Dock="Right" Style="{StaticResource CaptionCloseButton}"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose"
                    AutomationProperties.AutomationId="CaptionCloseButton">
                <Path Width="10" Height="10" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" StrokeThickness="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Image Source="pack://application:,,,/Assets/logo.png" Width="16" Height="16" Margin="12,0,10,0"
                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="CaptionTitle" FontSize="12" LineHeight="16"
                       LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="24,16,24,24">
            <DockPanel Height="56">
                <Image x:Name="AppIcon" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.AutomationId="AppIcon" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeroTitle" Style="{StaticResource Subtitle}" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="HeroTitle" />
                    <TextBlock x:Name="HeroPackage" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="Chips" Orientation="Horizontal" Margin="0,6,0,0">
                        <Border x:Name="VersionBorder" Style="{StaticResource Chip}">
                            <TextBlock x:Name="VersionChip" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                        </Border>
                        <Border x:Name="SizeBorder" Style="{StaticResource Chip}">
                            <TextBlock x:Name="SizeChip" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Grid Margin="0,20,0,0">
                <StackPanel x:Name="ProgressPanel">
                    <TextBlock x:Name="ProgressTitle" Style="{StaticResource SectionHeader}" Margin="0" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="ProgressTitle" />
                    <Grid x:Name="ProgressMarquee" Margin="0,12,0,0" Height="3" ClipToBounds="True" />
                    <TextBlock x:Name="ProgressDetail" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                </StackPanel>

                <Grid x:Name="ResultPanel" Visibility="Collapsed" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" Margin="0,-1,0,0" VerticalAlignment="Top">
                        <Ellipse x:Name="ResultBadge" Fill="{DynamicResource Accent}" />
                        <Path x:Name="ResultGlyph" Width="16" Height="16" Stretch="None" StrokeThickness="1.75"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{DynamicResource AccentText}" Data="M3.5,8.5 L6.5,11.5 L12.5,4.5" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionHeader}" Margin="0" AutomationProperties.AutomationId="ResultTitle" />
                        <TextBlock x:Name="ResultText" Style="{StaticResource Body}" Foreground="{DynamicResource TextSecondary}"
                                   AutomationProperties.AutomationId="ResultText" />
                    </StackPanel>
                </Grid>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="24"
                Background="{DynamicResource LayerFill}" BorderBrush="{DynamicResource LayerStroke}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Style="{StaticResource Button}" Margin="8,0,0,0"
                        Click="OnClose" AutomationProperties.AutomationId="CloseButton" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
