<Page
    x:Class="Dsa.Settings.Pages.MemoryPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <Page.Resources>
        <DataTemplate x:Key="MemoryRow">
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <TextBlock Text="{Binding Size}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ui:CardControl>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,8,36,24" MaxWidth="1000">
            <Grid>
                <TextBlock Text="{l:Text MemoryTitle.Text}" Style="{StaticResource PageTitle}" />
                <ui:Button Content="{l:Text MemoryRefreshButton.Content}" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefresh" />
            </Grid>

            <ui:InfoBar Title="{l:Text MemoryErrorBar.Title}" Severity="Error" IsClosable="False"
                        IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" />

            <!-- The limit is a setting, so these two cards read the settings, not the report. -->
            <StackPanel x:Name="LimitSection">
                <ui:InfoBar Title="{l:Text SettingsErrorBar.Title}" Severity="Error" IsClosable="False"
                            IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Ram20}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text MemoryLimitCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text MemoryLimitCard.Description}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="LimitBox" MinWidth="180" DisplayMemberPath="Label"
                              ItemsSource="{Binding MemoryLimitChoices, Mode=OneWay}"
                              SelectedIndex="{Binding SelectedMemoryLimitIndex, Mode=OneWay}"
                              IsEnabled="{Binding CanChange, Mode=OneWay}" SelectionChanged="OnLimitChanged" />
                </ui:CardControl>
            </StackPanel>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Server24}"
                            Visibility="{Binding HasVmSize, Converter={StaticResource Visible}}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text MemoryVmSizeCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text MemoryVmSizeCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="{Binding VmSize, Mode=OneWay}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding GuestReported, Converter={StaticResource Visible}}">
                        <TextBlock Text="{l:Text MemoryGuestUsedLabel.Text}" Margin="0,0,6,0" Style="{StaticResource CardDescription}" />
                        <TextBlock Text="{Binding GuestUsed, Mode=OneWay}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding HasVmBeyondGuest, Converter={StaticResource Visible}}">
                        <TextBlock Text="{l:Text MemoryBeyondGuestLabel.Text}" Margin="0,0,6,0" Style="{StaticResource CardDescription}" />
                        <TextBlock Text="{Binding VmBeyondGuest, Mode=OneWay}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="{l:Text MemoryHostHeader.Text}" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Desktop24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text MemoryHostTotalCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text MemoryHostTotalCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <TextBlock Text="{Binding HostTotal, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ui:CardControl>
            <ItemsControl ItemsSource="{Binding HostRows, Mode=OneWay}" ItemTemplate="{StaticResource MemoryRow}" />
            <TextBlock Text="{l:Text MemoryHostNone.Text}" Style="{StaticResource Note}"
                       Visibility="{Binding HostNotRunning, Converter={StaticResource Visible}}" />

            <TextBlock Text="{l:Text MemoryGuestHeader.Text}" Style="{StaticResource SectionHeader}" />
            <ui:InfoBar Title="{l:Text MemoryGuestNoneBar.Title}" Message="{l:Text MemoryGuestNoneBar.Message}"
                        Severity="Informational" IsClosable="False" IsOpen="{Binding GuestNotReported, Mode=OneWay}" />
            <StackPanel Visibility="{Binding GuestReported, Converter={StaticResource Visible}}">
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DataUsage24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text MemoryGuestTotalCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding GuestAge, Mode=OneWay}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="220">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding GuestAvailable, Mode=OneWay}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{l:Text MemoryAvailableOf.Text}" Margin="6,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding GuestTotal, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <ProgressBar Value="{Binding GuestUsedPercent, Mode=OneWay}" Maximum="100" Margin="0,6,0,0" />
                    </StackPanel>
                </ui:CardControl>
                <ItemsControl ItemsSource="{Binding GuestRows, Mode=OneWay}" ItemTemplate="{StaticResource MemoryRow}" />
                <StackPanel Visibility="{Binding KernelReported, Converter={StaticResource Visible}}">
                    <TextBlock Text="{l:Text MemoryKernelHeader.Text}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding KernelRows, Mode=OneWay}" ItemTemplate="{StaticResource MemoryRow}" />
                </StackPanel>
                <TextBlock Text="{l:Text MemoryTopHeader.Text}" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding GuestProcessRows, Mode=OneWay}" ItemTemplate="{StaticResource MemoryRow}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
