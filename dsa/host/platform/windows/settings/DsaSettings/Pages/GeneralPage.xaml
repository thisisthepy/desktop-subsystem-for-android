<Page
    x:Class="Dsa.Settings.Pages.GeneralPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}">
            <TextBlock Text="{l:Text GeneralTitle.Text}" Style="{StaticResource PageTitle}" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource PageContent}">
                <ui:InfoBar Title="{l:Text GeneralErrorBar.Title}" Severity="Error" IsClosable="False"
                            IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" />

                <ui:CardControl Icon="{ui:SymbolIcon Desktop24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text GeneralStateCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text GeneralStateCard.Description}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Style="{StaticResource CardControls}">
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                         Visibility="{Binding ShowsProgress, Converter={StaticResource Visible}}"
                                         AutomationProperties.Name="{l:Text GeneralStateCard.Header}" />
                        <TextBlock Text="{Binding StateText, Mode=OneWay}" Margin="0,0,12,0" Style="{StaticResource CardValue}" />
                        <ui:Button Content="{Binding StartButtonText, Mode=OneWay}" Appearance="Primary" Click="OnStart" Margin="0,0,8,0"
                                   AutomationProperties.Name="{Binding StartButtonText, Mode=OneWay}"
                                   IsEnabled="{Binding CanPressStart, Mode=OneWay}" />
                        <ui:Button Content="{l:Text StopButton.Content}" Click="OnStop" IsEnabled="{Binding CanStop, Mode=OneWay}" />
                    </StackPanel>
                </ui:CardControl>

                <ui:InfoBar Title="{l:Text ProblemBar.Title}" Severity="Error" IsClosable="False"
                            IsOpen="{Binding HasProblem, Mode=OneWay}" Message="{Binding Problem, Mode=OneWay}" />
                <ui:InfoBar Title="{l:Text LastReasonBar.Title}" Severity="Warning" IsClosable="False"
                            IsOpen="{Binding HasLastReason, Mode=OneWay}" Message="{Binding LastReason, Mode=OneWay}" />
                <Expander Header="{l:Text LastReasonDetails.Header}" IsExpanded="False" Margin="0,0,0,4"
                          Visibility="{Binding HasLastReasonDetail, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding LastReasonDetail, Mode=OneWay}" Style="{StaticResource SelectableCode}"
                                     AutomationProperties.Name="{l:Text LastReasonDetails.Header}" />
                        </ScrollViewer>
                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Copy24}" Margin="8,0,0,0" VerticalAlignment="Top"
                                   ToolTip="{l:Text LastReasonCopy.ToolTip}" AutomationProperties.Name="{l:Text LastReasonCopy.ToolTip}"
                                   Click="OnCopyLastReason" />
                    </Grid>
                </Expander>
                <ui:InfoBar Title="{l:Text UpdateNoticeBar.Title}" Severity="Informational" IsClosable="False"
                            IsOpen="{Binding HasUpdateNotice, Mode=OneWay}" Message="{Binding UpdateNotice, Mode=OneWay}" />
                <ui:CardControl Icon="{ui:SymbolIcon Snooze24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text FreezeNowCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text FreezeNowCard.Description}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Content="{l:Text FreezeNowButton.Content}" Click="OnFreeze" IsEnabled="{Binding CanFreeze, Mode=OneWay}" />
                </ui:CardControl>

                <TextBlock Text="{l:Text GeneralMoreHeader.Text}" Style="{StaticResource SectionHeader}" />
                <ui:CardAction Icon="{ui:SymbolIcon Folder24}" Click="OnOpenLogs"
                               AutomationProperties.Name="{l:Text OpenLogsCard.Header}"
                               AutomationProperties.HelpText="{l:Text OpenLogsCard.Description}">
                    <StackPanel>
                        <TextBlock Text="{l:Text OpenLogsCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text OpenLogsCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction Icon="{ui:SymbolIcon FolderPeople24}" Click="OnOpenServiceLogs"
                               AutomationProperties.Name="{l:Text ServiceLogsCard.Header}"
                               AutomationProperties.HelpText="{l:Text ServiceLogsCard.Description}">
                    <StackPanel>
                        <TextBlock Text="{l:Text ServiceLogsCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text ServiceLogsCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefresh"
                               AutomationProperties.Name="{l:Text RefreshCard.Header}"
                               AutomationProperties.HelpText="{l:Text RefreshCard.Description}">
                    <StackPanel>
                        <TextBlock Text="{l:Text RefreshCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text RefreshCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardAction>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
