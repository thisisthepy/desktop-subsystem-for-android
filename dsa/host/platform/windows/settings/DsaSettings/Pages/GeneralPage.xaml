<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dsa.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="36,0,36,24">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock x:Uid="GeneralTitle" Style="{StaticResource PageTitleStyle}" />

            <InfoBar x:Uid="GeneralErrorBar" Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

            <controls:SettingsCard x:Uid="GeneralStateCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F8;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                    <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <Button x:Uid="StartButton" Style="{StaticResource AccentButtonStyle}" Click="OnStart"
                            IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" />
                    <Button x:Uid="StopButton" Click="OnStop" IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" />
                </StackPanel>
            </controls:SettingsCard>

            <InfoBar x:Uid="LastReasonBar" Severity="Warning" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasLastReason, Mode=OneWay}"
                     Message="{x:Bind ViewModel.LastReason, Mode=OneWay}" />
            <InfoBar x:Uid="UpdateNoticeBar" Severity="Informational" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasUpdateNotice, Mode=OneWay}"
                     Message="{x:Bind ViewModel.UpdateNotice, Mode=OneWay}" />

            <TextBlock x:Uid="GeneralMoreHeader" Style="{StaticResource SectionHeaderStyle}" />
            <controls:SettingsCard x:Uid="OpenLogsCard" IsClickEnabled="True" Click="OnOpenLogs">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE838;" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="RefreshCard" IsClickEnabled="True" Click="OnRefresh">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72C;" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
