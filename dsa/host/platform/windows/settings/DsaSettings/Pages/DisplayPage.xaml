<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dsa.Settings.Pages.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="36,0,36,24">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock x:Uid="DisplayTitle" Style="{StaticResource PageTitleStyle}" />

            <InfoBar x:Uid="SettingsErrorBar" Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

            <controls:SettingsCard x:Uid="RenderGpuCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="GpuBox" MinWidth="260"
                          ItemsSource="{x:Bind ViewModel.GpuChoices, Mode=OneWay}"
                          DisplayMemberPath="Label"
                          SelectedIndex="{x:Bind ViewModel.SelectedGpuIndex, Mode=OneWay}"
                          IsEnabled="{x:Bind ViewModel.CanChange, Mode=OneWay}"
                          SelectionChanged="OnGpuChosen" />
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="DisplayGpuCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE950;" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock Text="{x:Bind ViewModel.DisplayGpuName, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="360" />
            </controls:SettingsCard>

            <InfoBar x:Uid="RenderGpuAppliesBar" Severity="Informational" IsClosable="False" IsOpen="True" />

            <controls:SettingsCard x:Uid="RestartWindowManagerCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE777;" />
                </controls:SettingsCard.HeaderIcon>
                <Button x:Uid="RestartWindowManagerButton" Click="OnRestartWindowManager" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
