<Page
    x:Class="Dsa.Settings.Pages.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,8,36,24" MaxWidth="1000">
            <TextBlock Text="{l:Text DisplayTitle.Text}" Style="{StaticResource PageTitle}" />

            <ui:InfoBar Title="{l:Text SettingsErrorBar.Title}" Severity="Error" IsClosable="False"
                        IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" />

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Desktop24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text RenderGpuCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text RenderGpuCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="GpuBox" MinWidth="280"
                          ItemsSource="{Binding GpuChoices, Mode=OneWay}"
                          DisplayMemberPath="Label"
                          SelectedIndex="{Binding SelectedGpuIndex, Mode=OneWay}"
                          IsEnabled="{Binding CanChange, Mode=OneWay}"
                          SelectionChanged="OnGpuChosen" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DeveloperBoard24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text DisplayGpuCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text DisplayGpuCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <TextBlock Text="{Binding DisplayGpuName, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="360"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </ui:CardControl>

            <ui:InfoBar Message="{l:Text RenderGpuAppliesBar.Message}" Severity="Informational" IsClosable="False" IsOpen="True"
                        Margin="0,0,0,4" />

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowClockwise24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{l:Text RestartWindowManagerCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text RestartWindowManagerCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="{l:Text RestartWindowManagerButton.Content}" Click="OnRestartWindowManager" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
