<Page
    x:Class="Dsa.Settings.Pages.DisplayPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}">
            <TextBlock Text="{l:Text DisplayTitle.Text}" Style="{StaticResource PageTitle}" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource PageContent}">
                <ui:InfoBar Title="{l:Text SettingsErrorBar.Title}" Severity="Error" IsClosable="False"
                            IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" />

                <ui:CardControl Icon="{ui:SymbolIcon Desktop24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text RenderGpuCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text RenderGpuCard.Description}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="GpuBox" MinWidth="280"
                              ItemsSource="{Binding GpuChoices, Mode=OneWay}"
                              DisplayMemberPath="Label"
                              SelectedIndex="{Binding SelectedGpuIndex, Mode=OneWay}"
                              IsEnabled="{Binding CanChange, Mode=OneWay}"
                              SelectionChanged="OnGpuChosen" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon DeveloperBoard24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text DisplayGpuCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text DisplayGpuCard.Description}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <TextBlock Text="{Binding DisplayGpuName, Mode=OneWay}" Style="{StaticResource CardValue}" />
                </ui:CardControl>

                <ui:InfoBar Title="{l:Text RenderGpuAppliesBar.Title}" Message="{l:Text RenderGpuAppliesBar.Message}" Severity="Informational" IsClosable="False" IsOpen="True" />

                <ui:CardControl Icon="{ui:SymbolIcon TapDouble24}"
                                Visibility="{Binding ShowTouchGestures, Converter={StaticResource Visible}}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text TouchGesturesCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text TouchGesturesCard.Description}" Style="{StaticResource CardDescription}" />
                            <TextBlock Text="{Binding TouchGesturesProblemText, Mode=OneWay}" Style="{StaticResource CardDescription}"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,4,0,0"
                                       Visibility="{Binding TouchGesturesFailed, Converter={StaticResource Visible}}" />
                            <ui:HyperlinkButton Content="{l:Text TouchSettingsLink.Content}" Click="OnOpenTouchSettings"
                                                Padding="0" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                Visibility="{Binding TouchGesturesFailed, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="TouchGesturesSwitch" IsChecked="{Binding TouchGesturesOff, Mode=OneWay}"
                                     IsEnabled="{Binding CanChangeTouchGestures, Mode=OneWay}" Click="OnTouchGesturesToggled"
                                     AutomationProperties.Name="{l:Text TouchGesturesCard.Header}" />
                </ui:CardControl>

                <ui:CardControl Icon="{ui:SymbolIcon ArrowClockwise24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text RestartWindowManagerCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text RestartWindowManagerCard.Description}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Content="{l:Text RestartWindowManagerButton.Content}" Click="OnRestartWindowManager" />
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
