<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dsa.Settings.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="36,0,36,24">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock x:Uid="UpdatesTitle" Style="{StaticResource PageTitleStyle}" />

            <InfoBar x:Uid="SettingsErrorBar" Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" />
            <InfoBar x:Uid="UpdateNoticeBar" Severity="Informational" IsClosable="False"
                     IsOpen="{x:Bind General.HasUpdateNotice, Mode=OneWay}"
                     Message="{x:Bind General.UpdateNotice, Mode=OneWay}" />

            <controls:SettingsCard x:Uid="ProgramUpdatesCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE895;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="ProgramSwitch"
                              IsOn="{x:Bind ViewModel.ProgramUpdates, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanChangeProgramUpdates, Mode=OneWay}"
                              Toggled="OnProgramToggled" />
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="ImageUpdatesCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7B8;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="ImageSwitch"
                              IsOn="{x:Bind ViewModel.ImageUpdates, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanChangeImageUpdates, Mode=OneWay}"
                              Toggled="OnImageToggled" />
            </controls:SettingsCard>
            <TextBlock x:Uid="UpdatesMachineNote" Margin="1,4,0,0" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock x:Uid="UpdateNowHeader" Style="{StaticResource SectionHeaderStyle}" />
            <controls:SettingsCard x:Uid="UpdateNowCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE896;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing x:Name="UpdateRing" IsActive="False" Width="20" Height="20" />
                    <Button x:Name="UpdateNowButton" x:Uid="UpdateNowButton" Click="OnUpdateNow"
                            IsEnabled="{x:Bind ViewModel.CanChangeProgramUpdates, Mode=OneWay}" />
                </StackPanel>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
