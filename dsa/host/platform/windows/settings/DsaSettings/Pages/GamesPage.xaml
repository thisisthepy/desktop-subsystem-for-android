<Page
    x:Class="Dsa.Settings.Pages.GamesPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}">
            <TextBlock Text="{l:Text GamesTitle.Text}" Style="{StaticResource PageTitle}" />
            <ui:Button Content="{l:Text GamesRefreshButton.Content}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefresh"
                       IsEnabled="{Binding IsIdle, Mode=OneWay}" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource PageContent}">
                <TextBlock Text="{l:Text GamesIntro.Text}" Style="{StaticResource PageIntro}" />

                <ProgressBar IsIndeterminate="True" Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"
                             AutomationProperties.Name="{l:Text A11y_Loading}" />
                <ui:InfoBar Title="{l:Text GamesErrorBar.Title}" Severity="Error" IsClosable="False"
                            IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" />

                <TextBlock Text="{l:Text GamesConvenienceHeader.Text}" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Icon="{ui:SymbolIcon Games24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text GamesKeepFocusCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text GamesKeepFocusCard.Description}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Content="{l:Text GamesSelectAllButton.Content}" Click="OnSelectAll"
                               Icon="{ui:SymbolIcon SelectAllOn24}"
                               IsEnabled="{Binding IsIdle, Mode=OneWay}" />
                </ui:CardControl>
                <TextBlock Text="{l:Text GamesNone.Text}" Style="{StaticResource Note}"
                           Visibility="{Binding HasNone, Converter={StaticResource Visible}}" />
                <l:RowList ItemsSource="{Binding Apps, Mode=OneWay}">
                    <l:RowList.ItemTemplate>
                        <DataTemplate>
                            <ui:CardControl>
                                <ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" Margin="0,0,12,0">
                                            <Image Source="{Binding Icon, Converter={StaticResource IconImage}, ConverterParameter=40}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescription}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch IsChecked="{Binding KeepFocus, Mode=OneWay}" Tag="{Binding Package}"
                                                 Click="OnKeepFocusChanged"
                                                 IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Page}, Mode=OneWay}"
                                                 AutomationProperties.Name="{l:ItemName GamesKeepFocusCard.Header}" />
                            </ui:CardControl>
                        </DataTemplate>
                    </l:RowList.ItemTemplate>
                </l:RowList>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
