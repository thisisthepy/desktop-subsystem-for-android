<Page
    x:Class="Dsa.Settings.Pages.LogsPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <!-- Android's log as it comes. Android sends it only while this page is shown. The page
         scrolls nothing itself, and ScrollViewer.CanContentScroll="False" keeps the navigation
         view from wrapping it in a scroll viewer (the library wraps a page when it is true):
         there the list would get unlimited height, stop virtualizing and lay out every one
         of its 5000 lines. -->
    <Grid Margin="{DynamicResource PageHeaderMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{l:Text LogsTitle.Text}" Style="{StaticResource PageTitle}" />
            <ui:Button Content="{l:Text LogsSaveButton.Content}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Icon="{ui:SymbolIcon Archive24}" Click="OnSaveDiagnostics"
                       IsEnabled="{Binding CanSave, Mode=OneWay}" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{l:Text LogsNote.Text}" Style="{StaticResource Note}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2">
            <ui:InfoBar Title="{l:Text LogsErrorBar.Title}" Severity="Error" IsClosable="False"
                        IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" />
            <ui:InfoBar Title="{l:Text LogsStatusBar.Title}" Severity="Informational" IsClosable="False"
                        IsOpen="{Binding HasStatus, Mode=OneWay}" Message="{Binding Status, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="{l:Text LogsFilter.PlaceholderText}"
                        Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}" IconPlacement="Right" ClearButtonEnabled="True" />
            <ComboBox x:Name="PriorityBox" Grid.Column="1" Margin="8,0,0,0" MinWidth="140"
                      SelectionChanged="OnPriorityChanged" />
            <ToggleButton Grid.Column="2" Margin="8,0,0,0" MinWidth="110"
                          IsChecked="{Binding Paused, Mode=TwoWay}" Content="{l:Text LogsPause.Content}" />
        </Grid>

        <Grid Grid.Row="4">
            <ListBox x:Name="LinesList" ItemsSource="{Binding Lines, Mode=OneWay}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" SelectionMode="Extended"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True">
                <!-- A log line is one short row in the app's body font: the theme's list rows
                     are tall and padded. The 20 px line fits Korean text and keeps every row
                     one height. -->
                <!-- Selected lines copy with Ctrl+C or the menu, as the whole lines of the log.
                     Ctrl+A and Shift or Ctrl clicks select as in any extended list. -->
                <ListBox.CommandBindings>
                    <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopy" CanExecute="OnCanCopy" />
                </ListBox.CommandBindings>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:Text CopyButton.ToolTip}" Command="ApplicationCommands.Copy" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.Resources>
                    <Style x:Key="LogCell" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="LineHeight" Value="20" />
                        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- A proportional font does not line columns up by itself, so the fields
                             have fixed widths. The body has none: a long line overflows into
                             the list's horizontal scroll bar. -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LogCell}" Width="164" Text="{Binding TimeColumn, Mode=OneTime}" />
                            <TextBlock Style="{StaticResource LogCell}" Width="56" TextAlignment="Right" Text="{Binding PidColumn, Mode=OneTime}" />
                            <TextBlock Style="{StaticResource LogCell}" Width="56" TextAlignment="Right" Text="{Binding TidColumn, Mode=OneTime}" />
                            <TextBlock Style="{StaticResource LogCell}" Width="32" TextAlignment="Center" Text="{Binding PriorityColumn, Mode=OneTime}" />
                            <TextBlock Style="{StaticResource LogCell}" Text="{Binding BodyColumn, Mode=OneTime}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Padding="12,6"
                    CornerRadius="4" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    Visibility="{Binding Paused, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding PausedText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>
        </Grid>
    </Grid>
</Page>
