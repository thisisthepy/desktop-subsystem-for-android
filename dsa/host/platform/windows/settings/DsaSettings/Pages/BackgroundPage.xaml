<Page
    x:Class="Dsa.Settings.Pages.BackgroundPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}">
            <TextBlock Text="{l:Text BackgroundTitle.Text}" Style="{StaticResource PageTitle}" />
            <ui:Button Content="{l:Text BackgroundRefreshButton.Content}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefresh"
                       IsEnabled="{Binding IsIdle, Mode=OneWay}" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource PageContent}">
                <TextBlock Text="{l:Text BackgroundIntro.Text}" Style="{StaticResource Note}" />

                <ProgressBar IsIndeterminate="True" Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                <ui:InfoBar Title="{l:Text BackgroundErrorBar.Title}" Severity="Error" IsClosable="False"
                            IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" Margin="0,0,0,4" />
                <ui:InfoBar Title="{l:Text BackgroundDoneBar.Title}" Severity="Success" IsClosable="False"
                            IsOpen="{Binding HasMessage, Mode=OneWay}" Message="{Binding Message, Mode=OneWay}" Margin="0,0,0,4" />

                <TextBlock Text="{l:Text BackgroundAppsHeader.Text}" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{l:Text BackgroundNone.Text}" Style="{StaticResource Note}"
                           Visibility="{Binding HasNone, Converter={StaticResource Visible}}" />
                <ItemsControl ItemsSource="{Binding Apps, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardControl Margin="0,0,0,4">
                                <ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" Margin="0,0,12,0">
                                            <Image Source="{Binding Icon, TargetNullValue={x:Null}}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescription}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="{l:Text BackgroundOpenButton.Content}" Tag="{Binding Package}" Click="OnOpen"
                                               Icon="{ui:SymbolIcon Open24}" Margin="0,0,8,0" />
                                    <ui:Button Content="{l:Text BackgroundStopButton.Content}" Tag="{Binding Package}" Click="OnStop"
                                               Icon="{ui:SymbolIcon Stop24}" />
                                </StackPanel>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{l:Text BackgroundStoppingHeader.Text}" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Icon="{ui:SymbolIcon QuestionCircle24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text BackgroundAskCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text BackgroundAskCard.Description}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding AskBeforeStop, Mode=OneWay}" Click="OnAskChanged"
                                     IsEnabled="{Binding IsIdle, Mode=OneWay}" />
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
