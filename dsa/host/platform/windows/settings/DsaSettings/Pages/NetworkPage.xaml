<Page
    x:Class="Dsa.Settings.Pages.NetworkPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}">
            <TextBlock Text="{l:Text NetworkTitle.Text}" Style="{StaticResource PageTitle}" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource PageContent}">
                <ui:InfoBar Title="{l:Text SettingsErrorBar.Title}" Severity="Error" IsClosable="False"
                            IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" Margin="0,0,0,4" />

                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Globe24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text NetworkStatusCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding NetworkModeText, Mode=OneWay}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Content="{l:Text NetworkRefreshButton.Content}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Click="OnRefresh" />
                </ui:CardControl>
                <ui:InfoBar Title="{l:Text NetworkProblemBar.Title}" Severity="Warning" IsClosable="False"
                            IsOpen="{Binding HasNetworkProblem, Mode=OneWay}" Message="{Binding NetworkProblem, Mode=OneWay}" Margin="0,0,0,4" />

                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Info24}"
                                Visibility="{Binding HasNetworkDetails, Converter={StaticResource Visible}}">
                    <ui:CardControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Text NetworkAddressLabel.Text}" Margin="0,0,16,4" />
                            <TextBox Style="{StaticResource SelectableText}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding NetworkAddresses, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Text NetworkDnsLabel.Text}" Margin="0,0,16,4" />
                            <TextBox Style="{StaticResource SelectableText}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Text="{Binding NetworkDns, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Text NetworkGatewayLabel.Text}" Margin="0,0,16,0" />
                            <TextBox Style="{StaticResource SelectableText}" Grid.Row="2" Grid.Column="1" Text="{Binding NetworkGateway, Mode=OneWay}" />
                        </Grid>
                    </ui:CardControl.Header>
                </ui:CardControl>

                <TextBlock Text="{l:Text NetworkAdvancedHeader.Text}" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PlugConnected24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text AdvancedNetworkingCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text AdvancedNetworkingCard.Description}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="AdvancedNetworkingSwitch" IsChecked="{Binding AdvancedNetworking, Mode=OneWay}"
                                     IsEnabled="{Binding CanChange, Mode=OneWay}" Click="OnAdvancedNetworkingToggled" />
                </ui:CardControl>
                <ui:InfoBar Title="{l:Text NetworkRestartBar.Title}" Message="{l:Text NetworkRestartBar.Message}"
                            Severity="Informational" IsClosable="False"
                            IsOpen="{Binding NetworkRestartNeeded, Mode=OneWay}" Margin="0,0,0,4" />

                <!-- The root certificates a user or an administrator added to this PC, which
                     Android trusts while the switch is on. The change applies at once. -->
                <TextBlock Text="{l:Text NetworkCertificatesHeader.Text}" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ShieldCheckmark24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text HostCertificatesCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text HostCertificatesCard.Description}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="HostCertificatesSwitch" IsChecked="{Binding HostCertificates, Mode=OneWay}"
                                     IsEnabled="{Binding CanChange, Mode=OneWay}" Click="OnHostCertificatesToggled"
                                     AutomationProperties.Name="{l:Text HostCertificatesCard.Header}" />
                </ui:CardControl>
                <TextBlock Text="{l:Text CertificatesNone.Text}" Style="{StaticResource Note}"
                           Visibility="{Binding HasNoImportedCertificates, Converter={StaticResource Visible}}" />
                <l:RowList ItemsSource="{Binding ImportedCertificates, Mode=OneWay}">
                    <l:RowList.ItemTemplate>
                        <DataTemplate>
                            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Certificate24}"
                                            ToolTip="{Binding Location, TargetNullValue={x:Null}}"
                                            AutomationProperties.Name="{Binding Subject}"
                                            AutomationProperties.HelpText="{Binding SourceText}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Subject}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding IssuedByText}" Style="{StaticResource CardDescription}" />
                                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource CardDescription}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                            </ui:CardControl>
                        </DataTemplate>
                    </l:RowList.ItemTemplate>
                </l:RowList>

                <TextBlock Text="{l:Text DeveloperHeader.Text}" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DeveloperBoard24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text DeveloperModeCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text DeveloperModeCard.Description}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="DeveloperModeSwitch" IsChecked="{Binding DeveloperMode, Mode=OneWay}"
                                     IsEnabled="{Binding CanChange, Mode=OneWay}" Click="OnDeveloperModeToggled" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSync24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text AdbAutoConnectCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text AdbAutoConnectCard.Description}" Style="{StaticResource CardDescription}" />
                            <TextBlock Text="{Binding AdbAutoConnectStateText, Mode=OneWay}"
                                       Style="{StaticResource CardDescription}" Margin="0,4,0,0" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="AdbAutoConnectSwitch" IsChecked="{Binding AdbAutoConnect, Mode=OneWay}"
                                     IsEnabled="{Binding CanChange, Mode=OneWay}" Click="OnAdbAutoConnectToggled"
                                     AutomationProperties.Name="{l:Text AdbAutoConnectCard.Header}" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PlugConnected24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text AdbCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text AdbCard.Description}" Style="{StaticResource CardDescription}" />
                            <Border Style="{StaticResource CodeBlock}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AdbCommand" Style="{StaticResource SelectableCode}" VerticalAlignment="Center"
                                             Text="{Binding AdbConnect, Mode=OneWay}" />
                                    <ui:Button x:Name="AdbCopyButton" Grid.Column="1" Margin="8,0,0,0" MinWidth="32" Width="32" Height="32" Padding="0"
                                               Appearance="Transparent" Icon="{ui:SymbolIcon Copy24}" Click="OnCopyAdbCommand"
                                               ToolTip="{l:Text CopyButton.ToolTip}" AutomationProperties.Name="{l:Text CopyButton.ToolTip}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel Style="{StaticResource CardControls}">
                        <TextBlock Text="{l:Text AdbPortLabel.Text}" Style="{StaticResource CardValue}" Margin="0,0,8,0" />
                        <ui:TextBox x:Name="AdbPortBox" Width="90" ClearButtonEnabled="False" Text="{Binding AdbPort, Mode=OneWay}"
                                    IsEnabled="{Binding CanChange, Mode=OneWay}" LostFocus="OnAdbPortChanged"
                                    KeyDown="OnAdbPortKeyDown" AutomationProperties.Name="{l:Text AdbPortLabel.Text}" />
                    </StackPanel>
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
