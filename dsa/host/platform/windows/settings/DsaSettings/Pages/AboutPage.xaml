<Page
    x:Class="Dsa.Settings.Pages.AboutPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}">
            <TextBlock Text="{l:Text AboutTitle.Text}" Style="{StaticResource PageTitle}" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource PageContent}">
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="32" Height="32" Margin="0,0,16,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:Text AboutProductCard.Header}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{l:Text AboutProductCard.Description}" Style="{StaticResource CardDescription}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <TextBlock x:Name="HeaderVersion" Style="{StaticResource CardValue}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Text="{l:Text AboutAppVersionCard.Header}" Style="{StaticResource CardTitle}" />
                    </ui:CardControl.Header>
                    <TextBlock x:Name="AppVersionText" Style="{StaticResource CardValue}" />
                </ui:CardControl>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Text="{l:Text AboutServiceVersionCard.Header}" Style="{StaticResource CardTitle}" />
                    </ui:CardControl.Header>
                    <TextBlock Text="{Binding ServiceVersion, Mode=OneWay}" Style="{StaticResource CardValue}" />
                </ui:CardControl>
                <ui:CardControl IsEnabled="{Binding HasAndroidVersion, Mode=OneWay}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{l:Text AboutAndroidVersionCard.Header}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Text AboutAndroidVersionCard.Description}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <TextBlock Text="{Binding AndroidVersion, Mode=OneWay}" Style="{StaticResource CardValue}" />
                </ui:CardControl>
                <ui:CardAction Click="OnOpenLicenses">
                    <StackPanel>
                        <TextBlock Text="{l:Text AboutLicenseCard.Header}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text AboutLicenseCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardControl>
                    <ui:CardControl.Header>
                        <TextBlock Text="{l:Text AboutSourceCard.Header}" Style="{StaticResource CardTitle}" />
                    </ui:CardControl.Header>
                    <ui:HyperlinkButton Content="github.com/thisisthepy/desktop-subsystem-for-android"
                                        NavigateUri="https://github.com/thisisthepy/desktop-subsystem-for-android" />
                </ui:CardControl>

                <TextBlock Text="{l:Text AboutIndependent.Text}" Style="{StaticResource Note}" Margin="1,16,0,0" />
                <TextBlock Text="{l:Text AboutTrademark.Text}" Style="{StaticResource Note}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
