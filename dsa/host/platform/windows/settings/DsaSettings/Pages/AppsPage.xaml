<Page
    x:Class="Dsa.Settings.Pages.AppsPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}">
            <TextBlock Text="{l:Text AppsTitle.Text}" Style="{StaticResource PageTitle}" />
            <ui:Button Content="{l:Text AppsRefreshButton.Content}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefresh"
                       IsEnabled="{Binding IsIdle, Mode=OneWay}" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource PageContent}">
                <TextBlock Text="{l:Text AppsIntro.Text}" Style="{StaticResource PageIntro}" />

                <ProgressBar IsIndeterminate="True" Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                <ui:InfoBar Title="{l:Text AppsErrorBar.Title}" Severity="Error" IsClosable="False"
                            IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" />
                <ui:InfoBar Title="{l:Text AppsDoneBar.Title}" Severity="Success" IsClosable="False"
                            IsOpen="{Binding HasMessage, Mode=OneWay}" Message="{Binding Message, Mode=OneWay}" />

                <!-- Android's own list of apps, as WSA's "Manage apps" opened it. -->
                <ui:CardAction Icon="{ui:SymbolIcon AppsList24}" Click="OnManage"
                               IsEnabled="{Binding IsIdle, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Text="{l:Text AppsManageCard.Title}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{l:Text AppsManageCard.Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardAction>

                <TextBlock Text="{l:Text AppsInstalledHeader.Text}" Style="{StaticResource SectionHeader}" />
                <!-- Each app's root level is chosen below once root access is on for this PC. -->
                <ui:InfoBar Title="{l:Text AppsRootOffBar.Title}" Message="{l:Text AppsRootOffBar.Message}"
                            Severity="Informational" IsClosable="False"
                            IsOpen="{Binding RootUnavailable, Mode=OneWay}" />
                <TextBlock Text="{l:Text AppsRootNote.Text}" Style="{StaticResource PageIntro}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                            Visibility="{Binding ShowAdbShellRoot, Converter={StaticResource Visible}}">
                    <TextBlock Text="{l:Text AppsAdbShell.Text}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding RootChoices}" DisplayMemberPath="Label"
                              SelectedIndex="{Binding AdbShellRootIndex, Mode=OneWay}"
                              IsEnabled="{Binding CanChangeAdbShellRoot}" ToolTip="{Binding AdbShellRootTip}"
                              Tag="com.android.shell" SelectionChanged="OnRoot" />
                </StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" PlaceholderText="{l:Text AppsSearch.PlaceholderText}"
                                Icon="{ui:SymbolIcon Search24}" IconPlacement="Right" ClearButtonEnabled="True"
                                Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1" Text="{Binding Count, Mode=OneWay}" Style="{StaticResource CardDescription}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{l:Text AppsNone.Text}" Style="{StaticResource Note}"
                           Visibility="{Binding HasNoApps, Converter={StaticResource Visible}}" />
                <TextBlock Text="{l:Text AppsNoMatch.Text}" Style="{StaticResource Note}"
                           Visibility="{Binding HasNoMatches, Converter={StaticResource Visible}}" />
                <l:RowList x:Name="AppList" ItemsSource="{Binding Rows, Mode=OneWay}">
                    <l:RowList.ItemTemplate>
                        <DataTemplate>
                            <!-- Two lines rather than a settings card: the actions together are
                                 wider than the page, and a card's header takes only the width its
                                 control leaves, so it got none and its text wrapped at every
                                 letter, which made the card taller than the window. -->
                            <Border Margin="0,0,0,4" Padding="16" CornerRadius="4"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <!-- The row a task window's App info opened the page at wears the
                                     accent colour around it, so the eye finds it. -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Apps24" FontSize="24"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding NoIcon, Converter={StaticResource Visible}}" />
                                        <Image Source="{Binding Icon, TargetNullValue={x:Null}}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitle}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescription}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource CardDescription}"
                                               VerticalAlignment="Center" Margin="16,0,0,0" />
                                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" HorizontalAlignment="Right">
                                        <ui:Button Content="{l:Text AppsOpenButton.Content}" Tag="{Binding Package}" Click="OnOpen"
                                                   Icon="{ui:SymbolIcon Open24}" Margin="8,4,0,0"
                                                   AutomationProperties.HelpText="{Binding Label}" />
                                        <ui:Button Content="{l:Text AppsInfoButton.Content}" Tag="{Binding Package}" Click="OnInfo"
                                                   Icon="{ui:SymbolIcon Info24}" Margin="8,4,0,0"
                                                   AutomationProperties.HelpText="{Binding Label}" />
                                        <ui:Button Content="{l:Text AppsDesktopShortcutButton.Content}" Tag="{Binding Package}" Click="OnDesktopShortcut"
                                                   Icon="{ui:SymbolIcon Desktop24}" Margin="8,4,0,0"
                                                   AutomationProperties.HelpText="{Binding Label}" />
                                        <ui:Button Content="{l:Text AppsUninstallButton.Content}" Tag="{Binding Package}" Click="OnUninstall"
                                                   Icon="{ui:SymbolIcon Delete24}" IsEnabled="{Binding CanUninstall}" Margin="8,4,0,0"
                                                   ToolTipService.ShowOnDisabled="True"
                                                   ToolTip="{Binding UninstallTip, TargetNullValue={x:Null}}"
                                                   AutomationProperties.HelpText="{Binding Label}" />
                                        <!-- The app's windows: whether the user resizes them, and the size they open at. -->
                                        <ui:ToggleSwitch Content="{l:Text AppsResizable.Content}" Tag="{Binding Package}"
                                                         IsChecked="{Binding Resizable, Mode=OneWay}" Click="OnResizable"
                                                         Margin="16,4,0,0" VerticalAlignment="Center"
                                                         ToolTip="{l:Text AppsResizable.ToolTip}"
                                                         AutomationProperties.HelpText="{Binding Label}" />
                                        <ComboBox Tag="{Binding Package}" MinWidth="200" Margin="16,4,0,0" VerticalAlignment="Center"
                                                  ItemsSource="{Binding DataContext.StartSizeChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  DisplayMemberPath="Label"
                                                  SelectedIndex="{Binding StartSizeIndex, Mode=OneWay}"
                                                  SelectionChanged="OnStartSize"
                                                  ToolTip="{l:Text AppsStartSize.ToolTip}"
                                                  AutomationProperties.Name="{l:Text AppsStartSize.ToolTip}"
                                                  AutomationProperties.HelpText="{Binding Label}" />
                                        <!-- How the app's windows follow a monitor of another scale: the app
                                             redraws, or its window is scaled. Auto and System never restart the app. -->
                                        <ComboBox Tag="{Binding Package}" MinWidth="200" Margin="16,4,0,0" VerticalAlignment="Center"
                                                  ItemsSource="{Binding DataContext.DpiScalingChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  DisplayMemberPath="Label"
                                                  SelectedIndex="{Binding DpiScalingIndex, Mode=OneWay}"
                                                  SelectionChanged="OnDpiScaling"
                                                  ToolTip="{Binding DpiScalingTip, TargetNullValue={l:Text AppsDpiScaling.ToolTip}}"
                                                  AutomationProperties.Name="{l:Text AppsDpiScaling.Name}"
                                                  AutomationProperties.HelpText="{Binding Label}" />
                                        <!-- Whether the app runs its ARM code through the translator. -->
                                        <ui:ToggleSwitch Content="{l:Text AppsRunAsArm.Content}" Tag="{Binding Package}"
                                                         IsChecked="{Binding RunAsArm, Mode=OneWay}" Click="OnRunAsArm"
                                                         IsEnabled="{Binding CanRunAsArm}"
                                                         Margin="16,4,0,0" VerticalAlignment="Center"
                                                         ToolTipService.ShowOnDisabled="True"
                                                         ToolTip="{Binding RunAsArmTip, TargetNullValue={x:Null}}"
                                                         AutomationProperties.HelpText="{Binding Label}" />
                                        <!-- How far the app may use root: not at all, asking an
                                             administrator each time, or without asking. -->
                                        <ComboBox Tag="{Binding Package}" MinWidth="200" Margin="16,4,0,0" VerticalAlignment="Center"
                                                  ItemsSource="{Binding DataContext.RootChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  DisplayMemberPath="Label"
                                                  SelectedIndex="{Binding RootIndex, Mode=OneWay}"
                                                  IsEnabled="{Binding CanChangeRoot}"
                                                  SelectionChanged="OnRoot"
                                                  ToolTipService.ShowOnDisabled="True"
                                                  ToolTip="{Binding RootTip, TargetNullValue={x:Null}}"
                                                  AutomationProperties.Name="{l:Text AppsRoot.Name}"
                                                  AutomationProperties.HelpText="{Binding Label}" />
                                    </WrapPanel>
                                    <!-- Why the app cannot run as ARM, where the switch is. -->
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding RunAsArmTip}"
                                               Style="{StaticResource CardDescription}" HorizontalAlignment="Right"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasRunAsArmTip, Converter={StaticResource Visible}}" />
                                    <!-- Apps that share a user ID: which, and that root is one setting for them. -->
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding RootGroupNote}"
                                               Style="{StaticResource CardDescription}" HorizontalAlignment="Right"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding HasRootGroupNote, Converter={StaticResource Visible}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </l:RowList.ItemTemplate>
                </l:RowList>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
