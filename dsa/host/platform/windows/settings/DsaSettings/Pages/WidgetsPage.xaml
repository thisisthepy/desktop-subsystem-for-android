<Page
    x:Class="Dsa.Settings.Pages.WidgetsPage"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeader}">
            <TextBlock Text="{l:Text WidgetsTitle.Text}" Style="{StaticResource PageTitle}" />
            <ui:Button Content="{l:Text WidgetsRefreshButton.Content}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Icon="{ui:SymbolIcon ArrowClockwise24}" Click="OnRefresh"
                       IsEnabled="{Binding IsIdle, Mode=OneWay}" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Style="{StaticResource PageContent}">
                <TextBlock Text="{l:Text WidgetsIntro.Text}" Style="{StaticResource PageIntro}" />

                <ProgressBar IsIndeterminate="True" Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"
                             AutomationProperties.Name="{l:Text A11y_Loading}" />
                <ui:InfoBar Title="{l:Text WidgetsErrorBar.Title}" Severity="Error" IsClosable="False"
                            IsOpen="{Binding HasError, Mode=OneWay}" Message="{Binding Error, Mode=OneWay}" />
                <ui:InfoBar Title="{l:Text WidgetsDoneBar.Title}" Severity="Success" IsClosable="False"
                            IsOpen="{Binding HasMessage, Mode=OneWay}" Message="{Binding Message, Mode=OneWay}" />

                <TextBlock Text="{l:Text WidgetsPlacedHeader.Text}" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{l:Text WidgetsPlacedNone.Text}" Style="{StaticResource Note}"
                           Visibility="{Binding HasNoPlaced, Converter={StaticResource Visible}}" />
                <l:RowList ItemsSource="{Binding Placed, Mode=OneWay}">
                    <l:RowList.ItemTemplate>
                        <DataTemplate>
                            <ui:CardControl Icon="{ui:SymbolIcon Apps24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding App}" Style="{StaticResource CardDescription}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescription}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="{l:Text WidgetsRemoveButton.Content}" Tag="{Binding Id}" Click="OnRemove"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           AutomationProperties.Name="{l:ItemName WidgetsRemoveButton.Content}" />
                            </ui:CardControl>
                        </DataTemplate>
                    </l:RowList.ItemTemplate>
                </l:RowList>

                <TextBlock Text="{l:Text WidgetsGalleryHeader.Text}" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{l:Text WidgetsGalleryNone.Text}" Style="{StaticResource Note}"
                           Visibility="{Binding HasNoOffers, Converter={StaticResource Visible}}" />
                <!-- One entry per app that offers widgets, closed until the user opens it, so an
                     app with hundreds of widgets takes one line. An open app shows its widgets as
                     a grid of cards, a page at a time; choosing a card places the widget. The
                     expander is a toggle a screen reader reads as the app's name and how many
                     widgets it has, and Space or Enter opens and closes it. -->
                <l:RowList ItemsSource="{Binding Apps, Mode=OneWay}">
                    <l:RowList.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <ui:CardExpander Tag="{Binding Package}" ContentPadding="12"
                                                 IsExpanded="{Binding IsExpanded, Mode=OneWay}"
                                                 Expanded="OnAppExpanded" Collapsed="OnAppCollapsed"
                                                 AutomationProperties.Name="{Binding Name}"
                                                 AutomationProperties.HelpText="{Binding CountText}">
                                    <ui:CardExpander.Header>
                                        <Grid Margin="0,0,12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="32" Height="32" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Apps24" FontSize="24"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding NoIcon, Converter={StaticResource Visible}}" />
                                                <Image Source="{Binding Icon, Converter={StaticResource IconImage}, ConverterParameter=32}"
                                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource CardDescription}" />
                                            </StackPanel>
                                        </Grid>
                                    </ui:CardExpander.Header>
                                    <StackPanel>
                                        <!-- The app's widgets as a grid: cards wrap to the page's width.
                                             Tab and the arrow keys move between them, and each card is
                                             a button whose name is the widget's and whose help text is
                                             its size, so a screen reader says what choosing it places. -->
                                        <l:RowList ItemsSource="{Binding Cards, Mode=OneWay}"
                                                   KeyboardNavigation.DirectionalNavigation="Contained"
                                                   AutomationProperties.Name="{Binding Name}">
                                            <l:RowList.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </l:RowList.ItemsPanel>
                                            <l:RowList.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Button Width="176" Margin="0,0,8,8" Padding="8"
                                                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                                               Tag="{Binding Provider}" Click="OnAdd"
                                                               IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Page}}"
                                                               ToolTip="{l:Text WidgetsAddButton.Content}"
                                                               AutomationProperties.Name="{Binding Label}"
                                                               AutomationProperties.HelpText="{Binding Detail}">
                                                        <StackPanel>
                                                            <Border Height="104" CornerRadius="4" Margin="0,0,0,8"
                                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                                <Grid>
                                                                    <ui:SymbolIcon Symbol="Apps24" FontSize="32"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                   Visibility="{Binding NoPreview, Converter={StaticResource Visible}}" />
                                                                    <Image Source="{Binding Preview, Converter={StaticResource IconImage}, ConverterParameter=160}"
                                                                           Stretch="Uniform" Margin="4"
                                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource CardTitle}"
                                                                       TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescription}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                </DataTemplate>
                                            </l:RowList.ItemTemplate>
                                        </l:RowList>
                                        <ui:Button Content="{Binding MoreText}" Tag="{Binding Package}" Click="OnShowMore"
                                                   Icon="{ui:SymbolIcon ChevronDown24}" Margin="0,4,0,0"
                                                   Visibility="{Binding HasMore, Converter={StaticResource Visible}}"
                                                   AutomationProperties.Name="{Binding MoreText}"
                                                   AutomationProperties.HelpText="{Binding Name}" />
                                    </StackPanel>
                                </ui:CardExpander>
                            </Grid>
                        </DataTemplate>
                    </l:RowList.ItemTemplate>
                </l:RowList>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
