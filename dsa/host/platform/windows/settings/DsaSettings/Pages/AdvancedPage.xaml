<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dsa.Settings.Pages.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer Padding="36,0,36,24">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock x:Uid="AdvancedTitle" Style="{StaticResource PageTitleStyle}" />

            <InfoBar x:Uid="SettingsErrorBar" Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

            <controls:SettingsCard x:Uid="FreezeCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9CA;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="FreezeSwitch"
                              IsOn="{x:Bind ViewModel.Freeze, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanChange, Mode=OneWay}"
                              Toggled="OnFreezeToggled" />
            </controls:SettingsCard>

            <TextBlock x:Uid="LogsHeader" Style="{StaticResource SectionHeaderStyle}" />
            <controls:SettingsCard x:Uid="UserLogsCard" IsClickEnabled="True" Click="OnOpenUserLogs">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE838;" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="ServiceLogsCard" IsClickEnabled="True" Click="OnOpenServiceLogs"
                                   Description="{x:Bind ViewModel.LogDir, Mode=OneWay}"
                                   IsEnabled="{x:Bind ViewModel.HasLogDir, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9F9;" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

            <TextBlock x:Uid="CommandLineHeader" Style="{StaticResource SectionHeaderStyle}" />
            <controls:SettingsCard x:Uid="CommandLineCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE756;" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock Text="dsa status | dsa settings | dsa memory" FontFamily="Consolas" IsTextSelectionEnabled="True" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
