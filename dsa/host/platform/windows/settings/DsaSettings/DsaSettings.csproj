<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DSA Settings: the app that shows and changes DSA's settings and state.

    It is a WPF app with WPF UI (MIT), an open source library of Windows 11 style controls,
    and is published self-contained (the .NET runtime, MIT, ships in its folder), so the
    installer copies a folder and needs no runtime installer. It asks the dsa command,
    installed beside it, for everything it shows.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Dsa.Settings</RootNamespace>
    <AssemblyName>DsaSettings</AssemblyName>
    <AssemblyTitle>DSA Settings</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <!-- win-x64 unless the build names another runtime: the installer publishes it with
         -r win-x64 or -r win-arm64 for each package, and the SDK takes the platform from
         the runtime. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- The fourteen interface languages. The app's own tables (Strings.resx and every
         Strings.<tag>.resx beside it, taken in by the SDK's default items) are built into a
         satellite for each; this list keeps the same languages of WPF's and WPF UI's own
         resources, whose Chinese ones are named zh-Hans and zh-Hant. -->
    <SatelliteResourceLanguages>en;ko;ja;zh-CN;zh-TW;zh-Hans;zh-Hant;es;fr;de;pt-BR;ru;it;vi;id;tr</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- A smaller memory footprint for an app that is open now and then and mostly waits:
         - ReadyToRun: the published assemblies carry precompiled code, so the JIT compiles
           little at start and holds less code and JIT state in memory. It applies to publish
           (the installer's build), not to a plain build.
         - Workstation, non-concurrent GC: one heap and no background GC thread with its own
           reserve. Its heap is small, so a blocking collection is a pause of milliseconds.
         - TieredPGO off: no instrumented copies of hot methods and no profile data, which
           buy a settings app nothing.
         - GCConserveMemory (below): the GC compacts sooner rather than keep fragmented space. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- Tiered compilation off: the precompiled ReadyToRun code is kept and never compiled a
         second time, so there are no call counting stubs, no second copy of each hot method
         and no background tiering work. What is not precompiled is compiled once, optimised. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <!-- Windows' own national language support for culture data, casing and sorting, as the
         .NET Framework and Windows' own apps use it, instead of loading ICU and building its
         collators and culture data in the process's heap. -->
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
    <!-- Touch and pen through Windows' pointer messages. WPF's default stylus stack loads the
         Tablet PC input libraries (wisp, tpcps, PenIMC) and runs two input threads of its own,
         each with its stack and heaps, in every WPF process, touch screen or not. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.EnablePointerSupport" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DsaSettings.Core\DsaSettings.Core.csproj" />
  </ItemGroup>

  <!-- The APK install window looks like setup: it takes setup's styles and colours from
       installer\setup-ui rather than keeping a copy of them. -->
  <ItemGroup>
    <Compile Include="..\..\installer\setup-ui\Palette.cs" Link="SetupStyle\Palette.cs" />
    <Page Include="..\..\installer\setup-ui\Styles.xaml" Link="SetupStyle\Styles.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>
</Project>
