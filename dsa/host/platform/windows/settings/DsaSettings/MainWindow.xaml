<ui:FluentWindow
    x:Class="Dsa.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings"
    xmlns:pages="clr-namespace:Dsa.Settings.Pages"
    Title="{l:Text WindowTitle}"
    Width="1040"
    Height="760"
    MinWidth="640"
    MinHeight="360"
    FontFamily="{StaticResource TextFont}"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">
    <!-- Mica on Windows 11; Windows 10 shows the theme's solid background instead. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{l:Text WindowTitle}" Grid.Row="0" Height="48">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- APK files dropped anywhere on the window are installed in Android; this bar says how
             it went. -->
        <ui:InfoBar x:Name="InstallBar" Grid.Row="1" Margin="{DynamicResource PageHeaderMargin}" IsClosable="True"
                    Title="{Binding Title, Mode=OneWay}" Message="{Binding Message, Mode=OneWay}"
                    IsOpen="{Binding IsOpen, Mode=TwoWay}" />

        <ui:NavigationView
            x:Name="Navigation"
            Grid.Row="2"
            PaneDisplayMode="Left"
            OpenPaneLength="320"
            IsBackButtonVisible="Auto"
            IsPaneToggleVisible="True">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{l:Text NavGeneral.Content}" TargetPageType="{x:Type pages:GeneralPage}"
                                       Icon="{ui:SymbolIcon Home24}" />
                <ui:NavigationViewItem Content="{l:Text NavMemory.Content}" TargetPageType="{x:Type pages:MemoryPage}"
                                       Icon="{ui:SymbolIcon DataUsage24}" />
                <ui:NavigationViewItem Content="{l:Text NavApps.Content}" TargetPageType="{x:Type pages:AppsPage}"
                                       Icon="{ui:SymbolIcon AppsList24}" />
                <ui:NavigationViewItem Content="{l:Text NavBackground.Content}" TargetPageType="{x:Type pages:BackgroundPage}"
                                       Icon="{ui:SymbolIcon Play24}" />
                <ui:NavigationViewItem Content="{l:Text NavWidgets.Content}" TargetPageType="{x:Type pages:WidgetsPage}"
                                       Icon="{ui:SymbolIcon Apps24}" />
                <ui:NavigationViewItem Content="{l:Text NavDisplay.Content}" TargetPageType="{x:Type pages:DisplayPage}"
                                       Icon="{ui:SymbolIcon Desktop24}" />
                <ui:NavigationViewItem Content="{l:Text NavUpdates.Content}" TargetPageType="{x:Type pages:UpdatesPage}"
                                       Icon="{ui:SymbolIcon ArrowSync24}" />
                <ui:NavigationViewItem Content="{l:Text NavIdentity.Content}" TargetPageType="{x:Type pages:DeviceIdentityPage}"
                                       Icon="{ui:SymbolIcon Phone24}" />
                <ui:NavigationViewItem Content="{l:Text NavNetwork.Content}" TargetPageType="{x:Type pages:NetworkPage}"
                                       Icon="{ui:SymbolIcon Globe24}" />
                <ui:NavigationViewItem Content="{l:Text NavAdvanced.Content}" TargetPageType="{x:Type pages:AdvancedPage}"
                                       Icon="{ui:SymbolIcon Settings24}" />
                <ui:NavigationViewItem Content="{l:Text NavLogs.Content}" TargetPageType="{x:Type pages:LogsPage}"
                                       Icon="{ui:SymbolIcon DocumentText24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{l:Text NavAbout.Content}" TargetPageType="{x:Type pages:AboutPage}"
                                       Icon="{ui:SymbolIcon Info24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
