<ui:FluentWindow
    x:Class="Dsa.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:l="clr-namespace:Dsa.Settings"
    xmlns:pages="clr-namespace:Dsa.Settings.Pages"
    Title="{l:Text WindowTitle}"
    Width="1040"
    Height="760"
    MinWidth="640"
    MinHeight="360"
    FontFamily="{StaticResource TextFont}"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">
    <!-- The navigation pane as Task Manager lays it out, in the open and the closed state: every
         icon, the title bar's too, is centred 24 px from the window's edge, and every label, the
         window title's too, starts 48 px from it. Rows are 40 px apart, each with a 36 px
         highlight. The library's own template (WPF UI, MIT licence, Leszek Pomianowski and WPF
         UI contributors) puts its icons 1.5 px apart and has a back button; the app has no
         sub-pages to go back from. The open pane is as wide as its longest label needs:
         the 40 px icon column (the selection bar sits in it), 4 px, the label at 14 px, and a
         12 px gap on the right, rounded up to 4. NavigationPaneWidthTests holds the arithmetic. -->
    <ui:FluentWindow.Resources>
        <ControlTemplate x:Key="PaneItemTemplate" TargetType="{x:Type ui:NavigationViewItem}">
            <Border x:Name="MainBorder" Height="36" Background="Transparent"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="IconContentPresenter" Grid.Column="0"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Content="{TemplateBinding Icon}" Focusable="False"
                                      TextElement.FontSize="16"
                                      TextElement.Foreground="{DynamicResource NavigationViewItemForeground}" />
                    <Rectangle x:Name="ActiveRectangle" Grid.Column="0" Width="3" Height="16"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Fill="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                               Opacity="0" RadiusX="1.5" RadiusY="1.5" />
                    <ContentPresenter x:Name="ElementContentPresenter" Grid.Column="1" Margin="4,0,0,0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Content="{TemplateBinding Content}" TextElement.FontSize="14"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}" />
                </Trigger>
                <Trigger Property="IsActive" Value="True">
                    <Setter TargetName="ActiveRectangle" Property="Opacity" Value="1" />
                    <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelected}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsActive" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPressed}" />
                </MultiTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPressed}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="PaneTemplate" TargetType="{x:Type ui:NavigationView}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="PaneGrid" Grid.Column="0" Width="{TemplateBinding OpenPaneLength}" Margin="4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button x:Name="PART_ToggleButton" Grid.Row="0" Width="40" Height="36" Margin="0,2,0,2"
                            HorizontalAlignment="Left" Foreground="{DynamicResource NavigationViewItemForeground}">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="ToggleBorder" Background="Transparent"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="16" Symbol="LineHorizontal320"
                                                   Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPressed}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ContentPresenter Grid.Row="1" Content="{TemplateBinding PaneHeader}" />

                    <ui:DynamicScrollViewer Grid.Row="2" Margin="0,0,-4,0" Padding="0,0,4,0" CanContentScroll="True"
                                            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <l:PaneItemsControl x:Name="PART_MenuItemsItemsControl" Grid.Row="0" Focusable="False"
                                          KeyboardNavigation.DirectionalNavigation="Contained"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <l:PaneItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </l:PaneItemsControl.ItemsPanel>
                            </l:PaneItemsControl>
                            <l:PaneItemsControl x:Name="PART_FooterMenuItemsItemsControl" Grid.Row="1" Margin="0,0,0,4" Focusable="False"
                                          KeyboardNavigation.DirectionalNavigation="Contained"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <l:PaneItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </l:PaneItemsControl.ItemsPanel>
                            </l:PaneItemsControl>
                        </Grid>
                    </ui:DynamicScrollViewer>

                    <ContentPresenter Grid.Row="3" Content="{TemplateBinding PaneFooter}" />
                </Grid>

                <Border x:Name="ContentCard" Grid.Column="1" Margin="{TemplateBinding FrameMargin}"
                        Background="{DynamicResource NavigationViewContentBackground}"
                        BorderBrush="{DynamicResource NavigationViewContentGridBorderBrush}"
                        BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0" Content="{TemplateBinding Header}"
                                          Visibility="{TemplateBinding HeaderVisibility}" />
                        <ui:NavigationViewContentPresenter x:Name="PART_NavigationViewContentPresenter" Grid.Row="1"
                                                           Padding="{TemplateBinding Padding}"
                                                           Transition="{TemplateBinding Transition}"
                                                           TransitionDuration="{TemplateBinding TransitionDuration}" />
                        <ContentPresenter Grid.Row="0" Grid.RowSpan="2" Content="{TemplateBinding ContentOverlay}" />
                    </Grid>
                </Border>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup Name="PaneStates">
                        <VisualState Name="PaneOpen">
                            <Storyboard>
                                <DoubleAnimation AccelerationRatio="0.4" Storyboard.TargetName="PaneGrid"
                                                 Storyboard.TargetProperty="Width" From="40"
                                                 To="{TemplateBinding OpenPaneLength}" Duration="0:0:.16" />
                            </Storyboard>
                        </VisualState>
                        <VisualState Name="PaneCompact">
                            <Storyboard>
                                <DoubleAnimation AccelerationRatio="0.4" Storyboard.TargetName="PaneGrid"
                                                 Storyboard.TargetProperty="Width"
                                                 From="{TemplateBinding OpenPaneLength}" To="40" Duration="0:0:.16" />
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </ControlTemplate>
    </ui:FluentWindow.Resources>

    <!-- Mica on Windows 11; Windows 10 shows the theme's solid background instead. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{l:Text WindowTitle}" Grid.Row="0" Height="48">
            <ui:TitleBar.Icon>
                <!-- 16 px wide, then 4 px here and the library's 12 px: the title starts on the labels' column. -->
                <ui:ImageIcon Width="16" Height="16" Margin="0,0,4,0" Source="pack://application:,,,/Assets/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- APK files dropped anywhere on the window are installed in Android; this bar says how
             it went. Closed, it takes no room: the library only hides what is inside it. -->
        <ui:InfoBar x:Name="InstallBar" Grid.Row="1" Margin="{DynamicResource PageHeaderMargin}" IsClosable="True"
                    Title="{Binding Title, Mode=OneWay}" Message="{Binding Message, Mode=OneWay}"
                    IsOpen="{Binding IsOpen, Mode=TwoWay}"
                    Visibility="{Binding IsOpen, Converter={StaticResource Visible}}" />

        <ui:NavigationView
            x:Name="Navigation"
            Grid.Row="2"
            PaneDisplayMode="Left"
            OpenPaneLength="236"
            Template="{StaticResource PaneTemplate}"
            ItemTemplate="{StaticResource PaneItemTemplate}"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True">
            <ui:NavigationView.MenuItems>
                <l:PaneItem Content="{l:Text NavGeneral.Content}" TargetPageType="{x:Type pages:GeneralPage}"
                                       Icon="{ui:SymbolIcon Home24}" />
                <l:PaneItem Content="{l:Text NavMemory.Content}" TargetPageType="{x:Type pages:MemoryPage}"
                                       Icon="{ui:SymbolIcon DataUsage24}" />
                <l:PaneItem Content="{l:Text NavApps.Content}" TargetPageType="{x:Type pages:AppsPage}"
                                       Icon="{ui:SymbolIcon AppsList24}" />
                <l:PaneItem Content="{l:Text NavBackground.Content}" TargetPageType="{x:Type pages:BackgroundPage}"
                                       Icon="{ui:SymbolIcon Play24}" />
                <l:PaneItem Content="{l:Text NavWidgets.Content}" TargetPageType="{x:Type pages:WidgetsPage}"
                                       Icon="{ui:SymbolIcon Apps24}" />
                <l:PaneItem Content="{l:Text NavDisplay.Content}" TargetPageType="{x:Type pages:DisplayPage}"
                                       Icon="{ui:SymbolIcon Desktop24}" />
                <l:PaneItem Content="{l:Text NavAndroid.Content}" TargetPageType="{x:Type pages:AndroidPage}"
                                       Icon="{ui:SymbolIcon Phone24}" />
                <l:PaneItem Content="{l:Text NavUpdates.Content}" TargetPageType="{x:Type pages:UpdatesPage}"
                                       Icon="{ui:SymbolIcon ArrowSync24}" />
                <l:PaneItem Content="{l:Text NavIdentity.Content}" TargetPageType="{x:Type pages:DeviceIdentityPage}"
                                       Icon="{ui:SymbolIcon Phone24}" />
                <l:PaneItem Content="{l:Text NavNetwork.Content}" TargetPageType="{x:Type pages:NetworkPage}"
                                       Icon="{ui:SymbolIcon Globe24}" />
                <l:PaneItem Content="{l:Text NavAdvanced.Content}" TargetPageType="{x:Type pages:AdvancedPage}"
                                       Icon="{ui:SymbolIcon Settings24}" />
                <l:PaneItem Content="{l:Text NavLogs.Content}" TargetPageType="{x:Type pages:LogsPage}"
                                       Icon="{ui:SymbolIcon DocumentText24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <l:PaneItem Content="{l:Text NavAbout.Content}" TargetPageType="{x:Type pages:AboutPage}"
                                       Icon="{ui:SymbolIcon Info24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
