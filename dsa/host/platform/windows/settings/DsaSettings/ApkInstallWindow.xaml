<!--
    The APK install window. It is laid out as setup's window is, and takes setup's styles and
    colours from installer\setup-ui (Styles.xaml and Palette.cs, linked into this project), so
    the two look alike: the caption bar, the hero with what is being installed, a panel for the
    screen, and the footer layer with its buttons.
-->
<Window x:Class="Dsa.Settings.ApkInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="600"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource TextFont}" FontSize="14"
        Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        AutomationProperties.AutomationId="ApkInstallWindow">
    <Window.Resources>
        <ResourceDictionary Source="/SetupStyle/Styles.xaml" />
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="Chrome" CaptionHeight="32" ResizeBorderThickness="0" CornerRadius="0"
                      GlassFrameThickness="-1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Caption bar: icon, title, minimize and close. -->
        <DockPanel Grid.Row="0">
            <Button x:Name="CaptionClose" DockPanel.Dock="Right" Style="{StaticResource CaptionCloseButton}"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCaptionClose"
                    AutomationProperties.AutomationId="CaptionCloseButton">
                <Path Width="10" Height="10" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" StrokeThickness="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button x:Name="CaptionMinimize" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCaptionMinimize"
                    AutomationProperties.AutomationId="MinimizeButton">
                <Path Width="10" Height="10" Data="M0,5.5 L10,5.5" StrokeThickness="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Image Source="pack://application:,,,/Assets/logo.png" Width="16" Height="16" Margin="12,0,10,0"
                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="CaptionTitle" FontSize="12" LineHeight="16"
                       LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Content: 24 px gutters, 16 px above. -->
        <DockPanel Grid.Row="1" Margin="24,16,24,24" LastChildFill="True">
            <!-- Hero: the app's icon and what is being installed. -->
            <DockPanel x:Name="Hero" DockPanel.Dock="Top" Height="72">
                <Image x:Name="AppIcon" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.AutomationId="AppIcon">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.16" Color="Black" />
                    </Image.Effect>
                </Image>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeroTitle" Style="{StaticResource Subtitle}" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="HeroTitle" />
                    <TextBlock x:Name="HeroPackage" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="HeroPackage" />
                    <StackPanel x:Name="Chips" Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Style="{StaticResource Chip}">
                            <TextBlock x:Name="VersionChip" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                       AutomationProperties.AutomationId="VersionChip" />
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock x:Name="SizeChip" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock x:Name="AndroidChip" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Grid Margin="0,20,0,0">
                <!-- Reading the file. -->
                <StackPanel x:Name="ReadingPanel">
                    <TextBlock x:Name="ReadingText" Style="{StaticResource BodyStrong}" />
                    <Grid x:Name="ReadingBar" Margin="0,12,0,0" Height="3" ClipToBounds="True" />
                </StackPanel>

                <!-- What the APK is, and what installing it does. -->
                <DockPanel x:Name="DetailsPanel" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="SummaryBadge" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top"
                              Visibility="Collapsed">
                            <Ellipse Fill="{DynamicResource Critical}" />
                            <Path Width="16" Height="16" Stretch="None" StrokeThickness="1.75" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Stroke="{DynamicResource CriticalText}"
                                  Data="M8,4.5 L8,8.5 M8,11.4 L8,11.5" Margin="2,2,0,0" />
                        </Grid>
                        <TextBlock x:Name="SummaryText" Grid.Column="1" Style="{StaticResource Body}"
                                   AutomationProperties.AutomationId="SummaryText" />
                    </Grid>
                    <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                      AutomationProperties.AutomationId="DetailsScroller">
                            <StackPanel>
                                <ItemsControl x:Name="FactList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="0,2,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Body}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="PermissionsHeader" Style="{StaticResource BodyStrong}" Margin="0,10,0,6"
                                           AutomationProperties.AutomationId="PermissionsHeader" />
                                <ItemsControl x:Name="PermissionList" Focusable="False"
                                              AutomationProperties.AutomationId="PermissionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,8">
                                                <Border x:Name="SensitiveChip" DockPanel.Dock="Right" Style="{StaticResource Chip}"
                                                        Margin="8,0,0,0" VerticalAlignment="Top">
                                                    <TextBlock Text="{DynamicResource SensitiveText}"
                                                               Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" />
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Sensitive}" Value="False">
                                                    <Setter TargetName="SensitiveChip" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <!-- Working: starting Android, copying the APK, Android installing it. -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" Style="{StaticResource Body}"
                                   Foreground="{DynamicResource TextSecondary}" Typography.NumeralAlignment="Tabular"
                                   TextWrapping="NoWrap" AutomationProperties.AutomationId="ProgressPercent" />
                        <TextBlock x:Name="ProgressTitle" Style="{StaticResource BodyStrong}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ProgressTitle" />
                    </DockPanel>
                    <Grid Margin="0,12,0,0">
                        <ProgressBar x:Name="Progress" Style="{StaticResource ProgressBar}"
                                     AutomationProperties.AutomationId="ProgressBar" />
                        <Grid x:Name="ProgressMarquee" Height="3" ClipToBounds="True" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="ProgressDetail" Style="{StaticResource Caption}" Margin="0,12,0,0"
                               AutomationProperties.AutomationId="ProgressDetail" />
                </StackPanel>

                <!-- Finished or failed. -->
                <Grid x:Name="ResultPanel" Visibility="Collapsed" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Height="24" Margin="0,-1,0,0" VerticalAlignment="Top">
                        <Ellipse x:Name="ResultBadge" Fill="{DynamicResource Accent}" />
                        <Path x:Name="ResultGlyph" Width="16" Height="16" Stretch="None" StrokeThickness="1.75"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{DynamicResource AccentText}" Data="M3.5,8.5 L6.5,11.5 L12.5,4.5" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock x:Name="ResultTitle" Style="{StaticResource BodyStrong}" AutomationProperties.AutomationId="ResultTitle" />
                        <TextBlock x:Name="ResultText" Style="{StaticResource Body}" Foreground="{DynamicResource TextSecondary}"
                                   AutomationProperties.AutomationId="ResultText" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- Footer: its own layer, buttons on the right. -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="24"
                Background="{DynamicResource LayerFill}" BorderBrush="{DynamicResource LayerStroke}">
            <StackPanel x:Name="Footer" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource Button}" Margin="8,0,0,0"
                        Click="OnCancel" AutomationProperties.AutomationId="CancelButton" />
                <Button x:Name="CloseButton" Style="{StaticResource Button}" Margin="8,0,0,0"
                        Click="OnClose" AutomationProperties.AutomationId="CloseButton" />
                <Button x:Name="OpenButton" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Click="OnOpen" AutomationProperties.AutomationId="OpenButton" />
                <Button x:Name="InstallButton" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Click="OnInstall" AutomationProperties.AutomationId="InstallButton" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
