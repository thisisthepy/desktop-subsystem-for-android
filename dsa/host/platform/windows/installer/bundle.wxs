<?xml version="1.0" encoding="utf-8"?>
<!--
  setup.exe: the DSA package behind this project's own setup screens (theme\).

  Build variables (-d): Version, MsiPath.

  Options lets the user choose where the program goes (InstallFolder) and where the
  service keeps its configuration, logs and Android images (DataFolder). Each user's
  Android disk is in their own profile, under %LOCALAPPDATA%\DSA, whatever is chosen.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
    <Bundle Name="Desktop Subsystem for Android"
            Manufacturer="thisisthepy"
            Version="$(Version)"
            UpgradeCode="706723c3-776c-4ab2-8402-780943fda74c"
            IconSourceFile="theme\logo.ico">
        <BootstrapperApplication>
            <bal:WixStandardBootstrapperApplication
                Theme="hyperlinkLicense"
                ThemeFile="theme\theme.xml"
                LocalizationFile="theme\theme.wxl"
                LogoFile="theme\logo.png"
                LicenseUrl="https://www.apache.org/licenses/LICENSE-2.0"
                SuppressOptionsUI="no"
                ShowVersion="yes" />
            <!-- The images theme.xml draws with, from make-theme.py. -->
            <Payload SourceFile="theme\button-primary-104-focus.png" />
            <Payload SourceFile="theme\button-primary-104-hover.png" />
            <Payload SourceFile="theme\button-primary-104-normal.png" />
            <Payload SourceFile="theme\button-primary-104-pressed.png" />
            <Payload SourceFile="theme\button-secondary-104-focus.png" />
            <Payload SourceFile="theme\button-secondary-104-hover.png" />
            <Payload SourceFile="theme\button-secondary-104-normal.png" />
            <Payload SourceFile="theme\button-secondary-104-pressed.png" />
            <Payload SourceFile="theme\button-secondary-200-focus.png" />
            <Payload SourceFile="theme\button-secondary-200-hover.png" />
            <Payload SourceFile="theme\button-secondary-200-normal.png" />
            <Payload SourceFile="theme\button-secondary-200-pressed.png" />
            <Payload SourceFile="theme\background.png" />
        </BootstrapperApplication>
        <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles64Folder]DSA" bal:Overridable="yes" />
        <Variable Name="DataFolder" Type="formatted" Value="[CommonAppDataFolder]DSA" bal:Overridable="yes" />
        <Chain>
            <MsiPackage SourceFile="$(MsiPath)" Visible="no">
                <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
                <MsiProperty Name="DATAFOLDER" Value="[DataFolder]" />
            </MsiPackage>
        </Chain>
    </Bundle>
</Wix>
