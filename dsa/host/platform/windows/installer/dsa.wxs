<?xml version="1.0" encoding="utf-8"?>
<!--
  The DSA package (MSI). build.ps1 builds it; see README.md.

  It installs dsa-hostd as the DsaHost service (SYSTEM, started automatically), the dsa
  command on the system PATH, the DSA Window Manager (dsa-wm, started at each sign-in) and
  the app window host it makes each app's window program from, the service's configuration, the guest kernel and, when the
  build has one, the first Android image. Uninstalling removes all of that, the Android
  images the service downloaded since, the setup files it downloaded to update DSA, the
  service's settings, logs and tmp folder, and in every user's profile the files, shortcuts
  and registry keys DSA made there. Each user's Android disk is in their own profile
  (%LOCALAPPDATA%\DSA\android.vhdx), so it is not part of the package and stays.

  The files follow one layout. The machine's folder (DATAFOLDER, %ProgramData%\DSA by
  default): dsa-hostd.json, images\, updates\, settings\, logs\, tmp\. Each user's
  %LOCALAPPDATA%\DSA: android.vhdx, android.image-version, apps\, notifications\, logs\,
  compositor.json, monitors.txt, start-menu.json, tmp\. The Windows host's paths module (src\paths.rs) is
  the one place that builds them. The settings app (DSA Settings) goes in the program folder's
  settings folder, with a Start menu shortcut.

  INSTALLFOLDER (the program) and DATAFOLDER (configuration, logs and images) can be set
  on the command line or from setup.exe's Options. The configuration names them as
  {program} and {data}, which the service fills in. The package records both, and a later
  version installed over it (as the service does when it updates DSA) keeps them.

  Build variables (-d): Version, ProductName (with " (test package)" after it for a
  package that only tests the installer), SourceDir (the built binaries and
  dsa-hostd.json),
  SettingsDir (the published settings app), and,
  when an image is bundled, ImageDir and ImageVersion, plus ImageManifest when the image
  is one make-image.py made (image.json, initrd.img, disk.vhdx) and ImageKernel when it
  carries its own bzImage.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
    <Package Name="$(ProductName)"
             Manufacturer="Thisisthepy"
             Version="$(Version)"
             UpgradeCode="5c08f90f-6eaa-402b-992b-6069634c45e8"
             Scope="perMachine"
             Compressed="yes">
        <!-- The new version installs over the old one before the old one is removed, so the
             files both have stay. Removing the old one first would also remove the
             configuration after costing had decided to keep it, and leave none. An edited
             configuration is kept: the package never overwrites it. A package of the same version installs over the one
             already there too, as a repair would, rather than beside it. -->
        <MajorUpgrade Schedule="afterInstallExecute"
                      AllowSameVersionUpgrades="yes"
                      DowngradeErrorMessage="A newer Desktop Subsystem for Android is already installed." />
        <!-- The trademark and independence notice, shown in Installed apps (the support
             information). The licence bundle below carries it too, in NOTICE.txt. -->
        <Property Id="ARPCOMMENTS" Value="Desktop Subsystem for Android is an independent open source project, not affiliated with, endorsed by or sponsored by Microsoft or Google. Android is a trademark of Google LLC." />
        <Media Id="1" Cabinet="dsa.cab" EmbedCab="yes" />
        <?ifdef ImageVersion ?>
        <!-- An MSI holds at most 2 GB and an image comes close to that, so the image's
             cabinet sits beside the package. setup.exe carries it inside. -->
        <Media Id="2" Cabinet="image.cab" EmbedCab="no" CompressionLevel="high" />
        <?endif?>

        <!-- Virtual Machine Platform brings vmcompute.exe. Without it no VM can run, so setup
             stops and says how to turn the feature on; it never turns it on by itself. -->
        <Property Id="VMCOMPUTE">
            <DirectorySearch Id="System64Search" Path="[System64Folder]" Depth="0">
                <FileSearch Name="vmcompute.exe" />
            </DirectorySearch>
        </Property>
        <!-- The folders an earlier installation chose. setup.exe always passes folders, its
             defaults when nobody chose others, so these win: an upgrade, run by the service
             without anyone to choose, stays where DSA is and finds its data. -->
        <Property Id="INSTALLFOLDER">
            <RegistrySearch Id="InstalledProgramFolder" Root="HKLM" Key="SOFTWARE\thisisthepy\DSA" Name="InstallFolder" Type="raw" Bitness="always64" />
        </Property>
        <Property Id="DATAFOLDER">
            <RegistrySearch Id="InstalledDataFolder" Root="HKLM" Key="SOFTWARE\thisisthepy\DSA" Name="DataFolder" Type="raw" Bitness="always64" />
        </Property>

        <Launch Condition="Installed OR VMCOMPUTE"
                Message="Desktop Subsystem for Android needs the Windows feature Virtual Machine Platform. Turn it on in Settings, System, Optional features, More Windows features (or run: dism /online /enable-feature /featurename:VirtualMachinePlatform /all), restart, and run setup again." />

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="DSA">
                <Directory Id="VMFOLDER" Name="vm" />
                <Directory Id="LICENSESFOLDER" Name="licenses" />
                <Directory Id="SETTINGSFOLDER" Name="settings" />
            </Directory>
        </StandardDirectory>
        <StandardDirectory Id="CommonAppDataFolder">
            <Directory Id="DATAFOLDER" Name="DSA">
                <Directory Id="IMAGESFOLDER" Name="images">
                    <Directory Id="IMAGESTORE" Name="images">
                        <?ifdef ImageVersion ?>
                        <Directory Id="FIRSTIMAGEFOLDER" Name="$(ImageVersion)" />
                        <?endif?>
                    </Directory>
                </Directory>
                <Directory Id="LOGFOLDER" Name="logs" />
            </Directory>
        </StandardDirectory>

        <util:CloseApplication Id="CloseWindowManager"
                               Target="dsa-wm.exe"
                               CloseMessage="yes"
                               PromptToContinue="no"
                               RebootPrompt="no" />
        <!-- Earlier releases called the window manager dsa-compositor.exe; an upgrade
             from one closes it too, so its files can be replaced. -->
        <util:CloseApplication Id="CloseCompositor"
                               Target="dsa-compositor.exe"
                               CloseMessage="yes"
                               PromptToContinue="no"
                               RebootPrompt="no" />

        <util:CloseApplication Id="CloseSettingsApp"
                               Target="DsaSettings.exe"
                               CloseMessage="yes"
                               PromptToContinue="no"
                               RebootPrompt="no" />

        <!-- The settings app and the runtimes it carries. Its shortcut is named so that
             searching the Start menu for DSA or for settings finds it. -->
        <ComponentGroup Id="SettingsApp" Directory="SETTINGSFOLDER">
            <Files Include="$(SettingsDir)\**">
                <Exclude Files="$(SettingsDir)\DsaSettings.exe" />
            </Files>
            <Component Id="SettingsExe" Guid="*">
                <File Id="SettingsExe" Source="$(SettingsDir)\DsaSettings.exe" KeyPath="yes">
                    <Shortcut Id="SettingsShortcut"
                              Directory="ProgramMenuFolder"
                              Name="DSA Settings"
                              Description="Settings and state of Desktop Subsystem for Android"
                              WorkingDirectory="SETTINGSFOLDER" />
                </File>
            </Component>
        </ComponentGroup>

        <!-- Every installation, upgrade and repair replaces every file of the package (the
             "a" of REINSTALLMODE), even one whose version is higher than the package's or
             one without a version that was changed after it was installed: Windows
             Installer's own rules would keep those, and an old program beside a new service
             cannot talk to it. The configuration alone is never overwritten, so an edited one
             stays. -->
        <Property Id="REINSTALLMODE" Value="amus" />
        <ComponentGroup Id="Service" Directory="INSTALLFOLDER">
            <Component Id="HostdExe" Guid="*">
                <File Id="HostdExe" Source="$(SourceDir)\dsa-hostd.exe" KeyPath="yes" />
                <ServiceInstall Id="DsaHost"
                                Name="DsaHost"
                                DisplayName="Desktop Subsystem for Android Service"
                                Description="Runs each user's Android in its own virtual machine and answers the dsa command and the desktop apps."
                                Type="ownProcess"
                                Start="auto"
                                ErrorControl="normal"
                                Account="LocalSystem"
                                Arguments="service &quot;[DATAFOLDER]dsa-hostd.json&quot;">
                    <PermissionEx Sddl="D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWLOCRRC;;;SU)(A;;CCLCRPLORC;;;IU)(A;;CCLCRPLORC;;;AU)" />
                    <util:ServiceConfig
                        FirstFailureActionType="restart"
                        SecondFailureActionType="restart"
                        ThirdFailureActionType="restart"
                        RestartServiceDelayInSeconds="5"
                        ResetPeriodInDays="1" />
                </ServiceInstall>
                <ServiceControl Id="DsaHost" Name="DsaHost" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
            </Component>
            <Component Id="DsaExe" Guid="*">
                <File Id="DsaExe" Source="$(SourceDir)\dsa.exe" KeyPath="yes" />
                <Environment Id="Path" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
            </Component>
            <Component Id="WindowManagerExe" Guid="*">
                <File Id="WindowManagerExe" Source="$(SourceDir)\dsa-wm.exe" KeyPath="yes" />
            </Component>
            <!-- The app window host. The window manager copies it for each Android app into
                 the user's profile (%LOCALAPPDATA%\DSA\apps\<package>\<Label>.exe), named and drawn as the app. -->
            <Component Id="AppWindowExe" Guid="*">
                <File Id="AppWindowExe" Source="$(SourceDir)\dsa-app-window.exe" KeyPath="yes" />
            </Component>
            <!-- Opening an .apk file in Explorer opens the APK install window of the settings
                 app, which shows what the file is (its name, icon, version, permissions and
                 signer), then installs it in the user's Android, starting Android when it is not
                 running, and shows how the install went. The association is the machine's, like the rest of the
                 installation, so uninstalling removes it for every user at once. A user who
                 picked another app for .apk files keeps it; DSA is then under Open with. -->
            <Component Id="ApkFileAssociation" Guid="5e3b8a2c-7d41-4f96-b0c8-2a9e6f1d4c73">
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\Dsa.ApkFile"
                               Type="string" Value="APK app package" KeyPath="yes" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\Dsa.ApkFile\DefaultIcon"
                               Type="string" Value="&quot;[INSTALLFOLDER]dsa-app-window.exe&quot;,0" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\Dsa.ApkFile\shell"
                               Type="string" Value="open" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\Dsa.ApkFile\shell\open"
                               Name="MUIVerb" Type="string" Value="Install in Android" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\Dsa.ApkFile\shell\open\command"
                               Type="string" Value="&quot;[SETTINGSFOLDER]DsaSettings.exe&quot; --install-apk &quot;%1&quot;" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.apk"
                               Type="string" Value="Dsa.ApkFile" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.apk"
                               Name="Content Type" Type="string" Value="application/vnd.android.package-archive" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\.apk\OpenWithProgids"
                               Name="Dsa.ApkFile" Type="string" Value="" />
            </Component>
            <!-- Two entries in the context menu of every file (on Windows 11, under Show more
                 options): the installed window host sends the file to the user's Android, which
                 asks which app opens it or takes it. They are the machine's, like the rest of
                 the installation, so uninstalling removes them for every user at once; entries
                 written into each user's profile would outlive DSA there. -->
            <Component Id="OpenFileInAndroid" Guid="9c6f4b1e-5d2a-4f8e-a3b7-1e0d6c9f2a41">
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\*\shell\DsaOpenInAndroidApp"
                               Name="MUIVerb" Type="string" Value="Open in an Android app" KeyPath="yes" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\*\shell\DsaOpenInAndroidApp"
                               Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]dsa-app-window.exe&quot;,0" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\*\shell\DsaOpenInAndroidApp\command"
                               Type="string" Value="&quot;[INSTALLFOLDER]dsa-app-window.exe&quot; --open-file &quot;%1&quot;" />
            </Component>
            <Component Id="ShareFileWithAndroid" Guid="2b8e7d30-6c41-4a9f-9e25-7f3a0b1c8d52">
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\*\shell\DsaShareWithAndroidApp"
                               Name="MUIVerb" Type="string" Value="Share with an Android app" KeyPath="yes" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\*\shell\DsaShareWithAndroidApp"
                               Name="Icon" Type="string" Value="&quot;[INSTALLFOLDER]dsa-app-window.exe&quot;,0" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\*\shell\DsaShareWithAndroidApp\command"
                               Type="string" Value="&quot;[INSTALLFOLDER]dsa-app-window.exe&quot; --share-file &quot;%1&quot;" />
            </Component>
            <Component Id="GfxstreamBackendDll" Guid="*">
                <File Id="GfxstreamBackendDll" Source="$(SourceDir)\gfxstream_backend.dll" KeyPath="yes" />
            </Component>
            <Component Id="WindowManagerRun" Guid="c1904da8-fec3-46a3-9d9f-676d1873a52e">
                <RegistryValue Root="HKLM"
                               Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                               Name="DsaWindowManager"
                               Type="string"
                               Value="&quot;[INSTALLFOLDER]dsa-wm.exe&quot;"
                               KeyPath="yes" />
            </Component>
            <Component Id="GuestCommunicationCommandService" Guid="6a0a012a-3eb5-44ea-86ad-953e5e01b341">
                <RegistryKey Root="HKLM"
                             Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion\Virtualization\GuestCommunicationServices\000015be-facb-11e6-bd58-64006a7986d3"
                             ForceCreateOnInstall="yes"
                             ForceDeleteOnUninstall="yes">
                    <RegistryValue Name="ElementName"
                                   Type="string"
                                   Value="Desktop Subsystem for Android Graphics Command Stream"
                                   KeyPath="yes" />
                    <PermissionEx Sddl="D:P(A;OICI;GA;;;SY)(A;OICI;GA;;;BA)(A;OICI;GA;;;OW)(A;OICI;GR;;;IU)(A;OICI;GR;;;AU)" />
                </RegistryKey>
            </Component>
            <Component Id="GuestCommunicationProcessPipeService" Guid="5b1a0e1c-5264-42b4-82a1-547dfaaef758">
                <RegistryKey Root="HKLM"
                             Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion\Virtualization\GuestCommunicationServices\000015bf-facb-11e6-bd58-64006a7986d3"
                             ForceCreateOnInstall="yes"
                             ForceDeleteOnUninstall="yes">
                    <RegistryValue Name="ElementName"
                                   Type="string"
                                   Value="Desktop Subsystem for Android Graphics Process Pipe"
                                   KeyPath="yes" />
                    <PermissionEx Sddl="D:P(A;OICI;GA;;;SY)(A;OICI;GA;;;BA)(A;OICI;GA;;;OW)(A;OICI;GR;;;IU)(A;OICI;GR;;;AU)" />
                </RegistryKey>
            </Component>
            <Component Id="NoticeFile" Guid="*">
                <File Id="NoticeFile" Source="$(SourceDir)\NOTICE.txt" KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <!-- The service's own folder: SYSTEM and Administrators only, and read access for
             Hyper-V's virtual machines (S-1-5-83-0), which open the images from it. -->
        <ComponentGroup Id="Data" Directory="DATAFOLDER">
            <Component Id="Config" Guid="*" NeverOverwrite="yes">
                <File Id="Config" Source="$(SourceDir)\dsa-hostd.json" KeyPath="yes" />
                <CreateFolder>
                    <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;GRGX;;;S-1-5-83-0)" />
                </CreateFolder>
            </Component>
            <!-- Where both folders are, for the next version to install into. -->
            <Component Id="InstalledFolders" Guid="5e6764b9-ac6a-419f-ad0e-f69724d05a5a">
                <RegistryValue Root="HKLM" Key="SOFTWARE\thisisthepy\DSA" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\thisisthepy\DSA" Name="DataFolder" Type="string" Value="[DATAFOLDER]" />
            </Component>
            <!-- Folders alone cannot have a generated GUID, so these two have fixed ones. -->
            <Component Id="LogFolder" Directory="LOGFOLDER" Guid="3881831f-c7d6-4709-9747-1f68e230d7e4">
                <CreateFolder />
            </Component>
            <Component Id="ImageStore" Directory="IMAGESTORE" Guid="bd8a3e82-b7f2-4af5-a110-fc9722072f5f">
                <CreateFolder />
            </Component>
        </ComponentGroup>

        <!-- The licence bundle for all shipped components and dependencies. -->
        <ComponentGroup Id="Licenses" Directory="LICENSESFOLDER">
            <Component Id="LicNotice" Guid="*">
                <File Id="LicNotice" Source="$(SourceDir)\licenses\NOTICE.txt" KeyPath="yes" />
            </Component>
            <Component Id="LicRust" Guid="*">
                <File Id="LicRust" Source="$(SourceDir)\licenses\rust-crates.txt" KeyPath="yes" />
            </Component>
            <Component Id="LicKernel" Guid="*">
                <File Id="LicKernel" Source="$(SourceDir)\licenses\kernel-GPL-2.0.txt" KeyPath="yes" />
            </Component>
            <Component Id="LicWix" Guid="*">
                <File Id="LicWix" Source="$(SourceDir)\licenses\wix-MS-RL.txt" KeyPath="yes" />
            </Component>
            <Component Id="LicSetupUi" Guid="*">
                <File Id="LicSetupUi" Source="$(SourceDir)\licenses\setup-ui.txt" KeyPath="yes" />
            </Component>
            <Component Id="LicSettingsApp" Guid="*">
                <File Id="LicSettingsApp" Source="$(SourceDir)\licenses\settings-app.txt" KeyPath="yes" />
            </Component>
            <Component Id="LicGfxstream" Guid="*">
                <File Id="LicGfxstream" Source="$(SourceDir)\licenses\gfxstream.txt" KeyPath="yes" />
            </Component>
            <Component Id="LicAosp" Guid="*">
                <File Id="LicAosp" Source="$(SourceDir)\licenses\aosp-notice.txt" KeyPath="yes" />
            </Component>
            <Component Id="LicApache" Guid="*">
                <File Id="LicApache" Source="$(SourceDir)\licenses\apache-2.0.txt" KeyPath="yes" />
            </Component>
            <Component Id="LicMit" Guid="*">
                <File Id="LicMit" Source="$(SourceDir)\licenses\mit.txt" KeyPath="yes" />
            </Component>
            <Component Id="LicThirdParty" Guid="*">
                <File Id="LicThirdParty" Source="$(SourceDir)\licenses\third-party-components.txt" KeyPath="yes" />
            </Component>
            <Component Id="LicKernelOffer" Guid="*">
                <File Id="LicKernelOffer" Source="$(SourceDir)\licenses\kernel-source-offer.txt" KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <!-- The kernel: readable by everyone and by the VMs. -->
        <ComponentGroup Id="Kernel" Directory="VMFOLDER">
            <Component Id="Kernel" Guid="*">
                <File Id="Kernel" Source="$(SourceDir)\bzImage" KeyPath="yes" />
                <CreateFolder>
                    <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;GRGX;;;BU)(A;OICI;GRGX;;;S-1-5-83-0)" />
                </CreateFolder>
            </Component>
        </ComponentGroup>

        <?ifdef ImageVersion ?>
        <ComponentGroup Id="FirstImage" Directory="FIRSTIMAGEFOLDER">
            <?ifdef ImageManifest ?>
            <Component Id="FirstImageManifest" Guid="*">
                <File Id="FirstImageManifest" Source="$(ImageDir)\image.json" KeyPath="yes" DiskId="2" />
            </Component>
            <Component Id="FirstImageDisk" Guid="*">
                <File Id="FirstImageDisk" Source="$(ImageDir)\disk.vhdx" KeyPath="yes" DiskId="2" />
            </Component>
            <Component Id="FirstImageInitrd" Guid="*">
                <File Id="FirstImageInitrd" Source="$(ImageDir)\initrd.img" KeyPath="yes" DiskId="2" />
            </Component>
            <?ifdef ImageKernel ?>
            <Component Id="FirstImageKernel" Guid="*">
                <File Id="FirstImageKernel" Source="$(ImageDir)\bzImage" KeyPath="yes" DiskId="2" />
            </Component>
            <?endif?>
            <?ifdef ImageNotice ?>
            <Component Id="FirstImageNotice" Guid="*">
                <File Id="FirstImageNotice" Source="$(ImageDir)\$(ImageNotice)" KeyPath="yes" DiskId="2" />
            </Component>
            <?endif?>
            <?else?>
            <Component Id="FirstImage" Guid="*">
                <File Id="FirstImage" Source="$(ImageDir)\system.vhdx" KeyPath="yes" DiskId="2" />
            </Component>
            <?endif?>
        </ComponentGroup>
        <?endif?>

        <!-- The images and setup files the service downloaded are not files of this package,
             so the service removes them itself; each user's Android disk, in their profile,
             stays. An upgrade keeps them: the new version goes on with the same images, and
             reads what the update it came from left in the updates folder. -->
        <CustomAction Id="RemoveImages"
                      FileRef="HostdExe"
                      ExeCommand="remove-images &quot;[IMAGESFOLDER]&quot;"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore" />
        <CustomAction Id="RemoveUpdates"
                      FileRef="HostdExe"
                      ExeCommand="remove-updates &quot;[DATAFOLDER]updates&quot;"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore" />
        <!-- The service's settings, logs and tmp folder in DATAFOLDER are not files of this
             package either. A users folder, where the first releases kept each user's Android
             disk, stays if a disk could not be moved out of it. -->
        <CustomAction Id="RemoveMachineData"
                      FileRef="HostdExe"
                      ExeCommand="remove-machine-data &quot;[DATAFOLDER]&quot;"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore" />
        <!-- In each user's profile the window manager made a Start menu shortcut for each
             Android app (only the ones it recorded making are removed), the files in
             %LOCALAPPDATA%\DSA (app window programs, notification icons, logs, its notes),
             and the notification keys in the user's classes (the io.github.thisisthepy.dsa-notification
             protocol and the Thisisthepy.DSA.<package> app IDs, and the dsa-notification and
             DSA.<package> names earlier versions used). All of it goes, for every user,
             signed in or not; each user's Android disk (android.vhdx, android.image-version) stays. -->
        <CustomAction Id="RemoveUserData"
                      FileRef="HostdExe"
                      ExeCommand="remove-user-data"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore" />
        <!-- Before any file is replaced or removed: every DSA program still running from the
             program folder, and each app's window program in every user's profile, in every
             session. A program left running keeps its file in use, and an old window manager
             would hold its single-instance lock against the new one. It runs from the package
             itself, since the installed dsa-hostd may be an older one that cannot do it, or
             none. Not while an upgrade removes the version before it: the new one has its
             files in place by then, and its service is running. -->
        <Binary Id="StopProgramsHost" SourceFile="$(SourceDir)\dsa-hostd.exe" />
        <CustomAction Id="StopPrograms"
                      BinaryRef="StopProgramsHost"
                      ExeCommand="stop-programs &quot;[INSTALLFOLDER]&quot;"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore" />
        <!-- Once the old version is gone too: the window manager again, for every signed-in
             user, as signing in starts it. -->
        <CustomAction Id="StartWindowManagers"
                      FileRef="HostdExe"
                      ExeCommand="start-window-managers"
                      Execute="deferred"
                      Impersonate="no"
                      Return="ignore" />
        <InstallExecuteSequence>
            <Custom Action="StopPrograms" After="StopServices" Condition="NOT UPGRADINGPRODUCTCODE" />
            <Custom Action="StartWindowManagers" After="RemoveExistingProducts" Condition="NOT REMOVE~=&quot;ALL&quot;" />
            <Custom Action="RemoveUserData" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
            <Custom Action="RemoveMachineData" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
            <Custom Action="RemoveImages" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
            <Custom Action="RemoveUpdates" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
        </InstallExecuteSequence>

        <Feature Id="Main" Title="Desktop Subsystem for Android" Level="1">
            <ComponentGroupRef Id="Service" />
            <ComponentGroupRef Id="SettingsApp" />
            <ComponentGroupRef Id="Licenses" />
            <ComponentGroupRef Id="Data" />
            <ComponentGroupRef Id="Kernel" />
            <?ifdef ImageVersion ?>
            <ComponentGroupRef Id="FirstImage" />
            <?endif?>
        </Feature>
    </Package>
</Wix>
