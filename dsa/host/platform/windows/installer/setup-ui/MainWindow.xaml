<Window x:Class="Dsa.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="415"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource TextFont}" FontSize="14"
        Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="SetupWindow">
    <Window.Resources>
        <ResourceDictionary Source="Styles.xaml" />
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <!-- No system title bar: the caption below is drawn here, and the frame (glass,
             rounded corners, shadow) stays the window manager's. -->
        <WindowChrome x:Name="Chrome" CaptionHeight="32" ResizeBorderThickness="0" CornerRadius="0"
                      GlassFrameThickness="-1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="302" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Caption bar: icon, title, minimize and close. -->
        <DockPanel x:Name="CaptionBar" Grid.Row="0">
            <Button x:Name="CaptionClose" DockPanel.Dock="Right" Style="{StaticResource CaptionCloseButton}"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCaptionClose"
                    AutomationProperties.AutomationId="CaptionCloseButton">
                <Path Width="10" Height="10" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" StrokeThickness="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button x:Name="CaptionMinimize" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCaptionMinimize"
                    AutomationProperties.AutomationId="MinimizeButton">
                <Path Width="10" Height="10" Data="M0,5.5 L10,5.5" StrokeThickness="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Image x:Name="CaptionIcon" Width="16" Height="16" Margin="12,0,10,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="CaptionTitle" FontSize="12" LineHeight="16"
                       LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Content: 24 px gutters, 16 px above. -->
        <StackPanel Grid.Row="1" Margin="24,16,24,24">
            <!-- Hero: the logo and what is being installed. -->
            <DockPanel x:Name="Hero" Height="72">
                <Image Source="pack://application:,,,/assets/logo.png" Width="72" Height="72"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.16" Color="Black" />
                    </Image.Effect>
                </Image>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeroTitle" Style="{StaticResource Subtitle}" />
                    <TextBlock x:Name="HeroPublisher" Style="{StaticResource Caption}" />
                    <StackPanel x:Name="Chips" Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Style="{StaticResource Chip}">
                            <TextBlock x:Name="VersionChip" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                        </Border>
                        <Border x:Name="AndroidChipFrame" Style="{StaticResource Chip}">
                            <TextBlock x:Name="AndroidChip" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock x:Name="ArchitectureChip" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Ready to install. -->
            <StackPanel x:Name="InstallPanel" Margin="0,20,0,0">
                <TextBlock x:Name="InstallText" Style="{StaticResource Body}" />
                <Border Margin="0,16,0,0" MinHeight="64" Padding="16,8" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}">
                    <DockPanel VerticalAlignment="Center">
                        <Path DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,16,0" VerticalAlignment="Center"
                              Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.2" StrokeLineJoin="Round"
                              Data="M2.5,5.5 A1.5,1.5 0 0 1 4,4 H7.6 L9.2,5.6 H16 A1.5,1.5 0 0 1 17.5,7.1 V14.5 A1.5,1.5 0 0 1 16,16 H4 A1.5,1.5 0 0 1 2.5,14.5 Z" />
                        <Button x:Name="ChangeButton" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                Style="{StaticResource SmallButton}" Click="OnChange"
                                AutomationProperties.AutomationId="ChangeButton" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LocationHeader" Style="{StaticResource Body}" />
                            <TextBlock x:Name="LocationProgram" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="LocationData" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock x:Name="LegalText" Style="{StaticResource Caption}" Margin="0,12,0,0" />
            </StackPanel>

            <!-- Change: both folders. -->
            <StackPanel x:Name="OptionsPanel" Visibility="Collapsed">
                <TextBlock x:Name="OptionsHeader" Style="{StaticResource Subtitle}" />
                <TextBlock x:Name="OptionsProgramLabel" Style="{StaticResource Body}" Margin="0,16,0,4" />
                <DockPanel>
                    <Button x:Name="BrowseProgram" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource SmallButton}"
                            Click="OnBrowseProgram" AutomationProperties.AutomationId="BrowseProgramButton" />
                    <TextBox x:Name="ProgramFolderBox" Style="{StaticResource TextBox}"
                             AutomationProperties.AutomationId="ProgramFolderBox" />
                </DockPanel>
                <TextBlock x:Name="OptionsDataLabel" Style="{StaticResource Body}" Margin="0,16,0,4" />
                <DockPanel>
                    <Button x:Name="BrowseData" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource SmallButton}"
                            Click="OnBrowseData" AutomationProperties.AutomationId="BrowseDataButton" />
                    <TextBox x:Name="DataFolderBox" Style="{StaticResource TextBox}"
                             AutomationProperties.AutomationId="DataFolderBox" />
                </DockPanel>
                <TextBlock x:Name="OptionsNote" Style="{StaticResource Caption}" Margin="0,12,0,0" />
            </StackPanel>

            <!-- Already installed: repair or uninstall. -->
            <StackPanel x:Name="MaintenancePanel" Margin="0,20,0,0" Visibility="Collapsed">
                <TextBlock x:Name="MaintenanceText" Style="{StaticResource Body}" />
                <TextBlock x:Name="MaintenanceLocation" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Working. -->
            <StackPanel x:Name="ProgressPanel" Margin="0,20,0,0" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" Style="{StaticResource Body}"
                               Foreground="{DynamicResource TextSecondary}" Typography.NumeralAlignment="Tabular"
                               TextWrapping="NoWrap" Text="0%" AutomationProperties.AutomationId="ProgressPercent" />
                    <TextBlock x:Name="ProgressTitle" Style="{StaticResource BodyStrong}" TextWrapping="NoWrap" />
                </DockPanel>
                <ProgressBar x:Name="Progress" Style="{StaticResource ProgressBar}" Margin="0,12,0,0"
                             AutomationProperties.AutomationId="ProgressBar" />
                <TextBlock x:Name="ProgressDetail" Style="{StaticResource Caption}" Margin="0,12,0,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Finished, failed, or nothing to do. -->
            <Grid x:Name="ResultPanel" Margin="0,20,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="24" Height="24" Margin="0,-1,0,0" VerticalAlignment="Top">
                    <Ellipse x:Name="ResultBadge" Fill="{DynamicResource Accent}" />
                    <Path x:Name="ResultGlyph" Width="16" Height="16" Stretch="None" StrokeThickness="1.75"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{DynamicResource AccentText}" Data="M3.5,8.5 L6.5,11.5 L12.5,4.5" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="ResultTitle" Style="{StaticResource BodyStrong}" AutomationProperties.AutomationId="ResultTitle" />
                    <TextBlock x:Name="ResultText" Style="{StaticResource Body}" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="ResultRestart" Style="{StaticResource Body}" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- Help: the command line. -->
            <StackPanel x:Name="HelpPanel" Visibility="Collapsed">
                <TextBlock x:Name="HelpHeader" Style="{StaticResource Subtitle}" />
                <TextBlock x:Name="HelpText" Margin="0,16,0,0" FontFamily="{StaticResource CodeFont}" FontSize="12"
                           LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </StackPanel>

        <!-- Footer: its own layer, buttons on the right. -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="24"
                Background="{DynamicResource LayerFill}" BorderBrush="{DynamicResource LayerStroke}">
            <StackPanel x:Name="Footer" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource Button}" Margin="8,0,0,0"
                        IsCancel="True" Click="OnCancel" AutomationProperties.AutomationId="CancelButton" />
                <Button x:Name="CloseButton" Style="{StaticResource Button}" Margin="8,0,0,0"
                        Click="OnClose" AutomationProperties.AutomationId="CloseButton" />
                <Button x:Name="UninstallButton" Style="{StaticResource Button}" Margin="8,0,0,0"
                        Click="OnUninstall" AutomationProperties.AutomationId="UninstallButton" />
                <Button x:Name="RepairButton" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Click="OnRepair" AutomationProperties.AutomationId="RepairButton" />
                <Button x:Name="OkButton" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Click="OnOptionsOk" AutomationProperties.AutomationId="OkButton" />
                <Button x:Name="RestartButton" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Click="OnRestart" AutomationProperties.AutomationId="RestartButton" />
                <Button x:Name="InstallButton" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Click="OnInstall" AutomationProperties.AutomationId="InstallButton" />
                <Button x:Name="DoneButton" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                        Click="OnClose" AutomationProperties.AutomationId="DoneButton" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
