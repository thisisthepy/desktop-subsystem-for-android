<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The setup screens of setup.exe: a managed bootstrapper application for WiX 5's Burn
    engine. Burn starts it as its own process and drives it through
    WixToolset.BootstrapperApplicationApi. It targets .NET Framework 4.7.2, which every
    supported Windows 10 and 11 already has, so setup needs no runtime first.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DsaSetup</AssemblyName>
    <RootNamespace>Dsa.Setup</RootNamespace>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <!-- The bundle is x64, and mbanative.dll must match the process. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <DebugType>embedded</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\logo.ico</ApplicationIcon>
    <Product>Desktop Subsystem for Android</Product>
    <Company>Thisisthepy</Company>
    <AssemblyTitle>Desktop Subsystem for Android Setup</AssemblyTitle>
    <Copyright>Copyright thisisthepy. Licensed under the Apache License 2.0.</Copyright>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="5.0.2" />
    <!-- Reference assemblies for building on a machine without the 4.7.2 targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\logo.png" />
    <Resource Include="assets\logo.ico" />
    <None Remove="assets\make-logo.py" />
  </ItemGroup>
</Project>
