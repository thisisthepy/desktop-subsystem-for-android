+VkResult VkEmulation::waitForFenceBounded(VulkanDispatch* vk, VkFence fence, const char* what) {
+    VkResult last = VK_TIMEOUT;
+    const dsa::GpuWait waited = dsa::wait_bounded(
+        [&](uint64_t timeoutNs) {
+            last = vk->vkWaitForFences(mDevice, 1, &fence, VK_TRUE, timeoutNs);
+            switch (last) {
+                case VK_SUCCESS:
+                    return dsa::GpuWait::Signaled;
+                case VK_TIMEOUT:
+                    return dsa::GpuWait::Timeout;
+                case VK_ERROR_DEVICE_LOST:
+                    return dsa::GpuWait::DeviceLost;
+                default:
+                    return dsa::GpuWait::Failed;
+            }
+        },
+        [this] { return mRemake.isLost(); });
+    switch (waited) {
+        case dsa::GpuWait::Signaled:
+            return VK_SUCCESS;
+        case dsa::GpuWait::DeviceLost:
+        case dsa::GpuWait::GivenUp:
+            return VK_ERROR_DEVICE_LOST;
+        case dsa::GpuWait::Timeout:
+            ERR("%s did not finish on the GPU in %llu ms; it is given up and the device is "
+                "checked before the next operation.",
+                what, static_cast<unsigned long long>(dsa::kGpuWaitBudgetNs / 1000000ull));
+            suspectDeviceLost();
+            return VK_TIMEOUT;
+        case dsa::GpuWait::Failed:
+            break;
+    }
+    return last;
+}
