+bool MinigbmGralloc::wantsCpuUpload(const native_handle_t* handle) {
+    // With virtio-gpu the kernel moves a CPU's writes to the host when the lock ends.
+    if (mDevice || !handle) {
+        return false;
+    }
+    cros_gralloc_handle const* cros_handle = reinterpret_cast<cros_gralloc_handle const*>(handle);
+    if (!dsa::wantsCpuUpload(static_cast<uint64_t>(cros_handle->usage))) {
+        return false;
+    }
+    return dsa::uploadLayout(cros_handle->format, cros_handle->width, cros_handle->height,
+                             hostHasYuv(renderControl()))
+        .valid();
+}
+
+int64_t MinigbmGralloc::uploadForGpu(AHardwareBuffer* ahb) {
+    const native_handle_t* handle = ahb ? AHardwareBuffer_getNativeHandle(ahb) : nullptr;
+    if (!wantsCpuUpload(handle)) {
+        return 0;
+    }
+    cros_gralloc_handle const* cros_handle = reinterpret_cast<cros_gralloc_handle const*>(handle);
+    auto* rcEnc = renderControl();
+    const uint32_t hostHandle = getHostHandle(handle);
+    if (!rcEnc || hostHandle == 0) {
+        return -ENODEV;
+    }
+    const dsa::UploadLayout layout = dsa::uploadLayout(cros_handle->format, cros_handle->width,
+                                                       cros_handle->height, hostHasYuv(rcEnc));
+    // The planes as a CPU lock maps them: the lock gives the first plane at its offset, the
+    // others follow at theirs. A gralloc lock, because a dma-buf of minigbm's could not be
+    // mapped directly in every process (see writeThroughGralloc).
+    const uint32_t planes =
+        cros_handle->num_planes < DRV_MAX_PLANES ? cros_handle->num_planes : DRV_MAX_PLANES;
+    const uint64_t first = planes ? cros_handle->offsets[0] : 0;
+    dsa::SourcePlane sources[DRV_MAX_PLANES];
+    for (uint32_t i = 0; i < planes; ++i) {
+        sources[i] = dsa::SourcePlane{
+            cros_handle->offsets[i] >= first ? cros_handle->offsets[i] - first : UINT64_MAX / 2,
+            cros_handle->strides[i]};
+    }
+    // The planes span the allocation without its metadata region.
+    const uint64_t planeBytes = cros_handle->total_size > cros_handle->reserved_region_size
+                                    ? cros_handle->total_size - cros_handle->reserved_region_size
+                                    : 0;
+    const size_t mapSize = planeBytes > first ? static_cast<size_t>(planeBytes - first) : 0;
+
+    std::lock_guard<std::mutex> lock(mUploadMutex);
+    void* mapped = nullptr;
+    int result = AHardwareBuffer_lock(ahb, AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN, -1, nullptr,
+                                      &mapped);
+    if (result != 0 || !mapped) {
+        if (!mUploadFailureLogged) {
+            mesa_loge("%s: cannot lock buffer %u to copy what the CPU wrote up to the host: %d",
+                      __func__, cros_handle->id, result);
+            mUploadFailureLogged = true;
+        }
+        return result != 0 ? result : -EINVAL;
+    }
+    const uint8_t* bytes = static_cast<const uint8_t*>(mapped);
+    const uint64_t print = dsa::fingerprint(bytes, mapSize, sources, planes, layout);
+    bool send = false;
+    if (print == 0) {
+        result = -EINVAL;
+    } else if (mUploads.needsUpload(cros_handle->id, print, false)) {
+        mUploadStaging.resize(layout.packedSize());
+        send = dsa::packPlanes(bytes, mapSize, sources, planes, layout, mUploadStaging.data());
+        if (!send) {
+            result = -EINVAL;
+        }
+    }
+    AHardwareBuffer_unlock(ahb, nullptr);
+    if (result < 0) {
+        if (!mUploadFailureLogged) {
+            mesa_loge("%s: buffer %u (%ux%u, format %#x) has planes outside its %zu bytes",
+                      __func__, cros_handle->id, cros_handle->width, cros_handle->height,
+                      cros_handle->format, mapSize);
+            mUploadFailureLogged = true;
+        }
+        return result;
+    }
+    if (!send) {
+        return 0;
+    }
+
+    // The host answers once the ColorBuffer holds the planes, before the GPU is given work.
+    const int status = rcEnc->rcUpdateColorBuffer(rcEnc, hostHandle, 0, 0, layout.callWidth,
+                                                  layout.callHeight, layout.glFormat,
+                                                  layout.glType, mUploadStaging.data());
+    const int64_t sent = static_cast<int64_t>(mUploadStaging.size());
+    if (status != 0) {
+        if (!mUploadFailureLogged) {
+            mesa_loge("%s: the host did not take what the CPU wrote into buffer %u (%ux%u, "
+                      "format %#x)",
+                      __func__, cros_handle->id, cros_handle->width, cros_handle->height,
+                      cros_handle->format);
+            mUploadFailureLogged = true;
+        }
+        return -EIO;
+    }
+    mUploads.uploaded(cros_handle->id, print);
+    timespec now = {};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    dsa::UploadRate::Report report;
+    if (mUploadRate.add(uint64_t(now.tv_sec) * 1000000000ULL + uint64_t(now.tv_nsec),
+                        static_cast<uint64_t>(sent), &report)) {
+        mesa_logd("copied %" PRIu64 " KiB that the CPU wrote up to the host in %u uploads over "
+                  "%" PRIu64 " ms",
+                  report.bytes / 1024, report.uploads, report.windowNs / 1000000);
+    }
+    return sent;
+}
