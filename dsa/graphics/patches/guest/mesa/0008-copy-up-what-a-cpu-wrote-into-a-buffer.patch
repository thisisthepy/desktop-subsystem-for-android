+void ResourceTracker::uploadForGpu() {
+#ifdef VK_USE_PLATFORM_ANDROID_KHR
+    std::vector<AHardwareBuffer*> buffers;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        if (mCpuUploads.empty()) return;
+        // Each buffer stays alive while it is copied, even if another thread frees its memory.
+        buffers.reserve(mCpuUploads.size());
+        for (const auto& entry : mCpuUploads) {
+            AHardwareBuffer_acquire(entry.second);
+            buffers.push_back(entry.second);
+        }
+    }
+    for (AHardwareBuffer* ahb : buffers) {
+        mGralloc->uploadForGpu(ahb);
+        AHardwareBuffer_release(ahb);
+    }
+#endif
