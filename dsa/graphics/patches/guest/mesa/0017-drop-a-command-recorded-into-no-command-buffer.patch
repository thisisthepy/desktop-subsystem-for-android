 #include <vulkan/vulkan.h>
 
+#include <atomic>
 #include <vector>
 
 #include "gfxstream_vk_entrypoints.h"
@@ -128,6 +129,28 @@ VK_DEFINE_NONDISP_HANDLE_CASTS(gfxstream_vk_fence, vk.base, VkFence, VK_OBJECT_T
 VK_DEFINE_NONDISP_HANDLE_CASTS(gfxstream_vk_semaphore, vk.base, VkSemaphore,
                                VK_OBJECT_TYPE_SEMAPHORE)
 
+// Whether a command recorded into `commandBuffer` is dropped because there is no command
+// buffer (VK_NULL_HANDLE): said once in the log, then the command returns. A command buffer
+// handle of 0 is not valid usage, but the app's GL driver can make it: ANGLE records the
+// release of an image it shares (an AHardwareBuffer) into a primary command buffer it has
+// not allocated when nothing else was recorded since its last submit, which a large upload
+// (64 MiB of copies to images) brings about. Followed, the handle is a read of address 0
+// plus the field's offset, and the app ends on a SIGSEGV in its upload thread. Dropped, the
+// image only misses its queue family release, which the host's single queue does not need.
+static inline bool gfxstream_vk_drop_without_command_buffer(
+    const struct gfxstream_vk_command_buffer* commandBuffer, const char* command) {
+    if (commandBuffer) {
+        return false;
+    }
+    static std::atomic<bool> said{false};
+    if (!said.exchange(true)) {
+        mesa_logw("%s was recorded into no command buffer (VK_NULL_HANDLE) and is dropped; "
+                  "later commands without one are dropped as well",
+                  command);
+    }
+    return true;
+}
+
 VkResult gfxstream_vk_wsi_init(struct gfxstream_vk_physical_device* physical_device);
 
 void gfxstream_vk_wsi_finish(struct gfxstream_vk_physical_device* physical_device);
