+++ b/src/gfxstream/guest/vulkan/gfxstream_vk_cmd.cpp
@@ -123,12 +123,14 @@ VkResult gfxstream_vk_AllocateCommandBuffers(VkDevice device,
     }
     std::vector<gfxstream_vk_command_buffer*> gfxstream_commandBuffers(
         pAllocateInfo->commandBufferCount);
+    uint32_t created = 0;
     for (uint32_t i = 0; i < pAllocateInfo->commandBufferCount; i++) {
         result =
             vk_command_buffer_createOp(&gfxstream_commandPool->vk, VK_COMMAND_BUFFER_LEVEL_PRIMARY,
                                        (vk_command_buffer**)&gfxstream_commandBuffers[i]);
         if (VK_SUCCESS == result) {
             gfxstream_commandBuffers[i]->vk.level = pAllocateInfo->level;
+            created++;
         } else {
             break;
         }
@@ -156,6 +158,17 @@ VkResult gfxstream_vk_AllocateCommandBuffers(VkDevice device,
             }
         }
     }
+    if (VK_SUCCESS != result) {
+        // Neither the guest's objects nor any handle outlive a failure: the caller gets
+        // VK_NULL_HANDLE in every element and the error (out of host or device memory), and
+        // records nothing into a command buffer that does not exist.
+        for (uint32_t i = 0; i < created; i++) {
+            vk_command_buffer_destroyOp(&gfxstream_commandBuffers[i]->vk);
+        }
+        for (uint32_t i = 0; i < pAllocateInfo->commandBufferCount; i++) {
+            pCommandBuffers[i] = VK_NULL_HANDLE;
+        }
+    }
     return result;
 }
 
