+GfxStreamConnectionManager* GfxStreamConnectionManager::replaceThreadLocalInstance(
+    GfxStreamTransportType type, VirtGpuCapset capset) {
+    auto fresh = std::make_unique<GfxStreamConnectionManager>(type, capset);
+    if (!fresh->initialize()) {
+        return nullptr;
+    }
+    gfxstream::guest::IOStream* oldStream = sThreadInfo.mgr ? sThreadInfo.mgr->mStream : nullptr;
+    // The old connections go first: their encoders hold references to the old stream.
+    sThreadInfo.mgr = std::move(fresh);
+    if (oldStream) {
+        // The manager's own reference, which closes the dead socket once nothing else holds it.
+        oldStream->decRef();
+    }
+    return sThreadInfo.mgr.get();
+}
+
 void GfxStreamConnectionManager::threadLocalExit() {
     if (sThreadInfo.mgr == nullptr) {
         return;
