+// Whether this thread's Vulkan stream to the host renderer ended, and its generation.
+static bool threadStreamLost(GfxStreamConnectionManager* mgr, uint32_t* generation) {
+    auto* vkEncoder = (gfxstream::vk::VkEncoder*)mgr->getEncoder(GFXSTREAM_CONNECTION_VULKAN);
+    if (!vkEncoder) {
+        return false;
+    }
+    if (generation) *generation = vkEncoder->streamGeneration();
+    return vkEncoder->streamLost();
+}
+
+// A thread whose stream ended before the process started Vulkan over connects again
+// (dsa_lost_stream.h). While the renderer does not answer (it is restarting), the thread keeps
+// its lost stream, whose calls report VK_ERROR_DEVICE_LOST, and tries again later.
+static thread_local std::chrono::steady_clock::time_point sLastReconnectAttempt;
+
 static GfxStreamConnectionManager* getConnectionManager(void) {
     auto transport = renderControlGetTransport();
-    return GfxStreamConnectionManager::getThreadLocalInstance(transport, kCapsetGfxStreamVulkan);
+    auto* mgr = GfxStreamConnectionManager::getThreadLocalInstance(transport, kCapsetGfxStreamVulkan);
+    uint32_t generation = 0;
+    const bool lost = mgr && threadStreamLost(mgr, &generation);
+    const auto now = std::chrono::steady_clock::now();
+    if (lost && dsa::shouldReconnect(lost, generation, now, sLastReconnectAttempt)) {
+        sLastReconnectAttempt = now;
+        if (auto* fresh = GfxStreamConnectionManager::replaceThreadLocalInstance(
+                transport, kCapsetGfxStreamVulkan)) {
+            mesa_logi("Connected to the host renderer again");
+            mgr = fresh;
+        }
+    }
+    return mgr;
+}
+
+// After a stream to the host renderer ended, an instance-level call (eglInitialize makes one)
+// starts Vulkan over: a renderer that restarted knows nothing of this process, so the process
+// registers again (a new process pipe), its sequence numbers start from zero as the
+// renderer's do, and every thread whose stream ended connects again.
+static std::mutex sStartOverMutex;
+
+static void startOverAfterStreamLoss(void) {
+    if (!dsa::StreamGenerations::anyLost()) return;
+    std::lock_guard<std::mutex> lock(sStartOverMutex);
+    if (!dsa::StreamGenerations::anyLost()) return;
+    mesa_logw("A stream to the host renderer ended; starting Vulkan over with a new connection");
+    renderControlResetProcess();
+    __atomic_store_n(&gSeqno, 0, __ATOMIC_SEQ_CST);
+    dsa::StreamGenerations::beginNew();
 }
 
