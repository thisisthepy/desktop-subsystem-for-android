+void ResourceTracker::receiveReadBack(VkDeviceMemory memory, uint64_t offset, const uint8_t* data,
+                                      uint64_t size) {
+    std::lock_guard<std::recursive_mutex> lock(mLock);
+    auto it = info_VkDeviceMemory.find(memory);
+    if (it == info_VkDeviceMemory.end() || !it->second.ptr) return;
+    auto& info = it->second;
+    const uint64_t mappedSize = info.allocationSize;
+    if (offset >= mappedSize) return;
+    if (size > mappedSize - offset) size = mappedSize - offset;
+    sReadBackReceived.fetch_add(size, std::memory_order_relaxed);
+    if (!info.shadowBlocks) {
+        memcpy(info.ptr + offset, data, size);
+        sReadBackTaken.fetch_add(size, std::memory_order_relaxed);
+        return;
+    }
