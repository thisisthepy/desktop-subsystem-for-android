+            return 0;
+        }
         sProcUID = sProcessStream->processPipeInit();
         sNeedInit = false;
     }
@@ -80,6 +85,16 @@ static uint64_t getPuid(GfxStreamConnectionManager* mgr) {
     return sProcUID;
 }
 
+void renderControlResetProcess() {
+    std::lock_guard<std::mutex> lock(sNeedInitMutex);
+    if (sProcessStream) {
+        sProcessStream->decRef();
+        sProcessStream = nullptr;
+    }
+    sProcUID = 0;
+    sNeedInit = true;
+}
