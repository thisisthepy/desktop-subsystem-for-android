     if (sNeedInit) {
         GfxStreamTransportType transport = renderControlGetTransport();
         sProcessStream = mgr->processPipeStream(transport);
+        if (!sProcessStream) {
+            // The renderer does not answer (it may be restarting); the next connection tries
