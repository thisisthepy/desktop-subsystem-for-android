+// The copies of a whole ColorBuffer between it and the staging buffer, cut into jobs of at
+// most dsa::kMaxCopyPixels each (dsa_copy_bands.h): a single-plane image in bands of rows, each
+// plane of a multi-plane one on its own. A ColorBuffer of a window maximized on a 200% monitor
+// is 2880x2048 and more, and Windows resets a GPU whose work does not yield for two seconds.
+std::vector<std::vector<VkBufferImageCopy>> boundedCopies(
+    const std::vector<VkBufferImageCopy>& copies, VkDeviceSize bufferSize) {
+    std::vector<std::vector<VkBufferImageCopy>> groups;
+    if (copies.size() == 1) {
+        const VkBufferImageCopy& whole = copies[0];
+        const uint32_t height = whole.imageExtent.height;
+        // Rows packed one after the other from the buffer's start, so a band's rows start at
+        // a whole number of rows into it.
+        const bool packed = whole.bufferOffset == 0 && whole.bufferRowLength == 0 &&
+                            whole.bufferImageHeight == 0 && whole.imageOffset.x == 0 &&
+                            whole.imageOffset.y == 0 && whole.imageExtent.depth == 1 &&
+                            height > 0 && bufferSize % height == 0;
+        if (packed) {
+            const VkDeviceSize rowBytes = bufferSize / height;
+            for (const dsa::CopyBand& band : dsa::copy_bands(whole.imageExtent.width, height)) {
+                VkBufferImageCopy part = whole;
+                part.bufferOffset = rowBytes * band.y;
+                part.imageOffset.y = static_cast<int32_t>(band.y);
+                part.imageExtent.height = band.rows;
+                groups.push_back({part});
+            }
+            return groups;
+        }
+    }
+    for (const VkBufferImageCopy& copy : copies) {
+        groups.push_back({copy});
+    }
+    return groups;
+}
+
+// Orders a job after the copies submitted before it and the layout the first one set.
+void cmdAfterEarlierCopies(VulkanDispatch* vk, VkCommandBuffer commandBuffer) {
+    VkMemoryBarrier after = {};
+    after.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+    after.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    after.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT;
+    vk->vkCmdPipelineBarrier(commandBuffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                             VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &after, 0, nullptr, 0,
+                             nullptr);
+}
