diff --git a/src/gfxstream/guest/platform/linux/LinuxVirtGpuDevice.cpp b/src/gfxstream/guest/platform/linux/LinuxVirtGpuDevice.cpp
index 533a14f..0243938 100644
--- a/src/gfxstream/guest/platform/linux/LinuxVirtGpuDevice.cpp
+++ b/src/gfxstream/guest/platform/linux/LinuxVirtGpuDevice.cpp
@@ -65,6 +65,25 @@ LinuxVirtGpuDevice::LinuxVirtGpuDevice(enum VirtGpuCapset capset, int32_t descri
         }
     }
 
+    // The first render node is not always virtio-gpu: a Hyper-V VM has none, and its node
+    // belongs to vgem or vkms, which reject every virtio-gpu ioctl. Such a device has no
+    // handle, so nothing sends it virtio-gpu commands; gfxstream then reaches the host over
+    // its stream alone.
+    drmVersionPtr version = drmGetVersion(static_cast<int>(mDeviceHandle));
+    const bool isVirtioGpu = version && version->name && strcmp(version->name, "virtio_gpu") == 0;
+    if (!isVirtioGpu) {
+        mesa_logi("The render node is %s, not virtio-gpu; not using it",
+                  version && version->name ? version->name : "unknown");
+    }
+    if (version) {
+        drmFreeVersion(version);
+    }
+    if (!isVirtioGpu) {
+        close(static_cast<int>(mDeviceHandle));
+        mDeviceHandle = -1;
+        return;
+    }
+
     for (uint32_t i = 0; i < kParamMax; i++) {
         struct drm_virtgpu_getparam get_param = {0};
         get_param.param = params[i].param;
@@ -137,7 +156,11 @@ LinuxVirtGpuDevice::LinuxVirtGpuDevice(enum VirtGpuCapset capset, int32_t descri
     }
 }
 
-LinuxVirtGpuDevice::~LinuxVirtGpuDevice() { close(mDeviceHandle); }
+LinuxVirtGpuDevice::~LinuxVirtGpuDevice() {
+    if (mDeviceHandle >= 0) {
+        close(mDeviceHandle);
+    }
+}
 
 struct VirtGpuCaps LinuxVirtGpuDevice::getCaps(void) { return mCaps; }
 
