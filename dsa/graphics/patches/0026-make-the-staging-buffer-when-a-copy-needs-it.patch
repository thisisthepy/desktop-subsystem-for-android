+bool VkEmulation::ensureStagingLocked(VkDeviceSize bytes) {
+    mStaging.lastUse = std::chrono::steady_clock::now();
+    if (mStaging.buffer != VK_NULL_HANDLE && mStaging.allocated >= bytes) {
+        return true;
+    }
+    if (bytes > mStaging.size) {
+        ERR("A copy of %llu bytes does not fit the staging buffer's %llu.",
+            static_cast<unsigned long long>(bytes),
+            static_cast<unsigned long long>(mStaging.size));
+        return false;
+    }
+    if (mDevice == VK_NULL_HANDLE) {
+        return false;
+    }
+    // A smaller one goes: every copy that used it has been waited for under mMutex.
+    releaseStagingLocked();
+
+    // Rounded up, so a window that grows a little keeps its buffer.
+    constexpr VkDeviceSize kStep = 4ull * 1048576ull;
+    const VkDeviceSize want = std::min(mStaging.size, (bytes + kStep - 1) / kStep * kStep);
+    auto dvk = mDvk;
+    VkBufferCreateInfo bufCi = {};
+    bufCi.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+    bufCi.size = want;
+    bufCi.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+    bufCi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    const VkResult made = dvk->vkCreateBuffer(mDevice, &bufCi, nullptr, &mStaging.buffer);
+    if (made != VK_SUCCESS) {
+        mStaging.buffer = VK_NULL_HANDLE;
+        noteDeviceFailure(made, "vkCreateBuffer", __func__, __LINE__);
+        return false;
+    }
+
+    VkMemoryRequirements memReqs;
+    dvk->vkGetBufferMemoryRequirements(mDevice, mStaging.buffer, &memReqs);
+    mStaging.memory = ExternalMemoryInfo{};
+    mStaging.memory.size = memReqs.size;
+    if (!getStagingMemoryTypeIndex(dvk, mDevice, &mDeviceInfo.memProps,
+                                   &mStaging.memory.typeIndex) ||
+        !((1 << mStaging.memory.typeIndex) & memReqs.memoryTypeBits)) {
+        ERR("No memory type for the staging buffer.");
+        releaseStagingLocked();
+        return false;
+    }
+    if (!allocExternalMemory(dvk, &mStaging.memory, false /* not external */,
+                             kNullopt /* deviceAlignment */)) {
+        ERR("Could not allocate the staging buffer (%llu bytes).",
+            static_cast<unsigned long long>(memReqs.size));
+        releaseStagingLocked();
+        return false;
+    }
+    const VkResult bound =
+        dvk->vkBindBufferMemory(mDevice, mStaging.buffer, mStaging.memory.memory, 0);
+    if (bound != VK_SUCCESS) {
+        ERR("Could not bind the staging buffer's memory: %s.", string_VkResult(bound));
+        releaseStagingLocked();
+        return false;
+    }
+    mStaging.allocated = want;
+    return true;
+}
+
+void VkEmulation::releaseStagingLocked() {
+    if (mDvk && mDevice != VK_NULL_HANDLE) {
+        if (mStaging.buffer != VK_NULL_HANDLE) {
+            mDvk->vkDestroyBuffer(mDevice, mStaging.buffer, nullptr);
+        }
+        freeExternalMemoryLocked(mDvk, &mStaging.memory);
+    }
+    mStaging.buffer = VK_NULL_HANDLE;
+    mStaging.memory = ExternalMemoryInfo{};
+    mStaging.allocated = 0;
+}
+
+void VkEmulation::releaseIdleStaging(std::chrono::steady_clock::duration idle) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mStaging.buffer == VK_NULL_HANDLE ||
+        std::chrono::steady_clock::now() - mStaging.lastUse < idle) {
+        return;
+    }
+    releaseStagingLocked();
+}
