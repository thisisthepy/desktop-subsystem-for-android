+static std::atomic<DeviceDispatchHook> sDeviceDispatchHook{nullptr};
+
+void setDeviceDispatchHook(DeviceDispatchHook hook) { sDeviceDispatchHook.store(hook); }
+
+void runDeviceDispatchHook(VkDevice device, VulkanDispatch* dispatch) {
+    if (DeviceDispatchHook hook = sDeviceDispatchHook.load()) {
