@@ -21,5 +21,12 @@ namespace vk {
 VulkanDispatch* vkDispatch(bool forTesting = false);
 bool vkDispatchValid(const VulkanDispatch* vk);
 
+// Called with every device dispatch table once it is filled from its device: the renderer's
+// own, each one made again after its device was lost, and each guest device's. An embedder
+// sets it to wrap entries of the table, so that what it counts follows every device.
+using DeviceDispatchHook = void (*)(VkDevice device, VulkanDispatch* dispatch);
+void setDeviceDispatchHook(DeviceDispatchHook hook);
+void runDeviceDispatchHook(VkDevice device, VulkanDispatch* dispatch);
+
 }  // namespace vk
