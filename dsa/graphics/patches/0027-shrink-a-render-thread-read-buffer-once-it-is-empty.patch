+}
+
+void ReadBuffer::shrinkWhenEmpty() {
+    if (m_size <= m_initialSize) {
+        return;
+    }
+    if (m_size <= kReleaseAtOnce && m_smallReads < kSmallReadsBeforeShrink) {
+        return;
+    }
+    auto* small = (unsigned char*)malloc(m_initialSize);
+    if (!small) {
+        return;
+    }
+    free(m_buf);
+    m_buf = small;
+    m_size = m_initialSize;
+    m_readPtr = m_buf;
+    m_smallReads = 0;
 }
 
 void ReadBuffer::onSave(android::base::Stream* stream) {
     stream->putBe32(m_size);
     stream->putBe32(m_validData);
     stream->write(m_readPtr, m_validData);
diff --git a/host/ReadBuffer.h b/host/ReadBuffer.h
