@@ -61,6 +66,34 @@ class AbortMessage {
 // A function that terminates the process should be passed in. When calling the GFXSTREAM_ABORT
 // macro, the set function will be used to terminate the process instead of std::abort.
 void setDieFunction(std::optional<std::function<void()>> newDie);
+
+// What a fatal error throws, instead of ending the process, on a thread that serves one
+// guest: the thread ends what it serves (one guest's stream, one guest process's cleanup),
+// so a guest that sends a bad command, or whose GPU device is lost, loses its own rendering
+// and every other guest and the embedder keep running.
+class GuestFatalError : public std::exception {
+   public:
+    explicit GuestFatalError(std::string message) : mMessage(std::move(message)) {}
+    const char* what() const noexcept override { return mMessage.c_str(); }
+
+   private:
+    std::string mMessage;
+};
+
+inline thread_local int tGuestFatalErrorScopes = 0;
+
+// While one lives on a thread, a fatal error on that thread throws GuestFatalError. The
+// thread must catch it where it can end the work of one guest.
+class ScopedGuestFatalErrors {
+   public:
+    ScopedGuestFatalErrors() { ++tGuestFatalErrorScopes; }
+    ~ScopedGuestFatalErrors() { --tGuestFatalErrorScopes; }
+    ScopedGuestFatalErrors(const ScopedGuestFatalErrors&) = delete;
+    ScopedGuestFatalErrors& operator=(const ScopedGuestFatalErrors&) = delete;
+};
+
+// Whether a fatal error on this thread throws GuestFatalError rather than ending the process.
+inline bool guestFatalErrorsThrow() { return tGuestFatalErrorScopes > 0; }
 }  // namespace emugl
 
 #define GFXSTREAM_ABORT(reason) ::emugl::AbortMessage(__FILE__, __func__, __LINE__, reason).stream()
