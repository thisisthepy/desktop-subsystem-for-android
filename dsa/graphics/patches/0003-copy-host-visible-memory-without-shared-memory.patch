+void ResourceTracker::flushShadowedMemory(VkEncoder* enc, VkDevice device) {
+    std::vector<VkMappedMemoryRange> ranges;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        for (const auto& [memory, info] : info_VkDeviceMemory) {
+            if (!info.shadowed || info.device != device) continue;
+            ranges.push_back({VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, nullptr, memory, 0,
+                              VK_WHOLE_SIZE});
+        }
+    }
+    if (!ranges.empty()) {
+        enc->vkFlushMappedMemoryRanges(device, ranges.size(), ranges.data(), true /* do lock */);
+    }
+}
+
+void ResourceTracker::invalidateShadowedMemory(VkEncoder* enc, VkDevice device) {
+    // Only memory the host caches for reading comes back: reading back memory the guest
+    // only writes would overwrite what it wrote since its last submit.
+    std::vector<VkMappedMemoryRange> ranges;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto deviceIt = info_VkDevice.find(device);
+        if (deviceIt == info_VkDevice.end()) return;
+        const auto& memProps = deviceIt->second.memProps;
+        for (const auto& [memory, info] : info_VkDeviceMemory) {
+            if (!info.shadowed || info.device != device) continue;
+            if (!(memProps.memoryTypes[info.memoryTypeIndex].propertyFlags &
+                  VK_MEMORY_PROPERTY_HOST_CACHED_BIT)) {
+                continue;
+            }
+            ranges.push_back({VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, nullptr, memory, 0,
+                              VK_WHOLE_SIZE});
+        }
+    }
+    if (!ranges.empty()) {
+        enc->vkInvalidateMappedMemoryRanges(device, ranges.size(), ranges.data(),
+                                            true /* do lock */);
+    }
+}
 
