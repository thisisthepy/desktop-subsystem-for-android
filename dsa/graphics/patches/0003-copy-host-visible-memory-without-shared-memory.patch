+void ResourceTracker::flushShadowedMemory(VkEncoder* enc, VkDevice device) {
+    const bool traced = inputTraceRequested();
+    const auto started = std::chrono::steady_clock::now();
+    std::vector<VkMappedMemoryRange> ranges;
+    uint64_t scanned = 0;
+    uint64_t changed = 0;
+    {
+        // Held across the scan, so another thread freeing an allocation cannot free its copy
+        // from under it.
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        for (const auto& [memory, info] : info_VkDeviceMemory) {
+            if (!info.shadowed || info.device != device || !info.shadowBlocks) continue;
+            scanned += info.shadowBlocks->size();
+            for (const dsa::ShadowBlocks::Range& range : info.shadowBlocks->changed(info.ptr)) {
+                ranges.push_back({VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, nullptr, memory,
+                                  range.offset, range.size});
+                changed += range.size;
+            }
+        }
+    }
+    const auto compared = std::chrono::steady_clock::now();
+    if (!ranges.empty()) {
+        enc->vkFlushMappedMemoryRanges(device, ranges.size(), ranges.data(), true /* do lock */);
+    }
+    if (traced) {
+        // One line per batch of submits, so tracing does not add to what it measures.
+        static constexpr uint32_t kTraceEvery = 120;
+        static std::mutex traceMutex;
+        static uint32_t submits = 0;
+        static uint64_t scannedTotal = 0;
+        static uint64_t sentTotal = 0;
+        static double scanMs = 0;
+        static double sendMs = 0;
+        using Ms = std::chrono::duration<double, std::milli>;
+        std::lock_guard<std::mutex> lock(traceMutex);
+        submits++;
+        scannedTotal += scanned;
+        sentTotal += changed;
+        scanMs += Ms(compared - started).count();
+        sendMs += Ms(std::chrono::steady_clock::now() - compared).count();
+        if (submits == kTraceEvery) {
+            mesa_logi(
+                "input-trace stage=driver.flush submits=%u scanned_mb_per_submit=%.2f "
+                "sent_kb_per_submit=%.1f scan_ms_per_submit=%.2f send_ms_per_submit=%.2f",
+                submits, scannedTotal / (1048576.0 * submits), sentTotal / (1024.0 * submits),
+                scanMs / submits, sendMs / submits);
+            submits = 0;
+            scannedTotal = sentTotal = 0;
+            scanMs = sendMs = 0;
+        }
+    }
+}
+
+void ResourceTracker::invalidateShadowedMemory(VkEncoder* enc, VkDevice device) {
+    // Only memory the host caches for reading comes back: reading back memory the guest
+    // only writes would overwrite what it wrote since its last submit.
+    std::vector<VkMappedMemoryRange> ranges;
+    {
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        auto deviceIt = info_VkDevice.find(device);
+        if (deviceIt == info_VkDevice.end()) return;
+        const auto& memProps = deviceIt->second.memProps;
+        for (const auto& [memory, info] : info_VkDeviceMemory) {
+            if (!info.shadowed || info.device != device) continue;
+            if (!(memProps.memoryTypes[info.memoryTypeIndex].propertyFlags &
+                  VK_MEMORY_PROPERTY_HOST_CACHED_BIT)) {
+                continue;
+            }
+            ranges.push_back({VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, nullptr, memory, 0,
+                              VK_WHOLE_SIZE});
+        }
+    }
+    if (!ranges.empty()) {
+        enc->vkInvalidateMappedMemoryRanges(device, ranges.size(), ranges.data(),
+                                            true /* do lock */);
+        // The copies now hold what the host sent; the next flush need not send it back.
+        std::lock_guard<std::recursive_mutex> lock(mLock);
+        for (const VkMappedMemoryRange& range : ranges) {
+            auto it = info_VkDeviceMemory.find(range.memory);
+            if (it != info_VkDeviceMemory.end() && it->second.shadowBlocks) {
+                it->second.shadowBlocks->refresh(it->second.ptr);
+            }
+        }
+    }
+}
 
