+++ b/host/vulkan/VkCommonOperations.cpp
@@ -664,6 +664,71 @@ static std::string decodeDriverVersion(uint32_t vendorId, uint32_t driverVersion
     return res;
 }
 
+namespace {
+
+std::mutex sGpuPreferenceMutex;
+GpuPreference sGpuPreference;
+int sGpuPreferenceMatched = -1;
+
+std::string lowercaseGpuName(std::string text) {
+    std::transform(text.begin(), text.end(), text.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return text;
+}
+
+const char* gpuPreferenceRuleName(GpuPreference::Rule rule) {
+    switch (rule) {
+        case GpuPreference::Rule::None:
+            return "none";
+        case GpuPreference::Rule::Luid:
+            return "LUID";
+        case GpuPreference::Rule::Integrated:
+            return "integrated";
+        case GpuPreference::Rule::Discrete:
+            return "discrete";
+        case GpuPreference::Rule::Name:
+            return "name";
+    }
+    return "unknown";
+}
+
+bool deviceMatchesGpuPreference(bool hasGraphicsQueueFamily,
+                                const VkPhysicalDeviceProperties& props,
+                                const VkPhysicalDeviceIDProperties& idProps,
+                                const GpuPreference& preference) {
+    if (!hasGraphicsQueueFamily) {
+        return false;
+    }
+    switch (preference.rule) {
+        case GpuPreference::Rule::None:
+            return false;
+        case GpuPreference::Rule::Luid:
+            return idProps.deviceLUIDValid &&
+                   std::memcmp(idProps.deviceLUID, preference.luid, VK_LUID_SIZE) == 0;
+        case GpuPreference::Rule::Integrated:
+            return props.deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU;
+        case GpuPreference::Rule::Discrete:
+            return props.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU;
+        case GpuPreference::Rule::Name:
+            return !preference.name.empty() &&
+                   lowercaseGpuName(props.deviceName).find(lowercaseGpuName(preference.name)) !=
+                       std::string::npos;
+    }
+    return false;
+}
+
+}  // namespace
+
+void setGpuPreference(const GpuPreference& preference) {
+    std::lock_guard<std::mutex> lock(sGpuPreferenceMutex);
+    sGpuPreference = preference;
+}
+
+int gpuPreferenceMatched() {
+    std::lock_guard<std::mutex> lock(sGpuPreferenceMutex);
+    return sGpuPreferenceMatched;
+}
+
 // Checks if the user enforced a specific GPU, it can be done via index or name.
 // Otherwise try to find the best device with discrete GPU and high vulkan API level.
 // Scoring of the devices is done by some implicit choices based on known driver
@@ -673,6 +738,33 @@ static std::string decodeDriverVersion(uint32_t vendorId, uint32_t driverVersion
 int VkEmulation::getSelectedGpuIndex(
     const std::vector<VkEmulation::DeviceSupportInfo>& deviceInfos) {
     const int physicalDeviceCount = deviceInfos.size();
+
+    // The embedder's preference comes first.
+    GpuPreference preference;
+    {
+        std::lock_guard<std::mutex> lock(sGpuPreferenceMutex);
+        preference = sGpuPreference;
+        sGpuPreferenceMatched = -1;
+    }
+    if (preference.rule != GpuPreference::Rule::None) {
+        for (int i = 0; i < physicalDeviceCount; ++i) {
+            if (deviceMatchesGpuPreference(deviceInfos[i].hasGraphicsQueueFamily,
+                                           deviceInfos[i].physdevProps, deviceInfos[i].idProps,
+                                           preference)) {
+                INFO("Selecting GPU (%s) at index %d, which the embedder asked for by %s.",
+                     deviceInfos[i].physdevProps.deviceName, i,
+                     gpuPreferenceRuleName(preference.rule));
+                std::lock_guard<std::mutex> lock(sGpuPreferenceMutex);
+                sGpuPreferenceMatched = 1;
+                return i;
+            }
+        }
+        WARN("No GPU matches the embedder's preference (by %s); choosing by the ranking.",
+             gpuPreferenceRuleName(preference.rule));
+        std::lock_guard<std::mutex> lock(sGpuPreferenceMutex);
+        sGpuPreferenceMatched = 0;
+    }
+
     if (physicalDeviceCount == 1) {
         return 0;
     }
