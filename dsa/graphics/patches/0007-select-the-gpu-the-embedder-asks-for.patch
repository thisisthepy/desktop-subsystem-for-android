+// The GPU an embedder asks the renderer to run on. It is tried before
+// ANDROID_EMU_VK_SELECT_GPU and the built-in ranking, and only a device with a graphics
+// queue can match it. When no device matches, the renderer chooses as if none was asked.
+struct GpuPreference {
+    enum class Rule {
+        None,        // the built-in ranking
+        Luid,        // VkPhysicalDeviceIDProperties::deviceLUID equals `luid`
+        Integrated,  // the first integrated GPU
+        Discrete,    // the first discrete GPU
+        Name,        // the first device whose name contains `name`, ignoring case
+    };
+    Rule rule = Rule::None;
+    uint8_t luid[VK_LUID_SIZE] = {};
+    std::string name;
+};
+
+// Sets the preference for the next VkEmulation::create.
+void setGpuPreference(const GpuPreference& preference);
+
+// Whether the last VkEmulation::create found a device for the preference: 1 when it did,
+// 0 when it chose by the ranking because none matched, -1 when no preference was set.
+int gpuPreferenceMatched();
+
