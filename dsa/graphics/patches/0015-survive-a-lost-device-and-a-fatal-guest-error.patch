+void makeDispatchLoseDevice(VulkanDispatch* vk) {
+    if (!vk) {
+        return;
+    }
+    vk->vkQueueSubmit = lostQueueSubmit;
+#ifdef VK_VERSION_1_3
+    vk->vkQueueSubmit2 = lostQueueSubmit2;
+#endif
+    vk->vkQueueWaitIdle = lostQueueWaitIdle;
+    vk->vkDeviceWaitIdle = lostDeviceWaitIdle;
+    vk->vkGetFenceStatus = lostGetFenceStatus;
+    vk->vkWaitForFences = lostWaitForFences;
+}
+
+Compositor::CompositionFinishedWaitable RemakeableCompositor::compose(
+    const CompositionRequest& compositionRequest) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mInner) {
+        try {
+            emugl::ScopedGuestFatalErrors guestFatalErrors;
+            return mInner->compose(compositionRequest);
+        } catch (const emugl::GuestFatalError& error) {
+            ERR("A composition was given up after a fatal error: %s", error.what());
+        }
+    }
+    std::promise<void> done;
+    done.set_value();
+    return done.get_future().share();
+}
+
+void RemakeableCompositor::onImageDestroyed(uint32_t imageId) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mInner) {
+        mInner->onImageDestroyed(imageId);
+    }
+}
+
+void RemakeableCompositor::use(CompositorVk* inner) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    mInner = inner;
+}
+
+void VkEmulation::noteDeviceFailure(VkResult result, const char* call, const char* function,
+                                    int line) {
+    ERR("%s failed with %s in %s (line %d).", call, string_VkResult(result), function, line);
+    if (result == VK_ERROR_DEVICE_LOST) {
+        mDeviceLost.store(true);
+    }
+}
+
+void VkEmulation::noteDeviceLost() { mDeviceLost.store(true); }
+
+void VkEmulation::suspectDeviceLost() { mDeviceSuspect.store(true); }
+
+bool VkEmulation::deviceLostLocked() {
+    if (mDeviceLost.load()) {
+        return true;
+    }
+    if (!mDeviceSuspect.exchange(false) || mDevice == VK_NULL_HANDLE) {
+        return false;
+    }
+    VkResult result;
+    {
+        android::base::AutoLock queueLock(*mQueueLock);
+        result = mDvk->vkQueueWaitIdle(mQueue);
+    }
+    if (result == VK_ERROR_DEVICE_LOST) {
+        mDeviceLost.store(true);
+        return true;
+    }
+    return false;
+}
+
+bool VkEmulation::recoverIfLost() {
+    if (!mDeviceLost.load() && !mDeviceSuspect.load()) {
+        return true;
+    }
+    std::unique_lock<std::shared_mutex> use(mDeviceUse);
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (!deviceLostLocked()) {
+        return mDevice != VK_NULL_HANDLE;
+    }
+    if (!remakeDeviceLocked()) {
+        return false;
+    }
+    mDeviceLost.store(false);
+    return true;
+}
+
+void VkEmulation::loseDeviceForTesting() {
+    std::unique_lock<std::shared_mutex> use(mDeviceUse);
+    std::lock_guard<std::mutex> lock(mMutex);
+    makeDispatchLoseDevice(mDvk);
+    mDeviceSuspect.store(true);
+}
+
+bool VkEmulation::makeDeviceObjectsLocked() {
+    init_vulkan_dispatch_from_device(mIvk, mDevice, mDvk);
+    auto dvk = mDvk;
+
+    if (mDeviceInfo.supportsExternalMemoryImport) {
+        mDeviceInfo.getImageMemoryRequirements2Func =
+            reinterpret_cast<PFN_vkGetImageMemoryRequirements2KHR>(
+                dvk->vkGetDeviceProcAddr(mDevice, "vkGetImageMemoryRequirements2KHR"));
+        mDeviceInfo.getBufferMemoryRequirements2Func =
+            reinterpret_cast<PFN_vkGetBufferMemoryRequirements2KHR>(
+                dvk->vkGetDeviceProcAddr(mDevice, "vkGetBufferMemoryRequirements2KHR"));
+    }
+    if (mDeviceInfo.supportsExternalMemoryExport) {
+#ifdef _WIN32
+        mDeviceInfo.getMemoryHandleFunc = reinterpret_cast<PFN_vkGetMemoryWin32HandleKHR>(
+            dvk->vkGetDeviceProcAddr(mDevice, "vkGetMemoryWin32HandleKHR"));
+#else
+        if (!mInstanceSupportsMoltenVK) {
+            mDeviceInfo.getMemoryHandleFunc = reinterpret_cast<PFN_vkGetMemoryFdKHR>(
+                dvk->vkGetDeviceProcAddr(mDevice, "vkGetMemoryFdKHR"));
+        }
+#endif
+    }
+
+    {
+        android::base::AutoLock queueLock(*mQueueLock);
+        dvk->vkGetDeviceQueue(mDevice, mQueueFamilyIndex, 0, &mQueue);
+    }
+
+    VkCommandPoolCreateInfo poolCi = {};
+    poolCi.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+    poolCi.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    poolCi.queueFamilyIndex = mQueueFamilyIndex;
+    VK_EMU_TRY(dvk->vkCreateCommandPool(mDevice, &poolCi, nullptr, &mCommandPool), false);
+
+    VkCommandBufferAllocateInfo cbAi = {};
+    cbAi.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+    cbAi.commandPool = mCommandPool;
+    cbAi.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cbAi.commandBufferCount = 1;
+    VK_EMU_TRY(dvk->vkAllocateCommandBuffers(mDevice, &cbAi, &mCommandBuffer), false);
+
+    VkFenceCreateInfo fenceCi = {};
+    fenceCi.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+    VK_EMU_TRY(dvk->vkCreateFence(mDevice, &fenceCi, nullptr, &mCommandBufferFence), false);
+
+    VkBufferCreateInfo bufCi = {};
+    bufCi.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+    bufCi.size = mStaging.size;
+    bufCi.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+    bufCi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    VK_EMU_TRY(dvk->vkCreateBuffer(mDevice, &bufCi, nullptr, &mStaging.buffer), false);
+
+    VkMemoryRequirements memReqs;
+    dvk->vkGetBufferMemoryRequirements(mDevice, mStaging.buffer, &memReqs);
+    mStaging.memory = ExternalMemoryInfo{};
+    mStaging.memory.size = memReqs.size;
+    if (!getStagingMemoryTypeIndex(dvk, mDevice, &mDeviceInfo.memProps,
+                                   &mStaging.memory.typeIndex) ||
+        !((1 << mStaging.memory.typeIndex) & memReqs.memoryTypeBits)) {
+        ERR("No memory type for the staging buffer of the new Vulkan device.");
+        return false;
+    }
+    if (!allocExternalMemory(dvk, &mStaging.memory, false /* not external */,
+                             kNullopt /* deviceAlignment */)) {
+        ERR("Could not allocate the staging buffer of the new Vulkan device.");
+        return false;
+    }
+    VK_EMU_TRY(dvk->vkBindBufferMemory(mDevice, mStaging.buffer, mStaging.memory.memory, 0),
+               false);
+    return true;
+}
