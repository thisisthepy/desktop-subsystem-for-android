+// The FrameBuffer's context structure read lock, held while the GL decoders run. A fatal
+// error in a decoder unwinds through it, and the lock must not stay held after the thread
+// has ended its stream, or every context change after it would wait forever.
+class ContextStructureReadLock {
+   public:
+    ContextStructureReadLock() { FrameBuffer::getFB()->lockContextStructureRead(); }
+    ~ContextStructureReadLock() { unlock(); }
+    void unlock() {
+        if (mLocked) {
+            mLocked = false;
+            FrameBuffer::getFB()->unlockContextStructureRead();
+        }
+    }
+    ContextStructureReadLock(const ContextStructureReadLock&) = delete;
+    ContextStructureReadLock& operator=(const ContextStructureReadLock&) = delete;
+
+   private:
+    bool mLocked = true;
+};
