+bool VkEmulation::remakeDeviceLocked() {
+    ERR("The renderer's Vulkan device on %s was lost (the GPU was reset); making a new one.",
+        mDeviceInfo.physdevProps.deviceName);
+    auto vk = mDvk;
+
+    if (mDevice != VK_NULL_HANDLE) {
+        // Nothing runs on a lost device any more, so nothing is waited for, and Vulkan lets
+        // every object of a lost device be destroyed.
+        for (auto& retired : mRetired) {
