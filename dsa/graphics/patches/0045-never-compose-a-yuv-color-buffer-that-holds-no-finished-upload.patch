+bool VkEmulation::colorBufferAwaitsPicture(uint32_t colorBufferHandle,
+                                           dsa::YuvPicture* picture) {
+    // Under the lock every upload holds from its first job to its last, so an upload on
+    // another render thread is either not begun or finished, never half way.
+    std::lock_guard<std::mutex> lock(mMutex);
+    auto colorBufferInfo = android::base::find(mColorBuffers, colorBufferHandle);
+    if (!colorBufferInfo) {
+        return false;
+    }
+    const VkFormat format = colorBufferInfo->imageCreateInfoShallow.format;
+    if (format != VK_FORMAT_G8_B8R8_2PLANE_420_UNORM &&
+        format != VK_FORMAT_G8_B8_R8_3PLANE_420_UNORM) {
+        return false;
+    }
+    if (dsa::yuvPictureComposable(colorBufferInfo->picture)) {
+        return false;
+    }
+    *picture = colorBufferInfo->picture;
+    return true;
+}
