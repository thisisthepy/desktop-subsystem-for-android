+bool FrameBuffer::dsaCompositionAwaitsPicture(const ComposeLayer* layers, size_t count,
+                                              uint32_t target) {
+    if (!m_emulationVk) {
+        return false;
+    }
+    for (size_t i = 0; i < count; ++i) {
+        const ComposeLayer& layer = layers[i];
+        if (layer.composeMode == HWC2_COMPOSITION_SOLID_COLOR || layer.cbHandle == 0) {
+            continue;
+        }
+        dsa::YuvPicture picture = dsa::YuvPicture::None;
+        if (!m_emulationVk->colorBufferAwaitsPicture(layer.cbHandle, &picture)) {
+            continue;
+        }
+        std::string line;
+        if (dsaYuvPictures().compositionHeld(picture, dsaNowNs(), &line)) {
+            WARN("%s (the last: ColorBuffer %u, composed into ColorBuffer %u).", line.c_str(),
+                 layer.cbHandle, target);
+        }
+        return true;
+    }
+    return false;
+}
