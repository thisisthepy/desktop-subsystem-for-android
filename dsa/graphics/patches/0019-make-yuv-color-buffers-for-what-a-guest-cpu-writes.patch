+
+bool FrameBuffer::updateColorBufferFromDsaPackedYuv(HandleType p_colorbuffer, const void* bytes,
+                                                    size_t size) {
+    AutoLock mutex(m_lock);
+    ColorBufferPtr colorBuffer = findColorBuffer(p_colorbuffer);
+    if (!colorBuffer) {
+        return false;
+    }
+    const FrameworkFormat frameworkFormat = colorBuffer->getFrameworkFormat();
+    VkFormat vkFormat;
+    if (frameworkFormat == FRAMEWORK_FORMAT_YV12) {
+        vkFormat = VK_FORMAT_G8_B8_R8_3PLANE_420_UNORM;
+    } else if (frameworkFormat == FRAMEWORK_FORMAT_NV12) {
+        vkFormat = VK_FORMAT_G8_B8R8_2PLANE_420_UNORM;
+    } else {
+        return false;
+    }
+    const uint32_t width = colorBuffer->getWidth();
+    const uint32_t height = colorBuffer->getHeight();
+    VkDeviceSize expected = 0;
+    if (!vk::getFormatTransferInfo(vkFormat, width, height, &expected, nullptr) ||
+        expected != size) {
+        ERR("ColorBuffer %u (%ux%u YUV) was sent %zu bytes of planes, not %llu", p_colorbuffer,
+            width, height, size, static_cast<unsigned long long>(expected));
+        return false;
+    }
+    return colorBuffer->updateFromBytes(0, 0, static_cast<int>(width), static_cast<int>(height),
+                                        frameworkFormat, GL_RGBA, GL_UNSIGNED_BYTE, bytes);
+}
