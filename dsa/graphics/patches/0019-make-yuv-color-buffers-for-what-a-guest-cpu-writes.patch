+bool VkEmulation::supportsYuvColorBuffer(FrameworkFormat frameworkFormat) const {
+    VkFormat vkFormat;
+    switch (frameworkFormat) {
+        case FrameworkFormat::FRAMEWORK_FORMAT_NV12:
+            vkFormat = VK_FORMAT_G8_B8R8_2PLANE_420_UNORM;
+            break;
+        case FrameworkFormat::FRAMEWORK_FORMAT_YV12:
+            vkFormat = VK_FORMAT_G8_B8_R8_3PLANE_420_UNORM;
+            break;
+        default:
+            return false;
+    }
+    constexpr VkFormatFeatureFlags kNeeded =
+        VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+    // Sampled and written by a copy, as a 2D image of optimal tiling, with the external
+    // memory every ColorBuffer is made with where the device exports memory.
+    bool sampled = false;
+    bool written = false;
+    for (const auto& supportInfo : mImageSupportInfo) {
+        if (supportInfo.format != vkFormat || !supportInfo.supported ||
+            supportInfo.type != VK_IMAGE_TYPE_2D ||
+            supportInfo.tiling != VK_IMAGE_TILING_OPTIMAL ||
+            (supportInfo.formatProps2.formatProperties.optimalTilingFeatures & kNeeded) !=
+                kNeeded ||
+            (mDeviceInfo.supportsExternalMemoryExport && !supportInfo.supportsExternalMemory)) {
+            continue;
+        }
+        sampled = sampled || supportInfo.usageFlags == VK_IMAGE_USAGE_SAMPLED_BIT;
+        written = written || supportInfo.usageFlags == VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    }
+    return sampled && written;
+}
