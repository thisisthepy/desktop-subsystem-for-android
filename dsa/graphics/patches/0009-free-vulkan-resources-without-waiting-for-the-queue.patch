+void VkEmulation::retireLocked(RetiredResource resource) {
+    auto vk = mDvk;
+    // An empty submission's fence signals once all work submitted to the queue before it
+    // is done: exactly the work that may still use the resource.
+    VkFenceCreateInfo fenceInfo = {};
+    fenceInfo.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+    VkResult result = vk->vkCreateFence(mDevice, &fenceInfo, nullptr, &resource.fence);
+    if (result == VK_SUCCESS) {
+        android::base::AutoLock queueLock(*mQueueLock);
+        result = vk->vkQueueSubmit(mQueue, 0, nullptr, resource.fence);
+    }
+    if (result != VK_SUCCESS) {
+        // Without a fence the only safe point is an idle queue.
+        if (resource.fence != VK_NULL_HANDLE) {
+            vk->vkDestroyFence(mDevice, resource.fence, nullptr);
+            resource.fence = VK_NULL_HANDLE;
+        }
+        {
+            android::base::AutoLock queueLock(*mQueueLock);
+            VK_CHECK(vk->vkQueueWaitIdle(mQueue));
+        }
+        destroyRetiredLocked(&resource);
+        return;
+    }
+    mRetired.push_back(std::move(resource));
+}
+
+void VkEmulation::freeRetiredLocked(bool wait) {
+    auto vk = mDvk;
+    auto it = mRetired.begin();
+    while (it != mRetired.end()) {
+        const VkResult status =
+            wait ? vk->vkWaitForFences(mDevice, 1, &it->fence, VK_TRUE, UINT64_MAX)
+                 : vk->vkGetFenceStatus(mDevice, it->fence);
+        if (status == VK_NOT_READY || status == VK_TIMEOUT) {
+            ++it;
+            continue;
+        }
+        // Signaled, or the device is lost and nothing will use the resource again.
+        destroyRetiredLocked(&*it);
+        it = mRetired.erase(it);
+    }
+}
+
+void VkEmulation::destroyRetiredLocked(RetiredResource* resource) {
+    auto vk = mDvk;
+    if (resource->imageView != VK_NULL_HANDLE) {
+        vk->vkDestroyImageView(mDevice, resource->imageView, nullptr);
+    }
+    if (resource->ycbcrConversion != VK_NULL_HANDLE) {
+        vk->vkDestroySamplerYcbcrConversion(mDevice, resource->ycbcrConversion, nullptr);
+    }
+    if (resource->image != VK_NULL_HANDLE) {
+        vk->vkDestroyImage(mDevice, resource->image, nullptr);
+    }
+    if (resource->buffer != VK_NULL_HANDLE) {
+        vk->vkDestroyBuffer(mDevice, resource->buffer, nullptr);
+    }
+    freeExternalMemoryLocked(vk, &resource->memory);
+    if (resource->fence != VK_NULL_HANDLE) {
+        vk->vkDestroyFence(mDevice, resource->fence, nullptr);
+    }
+    *resource = RetiredResource{};
+}
