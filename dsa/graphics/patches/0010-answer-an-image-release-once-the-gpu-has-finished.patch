+    // device of its own, so no queue order puts the app's drawing before the composition, and
+    // a guest without fences from the host learns the image is ready only from this answer.
+    // Holds no lock while it waits, so one app's frame does not stop the others' commands.
+    void waitForImageRelease(VkImage image) {
+        std::optional<CancelableFuture> release;
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            auto* imageInfo = android::base::find(mImageInfo, image);
+            if (imageInfo && imageInfo->anbInfo) {
+                release = imageInfo->anbInfo->latestRelease();
+            }
+        }
+        if (release) {
+            release->wait();
+        }
+    }
