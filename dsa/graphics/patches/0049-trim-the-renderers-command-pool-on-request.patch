+void VkEmulation::trimCommandPool() {
+    // The pool's command buffers are recorded and allocated under mMutex, which is all the
+    // external synchronization vkTrimCommandPool asks for; pending ones are not affected.
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (!mDvk || mDevice == VK_NULL_HANDLE || mCommandPool == VK_NULL_HANDLE ||
+        !mDvk->vkTrimCommandPool) {
+        return;
+    }
+    mDvk->vkTrimCommandPool(mDevice, mCommandPool, 0);
+}
