     bool supportsYuvColorBuffer(FrameworkFormat frameworkFormat) const;
+    // The tiling of a device-local ColorBuffer of this format, and of every image a guest
+    // binds to its memory, which must be made the same way. Linear for an 8-bit 4:2:0 YUV
+    // format the device samples, copies and exports in linear tiling, so no driver keeps its
+    // pictures compressed; optimal otherwise.
+    VkImageTiling colorBufferTiling(VkFormat format) const;
 
     bool createVkColorBuffer(uint32_t width, uint32_t height, GLenum format,
                              FrameworkFormat frameworkFormat, uint32_t colorBufferHandle,
diff --git a/host/vulkan/VkDecoderGlobalState.cpp b/host/vulkan/VkDecoderGlobalState.cpp
--- a/host/vulkan/VkDecoderGlobalState.cpp
+++ b/host/vulkan/VkDecoderGlobalState.cpp
@@ -8039,6 +8039,13 @@
                 // For AHardwareBufferImage binding, we can't know which ColorBuffer this
                 // to-be-created VkImage will bind to, so we try our best to infer the creation
                 // parameters.
+                if (imageCreateInfo.tiling == VK_IMAGE_TILING_OPTIMAL) {
+                    // A device-local ColorBuffer of a YUV format may be linear, so that no
+                    // driver keeps what the host copies into it compressed; the image that
+                    // reads it must be made the same way, or it reads the planes in another
+                    // layout. A guest asks for optimal, which it cannot tell apart.
+                    imageCreateInfo.tiling = m_vkEmulation->colorBufferTiling(resolvedFormat);
+                }
