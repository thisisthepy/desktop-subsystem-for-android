# Memory allocation profiling for the guest kernel, merged last and only when asked for:
#
#   dsa/kernel/build.sh --memory-profile [--arch arm64]
#
# It is never part of the kernel DSA ships. It is for the memory measurement: the guest's
# kernel memory that /proc/meminfo puts in no line of its own (drivers, DMA, page structs and
# the pages subsystems take straight from the page allocator) can then be read by the place in
# the source that allocated it. /proc/allocinfo lists every allocation site with the bytes it
# holds now and how many allocations make them up, and dsa-channeld --memory-report writes its
# largest sites to the kernel log beside the slab caches and vmalloc users.
#
# The profiling costs memory itself: a tag for each allocation site, per-CPU counters for each
# tag, and a reference from every page and every slab object to its tag (8 bytes each), about
# 1% of the guest's memory. A profiled kernel's totals are therefore larger than the shipped
# kernel's; read what each site holds, not the sums.

# The counters, on from boot so allocations made while the kernel starts are counted too.
CONFIG_MEM_ALLOC_PROFILING=y
CONFIG_MEM_ALLOC_PROFILING_ENABLED_BY_DEFAULT=y
