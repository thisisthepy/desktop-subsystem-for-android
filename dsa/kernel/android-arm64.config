# The arm64 guest kernel only: merged after android.config on top of
# Microsoft/config-wsl-arm64, for ARM64 Windows hosts.
#
# config-wsl-arm64 has every option below. They are named here because the arm64 VM cannot
# boot, reach the host or hand memory back without them, so the build fails if a newer WSL
# tag ever drops one. build.sh checks that every line took effect.

# Boot: Hyper-V on ARM64 has no direct Linux boot. Its UEFI firmware starts the kernel's EFI
# stub, which loads the initrd named on its command line, and the machine is described by
# ACPI.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ACPI=y

# Console: the VM's first serial port is a PL011 UART (ttyAMA0), connected to the host's
# console pipe like COM1 on x86_64.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# Hyper-V: VMBus and its synthetic devices (storage, network, the integration services that
# keep time and shut down), the hypervisor's timer, and Hyper-V sockets for the control
# channel and graphics remoting.
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_TIMER=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_VSOCKETS=y
CONFIG_HYPERV_VSOCKETS=y

# Memory returned to the host, as on x86_64. On ARM64 the balloon driver only reports free
# pages; it has no memory hot-add.
CONFIG_HYPERV_BALLOON=y
CONFIG_PAGE_REPORTING=y

# 4 KiB pages: the host's free page reporting order counts them (5 is 128 KiB), and the
# Android arm64 userspace and apps are built for them.
CONFIG_ARM64_4K_PAGES=y
