# The guest kernel: the WSL kernel configuration (Microsoft/config-wsl at the tag in
# wsl-kernel.tag), with these options merged on top.
#
# The guest kernel ships as one image with no modules, so everything Android needs is
# built in (=y), including options config-wsl builds as modules. build.sh checks after the
# merge that every line below took effect, because Kconfig silently drops an option whose
# dependencies are not met.

# The release string. config-wsl names its kernel after WSL; this one is DSA's.
CONFIG_LOCALVERSION="-dsa"

# Binder, built in so it uses the kernel's own symbols. This AOSP init expects the
# three global device nodes before it mounts binderfs.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Power: the power HAL holds wake locks through /sys/power/wake_lock.
CONFIG_PM_WAKELOCKS=y

# Memory sharing: Android uses memfd instead of the obsolete ashmem driver. libcutils
# takes memfd only when memfds also answer the ashmem ioctls (patches/memfd-ashmem-shim.patch).
CONFIG_MEMFD_CREATE=y
CONFIG_MEMFD_ASHMEM_SHIM=y

# Memory returned to the host. The Hyper-V balloon driver reports free guest pages to the
# host (free page reporting, at the order the VM's command line gives), so Hyper-V can take
# back memory the guest has freed. Compaction gathers free pages into the 2 MiB blocks it
# reports. config-wsl has these too; they are named here because the guest's idle memory
# reaches the host only through them. patches/page-reporting-rereport.patch lets the idle
# reclaim report every free page again (page_reporting.rereport), for free pages a host that
# backs memory in clusters has taken in again after they were reported.
CONFIG_HYPERV_BALLOON=y
CONFIG_PAGE_REPORTING=y
CONFIG_COMPACTION=y

# Compressed swap in memory (zram), as Android devices use: idle apps' pages are kept
# compressed instead of resident, and the guest's init turns it on (dsa-memory.rc). LZ4 is
# the compressor Android uses for it, fast enough to swap on every reclaim; zstd compresses
# better for pages that stay swapped. With a second compressor (multi-compression), the
# idle reclaim compresses again with zstd what is already in zram, so the pages of apps that
# stay idle take about a fifth less, while pages swapped in and out as apps are used stay LZ4.
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_MULTI_COMP=y
# What stays cold in zram longer still goes to a backing file on the guest's data disk
# (writeback), so it costs the host disk space instead of memory. zram keeps when each page was
# last used, so only pages untouched for a long while are written, and the daily write budget
# (writeback_limit) keeps the disk's wear small. patches/zram-recompress-keeps-access-time.patch
# keeps that time when zstd compresses a page again, which is not a use.
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_TRACK_ENTRY_ACTIME=y

# The slab caches' sizes, for the memory measurement. config-wsl turns SLUB's debugging support
# off, and with it /proc/slabinfo and the per-cache object and slab counts, so the guest's
# largest kernel cost (about 100 MiB of slab it cannot reclaim, with Google Play) could only be
# read as one sum. The support costs a few counters for each cache; no checks run unless the
# command line asks for them (slab_debug=), and nothing here does.
CONFIG_SLUB_DEBUG=y
# CONFIG_SLUB_DEBUG_ON is not set

# Pressure stall information: lmkd decides when to end cached apps from memory pressure, not
# from free memory, which zram keeps low on purpose.
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

# Memory cgroups with the unified hierarchy's memory.reclaim: the gradual trim while apps are
# open asks the kernel for a bounded amount from the coldest pages of the app and system
# cgroups, rather than dropping every cache, hot pages of running apps included.
CONFIG_MEMCG=y

# The multi-generational LRU, as Android devices use: it ages pages by when they were last
# used, so a bounded memory.reclaim takes cache no app has touched for a while and leaves the
# working set of the app in use. The classic LRU picks far less precisely, and a trim of it can
# evict pages the visible app reads again at once.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Graphics buffers: the dma-buf heaps and DRM. The image's gralloc (minigbm) has no vgem
# backend, and Hyper-V has no virtio-gpu, so it allocates dumb buffers from a vkms card.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y
CONFIG_DRM=y
CONFIG_DRM_VGEM=y
CONFIG_DRM_VKMS=y

# Graphics remoting and the control channel use Hyper-V sockets.  The Linux guest end is
# AF_VSOCK, backed by Hyper-V's VMBus transport, so it must be built in with the rest of
# the VM drivers rather than loaded from a module after Android starts.
CONFIG_VSOCKETS=y
CONFIG_HYPERV_VSOCKETS=y

# File sharing: the user's host folders are mounted in Android's shared storage with the 9p
# file system, on a Hyper-V socket the guest's daemon opens and hands to the kernel
# (trans=fd), the way WSL mounts drvfs. Built in, since Android loads no modules for it.
CONFIG_NET_9P=y
CONFIG_NET_9P_FD=y
CONFIG_9P_FS=y

# Networking: the VM's synthetic network adapter (hv_netvsc), which the host connects to the
# NAT network it makes for this VM, or to the LAN in advanced networking. Built in, because
# the image has no modules. Android sees that adapter as Wi-Fi: the image's setup_wifi
# renames it and puts a virt_wifi link (wlan0) on top, as Cuttlefish does with its virtio
# adapter, so apps get the unmetered Wi-Fi network they expect on a PC. virt_wifi needs the
# wireless configuration API (cfg80211) and the WLAN driver menu.
CONFIG_HYPERV_NET=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_VIRT_WIFI=y

# The host hands each boot's control channel secret to the guest as bootconfig appended to
# the initrd. The guest reads it from /proc/bootconfig, which apps cannot read, unlike
# properties.
CONFIG_BOOT_CONFIG=y

# Scheduling: Android's task profiles set utilisation clamps per task and per cgroup.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# The controllers the image's cgroups.json mounts: cpu, cpuset and blkio as cgroup v1,
# freezer and memory in the unified hierarchy. config-wsl has them; they are named here so
# the build fails if it ever drops one. patches/cgroup-v1-sys-nice.patch lets system_server
# move apps between the v1 groups.
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_FREEZER=y

# Input: the agent injects host input through uinput; HAL clients read evdev.
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_UHID=y

# Storage: file-based encryption and fs-verity for /data and APKs, erofs and f2fs images,
# dm-crypt, blake2b for the dm-verity hash trees that use it, and disk quotas for per-app
# storage accounting.
CONFIG_CMDLINE_PARTITION=y
CONFIG_FS_ENCRYPTION=y
CONFIG_CRYPTO_HCTR2=y
CONFIG_FS_VERITY=y
CONFIG_CRYPTO_BLAKE2B=y
CONFIG_EROFS_FS=y
CONFIG_F2FS_FS=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_TRUSTED_KEYS=y
# config-wsl-arm64 builds device mapper as a module, which would hold dm-crypt to a
# module too; it is built in like the rest of the storage stack.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_QFMT_V2=y

# Networking: netd's traffic accounting and firewall use eBPF and these netfilter matches,
# and closes sockets with SOCK_DESTROY.
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_RAW=y
# The guest's DNS is answered by the host's resolver: dsa-channeld's root helper redirects
# every DNS query a program sends to port 53 to the daemon's stub on the loopback address
# (nat OUTPUT, REDIRECT). IPv4 has its NAT table below; this is IPv6's, for a network whose
# DNS servers are IPv6 addresses.
CONFIG_IP6_NF_NAT=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y

# The rest of the firewall, traffic control and IPsec rules netd and the connectivity
# stack install, as Android 16's kernel requirements (android-base.config) list them.
# They must be built in: the image ships no kernel modules, and netd exits when it
# cannot create the filter and mangle tables.
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_XCBC=y
CONFIG_DUMMY=y
# IFB redirects ingress traffic with the mirred action, so it needs that built in too.
CONFIG_NET_ACT_MIRRED=y
CONFIG_IFB=y
CONFIG_INET6_ESP=y
CONFIG_INET6_IPCOMP=y
CONFIG_INET_ESP=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IPV6_MIP6=y
CONFIG_IPV6_VTI=y
CONFIG_IP_NF_ARPFILTER=y
CONFIG_IP_NF_ARPTABLES=y
CONFIG_IP_NF_ARP_MANGLE=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_MATCH_ECN=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP_NF_MATCH_TTL=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_HELPER=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_POLICY=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_U32=y
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNSECMARK=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_SECMARK=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_EMATCH_U32=y
CONFIG_NET_IPGRE_DEMUX=y
CONFIG_NET_IPVTI=y
CONFIG_NET_KEY=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_TBF=y
CONFIG_NF_CONNTRACK_AMANDA=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_H323=y
CONFIG_NF_CONNTRACK_IRC=y
CONFIG_NF_CONNTRACK_NETBIOS_NS=y
CONFIG_NF_CONNTRACK_PPTP=y
CONFIG_NF_CONNTRACK_SANE=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_CT_NETLINK=y
CONFIG_XFRM_INTERFACE=y
CONFIG_XFRM_USER=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_TUN=y

# What config-wsl builds in for a WSL distribution and the guest never uses. The kernel's code
# and data stay resident for the VM's whole life (they are never paged out or reported free),
# so each of these cost memory in every guest for nothing: about 3 MiB together, most of it
# XFS. Android's disks are erofs, ext4 and f2fs (ext4 mounts an ext2 file system if one ever
# comes), with vfat for removable storage; the VM's disks are Hyper-V SCSI or
# virtio, never NVMe; the initrd is an initramfs, not a RAM disk. Android never asks the kernel
# to merge identical pages (KSM), and kallsyms keeps the functions' names, which traces and
# crash reports use, without every variable's. Live patching needs every name and goes with
# them, which costs nothing here: it patches through modules, and this kernel loads none.
# CONFIG_XFS_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_EXT2_FS is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_KSM is not set
# CONFIG_KALLSYMS_ALL is not set

# Preemption. config-wsl builds a server's kernel, which runs kernel code to its next
# voluntary reschedule while a real-time thread that has woken waits. Android's vsync,
# SurfaceFlinger and input threads expect to run at once, as on every Android kernel.
# CONFIG_PREEMPT_NONE is not set
CONFIG_PREEMPT=y

# pstore on a disk (pstore/blk): the kernel keeps its last messages, an oops's report and
# Android's last log lines (pmsg) on a small disk the host attaches, and shows them in
# /sys/fs/pstore at the next boot. A panic ends the VM, so RAM (ramoops) would keep nothing.
# The host names the disk's partition on the kernel command line (README.md says how, and
# what a panic leaves behind); the diagnostics carry what is there.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_ZONE=y
CONFIG_PSTORE_BLK=y
# CONFIG_PSTORE_RAM is not set
# The pstore disk's partition is found by its GPT partition UUID.
CONFIG_EFI_PARTITION=y

# Root elevation: the su binary of the image exists only for the Android uids the host has
# allowed. The DSA su guard, a small built-in LSM, returns -ENOENT for a lookup,
# stat, access, open or exec of a watched su inode by any other task, so su is a file that is
# not there. The host's control daemon drives it through securityfs, which SECURITYFS provides.
# Built in, because the image ships no kernel modules. The guest's control daemon has it hide su
# from every app when it starts, and shows su only to the apps the host names while root
# elevation is on.
CONFIG_SECURITYFS=y
CONFIG_DSA_SU_GUARD=y
# A security module the LSM list does not name never initialises. The list is the WSL
# kernel's, with dsa_su before selinux, so a hidden su is ENOENT rather than a SELinux denial.
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,dsa_su,selinux,apparmor,tomoyo,bpf"

# ARM app translation: a translation package the user installs is an erofs image on the user's
# disk, which init mounts and binds into /system, and its translator runs ARM64 executables
# through binfmt_misc. Built in, because the image ships no kernel modules.
#
# init mounts the translation package's image and the Google apps image straight from their
# files (file-backed erofs, 6.12 and later), not through a loop device. A loop device keeps a
# second copy of every page it reads in the image file's own page cache, beside the copy erofs
# keeps; erofs reading the file itself keeps its metadata once, and with the directio mount
# option it reads the data without that second copy wherever the file's filesystem allows
# direct I/O. The loop driver stays for apexd, which mounts APEX payloads through it.
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_OVERLAY_FS=y
CONFIG_BINFMT_MISC=y
