# The guest kernel: the WSL kernel configuration (Microsoft/config-wsl at the tag in
# wsl-kernel.tag), with these options merged on top.
#
# The guest kernel ships as one image with no modules, so everything Android needs is
# built in (=y), including options config-wsl builds as modules. build.sh checks after the
# merge that every line below took effect, because Kconfig silently drops an option whose
# dependencies are not met.

# The release string. config-wsl names its kernel after WSL; this one is DSA's.
CONFIG_LOCALVERSION="-dsa"

# Binder, built in so it uses the kernel's own symbols. This AOSP init expects the
# three global device nodes before it mounts binderfs.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Power: the power HAL holds wake locks through /sys/power/wake_lock.
CONFIG_PM_WAKELOCKS=y

# Graphics buffers: gralloc allocates from the system dma-buf heap.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y

# Scheduling: Android's task profiles set utilisation clamps per task and per cgroup.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# Input: the agent injects host input through uinput; HAL clients read evdev.
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_UHID=y

# Storage: file-based encryption and fs-verity for /data and APKs, erofs and f2fs images,
# dm-crypt, and disk quotas for per-app storage accounting.
CONFIG_CMDLINE_PARTITION=y
CONFIG_FS_ENCRYPTION=y
CONFIG_CRYPTO_HCTR2=y
CONFIG_FS_VERITY=y
CONFIG_EROFS_FS=y
CONFIG_F2FS_FS=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_TRUSTED_KEYS=y
CONFIG_DM_CRYPT=y
CONFIG_QFMT_V2=y

# Networking: netd's traffic accounting and firewall use eBPF and these netfilter matches,
# and closes sockets with SOCK_DESTROY.
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_RAW=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_TUN=y
