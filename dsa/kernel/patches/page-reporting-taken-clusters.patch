+/**
+ * page_reporting_taken - A reported block was handed out by the allocator
+ * @zone: its zone, whose lock the caller holds
+ * @page: the first page handed out
+ * @order: the order of what was handed out
+ *
+ * Called only for a block that was marked reported, so the host had taken it back. A host
+ * that faults guest memory in clusters backs the whole cluster again when the guest touches
+ * the block, so the free blocks beside it in that cluster lose their reported mark.
+ */
+static inline void page_reporting_taken(struct zone *zone, struct page *page,
+					unsigned int order)
+{
+	if (order < page_reporting_fault_cluster_order)
+		__page_reporting_taken(zone, page, order);
+}
