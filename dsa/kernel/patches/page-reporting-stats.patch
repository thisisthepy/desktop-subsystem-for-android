+/*
+ * How free page reporting is doing, for the guest's memory report. reported_kb is the free
+ * memory marked reported now, which the host has taken back; MemFree less it is free memory
+ * the host still backs (pages on the per-CPU lists, blocks below the reporting order, pages
+ * freed since the last pass, and reported pages a host that faults in clusters took in
+ * again). It is counted from the free lists when read, one list at a time, so a read costs
+ * a walk of the free lists. reported_total_kb is the memory reported since boot: how fast it
+ * grows is how fast freed memory goes back. Both are read only.
+ */
+static int page_reporting_read_only_set(const char *val,
+					const struct kernel_param *kp)
+{
+	return -EPERM;
+}
+
+static int page_reporting_reported_get(char *buffer,
+				       const struct kernel_param *kp)
+{
+	unsigned long pages = 0;
+	unsigned int order, mt;
+	struct zone *zone;
+	struct page *page;
+
+	for_each_populated_zone(zone) {
+		for (order = page_reporting_order; order < NR_PAGE_ORDERS; order++) {
+			for (mt = 0; mt < MIGRATE_TYPES; mt++) {
+				struct list_head *list = &zone->free_area[order].free_list[mt];
+
+				spin_lock_irq(&zone->lock);
+				list_for_each_entry(page, list, lru)
+					if (PageReported(page))
+						pages += 1UL << order;
+				spin_unlock_irq(&zone->lock);
+				cond_resched();
+			}
+		}
+	}
+
+	return sysfs_emit(buffer, "%lu\n", pages << (PAGE_SHIFT - 10));
+}
+
+static int page_reporting_reported_total_get(char *buffer,
+					     const struct kernel_param *kp)
+{
+	unsigned long pages = atomic_long_read(&page_reporting_reported_pages);
+
+	return sysfs_emit(buffer, "%lu\n", pages << (PAGE_SHIFT - 10));
+}
+
+static const struct kernel_param_ops page_reporting_reported_ops = {
+	.set = page_reporting_read_only_set,
+	.get = page_reporting_reported_get,
+};
+
+static const struct kernel_param_ops page_reporting_reported_total_ops = {
+	.set = page_reporting_read_only_set,
+	.get = page_reporting_reported_total_get,
+};
+
+module_param_cb(reported_kb, &page_reporting_reported_ops, NULL, 0444);
+MODULE_PARM_DESC(reported_kb, "Free memory the host has taken back now, in KiB");
+module_param_cb(reported_total_kb, &page_reporting_reported_total_ops, NULL, 0444);
+MODULE_PARM_DESC(reported_total_kb, "Memory reported to the host since boot, in KiB");
+
