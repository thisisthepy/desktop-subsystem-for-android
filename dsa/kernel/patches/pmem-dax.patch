-		acpi_desc->nvdimm_bus = nvdimm_bus_register(dev,
+		acpi_desc->nvdimm_bus = nvdimm_bus_register(acpi_nfit_bus_parent(dev),
 				&acpi_desc->nd_desc);
 		if (!acpi_desc->nvdimm_bus)
 			return -ENOMEM;
