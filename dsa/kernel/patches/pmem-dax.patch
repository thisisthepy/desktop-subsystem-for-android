+/*
+ * The parent of each NVDIMM bus: a platform device named "virtio-pmem" rather than the virtio
+ * device. Android's init makes /dev/block/by-name links only for disks below a boot device,
+ * and finds a disk's boot device by walking up to the first platform device, or else by its
+ * PCI slot, which the VMM picks for a pmem device itself. The virtio device stays the
+ * provider: flushes reach it through the region's provider data.
+ */
+static struct device *virtio_pmem_bus_parent(struct virtio_device *vdev)
+{
+	static struct platform_device *parent;
+	static DEFINE_MUTEX(parent_lock);
+	struct device *found = &vdev->dev;
+
+	mutex_lock(&parent_lock);
+	if (!parent) {
+		struct platform_device *made;
+
+		made = platform_device_register_simple("virtio-pmem",
+						       PLATFORM_DEVID_NONE, NULL, 0);
+		if (IS_ERR(made))
+			dev_warn(&vdev->dev, "no platform device for the NVDIMM bus (%ld)\n",
+				 PTR_ERR(made));
+		else
+			parent = made;
+	}
+	if (parent)
+		found = &parent->dev;
+	mutex_unlock(&parent_lock);
+	return found;
+}
