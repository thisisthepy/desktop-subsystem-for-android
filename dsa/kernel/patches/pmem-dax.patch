+/*
+ * The parent of the NVDIMM bus: a platform device named "nfit" rather than the ACPI device.
+ * Android's init makes /dev/block/by-name links only for disks below a boot device, and it
+ * finds a disk's boot device by walking up to the first platform device, so a persistent
+ * memory disk below the ACPI device alone would get no links. The ACPI device stays the
+ * provider: every DSM call and notification still goes through acpi_desc->dev.
+ */
+static struct device *acpi_nfit_bus_parent(struct device *dev)
+{
+	static struct platform_device *parent;
+
+	if (!parent) {
+		struct platform_device *made;
+
+		made = platform_device_register_simple("nfit", PLATFORM_DEVID_NONE,
+						       NULL, 0);
+		if (IS_ERR(made)) {
+			dev_warn(dev, "no platform device for the NVDIMM bus (%ld)\n",
+				 PTR_ERR(made));
+			return dev;
+		}
+		parent = made;
+	}
+	return &parent->dev;
+}
