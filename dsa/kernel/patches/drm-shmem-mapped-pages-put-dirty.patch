diff --git a/drivers/gpu/drm/drm_gem_shmem_helper.c b/drivers/gpu/drm/drm_gem_shmem_helper.c
--- a/drivers/gpu/drm/drm_gem_shmem_helper.c
+++ b/drivers/gpu/drm/drm_gem_shmem_helper.c
@@ -368,6 +368,10 @@ int drm_gem_shmem_vmap_locked(struct drm_gem_shmem_object *shmem,
 		if (ret)
 			return ret;
 
+		/* Written through the kernel's mapping alike (drm_gem_shmem_mmap). */
+		shmem->pages_mark_dirty_on_put = true;
+		shmem->pages_mark_accessed_on_put = true;
+
 		if (shmem->map_wc)
 			prot = pgprot_writecombine(prot);
 		shmem->vaddr = vmap(shmem->pages, obj->size >> PAGE_SHIFT,
@@ -646,6 +650,19 @@ int drm_gem_shmem_mmap(struct drm_gem_shmem_object *shmem, struct vm_area_struct
 
 	dma_resv_lock(shmem->base.resv, NULL);
 	ret = drm_gem_shmem_get_pages_locked(shmem);
+	/*
+	 * A CPU writes the pages through this mapping, which inserts them by PFN, so its
+	 * writes never mark them dirty. Once the last mapping and vmap are gone the pages are
+	 * put, and a page put clean is a hole of the shmem file to reclaim: it is dropped
+	 * rather than swapped out, and the next mapping reads zeros where the writer's data
+	 * was. A video picture its decoder wrote into a gralloc buffer showed green bands
+	 * that way whenever the guest's memory was reclaimed before the picture was shown.
+	 * The pages of an object a mapping has reached are marked dirty when they are put.
+	 */
+	if (!ret) {
+		shmem->pages_mark_dirty_on_put = true;
+		shmem->pages_mark_accessed_on_put = true;
+	}
 	dma_resv_unlock(shmem->base.resv);
 
 	if (ret)
