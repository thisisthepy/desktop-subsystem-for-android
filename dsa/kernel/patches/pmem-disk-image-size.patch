+/* The start of a GPT header, which sits in the disk's second sector. */
+struct pmem_gpt_header {
+	__le64 signature;
+	__le32 revision;
+	__le32 header_size;
+	__le32 header_crc32;
+	__le32 reserved;
+	__le64 my_lba;
+	__le64 alternate_lba;
+};
+
+#define PMEM_GPT_SIGNATURE 0x5452415020494645ULL /* "EFI PART" */
+#define PMEM_GPT_HEADER_MIN 92
+
+/*
+ * The size of the disk image at the start of a namespace, from its GPT: the backup header
+ * is the image's last sector. 0 when the namespace holds no valid GPT header, or one whose
+ * disk does not end inside the namespace.
+ *
+ * Hyper-V gives every persistent memory device of a VM the size of the largest one (the
+ * size is the controller's, not the device's), so a small disk image sits at the start of
+ * a much larger region. Page structs for the rest of it (64 bytes for each 4 KiB) would be
+ * guest memory held for the VM's whole life for nothing: 32 MiB for a 370 MiB disk in a
+ * 2422 MiB region.
+ *
+ * Reads through the namespace's raw access, so it must run while that is enabled.
+ */
+static u64 pmem_disk_image_bytes(struct nd_namespace_common *ndns,
+				 resource_size_t namespace_bytes)
+{
+	struct pmem_gpt_header *gpt;
+	u32 header_size, crc;
+	u64 alternate, bytes = 0;
+	u8 *sector;
+
+	sector = kmalloc(SECTOR_SIZE, GFP_KERNEL);
+	if (!sector)
+		return 0;
+	if (nvdimm_read_bytes(ndns, SECTOR_SIZE, sector, SECTOR_SIZE, 0))
+		goto out;
+	gpt = (struct pmem_gpt_header *)sector;
+	if (le64_to_cpu(gpt->signature) != PMEM_GPT_SIGNATURE ||
+	    le64_to_cpu(gpt->my_lba) != 1)
+		goto out;
+	header_size = le32_to_cpu(gpt->header_size);
+	if (header_size < PMEM_GPT_HEADER_MIN || header_size > SECTOR_SIZE)
+		goto out;
+	crc = le32_to_cpu(gpt->header_crc32);
+	gpt->header_crc32 = 0;
+	if ((crc32_le(~0U, sector, header_size) ^ ~0U) != crc)
+		goto out;
+	alternate = le64_to_cpu(gpt->alternate_lba);
+	if (alternate < 2 || alternate >= namespace_bytes / SECTOR_SIZE)
+		goto out;
+	bytes = (alternate + 1) * SECTOR_SIZE;
+out:
+	kfree(sector);
+	return bytes;
+}
