diff --git a/include/linux/dsa_host_memory.h b/include/linux/dsa_host_memory.h
new file mode 100644
index 0000000..7d7541d
--- /dev/null
+++ b/include/linux/dsa_host_memory.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DSA host memory: apps see the memory the guest may grow to as the device's
+ * memory, in /proc/meminfo and sysinfo(). See fs/proc/dsa_host_memory.c.
+ */
+#ifndef _LINUX_DSA_HOST_MEMORY_H
+#define _LINUX_DSA_HOST_MEMORY_H
+
+struct sysinfo;
+
+/*
+ * Adjusts the totals si_meminfo() filled in for the calling process, and
+ * returns the pages added to its free memory, which its available memory
+ * gains too.
+ */
+#ifdef CONFIG_DSA_HOST_MEMORY
+unsigned long dsa_host_memory_adjust(struct sysinfo *info);
+#else
+static inline unsigned long dsa_host_memory_adjust(struct sysinfo *info)
+{
+	return 0;
+}
+#endif
+
+#endif /* _LINUX_DSA_HOST_MEMORY_H */
