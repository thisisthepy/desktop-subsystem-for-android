diff --git a/fs/proc/dsa_host_memory.c b/fs/proc/dsa_host_memory.c
new file mode 100644
index 0000000..78f4bb6
--- /dev/null
+++ b/fs/proc/dsa_host_memory.c
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DSA host memory: apps see the memory the guest may grow to as the device's
+ * memory.
+ *
+ * The DSA guest starts with a small VM and grows it as it needs, up to a
+ * maximum the host sets, so the size its kernel reports says nothing about
+ * what an app may use. Apps decide by that size: a game checks MemTotal
+ * against its requirements and refuses to start on a VM that has not grown
+ * yet, and an app store hands a device with little memory a build a 64-bit
+ * only guest cannot run. Every app process (an app ID of 10000 or more, for
+ * every Android user) sees the maximum instead, as MemTotal in /proc/meminfo
+ * and totalram in sysinfo(), and the memory still to grow (the maximum less
+ * the VM's size now) is added to what it sees as free and available. Every
+ * other process (init, lmkd, system_server and the other system uids) sees
+ * the guest's own memory, so memory management is unchanged.
+ *
+ * Parameters:
+ *
+ *   dsa_host_memory.total_kb        the memory the VM may grow to, in KiB,
+ *                                   which the host passes in the boot's
+ *                                   bootconfig (kernel.dsa_host_memory.*).
+ *                                   0, or no more than the guest has,
+ *                                   changes nothing.
+ *   dsa_host_memory.store_total_kb  the computer's physical memory, in KiB,
+ *                                   from the bootconfig too: the apps in uids
+ *                                   see it as their total when it is larger.
+ *                                   Their free and available memory still
+ *                                   grow only by what the VM may still grow.
+ *   dsa_host_memory.uids            the app store's app IDs (a uid modulo
+ *                                   100000, so the app's copy for every
+ *                                   Android user is included).
+ *   dsa_host_memory.real_uids       the app IDs that see the guest's own
+ *                                   memory, as the system does: DSA's agent,
+ *                                   which reports the guest's memory to the
+ *                                   host.
+ *
+ * Both lists are comma separated, at most DSA_HOST_MEMORY_MAX_UIDS long, and
+ * "none" names no app. The guest's control daemon names them from the package
+ * manager's list, and only init writes them.
+ */
+
+#include <linux/cred.h>
+#include <linux/dsa_host_memory.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/moduleparam.h>
+#include <linux/seqlock.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uidgid.h>
+
+/*
+ * Built into proc, whose parameters would otherwise be proc.*: these are
+ * dsa_host_memory.* on the command line and in /sys/module/dsa_host_memory.
+ */
+#undef MODULE_PARAM_PREFIX
+#define MODULE_PARAM_PREFIX "dsa_host_memory."
+
+#define DSA_HOST_MEMORY_MAX_UIDS 16
+/* An Android uid is the user ID times 100000 plus the app ID. */
+#define DSA_ANDROID_PER_USER_RANGE 100000
+/* The first app ID Android gives an installed app; below it are system uids. */
+#define DSA_ANDROID_FIRST_APPLICATION_UID 10000
+
+static unsigned long dsa_total_kb;
+module_param_named(total_kb, dsa_total_kb, ulong, 0444);
+MODULE_PARM_DESC(total_kb, "The memory the VM may grow to in KiB, which apps see");
+
+static unsigned long dsa_store_total_kb;
+module_param_named(store_total_kb, dsa_store_total_kb, ulong, 0444);
+MODULE_PARM_DESC(store_total_kb, "The computer's physical memory in KiB, which the apps in uids see");
+
+struct dsa_uid_list {
+	seqlock_t lock;
+	unsigned int uids[DSA_HOST_MEMORY_MAX_UIDS];
+	unsigned int count;
+};
+
+static struct dsa_uid_list dsa_store_uids = {
+	.lock = __SEQLOCK_UNLOCKED(dsa_store_uids.lock),
+};
+static struct dsa_uid_list dsa_real_uids = {
+	.lock = __SEQLOCK_UNLOCKED(dsa_real_uids.lock),
+};
+
+static bool dsa_app_listed(struct dsa_uid_list *list, unsigned int app)
+{
+	unsigned int seq, i;
+	bool listed;
+
+	if (!READ_ONCE(list->count))
+		return false;
+	do {
+		seq = read_seqbegin(&list->lock);
+		listed = false;
+		for (i = 0; i < list->count; i++) {
+			if (list->uids[i] == app) {
+				listed = true;
+				break;
+			}
+		}
+	} while (read_seqretry(&list->lock, seq));
+	return listed;
+}
+
+unsigned long dsa_host_memory_adjust(struct sysinfo *info)
+{
+	unsigned int app = from_kuid(&init_user_ns, current_uid()) % DSA_ANDROID_PER_USER_RANGE;
+	unsigned long own = info->totalram;
+	unsigned long shown = own;
+	unsigned long headroom = 0;
+	unsigned long pages;
+
+	/* System uids, root among them, keep the VM's own size. */
+	if (app < DSA_ANDROID_FIRST_APPLICATION_UID || dsa_app_listed(&dsa_real_uids, app))
+		return 0;
+	/* si_meminfo() counts in pages, with mem_unit set to the page size. */
+	pages = READ_ONCE(dsa_total_kb) >> (PAGE_SHIFT - 10);
+	if (pages > own) {
+		headroom = pages - own;
+		shown = pages;
+	}
+	if (dsa_app_listed(&dsa_store_uids, app)) {
+		pages = READ_ONCE(dsa_store_total_kb) >> (PAGE_SHIFT - 10);
+		if (pages > shown)
+			shown = pages;
+	}
+	info->totalram = shown;
+	info->freeram += headroom;
+	return headroom;
+}
+
+static int dsa_uids_set(const char *val, const struct kernel_param *kp)
+{
+	struct dsa_uid_list *list = kp->arg;
+	unsigned int parsed[DSA_HOST_MEMORY_MAX_UIDS];
+	unsigned int count = 0;
+	char *copy, *cursor, *word;
+	int err = 0;
+
+	copy = kstrdup(val, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+	cursor = strim(copy);
+	/* "none" names no app: init cannot write an empty value. */
+	if (!strcmp(cursor, "none"))
+		*cursor = 0;
+	while ((word = strsep(&cursor, ",")) != NULL) {
+		unsigned int uid;
+
+		word = strim(word);
+		if (!*word)
+			continue;
+		if (count == DSA_HOST_MEMORY_MAX_UIDS) {
+			err = -E2BIG;
+			break;
+		}
+		err = kstrtouint(word, 10, &uid);
+		if (err)
+			break;
+		parsed[count++] = uid % DSA_ANDROID_PER_USER_RANGE;
+	}
+	kfree(copy);
+	if (err)
+		return err;
+
+	write_seqlock(&list->lock);
+	memcpy(list->uids, parsed, count * sizeof(parsed[0]));
+	WRITE_ONCE(list->count, count);
+	write_sequnlock(&list->lock);
+	return 0;
+}
+
+static int dsa_uids_get(char *buffer, const struct kernel_param *kp)
+{
+	struct dsa_uid_list *list = kp->arg;
+	unsigned int uids[DSA_HOST_MEMORY_MAX_UIDS];
+	unsigned int count, seq, i;
+	int len = 0;
+
+	do {
+		seq = read_seqbegin(&list->lock);
+		count = list->count;
+		memcpy(uids, list->uids, count * sizeof(uids[0]));
+	} while (read_seqretry(&list->lock, seq));
+	for (i = 0; i < count; i++)
+		len += scnprintf(buffer + len, PAGE_SIZE - len, "%s%u", i ? "," : "", uids[i]);
+	len += scnprintf(buffer + len, PAGE_SIZE - len, "\n");
+	return len;
+}
+
+static const struct kernel_param_ops dsa_uids_ops = {
+	.set = dsa_uids_set,
+	.get = dsa_uids_get,
+};
+
+module_param_cb(uids, &dsa_uids_ops, &dsa_store_uids, 0644);
+MODULE_PARM_DESC(uids, "The app store's app IDs, which see the computer's memory, comma separated");
+module_param_cb(real_uids, &dsa_uids_ops, &dsa_real_uids, 0644);
+MODULE_PARM_DESC(real_uids, "App IDs that see the guest's own memory, comma separated");
