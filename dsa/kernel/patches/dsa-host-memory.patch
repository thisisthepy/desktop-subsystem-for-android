--- /dev/null
+++ b/include/linux/dsa_host_memory.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DSA host memory: the apps the guest names see the computer's memory as the
+ * device's memory, in /proc/meminfo and sysinfo(). See fs/proc/dsa_host_memory.c.
+ */
+#ifndef _LINUX_DSA_HOST_MEMORY_H
+#define _LINUX_DSA_HOST_MEMORY_H
+
+struct sysinfo;
+
+#ifdef CONFIG_DSA_HOST_MEMORY
+void dsa_host_memory_adjust(struct sysinfo *info);
+#else
+static inline void dsa_host_memory_adjust(struct sysinfo *info)
+{
+}
+#endif
+
+#endif /* _LINUX_DSA_HOST_MEMORY_H */
