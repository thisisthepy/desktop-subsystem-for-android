+/*
+ * The workqueue that converts unwritten extents once their writes complete.
+ * The maximum number of concurrent works can be high and concurrency isn't
+ * really necessary.  Limit it to 1.
+ */
+static int ext4_alloc_rsv_conversion_wq(struct super_block *sb)
+{
+	struct workqueue_struct *wq;
+
+	wq = alloc_workqueue("ext4-rsv-conversion", WQ_MEM_RECLAIM | WQ_UNBOUND, 1);
+	if (!wq) {
+		printk(KERN_ERR "EXT4-fs: failed to create workqueue\n");
+		return -ENOMEM;
+	}
+	EXT4_SB(sb)->rsv_conversion_wq = wq;
+	return 0;
+}
