diff --git a/kernel/cgroup/cgroup-v1.c b/kernel/cgroup/cgroup-v1.c
--- a/kernel/cgroup/cgroup-v1.c
+++ b/kernel/cgroup/cgroup-v1.c
@@ -518,12 +518,17 @@
 	 * Even if we're attaching all tasks in the thread group, we only need
 	 * to check permissions on one of them. Check permissions using the
 	 * credentials from file open to protect against inherited fd attacks.
+	 *
+	 * A task that may change other tasks' scheduling (CAP_SYS_NICE) may also move
+	 * them: Android's system_server moves every app between the cpu, cpuset and
+	 * blkio groups that set its scheduling, and the apps run as other users.
 	 */
 	cred = of->file->f_cred;
 	tcred = get_task_cred(task);
 	if (!uid_eq(cred->euid, GLOBAL_ROOT_UID) &&
 	    !uid_eq(cred->euid, tcred->uid) &&
-	    !uid_eq(cred->euid, tcred->suid))
+	    !uid_eq(cred->euid, tcred->suid) &&
+	    !file_ns_capable(of->file, tcred->user_ns, CAP_SYS_NICE))
 		ret = -EACCES;
 	put_cred(tcred);
 	if (ret)
