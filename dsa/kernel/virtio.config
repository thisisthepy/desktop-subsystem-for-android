# The virtio devices Apple's Virtualization framework gives a VM, merged after the other
# fragments for both architectures. The macOS host boots the same kernel and image as the
# Windows host, so the kernel carries both sets of drivers; a driver whose device is absent
# never probes.
#
# config-wsl builds some of these as modules. The VM loads no modules, so each is built in.

# PCI transport, which every virtio device of the framework sits on.
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y

# The system disk, the user's disk and the pstore disk (virtio-blk, vda to vdc).
CONFIG_VIRTIO_BLK=y

# The control channel, the log port, file sharing and graphics: AF_VSOCK over virtio. The
# Hyper-V transport registers first when VMBus is present (see
# patches/vsock-hyperv-first.patch), so one kernel serves both hosts.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y

# The NAT network adapter, which virt_wifi shows to Android as Wi-Fi as on Hyper-V.
CONFIG_VIRTIO_NET=y

# The serial console (hvc0), kept in the host's console log.
CONFIG_HVC_DRIVER=y
CONFIG_VIRTIO_CONSOLE=y

# The memory balloon: the host takes memory back by inflating it, and free pages are
# reported so the host can drop them.
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y

# The Linux host (crosvm under KVM) uses the same drivers, and stops the guest by SysRq on
# the virtio console (sync, remount read only, power off). It boots the VM small and grows
# and shrinks it with virtio-mem: memory hot-plug and hot-remove, with the page structs of
# hot-plugged memory kept in that memory (memmap_on_memory, which the Linux host turns on with
# memory_hotplug.memmap_on_memory=1), so the guest keeps page structs only for memory it has.
# Hot-plugged memory goes online on its own; the Linux host's command line asks for the
# movable zone (memory_hotplug.online_policy=auto-movable), so it can be unplugged again.
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_MHP_MEMMAP_ON_MEMORY=y
CONFIG_MHP_DEFAULT_ONLINE_TYPE_ONLINE_AUTO=y
CONFIG_VIRTIO_MEM=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y

# Entropy from the host, so early boot does not wait for the random pool.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
