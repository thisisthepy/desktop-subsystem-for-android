# Hyper-V's paravirtualized GPU (GPU-PV), the device WSL's own VM uses: the dxgkrnl driver from
# the WSL kernel tree (drivers/hv/dxgkrnl, GPL-2.0), merged for both architectures.
#
# config-wsl and config-wsl-arm64 already build it in; this fragment keeps it that way, so a
# change upstream fails the build's fragment check rather than silently dropping the device.
# The driver registers /dev/dxg when it starts, but it has nothing to drive until the host
# assigns the VM a GPU (the host setting gpu_paravirtualization) and offers the VMBus channels
# and the virtual render device (PCI 1414:008e) that come with it. Without that, and without
# an image built with the dxg drivers, the device stays unused: SELinux gives apps no access to
# it, and Android renders through the host renderer.
CONFIG_DXGKRNL=y

# What the driver depends on and selects: VMBus, and the dma-buf and sync file objects it
# hands to user space as file descriptors.
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y

# The virtual render device of each assigned GPU sits on Hyper-V's virtual PCI bus.
CONFIG_PCI=y
CONFIG_PCI_HYPERV=y
CONFIG_PCI_HYPERV_INTERFACE=y
