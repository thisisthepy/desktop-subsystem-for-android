# Memory debugging for the guest kernel, merged last and only when asked for:
#
#   dsa/kernel/build.sh --debug [--arch arm64]
#
# It is never part of the kernel DSA ships. It is for chasing memory corruption such as the
# "BUG: Bad rss-counter state" that came 17 s before a panic in binder (rb_insert_color via
# binder_inc_ref_for_node): each option makes the kernel catch the bad access where it
# happens instead of where it later crashes. They cost CPU time and memory, so a debug
# kernel is slower and larger than the shipped one.

# Checks the page tables, the page and folio states and the mm counters on every change,
# and reports the first inconsistency with the call that made it.
CONFIG_DEBUG_VM=y

# A sampling detector for use-after-free and out-of-bounds accesses on the heap, cheap enough
# to leave on while reproducing.
CONFIG_KFENCE=y

# Records who allocated each page, so a bad page report names its owner
# (/sys/kernel/debug/page_owner, on with page_owner=on on the command line).
CONFIG_PAGE_OWNER=y

# Checks every list and red-black tree link on insertion and removal, the kind of corruption
# binder's rb_insert_color crashed on.
CONFIG_DEBUG_LIST=y

# The function tracer. The options above turn it on although the shipped kernel leaves it
# off, and it lets a reproduction trace the calls around the first bad report.
CONFIG_FUNCTION_TRACER=y

# Multi-generational LRU off: it walks page tables and clears the young bit itself, the
# leading suspect for PTEs changing under the arm64 guest on Apple's Virtualization
# framework. The shipped kernel keeps it on.
# CONFIG_LRU_GEN_ENABLED is not set
