diff --git a/SettingsTheme/res/animator-v36/settingslib_dsa_press_spring.xml b/SettingsTheme/res/animator-v36/settingslib_dsa_press_spring.xml
new file mode 100644
--- /dev/null
+++ b/SettingsTheme/res/animator-v36/settingslib_dsa_press_spring.xml
@@ -0,0 +1,24 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: The Desktop Subsystem for Android authors
+     SPDX-License-Identifier: Apache-2.0
+-->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <!-- A pressed row sinks a little, and springs back when it is let go. -->
+    <item android:state_pressed="true">
+        <set>
+            <objectAnimator android:propertyName="scaleX" android:valueTo="0.98"
+                android:duration="120" android:interpolator="@interpolator/settingslib_dsa_spring" />
+            <objectAnimator android:propertyName="scaleY" android:valueTo="0.98"
+                android:duration="120" android:interpolator="@interpolator/settingslib_dsa_spring" />
+        </set>
+    </item>
+    <item>
+        <set>
+            <objectAnimator android:propertyName="scaleX" android:valueTo="1"
+                android:duration="350" android:interpolator="@interpolator/settingslib_dsa_spring" />
+            <objectAnimator android:propertyName="scaleY" android:valueTo="1"
+                android:duration="350" android:interpolator="@interpolator/settingslib_dsa_spring" />
+        </set>
+    </item>
+</selector>
