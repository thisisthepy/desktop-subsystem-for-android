diff --git a/SettingsTheme/res/values-v36/settingslib_dsa_cards.xml b/SettingsTheme/res/values-v36/settingslib_dsa_cards.xml
new file mode 100644
--- /dev/null
+++ b/SettingsTheme/res/values-v36/settingslib_dsa_cards.xml
@@ -0,0 +1,16 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: The Desktop Subsystem for Android authors
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources>
+    <!-- DSA's cards: the rows of a group on a surface that stands clear of the window's
+         background, in light and dark. -->
+    <color name="settingslib_dsa_card">@color/settingslib_materialColorSurfaceContainerLowest</color>
+    <!-- The corners inside a card, between two of its rows. -->
+    <dimen name="settingslib_dsa_inner_corner">6dp</dimen>
+    <!-- The room above a group's title, which sets one group apart from the next. -->
+    <dimen name="settingslib_dsa_group_gap">28dp</dimen>
+    <!-- How long a pressed row takes to change its shape. -->
+    <integer name="settingslib_dsa_morph_ms">150</integer>
+</resources>
