diff --git a/res/drawable-v31/dsa_grant_button.xml b/res/drawable-v31/dsa_grant_button.xml
new file mode 100644
--- /dev/null
+++ b/res/drawable-v31/dsa_grant_button.xml
@@ -0,0 +1,15 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: The Desktop Subsystem for Android authors
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!-- A full-width, fully rounded tonal button, as the buttons of DSA's dialogs are. -->
+<ripple xmlns:android="http://schemas.android.com/apk/res/android"
+    android:color="?android:attr/colorControlHighlight">
+    <item>
+        <shape android:shape="rectangle">
+            <solid android:color="@android:color/system_accent2_100" />
+            <corners android:radius="28dp" />
+        </shape>
+    </item>
+</ripple>
