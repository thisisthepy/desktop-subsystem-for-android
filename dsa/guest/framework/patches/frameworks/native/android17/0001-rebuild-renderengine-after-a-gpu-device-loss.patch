+
+bool SkiaRenderEngine::isDeviceLost() {
+    return (mContext && mContext->isAbandonedOrDeviceLost()) ||
+            (mProtectedContext && mProtectedContext->isAbandonedOrDeviceLost()) ||
+            isBackendDeviceLost();
+}
+
+void SkiaRenderEngine::dropGpuObjects() {
+    // The textures first: they are freed through the old context and display, which must still
+    // exist, so that nothing is freed later through a display or device made after them.
+    mTextureCache.clear();
+    mTextureCleanupMgr.setDeferredStatus(false);
+    mTextureCleanupMgr.cleanup();
+    // Then the Skia contexts; each abandons its GrDirectContext as it goes.
+    mContext.reset();
+    mProtectedContext.reset();
+    mInProtectedContext = false;
+}
+
+bool SkiaRenderEngine::ensureDevice() {
+    using Clock = gpurecovery::DeviceLossRecovery::Clock;
+    if (mDeviceRecovery.isHealthy()) {
+        if (mContext && !isDeviceLost()) {
+            return true;
+        }
+        if (!mContext) {
+            // Never built: nothing was lost.
+            ensureContextsCreated();
+            return mContext != nullptr;
+        }
+        mDeviceRecovery.onLost(Clock::now());
+        ALOGW("RenderEngine lost its GPU device. It drops its GPU context and textures, and "
+              "builds them again once the GPU answers.");
+        mWasProtectedBeforeLoss = mInProtectedContext;
+        dropGpuObjects();
+    }
+    // While the host resets its GPU an attempt fails. RenderEngine waits for it here, on its own
+    // thread, for up to kDeviceRecoveryWait, and tries again on its next use after that.
+    const auto deadline = Clock::now() + kDeviceRecoveryWait;
+    while (!mDeviceRecovery.isHealthy()) {
+        const auto now = Clock::now();
+        if (!mDeviceRecovery.shouldRebuild(now)) {
+            const auto wait = mDeviceRecovery.untilNextAttempt(now);
+            if (now + wait > deadline) {
+                ALOGW("The GPU does not answer yet after the device loss (%u attempts); "
+                      "RenderEngine draws nothing until it does",
+                      mDeviceRecovery.failedAttempts());
+                return false;
+            }
+            std::this_thread::sleep_for(wait);
+            continue;
+        }
+        const bool rebuilt = rebuildBackend();
+        if (rebuilt) {
+            ensureContextsCreated();
+        }
+        mDeviceRecovery.onRebuilt(rebuilt && mContext != nullptr, Clock::now());
+    }
+
+    // What the old contexts were set to.
+    if (mResourceCacheLimit > 0) {
+        mContext->setResourceCacheLimit(mResourceCacheLimit);
+        if (mProtectedContext) {
+            mProtectedContext->setResourceCacheLimit(mResourceCacheLimit);
+        }
+    }
+    // The buffers SurfaceFlinger has mapped, imported again on the new context.
+    for (auto it = mMappedBuffers.begin(); it != mMappedBuffers.end();) {
+        const sp<GraphicBuffer> buffer = it->second.first.promote();
+        if (buffer == nullptr) {
+            it = mMappedBuffers.erase(it);
+            continue;
+        }
+        std::unique_ptr<SkiaBackendTexture> backendTexture =
+                mContext->makeBackendTexture(buffer->toAHardwareBuffer(), it->second.second);
+        mTextureCache.insert({it->first,
+                              std::make_shared<AutoBackendTexture::LocalRef>(std::move(backendTexture),
+                                                                             mTextureCleanupMgr)});
+        ++it;
+    }
+    if (mWasProtectedBeforeLoss) {
+        useProtectedContext(true);
+    }
+    mDeviceResetCount = mDeviceRecovery.resetCount();
+    ALOGI("RenderEngine has a GPU context again after the device loss (reset %u, %zu buffers "
+          "imported again)",
+          mDeviceResetCount.load(), mTextureCache.size());
+    if (mDeviceResetListener) {
+        mDeviceResetListener();
+    }
+    return true;
+}
+
+void SkiaRenderEngine::setDeviceResetListener(std::function<void()> listener) {
+    std::lock_guard<std::mutex> lock(mRenderingMutex);
+    mDeviceResetListener = std::move(listener);
 }
 
