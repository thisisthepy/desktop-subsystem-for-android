+bool SkiaGLRenderEngine::isBackendDeviceLost() {
+    EGLint version = 0;
+    if (eglQueryContext(mEGLDisplay, mEGLContext, EGL_CONTEXT_CLIENT_VERSION, &version)) {
+        return false;
+    }
+    return eglGetError() == EGL_CONTEXT_LOST;
+}
+
+bool SkiaGLRenderEngine::rebuildBackend() {
+    // A display that lost its device answers nothing but being made not current and being
+    // terminated, and terminating it frees everything made on it. The same holds for what an
+    // earlier failed attempt made.
+    eglMakeCurrent(mEGLDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    if (mDisplayInitialized) {
+        eglTerminate(mEGLDisplay);
+        mDisplayInitialized = false;
+    }
+    mEGLContext = EGL_NO_CONTEXT;
+    mPlaceholderSurface = EGL_NO_SURFACE;
+    mProtectedPlaceholderSurface = EGL_NO_SURFACE;
+    // mProtectedEGLContext keeps its old value until a new one is made: other threads ask whether
+    // protected content is supported, and the answer does not change.
+
+    if (!eglInitialize(mEGLDisplay, nullptr, nullptr)) {
+        return false;
+    }
+    mDisplayInitialized = true;
+
+    const auto& extensions = GLExtensions::getInstance();
+    EGLConfig config = EGL_NO_CONFIG_KHR;
+    EGLConfig surfaceConfig = EGL_NO_CONFIG_KHR;
+    if (!extensions.hasNoConfigContext() || !extensions.hasSurfacelessContext()) {
+        if (selectEGLConfig(mEGLDisplay, mPixelFormat, EGL_OPENGL_ES3_BIT, &surfaceConfig) !=
+                    NO_ERROR &&
+            selectEGLConfig(mEGLDisplay, mPixelFormat, EGL_OPENGL_ES2_BIT, &surfaceConfig) !=
+                    NO_ERROR &&
+            selectEGLConfig(mEGLDisplay, mPixelFormat, 0, &surfaceConfig) != NO_ERROR) {
+            ALOGW("No EGL config yet after the device loss");
+            return false;
+        }
+        if (!extensions.hasNoConfigContext()) {
+            config = surfaceConfig;
+        }
+    }
+
+    EGLContext protectedContext = EGL_NO_CONTEXT;
+    if (mEnableProtectedContext && extensions.hasProtectedContent()) {
+        protectedContext = createEglContext(mEGLDisplay, config, nullptr, mContextPriority,
+                                            Protection::Protected);
+    }
+    EGLContext context = createEglContext(mEGLDisplay, config, protectedContext, mContextPriority,
+                                          Protection::Unprotected);
+    if (context == EGL_NO_CONTEXT) {
+        ALOGW("No EGL context yet after the device loss: %#x", eglGetError());
+        return false;
+    }
+    EGLSurface placeholder = EGL_NO_SURFACE;
+    EGLSurface protectedPlaceholder = EGL_NO_SURFACE;
+    if (!extensions.hasSurfacelessContext()) {
+        placeholder = createPlaceholderEglPbufferSurface(mEGLDisplay, surfaceConfig, mPixelFormat,
+                                                         Protection::Unprotected);
+        if (placeholder == EGL_NO_SURFACE) {
+            return false;
+        }
+        if (protectedContext != EGL_NO_CONTEXT) {
+            protectedPlaceholder =
+                    createPlaceholderEglPbufferSurface(mEGLDisplay, surfaceConfig, mPixelFormat,
+                                                       Protection::Protected);
+        }
+    }
+    if (!eglMakeCurrent(mEGLDisplay, placeholder, placeholder, context)) {
+        return false;
+    }
+
+    mEGLContext = context;
+    mPlaceholderSurface = placeholder;
+    mProtectedEGLContext = protectedContext;
+    mProtectedPlaceholderSurface = protectedPlaceholder;
+    return true;
+}
