+// Whether the GPU device under the context is lost. Skia cannot wrap a buffer then, and that is
+// not a programming error: RenderEngine builds its context again and draws the frame again.
+// Skia abandons a Vulkan context when it sees the device lost; a GL context it does not, so the
+// EGL display is asked.
+bool isDeviceLost(GrDirectContext* context) {
+    if (context->abandoned()) {
+        return true;
+    }
+    if (context->backend() != GrBackendApi::kOpenGL) {
+        return false;
+    }
+    EGLint version = 0;
+    if (eglQueryContext(eglGetCurrentDisplay(), eglGetCurrentContext(), EGL_CONTEXT_CLIENT_VERSION,
+                        &version)) {
+        return false;
+    }
+    return eglGetError() == EGL_CONTEXT_LOST;
+}
+
