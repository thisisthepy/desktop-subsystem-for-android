     virtual bool canSkipPostRenderCleanup() const = 0;
 
+    // Called on the RenderEngine thread once it has had nothing to do for a while. Lets go of the
+    // GPU work of frames that have finished, and with it of every texture only that work still
+    // held: the buffers of a layer that is gone, of a closed app or of a screenshot. The GPU
+    // backend learns that a frame finished only when it submits again, and with a hardware
+    // composer that composes every layer itself, the next frame drawn here may be long after.
+    virtual void releaseIdleGpuResources() {}
