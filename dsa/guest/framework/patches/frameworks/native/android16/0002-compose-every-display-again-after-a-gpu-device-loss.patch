+    void onRenderEngineReset();
     // Schedule sampling independently from commit or composite.
     void scheduleSample();
 
@@ -1402,6 +1406,9 @@ private:
     std::atomic_bool mMustComposite = false;
     std::atomic_bool mGeometryDirty = false;
 
+    // The RenderEngine device resets this SurfaceFlinger has handled.
+    uint32_t mRenderEngineResets = 0;
+
     // constant members (no synchronization needed for access)
     const nsecs_t mBootTime = systemTime();
     bool mIsUserBuild = true;
