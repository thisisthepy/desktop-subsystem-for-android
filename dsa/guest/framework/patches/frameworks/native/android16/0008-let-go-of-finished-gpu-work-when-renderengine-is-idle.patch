+void GaneshGpuContext::releaseFinishedWork() {
+    // Recycles the command buffers of frames that have finished, which drops their refs on the
+    // textures those frames used. The synchronous submit makes an OpenGL driver free what it
+    // deferred until its next submission.
+    mGrContext->checkAsyncWorkCompletion();
+    mGrContext->flushAndSubmit(GrSyncCpu::kYes);
+}
