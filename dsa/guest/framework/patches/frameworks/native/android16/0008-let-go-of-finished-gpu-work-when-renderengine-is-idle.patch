diff --git a/libs/renderengine/skia/SkiaRenderEngine.cpp b/libs/renderengine/skia/SkiaRenderEngine.cpp
index 4da635b..fde80c5 100644
--- a/libs/renderengine/skia/SkiaRenderEngine.cpp
+++ b/libs/renderengine/skia/SkiaRenderEngine.cpp
@@ -704,6 +704,30 @@ void SkiaRenderEngine::cleanupPostRender() {
     }
 }
 
+void SkiaRenderEngine::releaseIdleGpuResources() {
+    SFTRACE_CALL();
+    std::lock_guard<std::mutex> lock(mRenderingMutex);
+    SkiaGpuContext* context = getActiveContext();
+    if (mDeviceLossPending || context == nullptr || context->isAbandonedOrDeviceLost()) {
+        // After a device loss the textures go with the lost context.
+        return;
+    }
+    const int before = AutoBackendTexture::liveCount();
+    mTextureCleanupMgr.cleanup();
+    // A texture that is no longer cached lives on while a frame that used it is not known to have
+    // finished: its buffer stays imported, and SurfaceFlinger holds it, however long ago the layer,
+    // the app or the screenshot it belonged to went. No frame is drawn while this holds
+    // mRenderingMutex, so what Skia lets go of here is deleted at once.
+    context->releaseFinishedWork();
+    mTextureCleanupMgr.cleanup();
+    const int after = AutoBackendTexture::liveCount();
+    if (after < before) {
+        ALOGI("RenderEngine idle: finished GPU work let go of %d textures; %d remain, %zu of them "
+              "for buffers SurfaceFlinger still holds",
+              before - after, after, mTextureCache.size());
+    }
+}
