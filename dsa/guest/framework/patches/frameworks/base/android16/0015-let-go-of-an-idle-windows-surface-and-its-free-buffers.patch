+++ b/libs/hwui/pipeline/skia/SkiaVulkanPipeline.cpp
@@ -193,6 +193,17 @@ void SkiaVulkanPipeline::setTargetSdrHdrRatio(float ratio) {
     }
 }
 
+bool SkiaVulkanPipeline::releaseSurfaceWhileIdle() {
+    if (mHardwareBuffer || !mNativeWindow || !mVkSurface) {
+        return false;
+    }
+    // Destroying the surface disconnects the window's buffer queue, which frees every buffer in
+    // it but the one on screen. makeCurrent() makes the surface again for the next frame.
+    vulkanManager().destroySurface(mVkSurface);
+    mVkSurface = nullptr;
+    return true;
+}
+
 bool SkiaVulkanPipeline::isSurfaceReady() {
     return CC_UNLIKELY(mVkSurface != nullptr);
 }
