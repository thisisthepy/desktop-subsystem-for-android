+    /**
+     * DSA: draws an app overlay window at another density than its app's, or at its app's again.
+     *
+     *     dsa-overlay-density                    prints "supported"
+     *     dsa-overlay-density <WINDOW>           prints the density it was last given, 0 for none
+     *     dsa-overlay-density <WINDOW> <DPI>     gives it DPI, or with 0 its app's own again
+     *
+     * WINDOW is the hexadecimal identity hash that starts the window's name (WindowState#getName,
+     * as SurfaceFlinger's list of windows names it). Only a window of an overlay type
+     * (TYPE_APPLICATION_OVERLAY and the older system alert types) that an app added is taken.
+     * The window manager tells the window's process (IWindow#executeCommand with
+     * DsaDensityRescale.WINDOW_DENSITY_COMMAND), which converts that window's views to the
+     * density in place and lays the window out again; the app's other windows keep theirs.
+     *
+     * The DSA agent gives the overlay of an app set to System (forced) scaling the density of the
+     * host monitor it is on when that differs from the density of the app's task, so it is drawn
+     * sharp there instead of stretched. Without arguments the command only answers, which tells
+     * the agent this framework has the change: one without it answers "Unknown command". The
+     * caller needs MANAGE_ACTIVITY_TASKS, as for dsa-forced-density.
+     */
+    private int runDsaOverlayDensity(PrintWriter pw) {
+        mInternal.mContext.enforceCallingOrSelfPermission(
+                android.Manifest.permission.MANAGE_ACTIVITY_TASKS, "dsa-overlay-density");
+        final String windowArg = getNextArg();
+        if (windowArg == null) {
+            pw.println("supported");
+            return 0;
+        }
+        final String dpiArg = getNextArg();
+        int dpi = -1;
+        if (dpiArg != null) {
+            try {
+                dpi = Integer.parseInt(dpiArg);
+            } catch (NumberFormatException e) {
+                dpi = -2;
+            }
+            if (dpi != 0 && (dpi < 72 || dpi > 960)) {
+                getErrPrintWriter().println("Error: bad density " + dpiArg);
+                return -1;
+            }
+        }
+        synchronized (mInternal.mGlobalLock) {
+            final WindowState[] found = new WindowState[1];
+            mInternal.mRoot.forAllWindows(w -> {
+                if (found[0] == null
+                        && windowArg.equals(Integer.toHexString(System.identityHashCode(w)))) {
+                    found[0] = w;
+                }
+            }, true /* traverseTopToBottom */);
+            final WindowState window = found[0];
+            if (window == null) {
+                getErrPrintWriter().println("Error: no window " + windowArg);
+                return -1;
+            }
+            if (!android.view.WindowManager.LayoutParams.isSystemAlertWindowType(
+                    window.mAttrs.type)
+                    || UserHandle.getAppId(window.getOwningUid())
+                            < android.os.Process.FIRST_APPLICATION_UID) {
+                getErrPrintWriter().println("Error: window " + windowArg
+                        + " is not an app's overlay window");
+                return -1;
+            }
+            if (dpi < 0) {
+                pw.println(window.mDsaDensityDpi);
+                return 0;
+            }
+            try {
+                final ParcelFileDescriptor[] pipe = ParcelFileDescriptor.createPipe();
+                try {
+                    window.mClient.executeCommand(
+                            android.view.DsaDensityRescale.WINDOW_DENSITY_COMMAND,
+                            Integer.toString(dpi), pipe[1]);
+                } finally {
+                    pipe[0].close();
+                    pipe[1].close();
+                }
+            } catch (IOException | RemoteException e) {
+                getErrPrintWriter().println("Error: could not reach window " + windowArg + ": "
+                        + e);
+                return -1;
+            }
+            window.mDsaDensityDpi = dpi;
+        }
+        return 0;
+    }
+
