+     * changes. Only an overlay window takes it: the window manager sends it to no other.
+     */
+    void dsaSetWindowDensity(int densityDpi) {
+        if (mView == null
+                || !WindowManager.LayoutParams.isSystemAlertWindowType(mWindowAttributes.type)) {
+            return;
+        }
+        final int dpi = Math.max(0, densityDpi);
+        if (dpi == mDsaDensityDpi) {
+            return;
+        }
