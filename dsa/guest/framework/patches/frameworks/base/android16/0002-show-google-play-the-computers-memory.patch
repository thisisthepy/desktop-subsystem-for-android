Subject: Process: give the apps the guest names the computer's memory as totalMem

ActivityManager.getMemoryInfo is computed in system_server for its caller, from
Process.getTotalMemory, which reads sysinfo() in system_server's own process. The DSA guest's VM
starts small and grows, so that size says nothing about the computer, and Google Play picks an
app's build by it: a device under 8 GB gets a Chrome whose browser is 32-bit, which the 64-bit
only guest cannot start.

DSA's guest kernel lists the apps that see the computer's memory in
/sys/module/dsa_host_memory/parameters/uids (the Play Store and Play services, which the guest's
control daemon names and only init may write) and holds the computer's memory, which the host
passes at each start, in total_kb. getTotalMemory now returns that size when the binder caller
the thread serves is one of those apps, and the VM's own size otherwise. Every other caller and
system_server itself (lmkd's and the cache limits' sizing) see the VM, as before.

Applies to frameworks/base at 45034f0663f960d9ee5fb0a101a4732b71f6e2f4 (Android 16).
---
diff --git a/core/jni/android_util_Process.cpp b/core/jni/android_util_Process.cpp
index fe69dd9..4bf480a 100644
--- a/core/jni/android_util_Process.cpp
+++ b/core/jni/android_util_Process.cpp
@@ -28,7 +28,10 @@
 #include <meminfo/sysmeminfo.h>
 #include <processgroup/processgroup.h>
 #include <processgroup/sched_policy.h>
+#include <android-base/file.h>
 #include <android-base/logging.h>
+#include <android-base/parseint.h>
+#include <android-base/strings.h>
 #include <android-base/unique_fd.h>
 #include <cutils/misc.h>
 
@@ -655,6 +658,47 @@ static jlong android_os_Process_getFreeMemory(JNIEnv* env, jobject clazz) {
     return android_os_Process_getMemory(env, clazz, ::android::meminfo::SysMemInfo::kMemFree);
 }
 
+// DSA: the computer's physical memory, in bytes, when the binder caller this thread is
+// serving is one of the apps that see it as the device's memory, else 0. The DSA guest's VM
+// starts small and grows, so its size says nothing about the computer, and Google Play picks an
+// app's build by the device's memory: a device under 8 GB gets a Chrome whose browser is 32-bit,
+// which the 64-bit only guest cannot start. The guest kernel shows the apps it lists in
+// /sys/module/dsa_host_memory/parameters/uids (the Play Store and Play services, which the
+// guest's control daemon names) the computer's memory, total_kb, in /proc/meminfo and sysinfo().
+// ActivityManager.getMemoryInfo is computed in system_server for its caller, so the same list
+// decides the answer here. Only init may write the list. Every other caller, and system_server
+// itself, gets the VM's size.
+static jlong dsaHostMemoryForCaller()
+{
+    static constexpr const char* kDir = "/sys/module/dsa_host_memory/parameters/";
+    static constexpr uid_t kPerUserRange = 100000;
+    if (IPCThreadState::selfOrNull() == nullptr) {
+        return 0;
+    }
+    const uid_t caller = IPCThreadState::self()->getCallingUid();
+    if (caller == getuid()) {
+        return 0;
+    }
+    std::string uids;
+    std::string total;
+    if (!android::base::ReadFileToString(std::string(kDir) + "uids", &uids) ||
+        !android::base::ReadFileToString(std::string(kDir) + "total_kb", &total)) {
+        return 0;
+    }
+    uint64_t totalKb = 0;
+    if (!android::base::ParseUint(android::base::Trim(total), &totalKb) || totalKb == 0) {
+        return 0;
+    }
+    for (const std::string& word : android::base::Split(android::base::Trim(uids), ",")) {
+        uint32_t app = 0;
+        if (android::base::ParseUint(android::base::Trim(word), &app) &&
+            app == caller % kPerUserRange) {
+            return static_cast<jlong>(totalKb) * 1024;
+        }
+    }
+    return 0;
+}
+
 static jlong android_os_Process_getTotalMemory(JNIEnv* env, jobject clazz)
 {
     struct sysinfo si;
@@ -663,7 +707,9 @@ static jlong android_os_Process_getTotalMemory(JNIEnv* env, jobject clazz)
         return -1;
     }
 
-    return static_cast<jlong>(si.totalram) * si.mem_unit;
+    const jlong own = static_cast<jlong>(si.totalram) * si.mem_unit;
+    const jlong host = dsaHostMemoryForCaller();
+    return host > own ? host : own;
 }
 
