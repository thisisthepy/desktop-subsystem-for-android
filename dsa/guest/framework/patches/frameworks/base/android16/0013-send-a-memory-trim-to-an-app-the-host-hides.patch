@@ -3677,6 +3680,67 @@ final class ActivityManagerShellCommand extends ShellCommand {
         return 0;
     }
 
+    /**
+     * DSA: sends a memory trim to the process of an app the host hides from the user, whose
+     * task Android still shows and so counts as in the foreground
+     * (ActivityManagerService.dsaSetHiddenProcessMemoryTrimLevel).
+     *
+     *     dsa-hidden-trim                                    prints "supported"
+     *     dsa-hidden-trim hidden [PACKAGE...]                the packages the host hides,
+     *                                                        replacing those before
+     *     dsa-hidden-trim send <PROCESS> <HIDDEN|BACKGROUND> sends the process the level
+     *
+     * The DSA agent, which holds MANAGE_ACTIVITY_TASKS, sets the packages whenever the host says
+     * which windows the user can see; "hidden" alone means none. Only the shell may send, as
+     * for send-trim-memory, and only to a process of a package that is set: send-trim-memory
+     * itself, and every other app, behave as before. Without arguments the command only
+     * answers, which tells the agent and its trim script that this framework has the change:
+     * one without it answers "Unknown command". The set lives in this process, so it ends when
+     * the process does, and the agent sets it again when it starts.
+     */
+    int runDsaHiddenTrim(PrintWriter pw) throws RemoteException {
+        final String verb = getNextArg();
+        if (verb == null) {
+            pw.println("supported");
+            return 0;
+        }
+        if ("hidden".equals(verb)) {
+            mInternal.mContext.enforceCallingOrSelfPermission(
+                    android.Manifest.permission.MANAGE_ACTIVITY_TASKS, "dsa-hidden-trim");
+            final android.util.ArraySet<String> packages = new android.util.ArraySet<>();
+            for (String arg = getNextArg(); arg != null; arg = getNextArg()) {
+                if (!arg.isEmpty()) {
+                    packages.add(arg);
+                }
+            }
+            mInternal.mDsaHiddenPackages = java.util.Collections.unmodifiableSet(packages);
+            return 0;
+        }
+        if (!"send".equals(verb)) {
+            getErrPrintWriter().println("Error: expected hidden or send, not " + verb);
+            return -1;
+        }
+        final String proc = getNextArgRequired();
+        final String levelArg = getNextArgRequired();
+        final int level;
+        if ("HIDDEN".equals(levelArg)) {
+            level = ComponentCallbacks2.TRIM_MEMORY_UI_HIDDEN;
+        } else if ("BACKGROUND".equals(levelArg)) {
+            level = ComponentCallbacks2.TRIM_MEMORY_BACKGROUND;
+        } else {
+            getErrPrintWriter().println("Error: expected HIDDEN or BACKGROUND, not " + levelArg);
+            return -1;
+        }
+        try {
+            mInternal.dsaSetHiddenProcessMemoryTrimLevel(proc, UserHandle.USER_CURRENT, level);
+        } catch (IllegalArgumentException | SecurityException e) {
+            // The reason goes to the caller as one line, so the trim script can log it.
+            getErrPrintWriter().println("Error: " + e.getMessage());
+            return -1;
+        }
+        return 0;
+    }
+
     int runSendTrimMemory(PrintWriter pw) throws RemoteException {
         int userId = UserHandle.USER_CURRENT;
         String opt;
@@ -5029,6 +5093,9 @@ final class ActivityManagerShellCommand extends ShellCommand {
             pw.println("  send-trim-memory [--user <USER_ID>] <PROCESS>");
             pw.println("          [HIDDEN|RUNNING_MODERATE|BACKGROUND|RUNNING_LOW|MODERATE|RUNNING_CRITICAL|COMPLETE]");
             pw.println("      Send a memory trim event to a <PROCESS>.  May also supply a raw trim int level.");
+            pw.println("  dsa-hidden-trim [hidden [PACKAGE...] | send <PROCESS> <HIDDEN|BACKGROUND>]");
+            pw.println("      DSA: set the packages the host hides, or send a process of one of them a");
+            pw.println("      background trim level although its task is shown.");
