Subject: ProcessList: give the apps the guest names the computer's installed memory as advertisedMem

The framework's earlier patch (0002) gives the Play Store and Play services the computer's memory
as ActivityManager.MemoryInfo.totalMem. advertisedMem, which Google Play uploads next to it, still
came from Process.getAdvertisedMem: ro.boot.ddr_size when set, else the total memory rounded up
to the next power of two in decimal units. A 32 GB computer (33.8 GB of memory) was advertised as
64 GB.

ActivityManager.getMemoryInfo is answered in system_server by ProcessList.getMemoryInfo, for its
binder caller. advertisedMem there is now, for the callers whose totalMem 0002 makes the
computer's (an app in /sys/module/dsa_host_memory/parameters/uids and not in real_uids), the
memory the computer is sold with: the host passes the memory the computer is installed with in
ro.boot.dsa.host_installed_kb (the computer's memory, store_total_kb, where it cannot read that),
and the patch rounds it to whole GiB and counts it in decimal units, as ro.boot.ddr_size is
counted, so a 32 GiB computer advertises 32,000,000,000. Every other caller, and system_server
itself, keeps Process.getAdvertisedMem's value.

The change is in services.jar, which the image takes from DSA's build, and not in Process: the
image keeps the published framework.jar (it is on the boot class path, with a precompiled boot
image). A native method libandroid_runtime registered for a Process method the published
framework.jar does not declare made zygote abort at start.

Applies to frameworks/base at 45034f0663f960d9ee5fb0a101a4732b71f6e2f4 (Android 16).
---
diff --git a/services/core/java/com/android/server/am/ProcessList.java b/services/core/java/com/android/server/am/ProcessList.java
--- a/services/core/java/com/android/server/am/ProcessList.java
+++ b/services/core/java/com/android/server/am/ProcessList.java
@@ -1762,10 +1762,89 @@ public final class ProcessList implements ProcessStateController.ProcessLruUpdat
         return mProcessNames.get(processName, uid);
     }
 
+    // DSA: the folder where the guest kernel lists the apps that see the computer's memory (uids:
+    // the Play Store and Play services) and the ones that see the VM's own (real_uids: DSA's
+    // agent), and holds the computer's memory (store_total_kb). The guest's control daemon names
+    // both lists and only init may write them.
+    private static final String DSA_HOST_MEMORY_DIR = "/sys/module/dsa_host_memory/parameters/";
+    private static final long DSA_GIB_IN_KB = 1024L * 1024L;
+
+    /**
+     * DSA: the memory the computer is sold with, in bytes, as a user reads it ("32 GB"), for a
+     * binder caller that sees the computer's memory (an app in uids and not in real_uids), else 0.
+     *
+     * ActivityManager.MemoryInfo.advertisedMem is that figure on a device, and Google Play uploads
+     * it next to totalMem. Android takes it from ro.boot.ddr_size, or else rounds the total memory
+     * up to the next power of two in decimal units, which turned the computer's 33.8 GB into
+     * 64 GB. The host passes the memory the computer is installed with in
+     * ro.boot.dsa.host_installed_kb (the computer's memory, store_total_kb, when it cannot read
+     * that), which is rounded to whole GiB, the way memory is sold, and counted in decimal units,
+     * as Android counts ro.boot.ddr_size: 32 GiB gives 32,000,000,000.
+     *
+     * The callers are chosen as libandroid_runtime chooses the ones whose totalMem is the
+     * computer's: by the binder caller's app id (its uid modulo 100000), never for a call
+     * system_server makes itself. This is done here rather than in Process.getAdvertisedMem
+     * because the image takes services.jar from DSA's build and keeps the published framework.jar.
+     */
+    private static long dsaHostAdvertisedMemForCaller() {
+        final int caller = Binder.getCallingUid();
+        if (caller == Process.myUid()) {
+            return 0;
+        }
+        final int app = UserHandle.getAppId(caller);
+        if (app < Process.FIRST_APPLICATION_UID || dsaHostMemoryListed("real_uids", app)
+                || !dsaHostMemoryListed("uids", app)) {
+            return 0;
+        }
+        long kb = dsaParseKb(SystemProperties.get("ro.boot.dsa.host_installed_kb", ""));
+        if (kb == 0) {
+            kb = dsaParseKb(dsaHostMemoryRead("store_total_kb"));
+        }
+        if (kb == 0) {
+            return 0;
+        }
+        final long gib = (kb + DSA_GIB_IN_KB / 2) / DSA_GIB_IN_KB;
+        return Math.max(gib, 1) * 1_000_000_000L;
+    }
+
+    /** DSA: a file of the guest kernel's dsa_host_memory parameters, or "" if it cannot be read. */
+    private static String dsaHostMemoryRead(String name) {
+        try {
+            return android.os.FileUtils.readTextFile(new File(DSA_HOST_MEMORY_DIR + name), 0, null);
+        } catch (IOException e) {
+            return "";
+        }
+    }
+
+    /** DSA: the size in KiB that `text` holds, or 0 when it holds none. */
+    private static long dsaParseKb(String text) {
+        try {
+            return Math.max(Long.parseLong(text.trim()), 0);
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
+    /** DSA: whether the comma separated list of app ids in the file `name` holds `app`. */
+    private static boolean dsaHostMemoryListed(String name, int app) {
+        for (String word : dsaHostMemoryRead(name).trim().split(",")) {
+            try {
+                if (Integer.parseInt(word.trim()) == app) {
+                    return true;
+                }
+            } catch (NumberFormatException e) {
+                // A word that is not a number names no app.
+            }
+        }
+        return false;
+    }
+
     void getMemoryInfo(ActivityManager.MemoryInfo outInfo) {
         final long homeAppMem = getMemLevel(HOME_APP_ADJ);
         final long cachedAppMem = getMemLevel(CACHED_APP_MIN_ADJ);
-        outInfo.advertisedMem = getAdvertisedMem();
+        // DSA: the apps that see the computer's memory see what it is sold with.
+        final long dsaAdvertisedMem = dsaHostAdvertisedMemForCaller();
+        outInfo.advertisedMem = dsaAdvertisedMem > 0 ? dsaAdvertisedMem : getAdvertisedMem();
         outInfo.availMem = getMemAvailable();
         outInfo.freeMem = getMemFree();
         outInfo.totalMem = getTotalMemory();
