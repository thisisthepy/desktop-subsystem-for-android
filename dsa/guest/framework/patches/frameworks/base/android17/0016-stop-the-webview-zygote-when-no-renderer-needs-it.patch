+    /**
+     * DSA: how long no WebView renderer may exist before the WebView zygote is stopped, and how
+     * often that is checked while the zygote may run. The zygote holds 5 to 11 MiB for as long as
+     * it runs, and once started it ran until the guest stopped, though most apps show web content
+     * only now and then. Three minutes keep it for an app that opens one web page after another;
+     * a WebView opened later waits once more for the zygote to start (a few hundred milliseconds).
+     */
+    private static final long DSA_WEBVIEW_ZYGOTE_IDLE_MS = 3 * 60 * 1000;
+    private static final long DSA_WEBVIEW_ZYGOTE_CHECK_MS = 60 * 1000;
+
+    /** DSA: when a WebView renderer last existed, as the last check or start saw it. */
+    @GuardedBy("mService")
+    private long mDsaWebViewRendererSeen;
+
+    /** DSA: a check of the WebView zygote is posted to the process start handler. */
+    @GuardedBy("mService")
+    private boolean mDsaWebViewZygoteCheckPending;
+
+    /**
+     * DSA: a WebView renderer is about to start, which starts the WebView zygote if it is not
+     * running. From then on the zygote is checked every minute until it is stopped.
+     */
+    private void dsaWebViewRendererStarting() {
+        synchronized (mService) {
+            mDsaWebViewRendererSeen = SystemClock.uptimeMillis();
+            if (!mDsaWebViewZygoteCheckPending && mService.mProcStartHandler != null) {
+                mDsaWebViewZygoteCheckPending = true;
+                mService.mProcStartHandler.postDelayed(this::dsaCheckWebViewZygote,
+                        DSA_WEBVIEW_ZYGOTE_CHECK_MS);
+            }
+        }
+    }
+
+    /**
+     * DSA: stops the WebView zygote once no WebView renderer has existed for
+     * DSA_WEBVIEW_ZYGOTE_IDLE_MS; WebViewZygote.getProcess() starts it again for the next one.
+     * Runs on the process start handler with the activity manager's lock held. A renderer is
+     * started either on that handler or with that lock held, and its process record exists
+     * before it starts, so no start can find the zygote stopping under it.
+     */
+    private void dsaCheckWebViewZygote() {
+        synchronized (mService) {
+            final long now = SystemClock.uptimeMillis();
+            if (dsaHasWebViewRendererLocked()) {
+                mDsaWebViewRendererSeen = now;
+            }
+            if (now - mDsaWebViewRendererSeen < DSA_WEBVIEW_ZYGOTE_IDLE_MS) {
+                mService.mProcStartHandler.postDelayed(this::dsaCheckWebViewZygote,
+                        DSA_WEBVIEW_ZYGOTE_CHECK_MS);
+                return;
+            }
+            mDsaWebViewZygoteCheckPending = false;
+            if (WebViewZygote.stopIdleZygote()) {
+                Slog.i(TAG, "Stopped the WebView zygote: no WebView renderer for "
+                        + (now - mDsaWebViewRendererSeen) / 1000
+                        + " s; the next WebView starts it again");
+            }
+        }
+    }
+
+    /** DSA: whether a process started from the WebView zygote exists, or is starting. */
+    @GuardedBy("mService")
+    private boolean dsaHasWebViewRendererLocked() {
+        final ArrayMap<String, SparseArray<ProcessRecord>> names = mProcessNames.getMap();
+        for (int i = names.size() - 1; i >= 0; i--) {
+            final SparseArray<ProcessRecord> apps = names.valueAt(i);
+            for (int j = apps.size() - 1; j >= 0; j--) {
+                final HostingRecord hosting = apps.valueAt(j).getHostingRecord();
+                if (hosting != null && hosting.usesWebviewZygote()) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
