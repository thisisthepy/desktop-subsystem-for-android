+
+package android.view;
+
+import android.content.Context;
+import android.content.res.Resources;
+import android.content.res.TypedArray;
+import android.content.res.XmlResourceParser;
+import android.os.IBinder;
+import android.util.DisplayMetrics;
+import android.util.Log;
+import android.util.TypedValue;
+
+import org.xmlpull.v1.XmlPullParser;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.WeakHashMap;
+
+/**
+ * DSA: rebuilds the views of an activity at a new density without relaunching it.
+ *
+ * <p>DSA gives a task the density of the host monitor its window is on. A task the user set to
+ * forced system scaling takes a new density without a relaunch (the window manager treats the
+ * change as handled), so the activity, its process and everything it holds survive. Its
+ * resources then answer at the new density, but its views keep every pixel size they read at
+ * the old one: the height of an app bar, the padding and text size of a list item, the size of
+ * an icon. This class converts those sizes to the new density, in place, on the views the app
+ * already has, as if they had been inflated at it.
+ *
+ * <p>Each view and each set of layout parameters records the density its sizes are in
+ * ({@link View#mDsaDensityDpi}, {@link ViewGroup.LayoutParams#mDsaDensityDpi}). When the
+ * window manager says the activity's views are rescaled (ActivityConfigurationChangeItem), the
+ * activity's windows are converted at once ({@link #rescaleWindowsOf}). A view that is not in a
+ * window then (a list item a RecyclerView keeps for reuse, a page a pager keeps, a dialog's
+ * content) is converted when it is added to a parent or a window again, or when the app first
+ * touches one of its sizes through the framework (its layout parameters, its padding, its
+ * minimum size, its text size), so that a size the app sets at the new density is never
+ * converted a second time. A view converted once records the new density and is left alone.
+ *
+ * <p>What it converts: layout parameters (width, height, margins), padding, minimum size,
+ * elevation, translation, scroll position, the density of the drawables a view shows (bitmap,
+ * nine-patch, vector, shape, layer, state list and inset drawables), a text view's text size,
+ * line spacing, shadow, size limits, auto-size range and compound drawables, and an image
+ * view's drawable and size limits.
+ *
+ * <p>A view of the app's own class (or of a library it ships) may also keep in its own fields
+ * sizes its constructor read from its XML attributes, and lay out with them ever after: the
+ * collapsed height of a sliding panel. The first time such a view is converted, the element it
+ * was inflated from is read again from its layout ({@link View#getSourceLayoutResId}), the
+ * sizes written on it and in its style are worked out at the old density, and each int or float
+ * field of the view's own classes that holds one of them is converted with it, the same fields
+ * every time after that ({@link #rescaleAttributeFields}). Nothing of this runs, and nothing is
+ * kept, in a process that never converts a view.
+ *
+ * <p>What it cannot convert: sizes an app works out itself (from the display metrics, from
+ * resources it reads in code, or in objects other than the view), sizes that come only from a
+ * view's default style, sizes in text spans, an image matrix, and drawables an app made itself
+ * without resources.
+ *
+ * <p>Nothing changes in a process until the first such change reaches it, and no view of any
+ * other task is touched.
+ *
+ * @hide
+ */
+public final class DsaDensityRescale {
+    /**
+     * Set once this process has rebuilt a window at a new density. Until then no view checks
+     * its density, so nothing changes for an app that is never set to forced system scaling.
+     */
+    static volatile boolean sActive;
+
+    private DsaDensityRescale() {}
+
+    /**
+     * Converts every view in the windows of the activity whose token is {@code token} (its own
+     * window, its dialogs and popups) to the density their resources now have, and asks them to
+     * lay out and draw again. Called by ActivityThread after the activity's resources take a new
+     * density, before the activity hears of the change.
+     *
+     * <p>Converted views alone are not enough: the app has to lay out again at the window's new
+     * bounds as if it had been inflated at the new density. So each window asks the window
+     * manager for its frame again, the insets go through its tree again, and every view in it
+     * measures and lays out again ({@link #relayoutTree}).
+     */
+    public static void rescaleWindowsOf(IBinder token) {
+        sActive = true;
+        // The views of one layout read it once in this pass (layoutSizes).
+        sPassThread = Thread.currentThread();
+        sPassSizes = new HashMap<>();
+        for (ViewRootImpl root : WindowManagerGlobal.getInstance().getRootViews(token)) {
+            // A window of another thread is converted when that thread next adds or touches
+            // its views; a view may only be changed on the thread that owns its window.
+            if (root.mThread != Thread.currentThread()) {
+                continue;
+            }
+            final View view = root.getView();
+            if (view == null) {
+                continue;
+            }
+            rescaleTree(view);
+            relayoutTree(view);
+            // The window takes its frame from the window manager again, so its surface follows
+            // the task's bounds at the new density instead of keeping the size it had.
+            root.mForceNextWindowRelayout = true;
+            // The insets go through the tree again: a listener that turns them into padding or
+            // margins (an app bar below the status bar, a player bar above the navigation bar)
+            // works them out again with the converted views, and a CoordinatorLayout hands them
+            // to its behaviours again.
+            view.requestApplyInsets();
+            view.requestLayout();
+            view.invalidate();
+        }
+        sPassSizes = null;
+        sPassThread = null;
+    }
+
+    /**
+     * Makes every view in {@code view}'s tree measure and lay out again, converted or not: a
+     * parent that places its children from what it keeps itself (a CoordinatorLayout, and the
+     * behaviours of its app bar, its scrolling content and its bottom bar) works that out again
+     * from the converted sizes, where it would otherwise keep the places it found at the old
+     * density.
+     */
+    static void relayoutTree(View view) {
+        view.forceLayout();
+        if (view instanceof ViewGroup group) {
+            final int count = group.getChildCount();
+            for (int i = 0; i < count; i++) {
+                final View child = group.getChildAt(i);
+                if (child != null) {
+                    relayoutTree(child);
+                }
+            }
+        }
+    }
+
+    /** Converts {@code view} and every view below it whose sizes are at another density. */
+    static void rescaleTree(View view) {
+        view.dsaRescaleIfStale();
+        if (view instanceof ViewGroup group) {
+            final int count = group.getChildCount();
+            for (int i = 0; i < count; i++) {
+                final View child = group.getChildAt(i);
+                if (child != null) {
+                    rescaleTree(child);
+                }
+            }
+        }
+    }
+
+    /**
+     * {@link #rescaleTree} for a view about to join a parent or a window, once this process
+     * rebuilds windows at all.
+     */
+    static void rescaleTreeIfActive(View view) {
+        if (sActive && view != null) {
+            rescaleTree(view);
+        }
+    }
+
+    /**
+     * What finding a view's own fields keeps, in a class of its own so that it is made only the
+     * first time a view is converted: a process that is never given a forced change of density
+     * never loads it.
+     */
+    private static final class AttributeFields {
+        /**
+         * The fields of each converted view of the app's own class that hold a size from its
+         * layout's attributes ({@link #NONE} when none does), found the first time the view is
+         * converted. Weak, so it keeps no view alive.
+         */
+        static final WeakHashMap<View, Field[]> sFields = new WeakHashMap<>();
+        static final Field[] NONE = new Field[0];
+        static final float[] NO_SIZES = new float[0];
+    }
+
+    private static final String ANDROID_NS = "http://schemas.android.com/apk/res/android";
+
+    /** During {@link #rescaleWindowsOf}, on its thread: the sizes of each layout element read. */
+    private static HashMap<String, float[]> sPassSizes;
+    private static Thread sPassThread;
+
+    /**
+     * Converts the fields of {@code view}'s own classes that hold a size its constructor read
+     * from its XML attributes, from {@code fromDpi} to {@code toDpi}: a sliding panel's
+     * collapsed height, which the panel reads into a field of its own and lays out with ever
+     * after. The fields are found the first time the view is converted, while they still hold
+     * the sizes at the density the view was made at ({@link #layoutSizes},
+     * {@link #isAttributeSize}), and the same fields are converted every time after that. A view
+     * of the framework's own class keeps no such field: what it keeps, it converts itself.
+     */
+    static void rescaleAttributeFields(View view, int fromDpi, int toDpi) {
+        if (isFrameworkClass(view.getClass())) {
+            return;
+        }
+        Field[] fields;
+        synchronized (AttributeFields.sFields) {
+            fields = AttributeFields.sFields.get(view);
+        }
+        if (fields == null) {
+            fields = findAttributeFields(view, layoutSizes(view, fromDpi));
+            synchronized (AttributeFields.sFields) {
+                AttributeFields.sFields.put(view, fields);
+            }
+        }
+        for (Field field : fields) {
+            try {
+                if (field.getType() == int.class) {
+                    field.setInt(view, scale(field.getInt(view), fromDpi, toDpi));
+                } else {
+                    field.setFloat(view, scale(field.getFloat(view), fromDpi, toDpi));
+                }
+            } catch (ReflectiveOperationException | RuntimeException e) {
+                Log.w("DsaDensityRescale", "could not convert " + field + " of " + view, e);
+            }
+        }
+    }
+
+    /**
+     * The sizes, in pixels at {@code fromDpi}, written on the element of {@code view}'s layout it
+     * was inflated from and in that element's style. The element is the one whose class is the
+     * view's (or, for a short tag, the framework class the inflater made the app's subclass of,
+     * as AppCompat does for a TextView) and whose id is the view's; the root of a layout matches
+     * whatever its id, which an include may have replaced.
+     */
+    static float[] layoutSizes(View view, int fromDpi) {
+        final int layout = view.getSourceLayoutResId();
+        final Resources res = view.getResources();
+        if (layout == 0 || res == null || fromDpi <= 0) {
+            return AttributeFields.NO_SIZES;
+        }
+        final String key = layout + ":" + view.getClass().getName() + ":" + view.getId() + ":"
+                + fromDpi;
+        final HashMap<String, float[]> pass =
+                sPassThread == Thread.currentThread() ? sPassSizes : null;
+        final float[] known = pass != null ? pass.get(key) : null;
+        if (known != null) {
+            return known;
+        }
+        final DisplayMetrics now = res.getDisplayMetrics();
+        final DisplayMetrics old = new DisplayMetrics();
+        old.setTo(now);
+        old.densityDpi = fromDpi;
+        old.density = fromDpi / (float) DisplayMetrics.DENSITY_DEFAULT;
+        old.scaledDensity = now.density > 0 ? now.scaledDensity * old.density / now.density
+                : old.density;
+        float[] sizes = AttributeFields.NO_SIZES;
+        try (XmlResourceParser parser = res.getLayout(layout)) {
+            int type;
+            while ((type = parser.next()) != XmlPullParser.END_DOCUMENT) {
+                if (type == XmlPullParser.START_TAG && isElementOf(view, parser)) {
+                    sizes = addSizes(view, res, parser, old, sizes);
+                }
+            }
+        } catch (Exception e) {
+            // A layout that cannot be read again leaves the view's own fields as they are.
+            Log.w("DsaDensityRescale", "could not read the layout of " + view, e);
+        }
+        if (pass != null) {
+            pass.put(key, sizes);
+        }
+        return sizes;
+    }
+
+    /** Whether the element {@code parser} is at is the one {@code view} was inflated from. */
+    private static boolean isElementOf(View view, XmlResourceParser parser) {
+        String name = parser.getName();
+        if ("view".equals(name)) {
+            name = parser.getAttributeValue(null, "class");
+        }
+        if (name == null) {
+            return false;
+        }
+        final Class<?> c = view.getClass();
+        if (name.indexOf('.') >= 0) {
+            if (!name.equals(c.getName())) {
+                return false;
+            }
+        } else {
+            // A short name is a framework class the inflater may have made the app's subclass
+            // of (AppCompat makes an AppCompatTextView for a TextView): the first framework
+            // class above the view's must be the one named.
+            Class<?> framework = c;
+            while (framework != null && !isFrameworkClass(framework)) {
+                framework = framework.getSuperclass();
+            }
+            if (framework == null || !name.equals(framework.getSimpleName())) {
+                return false;
+            }
+        }
+        final int id = view.getId();
+        return id == View.NO_ID || parser.getDepth() == 1
+                || parser.getAttributeResourceValue(ANDROID_NS, "id", View.NO_ID) == id;
+    }
+
+    /**
+     * {@code sizes} and the sizes on the element {@code parser} is at: each attribute written on
+     * it or in its style whose value is a dimension, worked out with {@code old}.
+     */
+    private static float[] addSizes(View view, Resources res, XmlResourceParser parser,
+            DisplayMetrics old, float[] sizes) {
+        final int count = parser.getAttributeCount();
+        int[] attrs = new int[count];
+        int n = 0;
+        for (int i = 0; i < count; i++) {
+            final int attr = parser.getAttributeNameResource(i);
+            if (attr != 0) {
+                attrs[n++] = attr;
+            }
+        }
+        final int style = parser.getStyleAttribute();
+        final int[] styled = style != 0 ? res.getAssets().getStyleAttributes(style) : null;
+        if (styled != null) {
+            attrs = Arrays.copyOf(attrs, n + styled.length);
+            System.arraycopy(styled, 0, attrs, n, styled.length);
+            n += styled.length;
+        }
+        if (n == 0) {
+            return sizes;
+        }
+        // Theme.obtainStyledAttributes takes the attributes in ascending order, each once.
+        attrs = Arrays.copyOf(attrs, n);
+        Arrays.sort(attrs);
+        int unique = 0;
+        for (int i = 0; i < n; i++) {
+            if (unique == 0 || attrs[unique - 1] != attrs[i]) {
+                attrs[unique++] = attrs[i];
+            }
+        }
+        attrs = Arrays.copyOf(attrs, unique);
+        final TypedArray a = view.getContext().obtainStyledAttributes(parser, attrs);
+        try {
+            final TypedValue value = new TypedValue();
+            for (int i = 0; i < unique; i++) {
+                if (a.getValue(i, value) && value.type == TypedValue.TYPE_DIMENSION) {
+                    final float size = TypedValue.complexToDimension(value.data, old);
+                    if (Math.abs(size) > 1f) {
+                        sizes = Arrays.copyOf(sizes, sizes.length + 1);
+                        sizes[sizes.length - 1] = size;
+                    }
+                }
+            }
+        } finally {
+            a.recycle();
+        }
+        return sizes;
+    }
+
+    /**
+     * The int and float fields of {@code view}'s own classes, from its class up to the first
+     * class of the framework's, that hold one of the sizes in {@code sizes}.
+     */
+    private static Field[] findAttributeFields(View view, float[] sizes) {
+        if (sizes.length == 0) {
+            return AttributeFields.NONE;
+        }
