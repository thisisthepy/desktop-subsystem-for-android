+    /**
+     * DSA: the layers' insets and sizes, at the density the layer list was inflated at, and
+     * each layer's drawable.
+     * @hide
+     */
+    @Override
+    public void dsaRetargetDensity(int fromDpi, int toDpi) {
+        final LayerState state = mLayerState;
+        final boolean own = state.mDensity == fromDpi;
+        if (own) {
+            state.setDensity(toDpi);
+        }
+        final ChildDrawable[] array = state.mChildren;
+        final int count = state.mNumChildren;
+        for (int i = 0; i < count; i++) {
+            final ChildDrawable layer = array[i];
+            if (own && layer.mDensity == fromDpi) {
+                layer.setDensity(toDpi);
+            }
+            if (layer.mDrawable != null) {
+                layer.mDrawable.dsaRetargetDensity(fromDpi, toDpi);
+            }
+        }
+        ensurePadding();
+        refreshPadding();
+        onBoundsChange(getBounds());
+        invalidateSelf();
+    }
