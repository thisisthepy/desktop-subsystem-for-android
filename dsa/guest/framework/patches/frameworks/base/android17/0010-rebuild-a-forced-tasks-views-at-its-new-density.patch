+     * takes its stroke and padding from it again.
+     * @hide
+     */
+    @Override
+    public void dsaRetargetDensity(int fromDpi, int toDpi) {
+        final GradientState state = mGradientState;
+        if (state.mDensity == fromDpi) {
+            state.setDensity(toDpi);
+        }
+        if (state.mDensity == toDpi && fromDpi != toDpi) {
