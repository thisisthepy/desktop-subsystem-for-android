diff --git a/core/java/android/view/DsaDensityRescale.java b/core/java/android/view/DsaDensityRescale.java
new file mode 100644
--- /dev/null
+++ b/core/java/android/view/DsaDensityRescale.java
@@ -0,0 +1,445 @@
+/*
