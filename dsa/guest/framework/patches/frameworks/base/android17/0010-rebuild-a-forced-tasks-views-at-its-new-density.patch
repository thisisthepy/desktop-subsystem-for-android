+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package android.view;
+
+import android.content.Context;
+import android.content.res.Resources;
+import android.os.IBinder;
+
+/**
+ * DSA: rebuilds the views of an activity at a new density without relaunching it.
+ *
+ * <p>DSA gives a task the density of the host monitor its window is on. A task the user set to
+ * forced system scaling takes a new density without a relaunch (the window manager treats the
+ * change as handled), so the activity, its process and everything it holds survive. Its
+ * resources then answer at the new density, but its views keep every pixel size they read at
+ * the old one: the height of an app bar, the padding and text size of a list item, the size of
+ * an icon. This class converts those sizes to the new density, in place, on the views the app
+ * already has, as if they had been inflated at it.
+ *
+ * <p>Each view and each set of layout parameters records the density its sizes are in
+ * ({@link View#mDsaDensityDpi}, {@link ViewGroup.LayoutParams#mDsaDensityDpi}). When the
+ * window manager says the activity's views are rescaled (ActivityConfigurationChangeItem), the
+ * activity's windows are converted at once ({@link #rescaleWindowsOf}). A view that is not in a
+ * window then (a list item a RecyclerView keeps for reuse, a page a pager keeps, a dialog's
+ * content) is converted when it is added to a parent or a window again, or when the app first
+ * touches one of its sizes through the framework (its layout parameters, its padding, its
+ * minimum size, its text size), so that a size the app sets at the new density is never
+ * converted a second time. A view converted once records the new density and is left alone.
+ *
+ * <p>What it converts: layout parameters (width, height, margins), padding, minimum size,
+ * elevation, translation, scroll position, the density of the drawables a view shows (bitmap,
+ * nine-patch, vector, shape, layer, state list and inset drawables), a text view's text size,
+ * line spacing, shadow, size limits, auto-size range and compound drawables, and an image
+ * view's drawable and size limits. What it cannot convert: sizes kept in fields of the app's
+ * own classes or of its libraries (a custom view's measurements, an androidx Toolbar's insets,
+ * a RecyclerView ItemDecoration's spacing, a ConstraintLayout guideline), sizes in text spans,
+ * an image matrix, and drawables an app made itself without resources.
+ *
+ * <p>Nothing changes in a process until the first such change reaches it, and no view of any
+ * other task is touched.
+ *
+ * @hide
+ */
+public final class DsaDensityRescale {
+    /**
+     * Set once this process has rebuilt a window at a new density. Until then no view checks
+     * its density, so nothing changes for an app that is never set to forced system scaling.
+     */
+    static volatile boolean sActive;
+
+    private DsaDensityRescale() {}
+
+    /**
+     * Converts every view in the windows of the activity whose token is {@code token} (its own
+     * window, its dialogs and popups) to the density their resources now have, and asks them to
+     * lay out and draw again. Called by ActivityThread after the activity's resources take a new
+     * density, before the activity hears of the change.
+     */
+    public static void rescaleWindowsOf(IBinder token) {
+        sActive = true;
+        for (ViewRootImpl root : WindowManagerGlobal.getInstance().getRootViews(token)) {
+            // A window of another thread is converted when that thread next adds or touches
+            // its views; a view may only be changed on the thread that owns its window.
+            if (root.mThread != Thread.currentThread()) {
+                continue;
+            }
+            final View view = root.getView();
+            if (view == null) {
+                continue;
+            }
+            rescaleTree(view);
+            view.requestLayout();
+            view.invalidate();
+        }
+    }
+
+    /** Converts {@code view} and every view below it whose sizes are at another density. */
+    static void rescaleTree(View view) {
+        view.dsaRescaleIfStale();
+        if (view instanceof ViewGroup group) {
+            final int count = group.getChildCount();
+            for (int i = 0; i < count; i++) {
+                final View child = group.getChildAt(i);
+                if (child != null) {
+                    rescaleTree(child);
+                }
+            }
+        }
+    }
+
+    /**
+     * {@link #rescaleTree} for a view about to join a parent or a window, once this process
+     * rebuilds windows at all.
+     */
+    static void rescaleTreeIfActive(View view) {
+        if (sActive && view != null) {
+            rescaleTree(view);
+        }
+    }
+
+    /** The density of {@code context}'s resources, or 0 for a context without any. */
+    static int densityOf(Context context) {
+        final Resources resources = context != null ? context.getResources() : null;
+        return resources != null ? resources.getDisplayMetrics().densityDpi : 0;
+    }
+
+    /** {@code px}, a size at {@code from} dpi, at {@code to} dpi. */
+    public static int scale(int px, int from, int to) {
+        if (px == 0 || from == to || from <= 0 || to <= 0) {
+            return px;
+        }
+        final float scaled = px * (float) to / from;
+        final int rounded = Math.round(scaled);
+        // As Resources rounds a dimension: a size that was not zero stays at least one pixel.
+        if (rounded == 0) {
+            return px > 0 ? 1 : -1;
+        }
+        return rounded;
+    }
+
+    /** {@code px}, a size at {@code from} dpi, at {@code to} dpi. */
+    public static float scale(float px, int from, int to) {
+        if (px == 0f || from == to || from <= 0 || to <= 0) {
+            return px;
+        }
+        return px * (float) to / from;
+    }
+}
