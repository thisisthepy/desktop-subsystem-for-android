+bool RenderThread::isDeviceLost() {
+    // Skia abandons its context once it sees VK_ERROR_DEVICE_LOST; nothing else in HWUI keeps an
+    // abandoned context.
+    if (mGrContext && mGrContext->abandoned()) {
+        return true;
+    }
+    if (Properties::getRenderPipelineType() == RenderPipelineType::SkiaGL) {
+        return mEglManager->isContextLost();
+    }
+    return mVkManager.get() && mVkManager->isDeviceLost();
+}
+
+void RenderThread::handleDeviceLoss() {
+    if (!mDeviceRecovery.onLost(gpurecovery::DeviceLossRecovery::Clock::now())) {
+        return;
+    }
+    ALOGW("The GPU device was lost. HWUI drops its GPU context, builds a new one once the GPU "
+          "answers, and draws every window again.");
+    if (mGrContext) {
+        // Nothing the lost context made can be drawn or freed through it any more. Abandoning
+        // it first lets Skia let go of the textures it wraps while the old display still exists,
+        // so that none of them is freed later through a display or device made after it.
+        mGrContext->abandonContext();
+    }
+    if (mVkManager.get()) {
+        // The next VulkanManager this process asks for is a new one, on a new device.
+        mVkManager->markDeviceLost();
+    }
+    destroyRenderingContext();
+    // Build the context again as soon as the GPU answers, whether or not a window draws first.
+    scheduleRebuildRetry();
+}
+
+bool RenderThread::checkDevice() {
+    if (mDeviceRecovery.isHealthy()) {
+        if (!isDeviceLost()) {
+            return true;
+        }
+        handleDeviceLoss();
+    }
+    (void)requireGrContext();
+    return mDeviceRecovery.isHealthy();
+}
+
+bool RenderThread::deviceAnswers() {
+    if (Properties::getRenderPipelineType() == RenderPipelineType::SkiaGL) {
+        return EglManager::deviceAnswers();
+    }
+    return VulkanManager::deviceAnswers();
+}
+
+void RenderThread::onContextRebuilt(bool succeeded) {
+    const auto now = gpurecovery::DeviceLossRecovery::Clock::now();
+    mDeviceRecovery.onRebuilt(succeeded, now);
+    if (!succeeded) {
+        ALOGW("The GPU does not answer yet after the device loss (%u attempts); trying again in "
+              "%lld ms",
+              mDeviceRecovery.failedAttempts(),
+              static_cast<long long>(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                             mDeviceRecovery.untilNextAttempt(now))
+                                             .count()));
+        scheduleRebuildRetry();
+        return;
+    }
+    mLastDeviceReset = now;
+    ALOGI("HWUI has a GPU context again after the device loss (reset %u); drawing every window "
+          "again",
+          mDeviceRecovery.resetCount());
+    for (auto&& context : mCacheManager->mCanvasContexts) {
+        context->onDeviceReset();
+    }
+}
+
+void RenderThread::watchGpuResets() {
+    // SurfaceFlinger creates the property before any app starts; without it (an image without
+    // the recovery) nothing is watched.
+    const prop_info* info = __system_property_find(kGpuResetsProperty);
+    if (info == nullptr) {
+        return;
+    }
+    std::thread([this, info]() {
+        uint32_t serial = __system_property_serial(info);
+        while (true) {
+            uint32_t newSerial = 0;
+            if (!__system_property_wait(info, serial, &newSerial, nullptr)) {
+                continue;
+            }
+            serial = newSerial;
+            queue().post([this]() { onGpuResetElsewhere(); });
+        }
+    }).detach();
+}
+
+void RenderThread::onGpuResetElsewhere() {
+    // SurfaceFlinger found the GPU device lost. Every process's device went with the same GPU,
+    // though this one may not have run into it yet, and what its windows showed may be gone.
+    if (!mDeviceRecovery.isHealthy() || !mGrContext) {
+        // Already building a new context, or none to drop: the windows draw when they next do.
+        return;
+    }
+    if (mDeviceRecovery.resetCount() > 0 &&
+        gpurecovery::DeviceLossRecovery::Clock::now() - mLastDeviceReset < kRecentReset) {
+        // This process already built its context again for the same loss.
+        return;
+    }
+    ALOGW("SurfaceFlinger recovered from a GPU device loss; HWUI builds its context again too");
+    handleDeviceLoss();
+}
+
+void RenderThread::scheduleRebuildRetry() {
+    if (mRebuildRetryScheduled) {
+        return;
+    }
+    mRebuildRetryScheduled = true;
+    const auto delay = std::chrono::duration_cast<std::chrono::nanoseconds>(
+            mDeviceRecovery.untilNextAttempt(gpurecovery::DeviceLossRecovery::Clock::now()));
+    queue().postDelayed(static_cast<nsecs_t>(delay.count()), [this]() {
+        mRebuildRetryScheduled = false;
+        if (!mDeviceRecovery.isHealthy()) {
+            (void)requireGrContext();
+        }
+    });
+}
+
