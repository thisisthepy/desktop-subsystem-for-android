+bool EglManager::isContextLost() {
+    if (!hasEglContext()) {
+        return false;
+    }
+    EGLint version = 0;
+    if (eglQueryContext(mEglDisplay, mEglContext, EGL_CONTEXT_CLIENT_VERSION, &version)) {
+        return false;
+    }
+    if (eglGetError() != EGL_CONTEXT_LOST) {
+        return false;
+    }
+    sDeviceLossSeen = true;
+    return true;
+}
+
+bool EglManager::deviceAnswers() {
+    EGLDisplay display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (display == EGL_NO_DISPLAY || !eglInitialize(display, nullptr, nullptr)) {
+        return false;
+    }
+    bool answers = false;
+    const EGLint configAttribs[] = {EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT, EGL_NONE};
+    EGLConfig config = nullptr;
+    EGLint count = 0;
+    if (eglQueryString(display, EGL_VENDOR) != nullptr &&
+        eglChooseConfig(display, configAttribs, &config, 1, &count) && count > 0) {
+        const EGLint contextAttribs[] = {EGL_CONTEXT_CLIENT_VERSION, GLES_VERSION, EGL_NONE};
+        EGLContext context = eglCreateContext(display, config, EGL_NO_CONTEXT, contextAttribs);
+        if (context != EGL_NO_CONTEXT) {
+            answers = true;
+            eglDestroyContext(display, context);
+        }
+    }
+    eglTerminate(display);
+    return answers;
+}
