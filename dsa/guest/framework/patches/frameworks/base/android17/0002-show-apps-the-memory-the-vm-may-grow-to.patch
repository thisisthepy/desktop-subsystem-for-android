Subject: Process: give apps the memory the VM may grow to as totalMem and availMem

ActivityManager.getMemoryInfo is computed in system_server for its caller, from
Process.getTotalMemory, getMemAvailable and getMemFree, which read sysinfo() and /proc/meminfo in
system_server's own process. The DSA guest's VM starts small and grows up to a maximum the host
sets, so that size says nothing about what an app may use, and apps decide by it: a game refuses
to start under its requirement, and Google Play picks an app's build by it (a device under 8 GB
gets a Chrome whose browser is 32-bit, which the 64-bit only guest cannot start).

DSA's guest kernel holds the memory the VM may grow to in
/sys/module/dsa_host_memory/parameters/total_kb and the computer's memory in store_total_kb, which
the host passes at each start, and lists the Play Store and Play services in uids and DSA's agent
in real_uids (the guest's control daemon names them and only init may write them). The kernel
shows every app process the first in /proc/meminfo and sysinfo(). For a binder caller that is an
app (an app ID of 10000 or more) and not in real_uids, getTotalMemory now returns total_kb (or
store_total_kb for an app in uids, when larger), and getMemAvailable and getMemFree add what the
VM may still grow. Every other caller and system_server itself (lmkd's and the cache limits'
sizing) see the VM, as before.

Applies to frameworks/base at 94b4c163b7dfe5ce3607f7bb8456f9573f7de57d (Android 17).
---
diff --git a/core/jni/android_util_Process.cpp b/core/jni/android_util_Process.cpp
index 0cfb648..780329c 100644
--- a/core/jni/android_util_Process.cpp
+++ b/core/jni/android_util_Process.cpp
@@ -29,7 +29,10 @@
 #include <processgroup/processgroup.h>
 #include <processgroup/processgroup_platform.h>
 #include <processgroup/sched_policy.h>
+#include <android-base/file.h>
 #include <android-base/logging.h>
+#include <android-base/parseint.h>
+#include <android-base/strings.h>
 #include <android-base/unique_fd.h>
 #include <cutils/misc.h>
 
@@ -649,12 +652,102 @@ static jlong android_os_Process_getMemory(JNIEnv* env, jobject clazz, std::strin
     return sum * 1024;
 }
 
+// DSA: the memory the binder caller this thread is serving sees as the device's. The DSA guest's
+// VM starts small and grows up to a maximum the host sets, so its size says nothing about what an
+// app may use, and apps decide by it: a game refuses to start under its requirement, and Google
+// Play picks an app's build by it (a device under 8 GB gets a Chrome whose browser is 32-bit,
+// which the 64-bit only guest cannot start). The guest kernel shows every app process (an app ID
+// of 10000 or more) the memory the VM may grow to, total_kb in
+// /sys/module/dsa_host_memory/parameters/, as MemTotal in /proc/meminfo and in sysinfo(), and adds
+// what the VM may still grow to its free memory. The apps in uids (the Play Store and Play
+// services) see the computer's memory, store_total_kb, as their total, and the apps in real_uids
+// (DSA's agent, which reports the guest's memory to the host) the VM's own. The guest's control
+// daemon names both lists and only init may write them. ActivityManager.getMemoryInfo is computed
+// in system_server for its caller, so the same rules decide its totalMem, availMem and freeMem
+// here. System callers, and system_server itself (lmkd's and the cache limits' sizing), get the
+// VM's size.
+static constexpr const char* kDsaHostMemoryDir = "/sys/module/dsa_host_memory/parameters/";
+
+static uint64_t dsaHostMemoryKb(const char* name)
+{
+    std::string text;
+    uint64_t kb = 0;
+    if (!android::base::ReadFileToString(std::string(kDsaHostMemoryDir) + name, &text) ||
+        !android::base::ParseUint(android::base::Trim(text), &kb)) {
+        return 0;
+    }
+    return kb;
+}
+
+static bool dsaHostMemoryListed(const char* name, uid_t app)
+{
+    std::string uids;
+    if (!android::base::ReadFileToString(std::string(kDsaHostMemoryDir) + name, &uids)) {
+        return false;
+    }
+    for (const std::string& word : android::base::Split(android::base::Trim(uids), ",")) {
+        uint32_t listed = 0;
+        if (android::base::ParseUint(android::base::Trim(word), &listed) && listed == app) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// The total the caller sees, in bytes, given the VM's own total `own`, and in `headroom` what the
+// VM may still grow, which the caller's free memory gains.
+static jlong dsaMemoryForCaller(jlong own, jlong* headroom)
+{
+    static constexpr uid_t kPerUserRange = 100000;
+    static constexpr uid_t kFirstApplicationUid = 10000;
+    *headroom = 0;
+    if (IPCThreadState::selfOrNull() == nullptr) {
+        return own;
+    }
+    const uid_t caller = IPCThreadState::self()->getCallingUid();
+    if (caller == getuid()) {
+        return own;
+    }
+    const uid_t app = caller % kPerUserRange;
+    if (app < kFirstApplicationUid || dsaHostMemoryListed("real_uids", app)) {
+        return own;
+    }
+    jlong shown = own;
+    const jlong growsTo = static_cast<jlong>(dsaHostMemoryKb("total_kb")) * 1024;
+    if (growsTo > own) {
+        *headroom = growsTo - own;
+        shown = growsTo;
+    }
+    if (dsaHostMemoryListed("uids", app)) {
+        const jlong store = static_cast<jlong>(dsaHostMemoryKb("store_total_kb")) * 1024;
+        if (store > shown) {
+            shown = store;
+        }
+    }
+    return shown;
+}
+
+// The free or available memory the caller sees: the VM's own, `own`, and what the VM may still
+// grow.
+static jlong dsaFreeMemoryForCaller(jlong own)
+{
+    struct sysinfo si;
+    if (own < 0 || sysinfo(&si) != 0) {
+        return own;
+    }
+    jlong headroom = 0;
+    dsaMemoryForCaller(static_cast<jlong>(si.totalram) * si.mem_unit, &headroom);
+    return own + headroom;
+}
+
 static jlong android_os_Process_getAvailableMemory(JNIEnv* env, jobject clazz) {
-    return android_os_Process_getMemory(env, clazz, ::android::meminfo::SysMemInfo::kMemAvailable);
+    return dsaFreeMemoryForCaller(android_os_Process_getMemory(
+            env, clazz, ::android::meminfo::SysMemInfo::kMemAvailable));
 }
 
 static jlong android_os_Process_getFreeMemory(JNIEnv* env, jobject clazz) {
-    return android_os_Process_getMemory(env, clazz, ::android::meminfo::SysMemInfo::kMemFree);
+    return dsaFreeMemoryForCaller(
+            android_os_Process_getMemory(env, clazz, ::android::meminfo::SysMemInfo::kMemFree));
 }
 
 static jlong android_os_Process_getTotalMemory(JNIEnv* env, jobject clazz)
@@ -665,7 +758,9 @@ static jlong android_os_Process_getTotalMemory(JNIEnv* env, jobject clazz)
         return -1;
     }
 
-    return static_cast<jlong>(si.totalram) * si.mem_unit;
+    const jlong own = static_cast<jlong>(si.totalram) * si.mem_unit;
+    jlong headroom = 0;
+    return dsaMemoryForCaller(own, &headroom);
 }
 
