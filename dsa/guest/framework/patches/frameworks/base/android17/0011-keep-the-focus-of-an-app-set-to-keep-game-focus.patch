+    /**
+     * DSA: sets the packages whose activities keep their focus while another app's task is the
+     * top resumed one ("keep game focus", ActivityRecord.dsaKeepFocus).
+     *
+     *     dsa-keep-focus                          prints "supported"
+     *     dsa-keep-focus set [PACKAGE...]         the packages, replacing those before
+     *
+     * The DSA agent sets the packages the user switched on, when it starts and whenever the
+     * user changes them; "set" alone switches every app off. Without arguments the command only
+     * answers, which tells the agent this framework has the change: one without it answers
+     * "Unknown command". The set lives in the window manager's process, so it ends when that
+     * process does, and the agent sets it again when it starts. An activity hears of a change
+     * with the next change of its top resumed state. The caller needs MANAGE_ACTIVITY_TASKS.
+     */
+    private int runDsaKeepFocus(PrintWriter pw) {
+        mInternal.mContext.enforceCallingOrSelfPermission(
+                android.Manifest.permission.MANAGE_ACTIVITY_TASKS, "dsa-keep-focus");
+        final String verb = getNextArg();
+        if (verb == null) {
+            pw.println("supported");
+            return 0;
+        }
+        if (!"set".equals(verb)) {
+            getErrPrintWriter().println("Error: expected set, not " + verb);
+            return -1;
+        }
+        final android.util.ArraySet<String> packages = new android.util.ArraySet<>();
+        for (String arg = getNextArg(); arg != null; arg = getNextArg()) {
+            if (!arg.isEmpty()) {
+                packages.add(arg);
+            }
+        }
+        ActivityRecord.sDsaKeepFocusPackages = java.util.Collections.unmodifiableSet(packages);
+        return 0;
+    }
