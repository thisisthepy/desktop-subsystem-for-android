+    /**
+     * DSA: whether the views are not told of this change of window focus, because the app
+     * keeps its focus ("keep game focus"). A loss is kept while another app's task is the top
+     * resumed one and this window is visible (ActivityThread.dsaWindowFocusKept); while the
+     * activity is still on top as far as this process knows, the loss waits
+     * DSA_FOCUS_LOSS_SETTLE_MS for the word that another task is (dsaCheckFocusLoss). A gain
+     * after a kept loss is not told either: the views never heard they lost the focus.
+     */
+    private boolean dsaKeepsFocus(boolean hasWindowFocus) {
+        mHandler.removeCallbacks(mDsaFocusLossCheck);
+        if (hasWindowFocus) {
+            final boolean held = mDsaFocusLossHeld;
+            mDsaFocusLossHeld = false;
+            return held;
+        }
+        if (mDsaFocusLossHeld) {
+            return true;
+        }
+        if (!mAppVisible) {
+            return false;
+        }
+        final ActivityThread thread = ActivityThread.currentActivityThread();
+        if (thread == null) {
+            return false;
+        }
+        switch (thread.dsaWindowFocusKept(mWindowAttributes.token)) {
+            case ActivityThread.DSA_FOCUS_KEPT:
+                mDsaFocusLossHeld = true;
+                return true;
+            case ActivityThread.DSA_FOCUS_MAYBE_KEPT:
+                mDsaFocusLossHeld = true;
+                mHandler.postDelayed(mDsaFocusLossCheck, DSA_FOCUS_LOSS_SETTLE_MS);
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    /**
+     * DSA: a loss of window focus that waited for the word that another app's task is the top
+     * resumed one: kept if that came, told to the views now if it did not.
+     */
+    private void dsaCheckFocusLoss() {
+        if (!mDsaFocusLossHeld || mAttachInfo.mHasWindowFocus) {
+            return;
+        }
+        final ActivityThread thread = ActivityThread.currentActivityThread();
+        if (mAppVisible && thread != null && thread.dsaWindowFocusKept(mWindowAttributes.token)
+                == ActivityThread.DSA_FOCUS_KEPT) {
+            return;
+        }
+        dsaReleaseFocusLoss();
+    }
+
+    /** DSA: tells the views of a loss of window focus they were not told of, if any. */
+    private void dsaReleaseFocusLoss() {
+        mHandler.removeCallbacks(mDsaFocusLossCheck);
+        if (!mDsaFocusLossHeld) {
+            return;
+        }
+        mDsaFocusLossHeld = false;
+        if (mView != null && !mAttachInfo.mHasWindowFocus) {
+            mView.dispatchWindowFocusChanged(false);
+            mAttachInfo.mTreeObserver.dispatchOnWindowFocusChange(false);
+        }
+    }
