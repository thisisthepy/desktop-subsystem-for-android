+//! Root key retrieval for DSA (Desktop Subsystem for Android), whose host gives the root key.
+//!
+//! [`crate::soft::Keys`] wraps every key blob under a fixed all-zero root key, so a copy of the
+//! device's disk gives up every key on it. DSA runs this service in a virtual machine whose host
+//! keeps a root key of its own, sealed on the host, and gives it to the guest once per boot. The
+//! guest's control daemon (`dsa-channeld --keymint-key`) fetches it before Android unlocks its
+//! storage and leaves it on tmpfs, readable only by this service's user, in [`HOST_KEY_FILE`].
+//! The file holds exactly one line:
+//!
+//! - `key <64 lowercase hex digits>\n`: the host's 32-byte root key, or
+//! - `none <reason>\n`: the host gave no key this boot, and why.
+//!
+//! With the host's key, every new key blob is wrapped under it and carries [`HOST_KEK_CONTEXT`]
+//! as its KEK context. A blob with that context opens only under the host's key: in a boot without
+//! one it fails, and the built-in key is never tried for it. A blob made before (empty context,
+//! built-in key) still opens, and the TA answers KEY_REQUIRES_UPGRADE for it
+//! (`kek_context_is_outdated`). Keystore and vold upgrade every blob they use on that answer, and
+//! upgradeKey wraps it again under the host's key, so an existing install keeps all its keys.
+//!
+//! Without the host's key (the file says `none`, is not in the form above, or does not appear in
+//! time) the service behaves exactly as upstream's: built-in key, empty context, no upgrades.
+
+use crate::soft;
+use kmr_common::{crypto, km_err, Error};
+use kmr_ta::device::RetrieveKeyMaterial;
+use log::{error, info, warn};
+use std::fmt;
+use std::io::ErrorKind;
+use std::path::PathBuf;
+use std::sync::OnceLock;
+use std::time::{Duration, Instant};
+use zeroize::Zeroize;
+
+/// Where DSA's control daemon leaves the root key the host gave for this boot.
+pub const HOST_KEY_FILE: &str = "/dev/dsa_keymint/root_key";
+
+/// How long after the service starts the file may take to appear. The daemon asks the host for at
+/// most 25 seconds and then writes `none`, so the file is normally there within a second or two of
+/// boot, and always before this.
+pub const HOST_KEY_WAIT: Duration = Duration::from_secs(30);
+
+/// How often the file is looked for while it is not there yet.
+const HOST_KEY_POLL: Duration = Duration::from_millis(50);
+
+/// The KEK context of a key blob wrapped under the host's root key. Upstream's blobs have an
+/// empty context. The version names this way of using the host's key, so that another can be told
+/// from it later.
+pub const HOST_KEK_CONTEXT: &[u8] = b"dsa-host-root-key-v1";
+
+/// The length of the host's root key, in bytes.
+pub const HOST_KEY_LEN: usize = 32;
+
+/// What the host key file says.
+#[derive(PartialEq, Eq)]
+pub enum HostKeyFile {
+    /// The host's root key.
+    Key(crypto::hmac::Key),
+    /// The host gave no key, for this reason.
+    NoKey(String),
+}
+
+impl fmt::Debug for HostKeyFile {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            // Never the key itself, which a log line would otherwise carry.
+            HostKeyFile::Key(_) => write!(f, "Key(..)"),
+            HostKeyFile::NoKey(reason) => write!(f, "NoKey({reason:?})"),
+        }
+    }
+}
+
+/// Reads the contents of the host key file. Anything but exactly one line in one of its two forms
+/// is refused, with what is wrong with it.
+pub fn parse_host_key_file(data: &[u8]) -> Result<HostKeyFile, String> {
+    let line = data.strip_suffix(b"\n").ok_or("it does not end with a newline")?;
+    if line.contains(&b'\n') {
+        return Err("it has more than one line".into());
+    }
+    if let Some(hex) = line.strip_prefix(b"key ") {
+        if hex.len() != 2 * HOST_KEY_LEN {
+            return Err(format!("its key has {} hex digits, not {}", hex.len(), 2 * HOST_KEY_LEN));
+        }
+        // Built in place, so that the key is wiped when it is dropped on the way out too.
+        let mut key = crypto::hmac::Key(Vec::with_capacity(HOST_KEY_LEN));
+        for pair in hex.chunks(2) {
+            match (lowercase_hex_digit(pair[0]), lowercase_hex_digit(pair[1])) {
+                (Some(high), Some(low)) => key.0.push((high << 4) | low),
+                _ => return Err("its key is not lowercase hex".into()),
+            }
+        }
+        Ok(HostKeyFile::Key(key))
+    } else if let Some(reason) = line.strip_prefix(b"none ") {
+        Ok(HostKeyFile::NoKey(String::from_utf8_lossy(reason).into_owned()))
+    } else {
+        Err("it starts with neither `key ` nor `none `".into())
+    }
+}
+
+fn lowercase_hex_digit(c: u8) -> Option<u8> {
+    match c {
+        b'0'..=b'9' => Some(c - b'0'),
+        b'a'..=b'f' => Some(c - b'a' + 10),
+        _ => None,
+    }
+}
+
+/// Root key retrieval with the DSA host's root key when it gave one this boot, and upstream's
+/// fake keys ([`soft::Keys`]) for everything else: the key agreement key, the unique ID key, and
+/// the root key of the blobs made before.
+pub struct HostKeys {
+    file: PathBuf,
+    deadline: Instant,
+    key: OnceLock<Option<crypto::hmac::Key>>,
+}
+
+impl Default for HostKeys {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl HostKeys {
+    /// Reads the host's key from [`HOST_KEY_FILE`], waiting at most [`HOST_KEY_WAIT`] from now (the
+    /// TA is built as the service starts).
+    pub fn new() -> Self {
+        Self::with_file(HOST_KEY_FILE, HOST_KEY_WAIT)
+    }
+
+    /// Reads the host's key from `file`, waiting at most `wait` from now for it to appear.
+    pub fn with_file(file: impl Into<PathBuf>, wait: Duration) -> Self {
+        Self { file: file.into(), deadline: Instant::now() + wait, key: OnceLock::new() }
+    }
+
+    /// The host's root key, read the first time the TA needs a root key, and kept for the life of
+    /// the process: the host gives it once per boot.
+    fn host_key(&self) -> Option<&crypto::hmac::Key> {
+        self.key.get_or_init(|| self.read_host_key()).as_ref()
+    }
+
+    fn read_host_key(&self) -> Option<crypto::hmac::Key> {
+        let file = self.file.display();
+        loop {
+            match std::fs::read(&self.file) {
+                Ok(mut data) => {
+                    let parsed = parse_host_key_file(&data);
+                    data.zeroize();
+                    return match parsed {
+                        Ok(HostKeyFile::Key(key)) => {
+                            info!("key blobs are wrapped under the DSA host's root key from {file}");
+                            Some(key)
+                        }
+                        Ok(HostKeyFile::NoKey(reason)) => {
+                            warn!(
+                                "the DSA host gave no root key this boot ({reason}); key blobs \
+                                 stay under the built-in root key"
+                            );
+                            None
+                        }
+                        Err(why) => {
+                            error!(
+                                "{file} does not hold a root key ({why}); key blobs stay under the \
+                                 built-in root key"
+                            );
+                            None
+                        }
+                    };
+                }
+                Err(e) if e.kind() == ErrorKind::NotFound && Instant::now() < self.deadline => {
+                    std::thread::sleep(HOST_KEY_POLL);
+                }
+                Err(e) if e.kind() == ErrorKind::NotFound => {
+                    error!(
+                        "{file} did not appear in time, so the DSA host's root key is not known; \
+                         key blobs stay under the built-in root key"
+                    );
+                    return None;
+                }
+                Err(e) => {
+                    error!("{file} cannot be read ({e}); key blobs stay under the built-in root key");
+                    return None;
+                }
+            }
+        }
+    }
+}
+
+impl RetrieveKeyMaterial for HostKeys {
+    fn root_kek(&self, context: &[u8]) -> Result<crypto::OpaqueOr<crypto::hmac::Key>, Error> {
+        if context.is_empty() {
+            // A blob made under the built-in key: before the host gave a key, or in a boot without
+            // one.
+            return soft::Keys.root_kek(context);
+        }
+        if context != HOST_KEK_CONTEXT {
+            return Err(km_err!(
+                InvalidKeyBlob,
+                "the key blob's KEK context is not one this KeyMint makes"
+            ));
+        }
+        match self.host_key() {
+            Some(key) => Ok(key.clone().into()),
+            // Never the built-in key: the blob was wrapped under the host's.
+            None => Err(km_err!(
+                HardwareNotYetAvailable,
+                "the key blob is wrapped under the DSA host's root key, which the host did not give \
+                 this boot"
+            )),
+        }
+    }
+
+    fn kek_context(&self) -> Result<Vec<u8>, Error> {
+        Ok(if self.host_key().is_some() { HOST_KEK_CONTEXT.to_vec() } else { Vec::new() })
+    }
+
+    fn kek_context_is_outdated(&self, kek_context: &[u8]) -> Result<bool, Error> {
+        // A blob under the built-in key is upgraded once the host has given its key.
+        Ok(kek_context.is_empty() && self.host_key().is_some())
+    }
+
+    fn kak(&self) -> Result<crypto::OpaqueOr<crypto::aes::Key>, Error> {
+        soft::Keys.kak()
+    }
+
+    fn unique_id_hbk(&self, ckdf: &dyn crypto::Ckdf) -> Result<crypto::hmac::Key, Error> {
+        soft::Keys.unique_id_hbk(ckdf)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::{SystemTime, UNIX_EPOCH};
+
+    const KEY_HEX: &str = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f";
+
+    fn key_bytes() -> Vec<u8> {
+        (0u8..32).collect()
+    }
+
+    fn explicit(key: crypto::OpaqueOr<crypto::hmac::Key>) -> Vec<u8> {
+        match key {
+            crypto::OpaqueOr::Explicit(key) => key.0.clone(),
+            crypto::OpaqueOr::Opaque(_) => panic!("opaque root key"),
+        }
+    }
+
+    fn file_with(contents: Option<&[u8]>) -> PathBuf {
+        let nanos = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos();
+        let path = std::env::temp_dir()
+            .join(format!("dsa-keymint-root-key-{}-{nanos}", std::process::id()));
+        if let Some(contents) = contents {
+            std::fs::write(&path, contents).unwrap();
+        }
+        path
+    }
+
+    #[test]
+    fn fr36_host_key_line_is_parsed() {
+        let parsed = parse_host_key_file(format!("key {KEY_HEX}\n").as_bytes()).unwrap();
+        assert_eq!(parsed, HostKeyFile::Key(crypto::hmac::Key(key_bytes())));
+        let parsed = parse_host_key_file(b"none no credential store\n").unwrap();
+        assert_eq!(parsed, HostKeyFile::NoKey("no credential store".into()));
+    }
+
+    #[test]
+    fn fr36_malformed_host_key_file_is_refused() {
+        for bad in [
+            format!("key {KEY_HEX}"),
+            format!("key {}\n", KEY_HEX.to_uppercase()),
+            format!("key {}\n", &KEY_HEX[2..]),
+            format!("key {KEY_HEX}0\n"),
+            format!("key {KEY_HEX}\nnone x\n"),
+            format!("key  {KEY_HEX}\n"),
+            "none\n".to_string(),
+            "\n".to_string(),
+            String::new(),
+            format!("KEY {KEY_HEX}\n"),
+        ] {
+            assert!(parse_host_key_file(bad.as_bytes()).is_err(), "{bad:?} was taken");
+        }
+    }
+
+    #[test]
+    fn fr36_without_host_key_behaves_as_upstream() {
+        for contents in [Some(&b"none the host has no key\n"[..]), Some(&b"garbage\n"[..]), None] {
+            let file = file_with(contents);
+            let keys = HostKeys::with_file(&file, Duration::ZERO);
+            assert_eq!(keys.kek_context().unwrap(), Vec::<u8>::new());
+            assert!(!keys.kek_context_is_outdated(&[]).unwrap());
+            assert_eq!(explicit(keys.root_kek(&[]).unwrap()), vec![0; 16]);
+            assert!(keys.root_kek(HOST_KEK_CONTEXT).is_err());
+            let _ = std::fs::remove_file(&file);
+        }
+    }
+
+    #[test]
+    fn fr36_host_key_seals_new_blobs_and_upgrades_old_ones() {
+        let file = file_with(Some(format!("key {KEY_HEX}\n").as_bytes()));
+        let keys = HostKeys::with_file(&file, Duration::ZERO);
+        assert_eq!(keys.kek_context().unwrap(), HOST_KEK_CONTEXT.to_vec());
+        assert_eq!(explicit(keys.root_kek(HOST_KEK_CONTEXT).unwrap()), key_bytes());
+        // Old blobs still open under the built-in key, and ask to be upgraded.
+        assert_eq!(explicit(keys.root_kek(&[]).unwrap()), vec![0; 16]);
+        assert!(keys.kek_context_is_outdated(&[]).unwrap());
+        assert!(!keys.kek_context_is_outdated(HOST_KEK_CONTEXT).unwrap());
+        assert!(keys.root_kek(b"another context").is_err());
+        // Read once, and kept: the file going away later changes nothing.
+        std::fs::remove_file(&file).unwrap();
+        assert_eq!(explicit(keys.root_kek(HOST_KEK_CONTEXT).unwrap()), key_bytes());
+    }
+
+    #[test]
+    fn fr36_host_key_is_waited_for() {
+        let file = file_with(None);
+        let keys = HostKeys::with_file(&file, Duration::from_secs(10));
+        let writer = {
+            let file = file.clone();
+            std::thread::spawn(move || {
+                std::thread::sleep(Duration::from_millis(200));
+                // As the daemon writes it: whole, then renamed into place.
+                let temp = file.with_extension("tmp");
+                std::fs::write(&temp, format!("key {KEY_HEX}\n")).unwrap();
+                std::fs::rename(temp, file).unwrap();
+            })
+        };
+        assert_eq!(keys.kek_context().unwrap(), HOST_KEK_CONTEXT.to_vec());
+        writer.join().unwrap();
+        let _ = std::fs::remove_file(&file);
+    }
+}
