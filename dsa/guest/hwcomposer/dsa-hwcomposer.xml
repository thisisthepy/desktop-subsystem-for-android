<!-- The composer HAL dsa-hwcomposer serves. Version 4 is the one the compatibility matrix
     of every supported image accepts. -->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>android.hardware.graphics.composer3</name>
        <version>4</version>
        <fqname>IComposer/default</fqname>
    </hal>
</manifest>
