# Google Play, when the user installed it (dsa gapps install). The host adds
# androidboot.dsa.gapps=on to the boot's bootconfig only while a Google apps image is
# installed, with androidboot.dsa.gapps_image saying where the image is: "disk" when it is
# gapps.img on the user's add-on disk, which dsa-addons.rc mounts at /mnt/dsa-addons before
# this runs, and "data" for one boot after an update from a DSA that sent the image to the
# user's disk, /data/vendor/dsa/gapps/system.img. In that boot the host moves the image onto the
# add-on disk and has dsa-channeld delete it from /data, so the next boot mounts it from the
# disk and nothing of it stays in /data. Here init mounts the image straight from its file and
# lays each of its folders over the same folder of /product and /system_ext, before the zygote
# starts: the apps (app, priv-app), the framework files, and the privileged permission lists,
# system configuration, default permissions and preferred apps in etc. The package manager
# reads a partition's lists only for that partition's apps, so each stays in its own partition.
# The fingerprint that makes the boot an upgrade comes from /system/etc/dsa/gapps-on.prop, which
# the product build.prop imports on the same condition. A system script, because only init
# itself may lay anything over a partition.
#
# Only those folders are laid over, never a partition's root: overlayfs looks every file up
# with init's credentials, and init may not read the attributes of the services' programs in
# /system_ext/bin and /product/bin, so a service started from an overlaid partition fails to
# start (bpfloader did, through /system/bin). The folders laid over hold apps and their
# configuration, which init may read. The image carries every one of them, empty when the
# build has nothing there, and so does the system, so each overlay finds both layers.
#
# erofs reads the image file itself (file-backed erofs), not through a loop device. A loop
# device kept a second copy of every page read from the image in the file's own page cache,
# beside the one erofs keeps. directio asks erofs to read the file's data without that copy;
# the file's filesystem decides whether it can. The add-on disk's erofs can for its
# uncompressed files, so a page read from the image is cached once. The encrypted /data cannot
# without inline encryption, which is why the image no longer lives there; there the read is an
# ordinary cached one. erofs opens the file with init's credentials and reads it with them,
# whichever process asked for the page.
#
# The image's files are labelled system files (context=), and its superblock gets a filesystem
# type of its own (fscontext=, sepolicy/gapps.cil), which every domain may statfs: statfs on an
# overlaid folder reports the image's superblock, the overlay's top lower layer. Both go in one
# comma-separated argument with directio: init passes only the last argument that is not a flag
# to the kernel and drops any other, and context= alone relabels the superblock to a file type,
# which the kernel refuses ("denied { relabelto } ... system_file ... tclass=filesystem"). The
# overlays are not nosuid, as the partitions are not.
#
# init runs the actions of one trigger in the order this file gives them, so the image is
# mounted, from wherever it is, before it is laid over.
on post-fs-data && property:ro.boot.dsa.gapps=on && property:ro.boot.dsa.gapps_image=disk
    mkdir /mnt/dsa-gapps 0755 root root
    mount erofs /mnt/dsa-addons/gapps.img /mnt/dsa-gapps ro nodev nosuid directio,fscontext=u:object_r:dsa_gapps_fs:s0,context=u:object_r:system_file:s0

# In the host's direct-mapped mode ("dax") the add-on disk is persistent memory, and the host's
# partition table also names the image's own bytes on it (dsa_gapps). erofs mounts that
# partition as a block device with dax=always, so it maps each file of the image from the host
# and keeps no page cache of it; mounted from the file, its pages would be cached as before.
on post-fs-data && property:ro.boot.dsa.gapps=on && property:ro.boot.dsa.gapps_image=dax
    mkdir /mnt/dsa-gapps 0755 root root
    mount erofs /dev/block/by-name/dsa_gapps /mnt/dsa-gapps ro nodev nosuid dax=always,fscontext=u:object_r:dsa_gapps_fs:s0,context=u:object_r:system_file:s0

on post-fs-data && property:ro.boot.dsa.gapps=on && property:ro.boot.dsa.gapps_image=data
    mkdir /mnt/dsa-gapps 0755 root root
    mount erofs /data/vendor/dsa/gapps/system.img /mnt/dsa-gapps ro nodev nosuid directio,fscontext=u:object_r:dsa_gapps_fs:s0,context=u:object_r:system_file:s0

on post-fs-data && property:ro.boot.dsa.gapps=on
    mount overlay overlay /product/app ro nodev lowerdir=/mnt/dsa-gapps/product/app:/product/app
    mount overlay overlay /product/priv-app ro nodev lowerdir=/mnt/dsa-gapps/product/priv-app:/product/priv-app
    mount overlay overlay /product/framework ro nodev lowerdir=/mnt/dsa-gapps/product/framework:/product/framework
    mount overlay overlay /product/etc/permissions ro nodev lowerdir=/mnt/dsa-gapps/product/etc/permissions:/product/etc/permissions
    mount overlay overlay /product/etc/sysconfig ro nodev lowerdir=/mnt/dsa-gapps/product/etc/sysconfig:/product/etc/sysconfig
    mount overlay overlay /product/etc/default-permissions ro nodev lowerdir=/mnt/dsa-gapps/product/etc/default-permissions:/product/etc/default-permissions
    mount overlay overlay /product/etc/preferred-apps ro nodev lowerdir=/mnt/dsa-gapps/product/etc/preferred-apps:/product/etc/preferred-apps
    mount overlay overlay /system_ext/app ro nodev lowerdir=/mnt/dsa-gapps/system_ext/app:/system_ext/app
    mount overlay overlay /system_ext/priv-app ro nodev lowerdir=/mnt/dsa-gapps/system_ext/priv-app:/system_ext/priv-app
    mount overlay overlay /system_ext/framework ro nodev lowerdir=/mnt/dsa-gapps/system_ext/framework:/system_ext/framework
    mount overlay overlay /system_ext/etc/permissions ro nodev lowerdir=/mnt/dsa-gapps/system_ext/etc/permissions:/system_ext/etc/permissions
    mount overlay overlay /system_ext/etc/sysconfig ro nodev lowerdir=/mnt/dsa-gapps/system_ext/etc/sysconfig:/system_ext/etc/sysconfig
    mount overlay overlay /system_ext/etc/default-permissions ro nodev lowerdir=/mnt/dsa-gapps/system_ext/etc/default-permissions:/system_ext/etc/default-permissions
    mount overlay overlay /system_ext/etc/preferred-apps ro nodev lowerdir=/mnt/dsa-gapps/system_ext/etc/preferred-apps:/system_ext/etc/preferred-apps

# Google Play services and the Play Store without an app image. ART compiles an app the Play
# Store installs or updates with its cloud profile (speed-profile) and an app image: the classes
# of the profile, laid out ready to use, which every process of the app loads into memory of its
# own. Play services runs several processes at once (com.google.android.gms,
# com.google.android.gms.unstable, com.google.android.gms.ui, ...); on a PC the first two held a
# 25-30 MiB copy each, of every class in the profile, used by that process or not. Without it a
# process loads only the classes it uses, as it runs. gapps-compile.sh compiles the two
# again with the same profile, so their code stays compiled ahead of time and shared, but with
# no app image: ART makes an app image only while dalvik.vm.appimageformat names a format, so
# init clears it for the length of the compile and puts it back when the script ends. An app
# the package manager compiles in that window gets no app image either, until its next compile.
#
# The script runs at each boot and whenever the agent asks (vendor.dsa.gapps.compile), which it
# does when either package is installed or updated and each time the screen goes off: ART's
# background job compiles apps again while the device is idle, with an app image, and the next
# screen off finds that, at a time no window is shown. The script compiles a package only while
# its code comes from a compile other than its own, at the background priority. It runs as the
# shell, which may ask the package manager to compile; the processes already running keep the
# app image they loaded until they start again.
service dsa_gapps_compile /system/bin/sh /system/etc/dsa/gapps-compile.sh
    user shell
    group shell
    seclabel u:r:shell:s0
    oneshot
    disabled

on post-fs-data && property:ro.boot.dsa.gapps=on
    setprop vendor.dsa.gapps.appimageformat ${dalvik.vm.appimageformat}

on property:sys.boot_completed=1 && property:ro.boot.dsa.gapps=on
    setprop dalvik.vm.appimageformat ""
    start dsa_gapps_compile

on property:vendor.dsa.gapps.compile=* && property:ro.boot.dsa.gapps=on
    setprop dalvik.vm.appimageformat ""
    start dsa_gapps_compile

# The format the image's build gives, which the first action above kept; lz4, the image's own,
# should that keeping have failed, so no app is left without an app image for the whole boot.
on property:init.svc.dsa_gapps_compile=stopped
    setprop dalvik.vm.appimageformat ${vendor.dsa.gapps.appimageformat:-lz4}
