# Android's log goes to the serial console, which the host keeps as the VM's console log.
# Cuttlefish's own seriallogging writes to a virtio console Hyper-V does not have.
service dsa_console_logcat /system/bin/logcat -b all -v threadtime -f /dev/ttyS0 *:V
    class core
    user logd
    group root logd
    seclabel u:r:logpersist:s0
