# The guest's control channel daemon: holds the connection to the host. init restarts it
# if it exits; it exits only when the boot has no secret or the host refuses this guest.
service dsa_channeld /vendor/bin/dsa-channeld
    class core
    user system
    # readproc: /proc is mounted so that only this group sees other users' processes, and the
    # daemon reads the name of a caller that says it is the agent. uhid: /dev/uinput, where the
    # daemon makes the host's game controllers gamepads.
    group system readproc uhid
    stdio_to_kmsg
    # Every pointer event passes through here on its way to the agent; it must not wait
    # behind apps. Only the framework's display and input threads go ahead of it.
    priority -10

# Tells the daemon, which tells the host, that Android has finished booting. A property of the
# daemon's own, because the policy that lets a vendor process read system properties varies.
on property:sys.boot_completed=1
    setprop vendor.dsa.boot_completed 1

# Handing idle memory back to the host. dsa-channeld sets this when no task is in use for a
# while, or the guest holds mostly cache. A guest with memory to spare is never short, so the
# kernel would never swap by itself: first it is asked to move cold pages to zram, a quarter at
# a time because init does nothing else during a command. Writing to the root cgroup covers
# every process, and "swappiness=200" prefers anonymous pages. vendor.dsa.memory.reclaim_step
# says how many MiB each quarter takes: together half the anonymous memory, the coldest, so the
# pages of the processes still running are not swapped out only to come straight back. Then the
# clean page cache and the reclaimable kernel caches are dropped, and compaction leaves whole
# blocks free, which free page reporting hands back to Hyper-V. Nothing is lost: what left is read back when needed.
# It waits for boot to finish, so a boot still under way does not swap out what it is using;
# a request made before then stays set, and runs when boot completes.
on property:vendor.dsa.memory.reclaim=1 && property:sys.boot_completed=1
    write /sys/fs/cgroup/memory.reclaim "${vendor.dsa.memory.reclaim_step}M swappiness=200"
    write /sys/fs/cgroup/memory.reclaim "${vendor.dsa.memory.reclaim_step}M swappiness=200"
    write /sys/fs/cgroup/memory.reclaim "${vendor.dsa.memory.reclaim_step}M swappiness=200"
    write /sys/fs/cgroup/memory.reclaim "${vendor.dsa.memory.reclaim_step}M swappiness=200"
    write /proc/sys/vm/drop_caches 3
    write /proc/sys/vm/compact_memory 1
    setprop vendor.dsa.memory.reclaim 0

# The working set trim: dsa-channeld sets this on the first look that finds page cache grown
# past the guest's working set (an app closed, or files were read), while the guest is not
# under memory pressure, whether or not the host is short. vendor.dsa.memory.trim_size says
# how many MiB: all of the excess at once. The kernel takes them from the
# root cgroup, which every process's memory is charged under, coldest pages first, so the hot
# pages of running apps and system_server stay. "swappiness=0" takes page cache only: app
# memory moves to zram in the idle reclaim, not while an app is in use. The root's file is
# root's, unlike those of the groups libprocessgroup makes, so init's vendor scripts can always
# open it. The pages it frees are scattered among pages in use, and free page reporting hands
# back only whole free blocks, so compaction then gathers them and they go back to the host at
# once rather than whenever background compaction gets to them.
on property:vendor.dsa.memory.trim=1
    write /sys/fs/cgroup/memory.reclaim "${vendor.dsa.memory.trim_size}M swappiness=0"
    write /proc/sys/vm/compact_memory 1
    setprop vendor.dsa.memory.trim 0

# Developer mode. dsa-channeld sets vendor.dsa.adb as the host says: 1 while the user's
# developer mode is on, 0 when it is off. adbd then listens on vsock only
# (service.adb.listen_addrs), which the host bridges to its loopback address. The USB
# configuration is "none", and init.usb.rc stops adbd each time that is set, so adbd is
# started again after that while developer mode is on.
on property:vendor.dsa.adb=1
    start adbd

on property:vendor.dsa.adb=0
    stop adbd

on property:sys.usb.config=none && property:vendor.dsa.adb=1
    start adbd

# File sharing: the user's host folders in the shared storage. dsa-channeld sets
# vendor.dsa.shares as the host says ("off", or the port, the location and the folders), and
# dsa-channeld --share-mount mounts each folder with 9p at /data/media/0/<location>/<folder>
# and takes away the ones no longer shared. It runs as root, which mounting needs, in a domain
# of its own (files.cil), and only once Android has finished booting, when the storage is
# there.
service dsa_sharemount /vendor/bin/dsa-channeld --share-mount
    user root
    group root media_rw
    seclabel u:r:dsa_sharemount:s0
    oneshot
    disabled
    stdio_to_kmsg

on property:vendor.dsa.shares=* && property:sys.boot_completed=1
    start dsa_sharemount

# Android's shared storage, served to the host as WebDAV while the host asks for it.
# dsa-channeld sets vendor.dsa.files to the port and the token ("off" to stop), and the service
# restarts with them. It runs as media_rw, the storage's owner, so what it writes belongs
# where Android's own files do.
service dsa_files /vendor/bin/dsa-channeld --android-files
    user media_rw
    group media_rw
    seclabel u:r:dsa_files:s0
    disabled
    stdio_to_kmsg

on property:vendor.dsa.files=* && property:sys.boot_completed=1
    restart dsa_files
