# The guest's control channel daemon: holds the connection to the host. init restarts it
# if it exits; it exits only when the boot has no secret or the host refuses this guest.
service dsa_channeld /vendor/bin/dsa-channeld
    class core
    user system
    group system
    stdio_to_kmsg

# Handing idle memory back to the host. dsa-channeld sets this when the guest has had no app
# task for a while, or holds mostly cache. Dropping the clean page cache and the reclaimable
# kernel caches, then compacting, leaves whole 2 MiB blocks free, which free page reporting
# hands back to Hyper-V. Nothing is lost: what was dropped is read again from disk if needed.
on property:vendor.dsa.memory.reclaim=1
    write /proc/sys/vm/drop_caches 3
    write /proc/sys/vm/compact_memory 1
    setprop vendor.dsa.memory.reclaim 0
