; Desktop Subsystem for Android (DSA)
; The guest's memory controls. init runs the commands of the vendor scripts (dsa-memory.rc,
; dsa-channeld.rc) as vendor_init, which may write only the kernel settings it is given here:
; the cache drop and compaction that let free page reporting hand idle memory back to the
; host, and how readily the kernel swaps to zram.

; /proc/sys/vm/compact_memory, /proc/sys/vm/swappiness and
; /proc/sys/vm/compaction_proactiveness have no label of their own, so they would be plain
; proc, which vendor_init may not write. A type of their own opens these three and nothing
; else.
(type dsa_proc_vm_tunable)
(roletype object_r dsa_proc_vm_tunable)
(typeattributeset fs_type (dsa_proc_vm_tunable))
(typeattributeset proc_type (dsa_proc_vm_tunable))
(genfscon proc "/sys/vm/compact_memory" (u object_r dsa_proc_vm_tunable ((s0) (s0))))
(genfscon proc "/sys/vm/swappiness" (u object_r dsa_proc_vm_tunable ((s0) (s0))))
(genfscon proc "/sys/vm/compaction_proactiveness" (u object_r dsa_proc_vm_tunable ((s0) (s0))))
(allow vendor_init dsa_proc_vm_tunable (file (write open getattr)))
(allow init dsa_proc_vm_tunable (file (read write open getattr)))
(allow vendor_init proc_drop_caches (file (write open getattr)))
(allow vendor_init proc_page_cluster (file (write open getattr)))

; vendor.dsa.memory.reclaim (vendor_property_contexts): set to 1 by dsa-channeld when the
; guest should drop its caches, and back to 0 by init once it has. Nothing else may set it.
(type dsa_memory_prop)
(roletype object_r dsa_memory_prop)
(typeattributeset property_type (dsa_memory_prop))
(typeattributeset vendor_property_type (dsa_memory_prop))
(allow vendor_init dsa_memory_prop (property_service (set)))
(allow vendor_init dsa_memory_prop (file (read open getattr map)))

; The reclaims write memory.reclaim in the unified cgroup hierarchy (labelled cgroup_v2).
(allow vendor_init cgroup_v2 (dir (search getattr)))
(allow vendor_init cgroup_v2 (file (write open getattr)))

; init names zram's second compressor before the swap starts (dsa-memory.rc), and the idle
; reclaim marks what zram holds idle, compresses it again and compacts zram (dsa-channeld.rc).
(allow vendor_init sysfs_zram (dir (search)))
(allow vendor_init sysfs_zram (file (write open getattr)))

; zram's backing file, /data/per_boot/zram_swap (fstab.dsa, dsa-zram-backing.rc). init makes
; the folder and, through fs_mgr in swapon_all, the file, attaches it to a loop device and
; names that zram's backing device. The loop driver reads and writes the file from the kernel's
; own threads. Nothing else may open it: what is in it is apps' memory.
(type dsa_zram_backing_file)
(roletype object_r dsa_zram_backing_file)
(typeattributeset file_type (dsa_zram_backing_file))
(typeattributeset data_file_type (dsa_zram_backing_file))
(typeattributeset core_data_file_type (dsa_zram_backing_file))
(allow init dsa_zram_backing_file (dir (create search getattr setattr open read write add_name remove_name relabelto)))
(allow init dsa_zram_backing_file (file (create open read write getattr setattr unlink relabelto)))
(allow kernel dsa_zram_backing_file (file (read write getattr)))
; dsa-zram-backing.rc and Android's init.rc remove the last boot's folder with toolbox's rm,
; which may only empty it: list it, unlink the file and remove the folder, never open the file.
; A folder left behind with the last boot's key would make init.rc's mkdir ask for a wipe.
(allow toolbox dsa_zram_backing_file (dir (getattr open read search write remove_name rmdir)))
(allow toolbox dsa_zram_backing_file (file (getattr unlink)))

; The idle reclaim and the zram writeback ask the kernel to report every free page to the host
; again (page_reporting.rereport, a parameter DSA's kernel adds): free pages a host that backs
; memory in clusters took in again, and those the per-CPU lists held. The parameter is plain
; sysfs otherwise, which vendor_init may not write; a type of its own opens this one file.
(type dsa_sysfs_page_reporting)
(roletype object_r dsa_sysfs_page_reporting)
(typeattributeset fs_type (dsa_sysfs_page_reporting))
(typeattributeset sysfs_type (dsa_sysfs_page_reporting))
(genfscon sysfs "/module/page_reporting/parameters/rereport" (u object_r dsa_sysfs_page_reporting ((s0) (s0))))
(allow vendor_init dsa_sysfs_page_reporting (file (write open getattr)))

; The agent reports how much compressed swap holds (zram's mm_stat) with the rest of the
; guest's memory.
(allow system_app sysfs_zram (dir (search)))
(allow system_app sysfs_zram (file (read open getattr)))
(allow platform_app sysfs_zram (dir (search)))
(allow platform_app sysfs_zram (file (read open getattr)))

; It also reports how much memory the guest has online (the online blocks in
; /sys/devices/system/memory times block_size_bytes), so the host can tell memory the guest has
; not yet handed back from memory Android uses. The platform leaves that folder plain sysfs,
; whose files no app may read, so the report always came without it. A type of its own opens
; this folder to the agent and nothing else.
(type dsa_sysfs_memory)
(roletype object_r dsa_sysfs_memory)
(typeattributeset fs_type (dsa_sysfs_memory))
(typeattributeset sysfs_type (dsa_sysfs_memory))
(genfscon sysfs "/devices/system/memory" (u object_r dsa_sysfs_memory ((s0) (s0))))
(allow system_app dsa_sysfs_memory (dir (search read open getattr)))
(allow system_app dsa_sysfs_memory (file (read open getattr)))
(allow platform_app dsa_sysfs_memory (dir (search read open getattr)))
(allow platform_app dsa_sysfs_memory (file (read open getattr)))

; Shared memory is a memfd. libcutils tries one in each process the first time it needs shared
; memory: it sizes a test memfd and asks it the ashmem ioctls, and when any step is refused it
; falls back to /dev/ashmem for the rest of that process's life, and DSA's kernel has no such
; device. A memfd made by a domain with no tmpfs type of its own is plain tmpfs, which the
; platform's policy gives only getattr, so the audio HAL and the software codecs fell back and
; every message queue they made was invalid. No audio output ever opened, audio policy never
; started, system_server asked for its audio ports ten times a second, and each click decoded
; its sound effects again and failed.
;
; The other end of each queue maps the same memfd: audioserver and system_server the ones made
; plain tmpfs, the HAL and the codecs those of audioserver and system_server.
(allow hal_audio_server tmpfs (file (ioctl read write getattr map)))
(allowx hal_audio_server tmpfs (ioctl file ((range 0x7701 0x770b))))
(allow mediaswcodec tmpfs (file (ioctl read write getattr map)))
(allowx mediaswcodec tmpfs (ioctl file ((range 0x7701 0x770b))))
(allow audioserver tmpfs (file (read write getattr map)))
(allow system_server tmpfs (file (read write getattr map)))
(allow hal_audio_server audioserver_tmpfs (file (read write getattr map)))
(allow hal_audio_server system_server_tmpfs (file (read write getattr map)))
(allow mediaswcodec system_server_tmpfs (file (read write getattr map)))

; The media services' memfds reach apps. An audio track's or a recording's control block is a
; memfd audioserver makes, labelled audioserver_tmpfs; the buffers of a remote media extractor,
; of the media player service and of the camera service are memfds labelled
; mediaextractor_tmpfs, mediaserver_tmpfs and cameraserver_tmpfs. Android's own policy expects
; them on /dev/ashmem, which every domain may use, so it never gave them the rules a memfd
; needs once it crosses to another process (Android 17 gives them only for its memfd_file
; class, which DSA's guest does not use):
;
; - An app runs at its own MLS level (s0 and its user's and app's categories) and the services
;   at s0, and a file below the subject's level may be written only when its type is
;   mlstrustedobject. Binder checks read and write on every memfd it carries, so the reply
;   that carried an audio track's control block failed, AudioTrack reported "Could not get
;   control block" (NO_INIT) and no app played a sound while SELinux was enforcing. An allow
;   rule cannot lift a constraint, which is why allowing the apps the files did not help.
;   system_server_tmpfs is mlstrustedobject for the same reason.
; - The type rules follow the ones Android 17 gives the memfd_file class: apps may use the
;   extractor's, the player service's and the camera service's memfds, the player service the
;   extractor's and audioserver's, system_server audioserver's, the extractor the transcoding
;   service's, and audioserver an app's and system_server's (the shared buffer of a static
;   track, as SoundPool and the click sounds use).
(typeattributeset mlstrustedobject (audioserver_tmpfs mediaextractor_tmpfs mediaserver_tmpfs cameraserver_tmpfs))
(allow appdomain mediaextractor_tmpfs (file (read write getattr map)))
(allow appdomain mediaserver_tmpfs (file (read write getattr map)))
(allow appdomain cameraserver_tmpfs (file (read write getattr map)))
(allow mediaserver mediaextractor_tmpfs (file (read write getattr map)))
(allow mediaserver audioserver_tmpfs (file (read write getattr map)))
(allow system_server audioserver_tmpfs (file (read write getattr map)))
(allow mediaextractor mediatranscoding_tmpfs (file (read write getattr map)))
(allow audioserver appdomain_tmpfs (file (read write getattr map)))
(allow audioserver system_server_tmpfs (file (read write getattr map)))

; The codec services' memfds reach every codec client, apps included: the queues of the buffer
; pool connection between a codec and its client, which the codec service makes and the
; client maps. The software codecs (mediaswcodec) and DSA's codec HAL (mediacodec) have no tmpfs
; type of their own, so their memfds were plain tmpfs, which no client may map and an app may
; not write at its MLS level. They get one type, as Android 17 lets apps use hal_codec2's
; memfd_file objects, and it is mlstrustedobject for the apps.
(type dsa_codec2_tmpfs)
(roletype object_r dsa_codec2_tmpfs)
(typeattributeset file_type (dsa_codec2_tmpfs))
(typeattributeset mlstrustedobject (dsa_codec2_tmpfs))
(typetransition mediaswcodec tmpfs file dsa_codec2_tmpfs)
(typetransition mediacodec tmpfs file dsa_codec2_tmpfs)
(allow hal_codec2_server dsa_codec2_tmpfs (file (ioctl read write getattr map)))
(allowx hal_codec2_server dsa_codec2_tmpfs (ioctl file ((range 0x7701 0x770b))))
(allow hal_codec2_client dsa_codec2_tmpfs (file (read write getattr map)))
