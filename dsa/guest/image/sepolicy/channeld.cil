; Desktop Subsystem for Android (DSA)
; The guest's control channel daemon (/vendor/bin/dsa-channeld): init starts it in its own
; domain, it reads the boot's secret from /proc/bootconfig and connects to the host over
; vsock. It serves the agent and the hwcomposer over binder, so those domains may call it
; and it may call them back; nothing else is granted to any other domain. Apps in particular
; still cannot read /proc/bootconfig, which is what keeps the secret the daemon's alone.

(type dsa_channeld)
(roletype object_r dsa_channeld)
(typeattributeset domain (dsa_channeld))

(type dsa_channeld_exec)
(roletype object_r dsa_channeld_exec)
(typeattributeset file_type (dsa_channeld_exec))
(typeattributeset exec_type (dsa_channeld_exec))
(typeattributeset vendor_file_type (dsa_channeld_exec))

; init starts it and it moves into its own domain.
(typetransition init dsa_channeld_exec process dsa_channeld)
(allow init dsa_channeld_exec (file (read getattr map execute open)))
(allow init dsa_channeld (process (transition siginh rlimitinh)))
(dontaudit init dsa_channeld (process (noatsecure)))
(allow dsa_channeld dsa_channeld_exec (file (entrypoint read getattr map execute open)))
(allow dsa_channeld init (fd (use)))

; Its messages go to the kernel log through the descriptor init opens for it
; (stdio_to_kmsg opens /dev/kmsg_debug).
(allow dsa_channeld kmsg_device (chr_file (write append getattr)))
(allow dsa_channeld kmsg_debug_device (chr_file (write append getattr)))

; The boot's secret.
(allow dsa_channeld proc_bootconfig (file (read open getattr)))

; The control channel.
(allow dsa_channeld self (vsock_socket (create connect read write getattr setopt getopt shutdown)))

; The binder service the agent and the hwcomposer reach the daemon through,
; io.github.thisisthepy.dsa.channel.IChannel/default on /dev/binder, which
; vendor_service_contexts labels dsa_channel_service. Only the daemon may register it.
(type dsa_channel_service)
(roletype object_r dsa_channel_service)
(typeattributeset service_manager_type (dsa_channel_service))
(typeattributeset hal_service_type (dsa_channel_service))

(allow dsa_channeld binder_device (chr_file (ioctl read write open getattr map)))
(allow dsa_channeld servicemanager (binder (call transfer)))
(allow servicemanager dsa_channeld (binder (call transfer)))
; servicemanager reads the caller's context to check it.
(allow servicemanager dsa_channeld (dir (search)))
(allow servicemanager dsa_channeld (file (read open)))
(allow servicemanager dsa_channeld (process (getattr)))
(allow dsa_channeld dsa_channel_service (service_manager (add find)))

; Its clients: the agent, a platform-signed system app (system_app with the system user ID,
; platform_app without), and the hwcomposer. They find the service and call it; the daemon
; calls back the listeners they hand it.
(allow system_app dsa_channel_service (service_manager (find)))
(allow platform_app dsa_channel_service (service_manager (find)))
(allow hal_graphics_composer_server dsa_channel_service (service_manager (find)))
(allow system_app dsa_channeld (binder (call transfer)))
(allow platform_app dsa_channeld (binder (call transfer)))
(allow hal_graphics_composer_server dsa_channeld (binder (call transfer)))
(allow dsa_channeld system_app (binder (call transfer)))
(allow dsa_channeld platform_app (binder (call transfer)))
(allow dsa_channeld hal_graphics_composer_server (binder (call transfer)))

; A caller that says it is the agent has its process name read, from /proc/<pid>/cmdline.
; Reading it checks getattr as well, which the kernel would otherwise refuse and log each time.
(allow dsa_channeld system_app (dir (search)))
(allow dsa_channeld system_app (file (read open getattr)))
(allow dsa_channeld platform_app (dir (search)))
(allow dsa_channeld platform_app (file (read open getattr)))
; An app's process carries MLS categories (s0:c512,c768), and without this the kernel refuses the
; read even though the rules above allow it. What the daemon may touch is still only what this
; file allows.
(typeattributeset mlstrustedsubject (dsa_channeld))

; vendor.dsa.boot_completed (vendor_property_contexts): init sets it to 1 when Android has
; finished booting, and the daemon reads it to tell the host. Nothing else may set it.
(type dsa_boot_prop)
(roletype object_r dsa_boot_prop)
(typeattributeset property_type (dsa_boot_prop))
(typeattributeset vendor_property_type (dsa_boot_prop))
(allow vendor_init dsa_boot_prop (property_service (set)))
(allow vendor_init dsa_boot_prop (file (read open getattr map)))
(allow dsa_channeld dsa_boot_prop (file (read open getattr map)))

; Handing idle memory back to the host: the daemon reads how the guest uses its memory and,
; when it should drop its caches, sets vendor.dsa.memory.reclaim (its type, dsa_memory_prop,
; is in memory.cil). init's vendor scripts do the rest (dsa-channeld.rc).
(allow dsa_channeld proc_meminfo (file (read open getattr)))
(allow dsa_channeld property_socket (sock_file (write)))
(allow dsa_channeld init (unix_stream_socket (connectto)))
(allow dsa_channeld dsa_memory_prop (property_service (set)))
(allow dsa_channeld dsa_memory_prop (file (read open getattr map)))
;
; The zram writeback reads zram's backing device and statistics (backing_dev, mm_stat,
; bd_stat), to skip a guest whose zram has no backing file and to log and count what each run
; wrote against the day's budget. It writes nothing there: init does.
(allow dsa_channeld sysfs_zram (dir (search)))
(allow dsa_channeld sysfs_zram (file (read open getattr)))

; The gradual trim skips a guest under memory pressure, which the daemon reads from the
; kernel's pressure stall information.
(allow dsa_channeld proc_pressure_mem (file (read open getattr)))
;
; Evicted page cache read back (workingset_refault_file in /proc/vmstat) tells the trim the
; working set is larger than it assumed. Without this the read was refused every check and the
; trim never learned it, so idle memory stayed in the guest.
(allow dsa_channeld proc_vmstat (file (read open getattr)))
;
; When an app's last window closes, the daemon waits for its processes to exit before it
; reclaims: it lists /proc and reads each process's /proc/<pid>/cmdline. An app's processes are
; appdomain (the rules for system_app and platform_app above are part of this). Every other
; domain's process is of no interest to it, so those reads are refused without being logged.
(allow dsa_channeld proc (dir (search read open getattr)))
(allow dsa_channeld appdomain (dir (search getattr)))
(allow dsa_channeld appdomain (file (read open getattr)))
;
; After something wakes an app that no window shows, the daemon pages its anonymous memory back
; to zram (process_madvise with MADV_PAGEOUT on the private anonymous ranges of
; /proc/<pid>/maps). It tells an app's process by the owner of its /proc entry (dir getattr
; above), reads its oom_score_adj, stat and status, and never touches the foreground app or one
; with a window. The kernel checks the advice against the target as a read of its address
; space, which SELinux checks as the file read above; the capabilities are the ones the kernel
; asks for: sys_nice for advising another process, sys_ptrace for reading the address space of
; a process of another user. init gives the daemon both (dsa-channeld.rc).
(allow dsa_channeld self (capability (sys_nice sys_ptrace)))
(dontaudit dsa_channeld domain (dir (search getattr)))
(dontaudit dsa_channeld domain (file (read open getattr)))

; Developer mode: the daemon sets vendor.dsa.adb (its type, dsa_adb_prop, is in adb.cil) as
; the host says, and init starts or stops adbd (dsa-channeld.rc).
(allow dsa_channeld dsa_adb_prop (property_service (set)))
(allow dsa_channeld dsa_adb_prop (file (read open getattr map)))
; Android's log, read only while the host asks for it, through logd's reader socket
; (/dev/socket/logdr, a sequenced-packet socket); the records go to the host on the log port,
; which the vsock rules above already cover. The daemon runs as the system user, which logd
; lets read every app's log. It writes no log of its own anywhere.
(allow dsa_channeld self (unix_stream_socket (create connect read write getattr setopt shutdown)))
(allow dsa_channeld logdr_socket (sock_file (write)))
(allow dsa_channeld logd (unix_stream_socket (connectto)))

; What the kernel kept of the boot before in pstore (/sys/fs/pstore), for the diagnostics the
; host asks for. A record the host has is unlinked, which erases it from the pstore disk; the
; daemon first makes the folder, which init leaves read only to it, writable to it.
(allow dsa_channeld pstorefs (dir (search read open getattr setattr write remove_name)))
(allow dsa_channeld pstorefs (file (read open getattr unlink)))

; ARM app translation: the daemon writes the package image the host sends to
; /data/vendor/dsa/arm-translation (dsa-arm-translation.rc makes the directory, as the system
; user the daemon runs as) and removes it when the host says so. init mounts it at the next
; boot (arm-translation.cil). /data itself carries a label of its own, which the way down passes.
(allow dsa_channeld system_data_root_file (dir (search)))
(allow dsa_channeld vendor_data_file (dir (search read open getattr write add_name remove_name)))
(allow dsa_channeld vendor_data_file (file (create read write open getattr setattr unlink rename)))

; The host's game controllers: the daemon makes each one a gamepad on /dev/uinput, reports its
; buttons, sticks and triggers there, and reads the rumble effects apps play on it.
(allow dsa_channeld uhid_device (chr_file (ioctl read write open getattr)))

; KeyMint's root key. init runs dsa-channeld --keymint-key once each boot in a domain of its
; own (dsa-channeld.rc, dsa-keymint-key.rc): it reads the boot's secret, asks the host for the
; key over vsock, and writes it to /dev/dsa_keymint/root_key, a tmpfs folder init makes, which
; vendor_file_contexts labels dsa_keymint_key_file. A file made there takes the folder's type.
; Only KeyMint's domain (hal_keymint_server) may read it; the control daemon itself cannot,
; and no app can. Nothing else in this domain touches the disk.
(type dsa_keymint_key)
(roletype object_r dsa_keymint_key)
(typeattributeset domain (dsa_keymint_key))
(allow init dsa_keymint_key (process (transition siginh rlimitinh)))
(dontaudit init dsa_keymint_key (process (noatsecure)))
(allow dsa_keymint_key dsa_channeld_exec (file (entrypoint read getattr map execute open)))
(allow dsa_keymint_key init (fd (use)))
(allow dsa_keymint_key kmsg_device (chr_file (write append getattr)))
(allow dsa_keymint_key kmsg_debug_device (chr_file (write append getattr)))
(allow dsa_keymint_key proc_bootconfig (file (read open getattr)))
(allow dsa_keymint_key self (vsock_socket (create connect read write getattr setopt getopt shutdown)))

(type dsa_keymint_key_file)
(roletype object_r dsa_keymint_key_file)
(typeattributeset file_type (dsa_keymint_key_file))
(allow dsa_keymint_key_file tmpfs (filesystem (associate)))
(allow init dsa_keymint_key_file (dir (create search getattr setattr open read write add_name relabelto)))
(allow dsa_keymint_key device (dir (search)))
(allow dsa_keymint_key dsa_keymint_key_file (dir (search getattr write add_name remove_name)))
(allow dsa_keymint_key dsa_keymint_key_file (file (create write open getattr rename unlink)))
(allow hal_keymint_server device (dir (search)))
(allow hal_keymint_server dsa_keymint_key_file (dir (search getattr)))
(allow hal_keymint_server dsa_keymint_key_file (file (read open getattr)))

; The guest's DNS, answered by the host's resolver. The daemon listens on the loopback
; addresses (port 5553, UDP and TCP), where the packet filter sends every DNS query a program
; makes while the host answers, and hands each query to the host on the DNS port, which the
; vsock rules above already cover. The address and the port carry no label of their own.
(allow dsa_channeld self (udp_socket (create bind read write getattr setattr getopt setopt shutdown)))
(allow dsa_channeld self (tcp_socket (create bind listen accept read write getattr setattr getopt setopt shutdown)))
(allow dsa_channeld node (udp_socket (node_bind)))
(allow dsa_channeld node (tcp_socket (node_bind)))
(allow dsa_channeld port (udp_socket (name_bind)))
(allow dsa_channeld port (tcp_socket (name_bind)))

; vendor.dsa.dns (vendor_property_contexts): the daemon sets it to "on" while the host answers
; DNS queries and to "off" when it stays unreachable. Nothing else may set it.
(type dsa_dns_prop)
(roletype object_r dsa_dns_prop)
(typeattributeset property_type (dsa_dns_prop))
(typeattributeset vendor_property_type (dsa_dns_prop))
(allow dsa_channeld dsa_dns_prop (property_service (set)))
(allow dsa_channeld dsa_dns_prop (file (read open getattr map)))
(allow vendor_init dsa_dns_prop (file (read open getattr map)))
; adb's shell reads it too, so `getprop vendor.dsa.dns` says whether the host answers rather
; than an empty value for a refused read.
(allow shell dsa_dns_prop (file (read open getattr map)))

; The DNS redirect: init runs dsa-channeld --dns-redirect as root in this domain when
; vendor.dsa.dns changes (dsa-channeld.rc). It reads the property and runs iptables and
; ip6tables (system files) to fill or empty its own nat chain, dsa_dns. Those programs change
; the packet filter through a raw socket, which needs net_admin and net_raw, and wait on the
; packet filter's lock file (/system/etc/xtables.lock) so they never race netd. Nothing else
; is granted: the domain touches no file but those it runs and that lock.
(type dsa_dns_redirect)
(roletype object_r dsa_dns_redirect)
(typeattributeset domain (dsa_dns_redirect))
(allow init dsa_dns_redirect (process (transition siginh rlimitinh)))
(dontaudit init dsa_dns_redirect (process (noatsecure)))
(allow dsa_dns_redirect dsa_channeld_exec (file (entrypoint read getattr map execute open)))
(allow dsa_dns_redirect init (fd (use)))
(allow dsa_dns_redirect kmsg_device (chr_file (write append getattr)))
(allow dsa_dns_redirect kmsg_debug_device (chr_file (write append getattr)))
(allow dsa_dns_redirect dsa_dns_prop (file (read open getattr map)))
(allow dsa_dns_redirect system_file (dir (search getattr)))
(allow dsa_dns_redirect system_file (file (read open getattr map execute execute_no_trans lock)))
(allow dsa_dns_redirect system_lib_file (dir (search getattr)))
(allow dsa_dns_redirect system_lib_file (file (read open getattr map execute)))
(allow dsa_dns_redirect system_linker_exec (file (read open getattr map execute)))
(allow dsa_dns_redirect self (capability (net_admin net_raw)))
(allow dsa_dns_redirect self (rawip_socket (create getopt setopt read write)))
; The programs' standard streams are pipes the helper reads their errors from.
(allow dsa_dns_redirect self (fifo_file (read write getattr ioctl)))
; iptables asks the kernel to load a table's module first, which this kernel has built in.
(dontaudit dsa_dns_redirect self (capability (sys_module)))
(dontaudit dsa_dns_redirect kernel (system (module_request)))