<?xml version="1.0" encoding="utf-8"?>
<!--
  The guest agent. coreApp makes it start in the core-only boot stages too; persistent makes
  the activity manager start it at boot and restart it if it dies. The host is the shell: the
  agent reports tasks and acts on the host's requests, and its activities are the guest's
  invisible home (platform/HomeActivity.kt), which Android requires and nobody sees, and the
  guest's browser while web links go to the host (platform/LinkActivity.kt), which shows
  nothing. Its first service is the guest's input method (platform/HostInputMethod.kt), which
  shows nothing and types what the host's input method composes. Its other service is its
  notification listener (platform/AndroidNotifications.kt), which hands the guest's
  notifications to the host. An accessibility service (platform/HostAccessibilityService.kt)
  is enabled only while a host accessibility client watches a task. It is also the guest's
  widget host (platform/AndroidWidgets.kt), which draws the widgets the user placed on the
  host's desktop. Its print service (platform/HostPrintService.kt) sends what apps print to the
  host's printers. Its text-to-speech engine (platform/HostTextToSpeechService.kt), speech
  recognition service (platform/HostRecognitionService.kt) and spell checker
  (platform/HostSpellCheckerService.kt) are the guest's defaults and answer with the host's
  voices, speech recognition and spell checker. It is the guest's network location provider, and without Google Play its
  geocode provider, both answered by the host (platform/HostNetworkLocationService.kt,
  platform/HostGeocodeService.kt), and "Share on PC" in the share sheet (platform/ShareActivity.kt).
  Its backup transport (platform/HostBackupTransport.kt) keeps app data in the
  host's backup folder, and its credential provider (platform/HostCredentialProvider.kt) makes
  and uses passkeys with the host's authenticator.
  Every permission here is also in privapp-permissions-dsa-agent.xml, but for the runtime
  permissions, which default-permissions-dsa-agent.xml grants instead.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.thisisthepy.dsa.agent"
    coreApp="true">

    <!-- Listening to task changes; moving and resizing tasks and setting their density. -->
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS" />
    <!-- Seeing every app's tasks, not only its own. -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <!-- Ending a task the host closed. -->
    <uses-permission android:name="android.permission.REMOVE_TASKS" />
    <!-- Starting the app the host launched while no window of the agent is in front. -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <!-- Turning freeform windows on. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Turning click sounds off: nothing carries the guest's sound to the host. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Making the display a freeform display. -->
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />
    <!-- Injecting the pointer input of each task's host window into the task. -->
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <!-- Hearing the Escapes no app takes (key gesture events), which become Back. -->
    <uses-permission android:name="android.permission.MANAGE_KEY_GESTURES" />
    <!-- Reading the label and launcher activity of any app. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!--
      Reading the Google Services Framework Android ID, which Google's page for uncertified
      devices asks for, once the user has installed Google Play. Google's services framework
      declares the permission; without it installed, the permission does not exist.
    -->
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" />
    <!--
      Turning the screen off and on, forcing Doze while no task window is shown on the host,
      and setting the battery and battery saver to the host's.
    -->
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <!--
      Ending cached apps when the guest goes to sleep with no task open, and ending another
      app's processes that stay cached with no window: killBackgroundProcesses takes both.
    -->
    <uses-permission android:name="android.permission.KILL_ALL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Ending an app's processes when its last window closes, or when the host says Stop. -->
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <!-- Turning off the phone-only apps a desktop does not use, if the build has them. -->
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
    <!--
      Reading apps' frame timings for the input trace, as dumpsys gfxinfo does: the graphics
      service asks for both, as every dump of app usage does.
    -->
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!--
      Reading the system's dropbox (tombstones, ANR traces, crashes, the boot before's kernel
      log) for the diagnostics the host gathers on request; DUMP and PACKAGE_USAGE_STATS above
      are needed for it too. Since Android 11 the dropbox also asks for READ_DROPBOX_DATA, and
      refuses the whole read without it, so a bundle had no tombstones.
    -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.READ_DROPBOX_DATA" />
    <!-- Installing the APKs the host sends, without asking the user to confirm each one. -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <!--
      Putting an installed app's expansion (OBB) files in its folder under Android/obb/: Android
      opens those folders to an installer only while it holds the storage permissions too.
      They are runtime permissions, which the image grants by default.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Uninstalling an app the user removes on the host, without asking again in the guest. -->
    <uses-permission android:name="android.permission.DELETE_PACKAGES" />

    <!--
      Making the agent the guest's browser while web links go to the host, and giving the
      role back to a browser app when the user keeps links in the guest.
    -->
    <uses-permission android:name="android.permission.MANAGE_ROLE_HOLDERS" />
    <!--
      Allowing the agent's own notification listener at start, as Settings does when a person
      allows one: the guest has no screen to ask on.
    -->
    <uses-permission android:name="android.permission.MANAGE_NOTIFICATION_LISTENERS" />
    <!--
      Placing the widgets the user picks on the host without asking them to allow each one:
      the guest has no screen to ask on.
    -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <!--
      Setting the guest's clock to the host's when the host wakes from sleep: the guest's
      clock stands still or drifts while the host sleeps.
    -->
    <uses-permission android:name="android.permission.SET_TIME" />
    <!--
      Stopping an app that runs in the background when the user stops it from the host's
      notification area or the settings app, as Settings' "Force stop" does.
    -->
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <!--
      Following the host's system settings: its time zone (SET_TIME_ZONE), its display
      languages and regional format (CHANGE_CONFIGURATION), its dark theme
      (MODIFY_DAY_NIGHT_MODE) and its accent color as the seed of the dynamic colors
      (CHANGE_OVERLAY_PACKAGES, for the overlay that carries the palette).
    -->
    <uses-permission android:name="android.permission.SET_TIME_ZONE" />
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <uses-permission android:name="android.permission.MODIFY_DAY_NIGHT_MODE" />
    <uses-permission android:name="android.permission.CHANGE_OVERLAY_PACKAGES" />
    <!--
      Joining the host's network: Wi-Fi turned on and the host's network saved for every app,
      as Settings does, because the guest has no setup wizard to do it.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />
    <!--
      Being the guest's speech recognition service: Android hands an app's recognition only to
      a recognizer that may record, as it checks the app may. The sound is recorded on the
      host. It is a runtime permission, which the image grants by default.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
      Keeping the activity manager's cached process limit, which it reads from the device
      configuration (DeviceConfig), and setting it again when something else changes it.
    -->
    <uses-permission android:name="android.permission.READ_DEVICE_CONFIG" />
    <uses-permission android:name="android.permission.WRITE_DEVICE_CONFIG" />
    <!--
      Making the agent's backup transport Android's, turning backup and automatic restore on,
      and running the backups and restores the host asks for.
    -->
    <uses-permission android:name="android.permission.BACKUP" />
    <!--
      Being a system credential provider, which the credential manager lists whatever other
      providers write into its settings.
    -->
    <uses-permission android:name="android.permission.PROVIDE_DEFAULT_ENABLED_CREDENTIAL_SERVICE" />
    <!--
      Being the guest's network location provider and geocode provider, which the location
      manager binds only in a package that holds this.
    -->
    <uses-permission android:name="android.permission.INSTALL_LOCATION_PROVIDER" />
    <!--
      Routing each app with a window to an output of its own (an audio policy), and setting
      Android's media volume to the one the user set for the app on the host.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".platform.AgentApplication"
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:label="@string/app_name"
        android:persistent="true">

        <!--
          The guest's home: no content, transparent, never in recents, and not in the launcher
          category, so it is in no app list. It stays in the agent's process (no
          android:process), which is always running, so it never starts cold. It keeps every
          configuration change instead of being recreated for it, and one instance is enough.
        -->
        <activity
            android:name=".platform.HomeActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          An app's request to pin a shortcut (requestPinShortcut), which Android hands to the
          default launcher: it shows nothing, hands the request to the agent, which asks the
          host, and finishes at once. Having it makes ShortcutManager.isRequestPinShortcutSupported
          true for the apps. It runs in a task of its own, in the agent's package, which the
          host never shows a window for, so the app that asked keeps its window. Only the
          system starts it, so it is not exported.
        -->
        <activity
            android:name=".platform.PinShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="io.github.thisisthepy.dsa.agent.pinshortcut"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!--
          The guest's browser while web links go to the host: it shows nothing, hands each
          http and https link to the agent, which sends it to the host, and finishes at once.
          A link an installed app has verified as its own (an App Link) never comes here:
          Android opens it in that app.
        -->
        <activity
            android:name=".platform.LinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
          "Share on PC" in Android's share sheet: it shows nothing, hands the text, links and
          files an app shares to the agent, which sends them to the host's share UI, and stays
          until the host has copied the files, since the app's read access lasts only while it
          does. It runs in a task of its own (singleInstance), which the host shows no window
          for, so the app that shared stays usable.
        -->
        <activity
            android:name=".platform.ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target_name"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          Runs a widget's setup when the user places it: it shows nothing, starts the setup of
          the widget's app above it, and finishes with its answer. It opens a freeform task of
          its own, never the agent's home task, which has no window on the host: an affinity
          of its own, and the agent starts it with NEW_TASK and MULTIPLE_TASK. The host shows
          that task as the app's window. It handles its own configuration changes, so a
          window moved or resized during the setup keeps it. It is not exported: only the
          agent starts it.
        -->
        <activity
            android:name=".platform.WidgetConfigureActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="false"
            android:resizeableActivity="true"
            android:taskAffinity="io.github.thisisthepy.dsa.agent.widgetsetup"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          The files the host sends, read only, to the app the user picks. Not exported: an app
          reads a file only through the permission granted with the intent that offers it.
        -->
        <provider
            android:name=".platform.HostFileProvider"
            android:authorities="io.github.thisisthepy.dsa.agent.hostfiles"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          The guest's only input method. It is no keyboard: it has no view and is never shown,
          and it puts the text the host's input method composes and commits into the focused
          editor. BIND_INPUT_METHOD keeps every caller but the input method manager out.
        -->
        <service
            android:name=".platform.HostInputMethod"
            android:exported="true"
            android:label="@string/input_method_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/host_input_method" />
        </service>

        <!--
          The agent's notification listener. Only the notification manager may bind it, and it
          runs in the agent's process, which is always running.
        -->
        <service
            android:name=".platform.HostNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          The guest's print service: it offers the host's printers in Android's print dialog
          and hands each job's PDF to the agent, which sends it to the host, where the host's
          print dialog picks the printer (platform/HostPrintService.kt). Only the print spooler
          may bind it, and it runs in the agent's process.
        -->
        <service
            android:name=".platform.HostPrintService"
            android:exported="true"
            android:label="@string/print_service_name"
            android:permission="android.permission.BIND_PRINT_SERVICE">
            <intent-filter>
                <action android:name="android.printservice.PrintService" />
            </intent-filter>
        </service>

        <!--
          The guest's text-to-speech engine: it lists the host's voices and speaks with them,
          the host sending back each text's sound (platform/HostTextToSpeechService.kt). The
          text to speech manager binds it for any app that speaks.
        -->
        <service
            android:name=".platform.HostTextToSpeechService"
            android:exported="true"
            android:label="@string/tts_engine_name">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/host_tts_engine" />
        </service>

        <!--
          Answers an app's or Settings' check of the engine's voice data: every language the
          host speaks is installed. It shows nothing.
        -->
        <activity
            android:name=".platform.HostTtsDataActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The guest's speech recognition service: the host's speech recognition listens to the
          host's microphone (platform/HostRecognitionService.kt). Any app may bind it, as any
          recognizer; Android checks the app may record before the service is asked.
        -->
        <service
            android:name=".platform.HostRecognitionService"
            android:exported="true"
            android:label="@string/recognition_service_name">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/host_recognition_service" />
        </service>

        <!--
          The guest's spell checker: the host's spell checker checks what editors ask about
          (platform/HostSpellCheckerService.kt). BIND_TEXT_SERVICE keeps every caller but the
          text services manager out.
        -->
        <service
            android:name=".platform.HostSpellCheckerService"
            android:exported="true"
            android:label="@string/spell_checker_name"
            android:permission="android.permission.BIND_TEXT_SERVICE">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService" />
            </intent-filter>
            <meta-data
                android:name="android.view.textservice.scs"
                android:resource="@xml/host_spell_checker" />
        </service>

        <!--
          The guest's network location provider: the image names the agent as the provider,
          and the location manager binds it for the network provider, which reports the host's
          location (platform/HostNetworkLocationService.kt). WRITE_SECURE_SETTINGS keeps every
          caller but the system out, as Android's own location providers do.
        -->
        <service
            android:name=".platform.HostNetworkLocationService"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.android.location.service.v3.NetworkLocationProvider" />
            </intent-filter>
            <meta-data
                android:name="serviceVersion"
                android:value="1" />
        </service>

        <!--
          The guest's geocode provider without Google Play: Android's Geocoder asks it, and it
          asks the host (platform/HostGeocodeService.kt). With the Google apps image an overlay
          names Google's geocoder, and the system does not bind this one. Only the system may
          bind it.
        -->
        <service
            android:name=".platform.HostGeocodeService"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.android.location.service.GeocodeProvider" />
            </intent-filter>
            <meta-data
                android:name="serviceVersion"
                android:value="1" />
        </service>

        <!--
          Reads the nodes of the tasks a host accessibility client (a screen reader) watches,
          so the host can show them in each task window's accessibility tree. The agent
          enables it only while the host watches a task and disables it after; it shows
          nothing. BIND_ACCESSIBILITY_SERVICE keeps every caller but the system out.
        -->
        <service
            android:name=".platform.HostAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/host_accessibility_service" />
        </service>

        <!--
          The guest's backup transport (platform/HostBackupTransport.kt): app data backups go
          to the host's backup folder and come back from it. The backup manager binds it with
          android.backup.TRANSPORT_HOST, and uses it only because the image's sysconfig
          (sysconfig-dsa-agent.xml) lists it and the agent is privileged. Not exported: only the
          system binds it.
        -->
        <service
            android:name=".platform.HostBackupTransportService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.backup.TRANSPORT_HOST" />
            </intent-filter>
        </service>

        <!--
          The guest's passkey provider (platform/HostCredentialProvider.kt): the host's
          authenticator makes and uses passkeys. Only the credential manager may bind it. The
          second action makes it a system provider, which the credential manager lists without
          the user enabling it.
        -->
        <service
            android:name=".platform.HostCredentialProvider"
            android:exported="true"
            android:label="@string/passkey_provider_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.credentials.system.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/host_credential_provider" />
        </service>

        <!--
          Hands a passkey request the person sent to "this computer" to the host and returns
          the result (platform/PasskeyActivity.kt). It shows nothing, and only the credential
          provider's pending intents start it.
        -->
        <activity
            android:name=".platform.PasskeyActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
