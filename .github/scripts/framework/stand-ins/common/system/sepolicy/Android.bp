// Stands in for system/sepolicy/Android.bp, which the lock leaves out and build.sh puts in
// its place. The tree takes only compat/libgenfslabelsversion from system/sepolicy, for
// libandroid_runtime. The real file declares the policy's se_* modules, whose module types
// only sepolicy's own Soong plugin defines, so Soong's analysis stops on them. This file
// keeps the package and the license that libgenfslabelsversion names, exactly as upstream
// writes them (the same in the Android 16 and 17 pins).

package {
    default_applicable_licenses: ["system_sepolicy_license"],
}

license {
    name: "system_sepolicy_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "legacy_unencumbered",
    ],
    license_text: [
        "NOTICE",
    ],
}
