// The x86_64 framework libraries the translator's proxy libraries call into. The build takes
// them from the pinned x86_64 image (dsa/guest/image/inputs.json) into x86_64/ with
// `assemble-digitalis.py framework-libs`, whose FRAMEWORK_LIBS lists the same libraries (a
// test checks the two agree). The proxies link against them and are installed beside them,
// so linking the image's own libraries is exact; building them would take the framework.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_prebuilt_library_shared {
    name: "libEGL",
    prefer: true,
    srcs: ["x86_64/libEGL.so"],
    compile_multilib: "64",
    installable: false,
    check_elf_files: false,
    strip: {
        none: true,
    },
    system_shared_libs: [],
    stl: "none",
    header_libs: ["dsa_translator_framework_headers"],
    export_header_lib_headers: ["dsa_translator_framework_headers"],
}

cc_prebuilt_library_shared {
    name: "libGLESv1_CM",
    prefer: true,
    srcs: ["x86_64/libGLESv1_CM.so"],
